__pycache__/
*.pyc
.DS_Store
.worktrees/
.claude/settings.local.json
node_modules/
package-lock.json
scratch/

# Compiled app binary (rebuild via ./desktop/build-desktop.sh)
Amux.app/Contents/MacOS/amux

# Built desktop app bundle (generated by ./desktop/build-desktop.sh)
Amux.app/

# Android build artifacts (generated by Gradle)
android/**/build/
android/**/.gradle/

# Runtime lock file
.claude/scheduled_tasks.lock

# Stray Chrome test-profile dir from a --user-data-dir mishap (safe to delete)
/-/

# Generated during cloud deploy — always copied from root amux-server.py
cloud/docker/amux-server.py

# iOS — generated by xcodegen (run `xcodegen generate` to recreate)
ios/AmuxApp.xcodeproj/
ios/fastlane/report.xml
ios/fastlane/Preview.html
ios/*.ipa
ios/*.dSYM.zip

# runtime database — never commit (user data)
amux.db
amux.db-*

.gstack/

# Rust build artifacts
/target
/test-results
# Playwright writes its output relative to e2e/ (testDir is '.'), so the
# repo-root pattern above never matched it — a failed e2e run left
# e2e/test-results/ untracked and one `git add -A` from being committed.
e2e/test-results/
e2e/playwright-report/

# Regenerated by scripts/spa-lint.sh on every run (and by CI before it lints),
# so a committed copy is never what anything actually reads — it only drifts.
# Tracking it made every session that lints or commits client JS leave an
# "ownership unknown" modification with no edit record, and its diff was
# partially STALE, so committing it would silently revert peers' entries.
# eslint.config.mjs already treats absence as correct: a direct eslint run
# without it fails loudly on no-undef rather than passing silently.
crates/amux-dashboard/eslint.globals.generated.json

# Generated by install.sh (AMUX-3667): pins every cargo invocation in this
# checkout to the shared build dir. Absolute and machine-specific, so it must
# never be committed — a baked-in home directory would send another machine's
# builds somewhere it cannot write.
/.cargo/config.toml
