#!/usr/bin/env bash
# amux — phone-friendly Claude Code worker manager built on tmux
# Usage: amux [command] [args...]
#
# LEGACY CLIENT, pending amux-rs verb parity: this bash CLI is an HTTP client
# of the Rust server — it is NOT part of the removed Python server, and the
# fleet's muscle memory (amux send/board/alert) runs through it. Keep it working
# until crates/amux-cli covers every verb.
#
# It talks to 8824, the canonical port (AMUX_RS_PORT, what install.sh sets).
# 8822 is the RETIRED address, answered only by a countdown bind for pre-cutover
# processes — see crates/amux-server/src/legacy_port.rs. Do not point anything
# new at it. Override with AMUX_API for a non-default server.
#
# This file is symlinked from ~/.local/bin/amux and re-read on every invocation,
# so editing the default here moves the whole fleet's bash-CLI traffic at once,
# with no restart — which is why it is the cheapest lever in the migration.

set -euo pipefail

CC_VERSION="0.3.0"

# ── Migration from cc/cmux → amux ───────────────────────────────────────────
# Migrate legacy dirs to ~/.amux if new one doesn't exist
if [[ ! -d "$HOME/.amux" ]]; then
  for _old in "$HOME/.cmux" "$HOME/.cc"; do
    if [[ -d "$_old" ]]; then
      mv "$_old" "$HOME/.amux"
      echo "Migrated $_old → ~/.amux"
      break
    fi
  done
fi

CC_HOME="${CC_HOME:-$HOME/.amux}"
CC_SESSIONS="$CC_HOME/sessions"
CC_DEFAULTS="$CC_HOME/defaults.env"

# ── Colors (disabled when not a tty or TERM is dumb) ────────────────────────
if [[ -t 1 ]] && [[ "${TERM:-dumb}" != "dumb" ]]; then
  BOLD=$'\033[1m' DIM=$'\033[2m' RESET=$'\033[0m'
  RED=$'\033[31m' GREEN=$'\033[32m' YELLOW=$'\033[33m'
  BLUE=$'\033[34m' CYAN=$'\033[36m'
else
  BOLD='' DIM='' RESET='' RED='' GREEN='' YELLOW='' BLUE='' CYAN=''
fi

# ── Helpers ──────────────────────────────────────────────────────────────────

die() { echo "${RED}error:${RESET} $*" >&2; exit 1; }

# ── Every server call goes through _curl ─────────────────────────────────────
#
# A CONNECT TIMEOUT, in one place, because a per-call-site flag is a thing every
# future call site has to remember and not one of the 41 sites did. Re-measured
# against upstream/main at rebase time: 41 curl invocations, 0 with
# --connect-timeout, 8 carrying only -m.
#
# Without one, an unreachable server does not FAIL — it HANGS, and none of the
# error handling in this file can run while curl is still waiting. Measured
# 2026-08-23 (AEAB-46): a dead localhost port on WSL2 drops the SYN instead of
# refusing it, so `amux board done <id> --outcome ...` sat until its CALLER gave
# up after two minutes and printed nothing. AEAB-36's "cannot reach the board —
# NOTHING was applied" die() was already right there and could not fire. Pointed
# at a host that fails fast (DNS, curl exit 6) the same command printed it
# correctly — so the instrument could report the shape of failure that was
# already obvious and not the one that looks like a wedged CLI.
#
# `-m`/`--max-time` is a DIFFERENT knob and stays at the call site: it caps the
# whole transfer, and `peek --live` or `send` may legitimately be slow. The eight
# sites that already had `-m` still hung for their full budget on a dropped
# connect, which is why adding more of it was never the fix.
_curl() {
  local rc=0
  command curl --connect-timeout "${AMUX_CURL_CONNECT_TIMEOUT:-5}" "$@" || rc=$?
  if [[ "$rc" -ne 0 ]]; then _transport_breadcrumb "$rc" "$@"; fi
  return "$rc"
}

# The second half of the fix: make the NEXT transport failure self-announcing.
#
# A CLI that cannot reach the server also cannot report that it could not reach
# the server — the request never arrives, so nothing lands in the request log and
# a sweep of /api/logs/analyze sees a silence identical to "nobody ran anything".
# So the note is written to disk here and shipped on the next invocation that CAN
# reach the server (_flush_transport_breadcrumbs).
#
# Recorded: the curl exit code, the method, and the URL with its QUERY STRING
# stripped — so scheme and host and path, not the path alone — never the body and
# never the headers. A breadcrumb whose own payload leaks an outcome's prose or an
# auth header into a log the whole fleet reads costs more than the hang did. The
# host is kept deliberately: AMUX_API pointing somewhere unexpected is one of the
# things this breadcrumb exists to make visible.
_transport_breadcrumb() {
  local rc="$1"; shift
  local url="" method="GET" prev="" a
  for a in "$@"; do
    case "$a" in http://*|https://*) url="$a" ;; esac
    if [[ "$prev" == "-X" ]]; then method="$a"; fi
    prev="$a"
  done
  printf '{"ts":%s,"curl_exit":%s,"method":"%s","url":"%s","session":"%s","cli":"bash"}\n' \
    "$(date -u +%s)" "$rc" "$method" "${url%%\?*}" \
    "${AMUX_SESSION:-${AMUX_WORKER:-}}" \
    >> "$CC_HOME/cli-transport.jsonl" 2>/dev/null || true
}

# Ship the backlog to /api/client-debug, which logs the whole payload at INFO in
# ~/.amux/logs/server-rs.log and serves it back from
# GET /api/client-debug?kind=cli-transport-failure. That is what turns "my amux
# command hung once" from a thing one operator saw into a thing a log sweep finds.
#
# ALWAYS returns 0: a diagnostic that can break a hot path 48 lanes run is worse
# than no diagnostic.
#
# What it deletes, it delivered. The first version of this function read the
# NEWEST 200 lines, posted those, and then cleared the WHOLE file — so on a
# backlog of 201 every older breadcrumb was destroyed unsent, and the truncate
# reported success. That is the shape this PR fixes one layer up, one layer down:
# a composite operation taking its success signal from the part that worked. It
# also raced: ~48 lanes share CC_HOME, so a `>>` landing between the read and the
# `: >` was lost even inside the window.
#
# So the file is ROTATED, not truncated. mv is atomic within the directory: the
# snapshot is exactly what gets posted, concurrent appends land in a fresh file
# while it drains, and the snapshot is removed only on a 2xx — any other answer
# puts it back for the next invocation to retry. There is no per-post row cap
# because that cap is what ate the evidence; the snapshot can only grow while the
# server is unreachable, and the first command that reaches it ships all of it.
_flush_transport_breadcrumbs() {
  local f="$CC_HOME/cli-transport.jsonl"
  [[ -s "$f" ]] || return 0
  local snap="$f.sending.$$"
  mv "$f" "$snap" 2>/dev/null || return 0
  local body code
  body=$(F="$snap" python3 -c '
import json, os
rows = []
with open(os.environ["F"]) as fh:
    for line in fh.read().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            rows.append(json.loads(line))
        except Exception:
            pass
print(json.dumps({"kind": "cli-transport-failure", "n": len(rows), "rows": rows}))
' 2>/dev/null) || { _restore_transport_snapshot "$snap" "$f"; return 0; }
  # command curl, NOT _curl: a failed flush must not breadcrumb its own failure,
  # which would be an unbounded pile of notes about not being able to send notes.
  code=$(command curl -sk --connect-timeout 3 -m 5 -o /dev/null -w '%{http_code}' \
    -X POST -H 'Content-Type: application/json' -d "$body" \
    "${AMUX_API:-https://localhost:8824}/api/client-debug" 2>/dev/null || echo 000)
  case "$code" in
    2??) rm -f "$snap" 2>/dev/null || true ;;
    *) _restore_transport_snapshot "$snap" "$f" ;;
  esac
  return 0
}

# Appended back rather than moved back, because a fresh $f may already exist from
# a lane that failed while this snapshot was in flight — clobbering it would lose
# the very breadcrumbs this function exists to keep.
_restore_transport_snapshot() {
  cat "$1" >> "$2" 2>/dev/null && rm -f "$1" 2>/dev/null
  return 0
}

need_tmux() {
  command -v tmux &>/dev/null || die "tmux is required. Install with: brew install tmux"
}

ensure_dirs() {
  mkdir -p "$CC_SESSIONS"
  [[ -f "$CC_DEFAULTS" ]] || touch "$CC_DEFAULTS"
}

# Resolve session name from partial match or alias
resolve_session() {
  local query="$1"
  # Exact match first
  if [[ -f "$CC_SESSIONS/$query.env" ]]; then
    echo "$query"
    return
  fi
  # Prefix match
  local matches=()
  for f in "$CC_SESSIONS"/*.env; do
    [[ -f "$f" ]] || continue
    local name
    name=$(basename "$f" .env)
    if [[ "$name" == "$query"* ]]; then
      matches+=("$name")
    fi
  done
  if [[ ${#matches[@]} -eq 1 ]]; then
    echo "${matches[0]}"
    return
  elif [[ ${#matches[@]} -gt 1 ]]; then
    die "ambiguous: '$query' matches ${matches[*]}"
  fi
  # Number lookup (for dashboard shortcuts)
  if [[ "$query" =~ ^[0-9]+$ ]]; then
    local i=1
    for f in "$CC_SESSIONS"/*.env; do
      [[ -f "$f" ]] || continue
      if [[ "$i" -eq "$query" ]]; then
        basename "$f" .env
        return
      fi
      ((i++))
    done
  fi
  die "worker '$query' not found"
}

# Load session config into env vars
load_session() {
  local name="$1"
  local file="$CC_SESSIONS/$name.env"
  [[ -f "$file" ]] || die "worker '$name' not found"
  # shellcheck disable=SC1090
  source "$file"
}

# Load global defaults
load_defaults() {
  [[ -f "$CC_DEFAULTS" ]] && source "$CC_DEFAULTS"
  # Load ~/.amux/server.env so CLI-spawned sessions see the same AMUX_* knobs
  # the server process uses (e.g. AMUX_CLAUDE_CMD). Parsed manually rather than
  # `source`d so values are never shell-expanded — mirrors the server's env
  # loader (crates/amux-server/src/config.rs), which treats entries as literal
  # key=value pairs and is safe for values containing $, backticks, etc.
  local _se="$CC_HOME/server.env"
  if [[ -f "$_se" ]]; then
    local _k _v
    while IFS='=' read -r _k _v; do
      # Trim all leading/trailing whitespace (matches Python's .strip()).
      # Standard glob [![:space:]] — no extglob needed.
      _k="${_k#"${_k%%[![:space:]]*}"}"; _k="${_k%"${_k##*[![:space:]]}"}"
      _v="${_v#"${_v%%[![:space:]]*}"}"; _v="${_v%"${_v##*[![:space:]]}"}"
      [[ -z "$_k" || "$_k" == \#* || -z "$_v" ]] && continue
      export "$_k=$_v"
    done < "$_se"
  fi
}

# Get tmux session name (prefixed to avoid conflicts)
tmux_name() { echo "amux-$1"; }

# Migrate a cmux-* or cc-* tmux session to amux-* if needed
migrate_tmux() {
  local name="$1"
  if tmux has-session -t "=amux-$name" 2>/dev/null; then return; fi
  for old_prefix in "cmux-" "cc-"; do
    if tmux has-session -t "=${old_prefix}${name}" 2>/dev/null; then
      tmux rename-session -t "=${old_prefix}${name}" "amux-$name" 2>/dev/null || true
      break
    fi
  done
}

# ─── herdr backend helpers ───────────────────────────────────────────────────
# Mirror of the server's _backend_of_cfg: CC_BACKEND in the session env wins,
# then $AMUX_BACKEND, default tmux. herdr sessions live in one headless named
# herdr session (AMUX_HERDR_SESSION, default "amux") that the SERVER owns, so
# start/stop go through the server API; attach/peek can talk to herdr direct.

herdr_session_name() { echo "${AMUX_HERDR_SESSION:-amux}"; }

session_backend() {
  local name="$1" b=""
  if [[ -f "$CC_SESSIONS/$name.env" ]]; then
    b=$(sed -n 's/^CC_BACKEND=//p' "$CC_SESSIONS/$name.env" | tail -1 | tr -d '"' | tr '[:upper:]' '[:lower:]')
  fi
  [[ -n "$b" ]] || b=$(printf '%s' "${AMUX_BACKEND:-tmux}" | tr '[:upper:]' '[:lower:]')
  if [[ "$b" == "herdr" ]]; then echo "herdr"; else echo "tmux"; fi
}

# Persisted herdr agent name for an amux session (server writes CC_HERDR_AGENT
# on first start; empty until then).
herdr_agent_of() {
  local name="$1"
  [[ -f "$CC_SESSIONS/$name.env" ]] || return 0
  sed -n 's/^CC_HERDR_AGENT=//p' "$CC_SESSIONS/$name.env" | tail -1 | tr -d '"'
}

need_herdr() {
  command -v herdr &>/dev/null || die "herdr is required for herdr-backend workers. Install herdr or set AMUX_BACKEND=tmux"
}

_start_via_api() {
  local name="$1"
  local AMUX_API="${AMUX_API:-https://localhost:8824}"
  local resp
  resp=$(_curl -sk -m 90 -X POST -H "X-Amux-Session: ${AMUX_SESSION:-}" \
    "$AMUX_API/api/sessions/$name/start" 2>/dev/null) || resp=""
  if [[ -z "$resp" ]]; then
    # herdr AND codex/ollama start through the server now (AMUX-3164), so this is
    # no longer herdr-specific. A stranded lane whose $AMUX_URL is the retired
    # 8822 (AMUX-3046) hits this even when the server is up — use `$(amux url)`.
    die "amux server unreachable at ${AMUX_API} — this worker starts through the server (amux serve). If the server IS up, your \$AMUX_URL may be the retired 8822 (AMUX-3046) — retry with: AMUX_URL=\$(amux url) amux start ${name}. NOTHING was started."
  fi
  local rc=0
  RESP="$resp" TGT="$name" python3 - <<'PYEOF' || rc=$?
import json, os, sys
try:
    d = json.loads(os.environ["RESP"])
except Exception:
    sys.exit(1)
tgt = os.environ["TGT"]
if d.get("error") or d.get("ok") is False:
    print(f"start {tgt} FAILED: {d.get('error') or d.get('message')}")
    sys.exit(1)
print(f"started {tgt}: {d.get('message', 'ok')}")
PYEOF
  return $rc
}

_stop_via_api() {
  local name="$1"
  local AMUX_API="${AMUX_API:-https://localhost:8824}"
  local resp
  resp=$(_curl -sk -m 15 -X POST -H "X-Amux-Session: ${AMUX_SESSION:-}" \
    "$AMUX_API/api/sessions/$name/stop" 2>/dev/null) || resp=""
  if [[ -z "$resp" ]]; then
    return 1
  fi
  # A non-empty body is NOT proof of success: an error JSON or a proxy's
  # HTML page must fall through to the direct pane-close fallback, not
  # masquerade as a graceful stop.
  if ! RESP="$resp" python3 - <<'PYEOF'
import json, os, sys
try:
    d = json.loads(os.environ["RESP"])
except Exception:
    sys.exit(1)
if not isinstance(d, dict) or d.get("error") or d.get("ok") is False:
    sys.exit(1)
PYEOF
  then
    return 1
  fi
  echo "${RED}stopping${RESET} $name (graceful, via server)"
  return 0
}

# Check if tmux session is alive.
# NOTE: tmux's -t prefix-matches session names by default, so a bare
# "amux-foo" would also match a running "amux-foo-worker". Prefix the
# target with '=' to force an exact match. Name resolution / abbreviation
# is already handled safely upstream by resolve_session().
is_running() {
  if [[ "$(session_backend "$1")" == "herdr" ]]; then
    local agent
    agent=$(herdr_agent_of "$1")
    [[ -n "$agent" ]] || return 1
    herdr --session "$(herdr_session_name)" agent get "$agent" >/dev/null 2>&1
    return $?
  fi
  migrate_tmux "$1"
  tmux has-session -t "=$(tmux_name "$1")" 2>/dev/null
}

# ─── Shell-safe flag quoting ─────────────────────────────────────────────────
#
# Common runner: spawn python3, isolate stderr to a temp file, check exit
# code, surface diagnostic on failure. Used by both quote_flags (one-string
# form) and quote_argv (multi-arg form) so the stderr-isolation pattern
# lives in one place. SECURITY: never echoes the input arguments back on
# failure — they may contain secrets — only the input length and python's
# stderr.
_run_py_safe() {
  local script="$1"
  shift
  local result err err_file
  local rc=0
  err_file=$(mktemp) || {
    echo "amux: error: mktemp failed (cannot create temp file for python3 stderr)" >&2
    return 1
  }
  # `|| rc=$?` is critical: under set -e (which the source-guard makes
  # possible if a sourcing script enables it), a naked `result=$(...); rc=$?`
  # would abort the function on python3 failure BEFORE rc is captured,
  # bypassing the error handler.
  result=$(python3 -c "$script" "$@" 2>"$err_file") || rc=$?
  if (( rc != 0 )); then
    err=$(<"$err_file")
    rm -f "$err_file"
    local n_args=$#
    echo "amux: error: python3 helper failed (exit $rc, $n_args input args): $err" >&2
    return 1
  fi
  rm -f "$err_file"
  printf '%s' "$result"
}

# Tokenize a stored flag string and re-quote each token shell-safely.
# Mirror of the server's shell_quote_flags (crates/amux-server/src/api/
# session_verbs.rs) — see that function for full rationale. Required
# because zsh glob-expands unquoted '[1m]' in
# model IDs like 'claude-opus-4-6[1m]', failing with 'no matches found'
# before claude is even invoked.
#
# Implementation note: this delegates to python3's shlex rather than using
# native bash word-splitting. Bash's IFS-based splitting (arr=( $s ),
# read -ra) ignores embedded quotes in multi-word flag values AND triggers
# pathname expansion (globbing) on the input. xargs has subtle escape-rule
# differences from shlex on macOS vs GNU. Using python3 guarantees 100%
# parity with the server's _shell_quote_flags so the same test fixtures
# verify both code paths.
#
# PERFORMANCE: each invocation spawns a python interpreter (~30-50ms).
# Acceptable for a once-per-session-spawn helper. Do NOT call this inside
# loops or hot paths.
quote_flags() {
  local s="$1"
  [[ -z "$s" ]] && return 0
  _run_py_safe '
import sys, shlex
s = sys.argv[1]
try:
    print(" ".join(shlex.quote(t) for t in shlex.split(s)))
except ValueError:
    print(shlex.quote(s))
' "$s"
}

# Quote a list of already-tokenized argv elements (each $1, $2, ... is one
# argument). Used in cmd_start for inline arguments passed via
# `amux start NAME -- ...`. printf '%q' uses bash-only $'...' syntax that
# breaks under dash; shlex.quote uses universal POSIX single-quoting.
quote_argv() {
  (( $# == 0 )) && return 0
  _run_py_safe '
import sys, shlex
print(" ".join(shlex.quote(a) for a in sys.argv[1:]))
' "$@"
}

# Parse Claude Code flags from args, split into CC_FLAGS array and remaining args
# Sets: CC_FLAGS_STR (for storage), CC_DIR, CC_EXTRA_ARGS
parse_claude_flags() {
  CC_FLAGS=()
  CC_DIR=""
  CC_EXTRA_ARGS=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      # Flags that take a value
      --model|--permission-mode|--system-prompt|--append-system-prompt|\
      --mcp-config|--allowedTools|--allowed-tools|--disallowedTools|--disallowed-tools|\
      --add-dir|--effort|--settings|--setting-sources|--tools|\
      --plugin-dir|--agents|--agent|--betas|--debug-file|--json-schema|\
      --fallback-model|--max-budget-usd|--session-id|--file|--strict-mcp-config)
        CC_FLAGS+=("$1" "$2")
        shift 2
        ;;
      # Boolean flags
      --dangerously-skip-permissions|--allow-dangerously-skip-permissions|\
      --yolo|--verbose|--chrome|--no-chrome|--debug|\
      --disable-slash-commands|--no-session-persistence|--ide|--fork-session)
        # --yolo is an alias for --dangerously-skip-permissions
        if [[ "$1" == "--yolo" ]]; then
          CC_FLAGS+=("--dangerously-skip-permissions")
        else
          CC_FLAGS+=("$1")
        fi
        shift
        ;;
      # Working directory — resolve to absolute path, create if needed.
      # We previously fell back to the literal $2 if cd failed, which silently
      # let relative paths slip into the session env file (CC_DIR=./foo). On
      # next start the relative path would resolve from whatever pwd happened
      # to be, and Claude Code would write files into the wrong tree. Now we
      # die loudly instead.
      --dir)
        mkdir -p "$2" || die "cannot create --dir: $2"
        CC_DIR="$(cd "$2" && pwd)" || die "cannot resolve --dir to absolute path: $2"
        shift 2
        ;;
      # Everything else goes to extra args
      *)
        CC_EXTRA_ARGS+=("$1")
        shift
        ;;
    esac
  done
  CC_FLAGS_STR="${CC_FLAGS[*]:-}"
}

# ── Commands ─────────────────────────────────────────────────────────────────

cmd_register() {
  local name="${1:-}"
  # A flag in the name slot is never a worker name (AMUX-3116). `amux register
  # --help` used to register a worker literally named "--help" in the cwd instead
  # of printing usage; a leading-dash name is a mistake, not an identifier. Same
  # guard the board verbs carry (see the `-*) die` case there).
  case "$name" in
    ""|-h|--help|help) die "usage: amux register <name> [--model opus] [--yolo] [--dir /path] [claude flags...]" ;;
    -*) die "amux register: '$name' looks like a flag, not a worker name. Put the name first: amux register <name> [flags]" ;;
  esac
  shift

  parse_claude_flags "$@"

  # Always persist an absolute CC_DIR. If --dir wasn't passed, use $(pwd) which
  # is already absolute. Refuse to write a relative path because it would be
  # resolved against pwd at start time — easy way for Claude Code to scribble
  # files into the wrong tree.
  local resolved_dir="${CC_DIR:-$(pwd)}"
  case "$resolved_dir" in
    /*) ;;  # absolute, ok
    *) die "CC_DIR must be absolute, got: $resolved_dir" ;;
  esac

  local file="$CC_SESSIONS/$name.env"
  # MERGE, do not truncate (AMUX-3117). Re-registering an existing worker used to
  # `cat >` the file down to CC_NAME/CC_DIR/CC_FLAGS, SILENTLY WIPING every other
  # CC_* key it does not manage — CC_DESC and CC_TAGS were lost this way, and
  # re-register is the only path to set flags (the PATCH-flags gap, AMUX-3115), so
  # the destructive path was on the happy path (gtm-engine, 2026-08-14). Preserve
  # every existing CC_* assignment except the three this verb owns, verbatim (no
  # re-parse, so quoting/JSON values survive intact).
  local preserved=""
  if [[ -f "$file" ]]; then
    preserved=$(grep -E '^CC_[A-Za-z0-9_]+=' "$file" 2>/dev/null \
                | grep -vE '^(CC_NAME|CC_DIR|CC_FLAGS)=' || true)
  fi
  {
    echo "# amux session: $name"
    echo "# registered: $(date -Iseconds)"
    echo "CC_NAME=\"$name\""
    echo "CC_DIR=\"$resolved_dir\""
    echo "CC_FLAGS=\"${CC_FLAGS_STR}\""
    [[ -n "$preserved" ]] && printf '%s\n' "$preserved"
  } > "$file"

  echo "${GREEN}registered${RESET} ${BOLD}$name${RESET} → $resolved_dir"
  [[ -n "$preserved" ]] && echo "  ${DIM}preserved: $(printf '%s\n' "$preserved" | sed -E 's/=.*//' | paste -sd, -)${RESET}"
  [[ -n "$CC_FLAGS_STR" ]] && echo "  flags: $CC_FLAGS_STR"
}

cmd_start() {
  local name dry_run=false detach=false
  # AMUX_API is referenced bare below (the tmux `-e AMUX_URL=$AMUX_API` inject at
  # the real-launch path, and the codex/ollama server delegation) but was never
  # declared local here the way _api_start / _api_stop / send all do, so under
  # `set -u` a real `amux start` (non-dry-run) died with "AMUX_API: unbound
  # variable" whenever AMUX_API wasn't already exported. Dry-run returns before
  # that line, which is why it hid.
  #
  # Resolve via cmd_url (the endpoint.json self-heal), NOT the raw $AMUX_URL. A
  # pre-cutover lane carries the retired 8822 in $AMUX_URL for life (AMUX-3046),
  # and since codex/ollama now DELEGATE their launch to this base (AMUX-3164), a
  # raw-$AMUX_URL fallback made `amux start` fail "server unreachable" on a
  # stranded lane even with the server up, and injected the dead 8822 into every
  # NEW worker (the `-e AMUX_URL=` below). cmd_url ignores a retired-port env and
  # falls to the canonical base, so both paths self-heal. An explicit AMUX_API
  # (a non-default server) still wins.
  local AMUX_API="${AMUX_API:-$(cmd_url)}"
  name=$(resolve_session "${1:-}")
  shift 2>/dev/null || true
  # Strip our own flags before inline claude args. Placed before `--` so
  # `amux start NAME --detach -- --some-claude-flag` still works.
  #   --detach / -d : start the tmux session but don't attach (scripts, CI, boot)
  while [[ "${1:-}" == "--dry-run" || "${1:-}" == "--detach" || "${1:-}" == "-d" ]]; do
    case "$1" in
      --dry-run)    dry_run=true ;;
      --detach|-d)  detach=true ;;
    esac
    shift
  done
  # herdr backend: the server owns the herdr session, so start goes through
  # the server API (herdr agent start + readiness detection live there).
  if [[ "$(session_backend "$name")" == "herdr" ]]; then
    if $dry_run; then
      echo "${BOLD}$name${RESET} (herdr backend — started via server API: POST /api/sessions/$name/start)"
      return
    fi
    _start_via_api "$name" || return 1
    if $detach; then
      echo "  ${DIM}detached — attach with: amux attach $name${RESET}"
      return
    fi
    need_herdr
    local agent
    agent=$(herdr_agent_of "$name")
    if [[ -n "$agent" ]]; then
      herdr --session "$(herdr_session_name)" agent attach "$agent" \
        || herdr --session "$(herdr_session_name)"
    else
      herdr --session "$(herdr_session_name)"
    fi
    return
  fi
  # dry-run is a pure command preview — no tmux session is spawned, so the
  # tmux dependency only matters for the real start path.
  $dry_run || need_tmux
  load_defaults
  load_session "$name"

  local tname
  tname=$(tmux_name "$name")

  if ! $dry_run && is_running "$name"; then
    if $detach; then
      echo "${YELLOW}already running:${RESET} $name"
      return
    fi
    echo "${YELLOW}already running:${RESET} $name — attaching..."
    tmux attach-session -t "=$tname"
    return
  fi

  local dir="${CC_DIR:-$HOME}"
  # Expand ~ in dir path
  dir="${dir/#\~/$HOME}"
  # Hard requirement: dir must be absolute. A relative CC_DIR (from an old
  # session env file) would resolve against whatever pwd happens to be when
  # `amux start` is invoked, and Claude Code would silently write files into
  # the wrong tree. Refuse instead. Re-register with --dir to fix.
  case "$dir" in
    /*) ;;
    *) die "CC_DIR is not absolute ('$dir'). Re-register the worker with: amux register $name --dir /absolute/path" ;;
  esac
  [[ -d "$dir" ]] || die "directory not found: $dir"

  # codex/ollama: DELEGATE the launch to the server (POST /api/sessions/<n>/start)
  # instead of building the command + tmux session here (AMUX-3164). The server's
  # start_session seeds codex dir-trust (~/.codex/config.toml, AC-356) AND forces
  # model_reasoning_effort=low — neither of which this bash path does, so a
  # CLI-launched codex/ollama worker otherwise hits the trust prompt and runs at
  # xhigh (which hangs local models). Mirrors the herdr delegation above and
  # collapses the two launch constructions into one (D6), so the server-side fixes
  # cannot be skipped by whichever door a worker is started through. The server
  # creates the session as amux-<name> (same name tmux_name produces) — we attach.
  local _provider="${CC_PROVIDER:-claude}"
  if [[ "$_provider" == "codex" || "$_provider" == "ollama" ]]; then
    if $dry_run; then
      echo "${BOLD}$name${RESET} ($_provider — started via server API: POST /api/sessions/$name/start; the server builds the codex command, seeds ~/.codex trust, and forces model_reasoning_effort=low)"
      return
    fi
    if [[ $# -gt 0 ]]; then
      echo "${YELLOW}note:${RESET} inline args after -- are not forwarded through server-side launch — set them in CC_FLAGS (the server reads it). Ignoring: $*" >&2
    fi
    _start_via_api "$name" || return 1
    if $detach; then
      echo "  ${DIM}detached — attach with: amux attach $name${RESET}"
      return
    fi
    tmux attach-session -t "=$tname"
    return
  fi

  # Build command. Check CC_PROVIDER to pick codex vs claude.
  local provider="${CC_PROVIDER:-claude}"
  local cmd
  if [[ "$provider" == "codex" ]]; then
    # Resume from stored codex session ID in meta file
    local meta_file="$CC_SESSIONS/${name}.meta.json"
    local codex_sid=""
    if [[ -f "$meta_file" ]]; then
      codex_sid=$(python3 -c "import json; print(json.load(open('$meta_file')).get('codex_session_id',''))" 2>/dev/null)
    fi
    if [[ -n "$codex_sid" ]]; then
      cmd="codex resume $codex_sid"
    else
      cmd="codex"
    fi
  elif [[ "$provider" == "ollama" ]]; then
    # Ollama workers run codex --oss --local-provider ollama so they get a full
    # coding agent (file editing, hooks, structured events) backed by the local
    # Ollama daemon. The model comes from CC_MODEL (default qwen3.8:27b) — CC_FLAGS
    # can add extra codex flags (approval policy, add-dir, etc.) just like codex.
    cmd="codex --oss --local-provider ollama --model ${CC_MODEL:-qwen3.8:27b}"
  else
    cmd="${AMUX_CLAUDE_CMD:-claude}"
  fi
  # Apply global defaults from defaults.env (skip for codex/ollama — Claude flags don't apply)
  if [[ "$provider" != "codex" && "$provider" != "ollama" && -n "${CC_DEFAULT_FLAGS:-}" ]]; then
    local q
    q=$(quote_flags "$CC_DEFAULT_FLAGS") || die "failed to quote CC_DEFAULT_FLAGS"
    [[ -n "$q" ]] && cmd="$cmd $q"
  fi
  # Apply session flags from <name>.env. Ollama now uses codex under the hood
  # so it accepts codex-style CC_FLAGS (e.g. --approve-for-me, --add-dir, etc.)
  if [[ -n "${CC_FLAGS:-}" ]]; then
    local q
    q=$(quote_flags "$CC_FLAGS") || die "failed to quote CC_FLAGS"
    [[ -n "$q" ]] && cmd="$cmd $q"
  fi
  # Apply any extra inline args from `amux start NAME -- ...`. These are
  # already tokenized argv (the user's outer shell parsed them), so we
  # quote each token via quote_argv. Without this, the v1 plan's $*
  # would lose quoting boundaries when re-evaluated by the nested shell.
  if [[ $# -gt 0 ]]; then
    local q
    q=$(quote_argv "$@") || die "failed to quote inline arguments"
    [[ -n "$q" ]] && cmd="$cmd $q"
  fi

  # Codex-specific defaults (apply to ollama too — it now runs codex under the hood)
  if [[ "$provider" == "codex" || "$provider" == "ollama" ]]; then
    # For codex (cloud): default to gpt-5.5 when no model is set.
    # For ollama: model is already set from CC_MODEL above — no default needed.
    if [[ "$provider" == "codex" ]]; then
      [[ "$cmd" == *"--model"* || "$cmd" == *"-m "* ]] || cmd="$cmd --model gpt-5.5"
    fi
    [[ "$cmd" == *"--full-auto"* || "$cmd" == *"--dangerously-bypass"* || "$cmd" == *"-a "* ]] || cmd="$cmd -a never"
    # codex defaults to read-only sandbox; workers need workspace-write to edit files.
    # Mirrors session_verbs.rs:4946 and OllamaAdapter::build_command (AH-82 / bb14642).
    [[ "$cmd" == *"--dangerously-bypass"* || "$cmd" == *"--sandbox"* || "$cmd" == *"-s "* ]] || cmd="$cmd --sandbox workspace-write"
    if [[ "$cmd" != *"--add-dir"* ]]; then
      local git_root
      git_root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || true
      if [[ -n "$git_root" && "$git_root" != "$dir" ]]; then
        cmd="$cmd --add-dir $(printf '%q' "$git_root")"
        [[ -d "$git_root/.git" ]] && cmd="$cmd --add-dir $(printf '%q' "$git_root/.git")"
      fi
    fi
  else
    [[ "$cmd" == *"--model"* ]] || cmd="$cmd --model sonnet"
  fi

  # Create tmux session and attach
  # Explicit cd to work dir in case shell profile overrides CWD.
  # If Claude OAuth is present (Max/claude.ai login), unset ANTHROPIC_API_KEY
  # to prevent auth conflict — BYO-key users don't have oauthAccount so they're
  # unaffected.
  local shell_setup=""
  if [[ "$provider" != "codex" && "$provider" != "ollama" ]]; then
    shell_setup="unset CLAUDECODE CLAUDE_CODE_ENTRYPOINT; "
    if [[ -f "$HOME/.claude.json" ]] && grep -q '"oauthAccount"' "$HOME/.claude.json" 2>/dev/null; then
      shell_setup="${shell_setup}unset ANTHROPIC_API_KEY; "
    fi
  fi
  if $dry_run; then
    echo "${BOLD}$name${RESET} in $dir"
    echo "  ${DIM}$cmd${RESET}"
    return
  fi
  # -e AMUX_SESSION/AMUX_WORKER: without these the worker cannot attribute
  # ANYTHING it writes (board-exp-1, 2026-08-06). The server's own start path
  # passes them; this one never did, so a CLI-started worker running
  # `amux board add` produced a card with session=None, creator='' and the
  # fallback AMUX prefix — landing on another lane's board, owned by nobody, and
  # therefore never driven by advance or pickup. Measured: a fresh worker
  # completed its task and its card came back as AMUX-2471 with no owner.
  # Every attribution header in this CLI reads ${AMUX_WORKER:-${AMUX_SESSION:-}},
  # so both are set here rather than relying on one.
  #
  # AMUX_URL too (board accountability experiment, run 3). The lane had
  # AMUX_SESSION and AMUX_WORKER but NOT the API base, so a fresh Sonnet worker
  # reported "$AMUX_URL wasn't set in this shell" and hand-rolled curl against
  # the default address instead of using `amux board`. Its create happened to
  # carry X-Amux-Session; its later doing->done PATCH did not, and landed as
  # `unattributed`.
  #
  # That is AMUX-2325's shape arriving through a new door: the sanctioned path
  # was not unwalkable, it was merely un-configured, and an un-configured
  # sanctioned path produces exactly the same unattributed writes as a broken
  # one. Exporting the base is what makes `amux board` work without the worker
  # having to discover the address.
  tmux new-session -d -s "$tname" -n "$name" -c "$dir" \
    -e "AMUX_SESSION=$name" -e "AMUX_WORKER=$name" -e "AMUX_URL=$AMUX_API" \
    "${shell_setup}cd $(printf '%q' "$dir"); $cmd"
  # Lock the window name so Claude can't overwrite it with escape sequences
  tmux set-option -t "=$tname" allow-rename off 2>/dev/null
  tmux set-window-option -t "=$tname" automatic-rename off 2>/dev/null
  echo "${GREEN}started${RESET} ${BOLD}$name${RESET} in $dir"
  echo "  ${DIM}$cmd${RESET}"
  # The session is already created detached (new-session -d). Only attach when
  # not asked to detach — --detach makes `amux start` script/CI/boot friendly.
  if $detach; then
    echo "  ${DIM}detached — attach with: amux attach $name${RESET}"
    return
  fi
  tmux attach-session -t "=$tname"
}

cmd_exec() {
  # Register + start in one step
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: amux exec <name> [--model opus] [--yolo] [--dir /path] [claude flags...]"
  shift

  parse_claude_flags "$@"

  local resolved_dir="${CC_DIR:-$(pwd)}"
  case "$resolved_dir" in
    /*) ;;
    *) die "CC_DIR must be absolute, got: $resolved_dir" ;;
  esac

  # Register if not exists, or update
  local file="$CC_SESSIONS/$name.env"
  cat > "$file" <<EOF
# amux session: $name
# registered: $(date -Iseconds)
CC_NAME="$name"
CC_DIR="$resolved_dir"
CC_FLAGS="${CC_FLAGS_STR}"
EOF

  # Start
  cmd_start "$name" "${CC_EXTRA_ARGS[@]+"${CC_EXTRA_ARGS[@]}"}"
}

cmd_attach() {
  local name
  name=$(resolve_session "${1:-}")
  if [[ "$(session_backend "$name")" == "herdr" ]]; then
    need_herdr
    is_running "$name" || die "worker '$name' is not running. Start with: amux start $name"
    local agent
    agent=$(herdr_agent_of "$name")
    if [[ -n "$agent" ]]; then
      exec herdr --session "$(herdr_session_name)" agent attach "$agent"
    fi
    exec herdr --session "$(herdr_session_name)"
  fi
  need_tmux
  local tname
  tname=$(tmux_name "$name")
  is_running "$name" || die "worker '$name' is not running. Start with: amux start $name"
  tmux attach-session -t "=$tname"
}

cmd_peek() {
  local name
  name=$(resolve_session "${1:-}")
  local lines="${2:-30}"

  if [[ "$(session_backend "$name")" == "herdr" ]]; then
    need_herdr
    is_running "$name" || die "worker '$name' is not running"
    local agent
    agent=$(herdr_agent_of "$name")
    echo "${BOLD}── $name ──${RESET}"
    herdr --session "$(herdr_session_name)" agent read "$agent" \
      --source recent-unwrapped --lines "$lines" --format text 2>/dev/null \
      || echo "${DIM}(no output)${RESET}"
    echo "${BOLD}── end ──${RESET}"
    return
  fi

  need_tmux
  local tname
  tname=$(tmux_name "$name")
  is_running "$name" || die "worker '$name' is not running"

  echo "${BOLD}── $name ──${RESET}"
  tmux capture-pane -t "=$tname:" -p -S "-$lines" 2>/dev/null || echo "${DIM}(no output)${RESET}"
  echo "${BOLD}── end ──${RESET}"
}

_send_usage() {
  cat <<USAGE
${BOLD}amux send${RESET} — send a message to a session

  amux send <worker> --stdin        read the message from stdin ${GREEN}(preferred)${RESET}
  amux send <worker> --file <path>  read the message from a file
  amux send <worker> <text>         inline text (see the warning below)
  amux send <worker> --keys 'C-c'   send a raw key sequence

  ${BOLD}--no-board${RESET}  skip board-card creation for one-off questions and status
              checks. Combines with any form above:
                amux send <worker> --no-board --stdin <<'EOF'
              Equivalent to the API's {"no_board": true}, or prefixing the
              message with [no-board] (which the server strips before delivery).

${BOLD}Why --stdin is preferred${RESET}
  With inline text your SHELL evaluates the string before amux ever sees it, so
  \`backticks\` and \$(...) inside the message are EXECUTED, not sent. That has
  garbled messages, leaked a credential, and fired a stray git command on a
  shared checkout. --stdin/--file pass the bytes through untouched.

  amux send api --stdin <<'EOF'
  fix the auth bug — see \`git log -1\` and \$(date) stay literal
  EOF
USAGE
}

cmd_send() {
  # --help must not be parsed as a session name (it used to error with
  # "session '--help' not found", so the safe form was undiscoverable).
  case "${1:-}" in
    --help|-h|help) _send_usage; return 0 ;;
  esac
  local name
  name=$(resolve_session "${1:-}")
  shift
  # --no-board (AC-183): skip board-card creation for one-off questions and status
  # checks. The flag existed only in the thin /usr/local/bin stub the server writes,
  # which is shadowed on PATH by THIS file (~/.local/bin comes first), so the
  # documented invocation `amux send X --no-board ...` reached a CLI that had never
  # heard of it. Consumed in a loop so it works before or after --stdin/--file.
  local _nb=""
  while [[ "${1:-}" == "--no-board" ]]; do _nb=1; shift; done
  # herdr sessions deliver through the server API; tmux is only needed for the raw
  # fallback path on tmux-backed sessions. BOTH sides of this conflict are wanted:
  # main added the --no-board loop, #80 made need_tmux conditional on the backend.
  if [[ "$(session_backend "$name")" != "herdr" ]]; then
    need_tmux
  fi

  local tname
  tname=$(tmux_name "$name")
  is_running "$name" || die "worker '$name' is not running"

  # ── Payload via --stdin / --file: the text NEVER transits a shell-evaluated
  # string (AMUX-1888). Passing a message as a double-quoted argument lets the
  # SENDER'S shell expand backticks/$() before amux ever sees it — demonstrated
  # blast radii: garbled messages, a leaked credential, and a stray
  # `git rebase --quit` on a SHARED checkout. Heredoc-per-call fixes it only if
  # every caller remembers; this encodes the safe path instead.
  #   amux send X --stdin <<'EOF' ... EOF
  #   amux send X --file /tmp/msg.txt
  if [[ "${1:-}" == "--stdin" || "${1:-}" == "-" ]]; then
    local msg; msg=$(cat)
    [[ -n "$msg" ]] || die "no message on stdin"
    _send_via_api "$name" "$msg" "$_nb"; return $?
  fi
  if [[ "${1:-}" == "--file" ]]; then
    local f="${2:-}"
    [[ -n "$f" && -r "$f" ]] || die "usage: amux send <worker> --file <path>"
    local msg; msg=$(cat "$f")
    [[ -n "$msg" ]] || die "file is empty: $f"
    _send_via_api "$name" "$msg" "$_nb"; return $?
  fi

  # Check for --keys flag
  if [[ "${1:-}" == "--keys" ]]; then
    shift
    tmux send-keys -t "=$tname:" "$@"
    echo "${GREEN}sent keys${RESET} to $name"
  else
    local text="$*"
    [[ -n "$text" ]] || { _send_usage; return 1; }
    # NUDGE ON USE, not content: by the time we see $text the shell has already
    # expanded it, so a warning about backticks is too late to be evidence. What
    # we CAN observe is the risky USAGE SHAPE — long or multi-line payloads are
    # where code/quotes/substitutions live. Warns to stderr, never blocks: this
    # is the only encoding available for callers who never read --help.
    if [[ ${#text} -gt 280 || "$text" == *$'\n'* ]]; then
      echo "${YELLOW}note:${RESET} long/multi-line payload sent as a shell argument — your shell already" >&2
      echo "      expanded any \`backticks\`/\$(...) in it. Prefer: amux send $name --stdin <<'EOF'" >&2
    fi
    _send_via_api "$name" "$text" "$_nb"
  fi
}

# Deliver a message through the server: SERVER-VERIFIED origin stamp
# (X-Amux-Session, AMUX-1768), busy-deferral, audit event. The old raw
# `tmux send-keys` path delivered ANONYMOUS text straight into the pane — no
# provenance, no record, could interrupt an in-flight turn — which is how the
# 2026-07-22 ts-gke→mvs-infra→gtm-engine misroute happened (AMUX-1818). Raw
# tmux is kept only as a loud last-resort fallback when the server is down.
# ── Unstamped-send ledger (AMUX-2670) ───────────────────────────────────────
#
# A raw-tmux fallback happens precisely when the server cannot be told about it,
# so the record has to be made locally and reconciled later. Otherwise an
# unaudited send and a send that never happened look identical from the server,
# which is the gap this ledger closes.
#
# Failure here must never break a send: every write is best-effort.
_unstamped_ledger() { echo "${CC_HOME}/pending-unstamped.jsonl"; }

_record_unstamped_send() {
  local target="$1" body="$2"
  local f; f=$(_unstamped_ledger)
  TGT="$target" BODY="$body" FROM="${AMUX_SESSION:-}" python3 -c "
import json, os, time, sys
try:
    print(json.dumps({
        'target': os.environ['TGT'],
        'text': os.environ['BODY'],
        'from': os.environ.get('FROM', ''),
        # MILLISECONDS. cmd_history.ts is millis (declared in
        # invariants/checks.rs TIMESTAMP_COLUMNS), and this wrote SECONDS, so
        # every reconciled fallback landed in the audit trail dated 1970-01-21
        # and sorted below every real row — GET /api/history?limit=50 never
        # returned one. The send WAS recorded and was unfindable where anyone
        # looks, which is the exact failure this ledger exists to prevent.
        # Found by writing scripts/test-unstamped-ledger.sh (AMUX-2626).
        'ts': int(time.time() * 1000),
    }))
except Exception:
    sys.exit(1)
" >> "$f" 2>/dev/null || true
}

# Flush on reconnect. Called after a send that REACHED the server, which is the
# only moment we know the server is answering. Each row goes to POST
# /api/history (records, does not deliver — re-delivering would double-send a
# message the pane already received) typed `raw-tmux-fallback`, so the audit
# trail can tell an unstamped injection from an audited send instead of showing
# neither.
_flush_unstamped_ledger() {
  local f; f=$(_unstamped_ledger)
  [[ -s "$f" ]] || return 0
  local api="${AMUX_API:-https://localhost:8824}"
  local tmp; tmp=$(mktemp) || return 0
  local sent=0 kept=0 line
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    local body
    body=$(LINE="$line" python3 -c "
import json, os, sys
try:
    d = json.loads(os.environ['LINE'])
except Exception:
    sys.exit(1)   # unparseable row: drop it rather than retry forever
print(json.dumps({
    'text': d.get('text', ''),
    'type': 'raw-tmux-fallback',
    'session': d.get('target', ''),
    # NORMALISE: rows written before the millis fix carry SECONDS. Converting
    # here rather than only at the write site means a ledger that survived the
    # upgrade still reconciles to the right instant instead of to 1970.
    # 1e11 is the discriminator: any plausible seconds timestamp is ~1.8e9 and
    # any plausible millis one is ~1.8e12, so the gap is three orders of
    # magnitude and cannot be straddled by clock skew.
    'ts': (lambda t: int(t) * 1000 if t and int(t) < 100000000000 else t)(d.get('ts')),
    'origin': 'unstamped-fallback from ' + (d.get('from') or 'unknown'),
}))" 2>/dev/null) || continue
    if _curl -sk -m 10 -X POST -H 'Content-Type: application/json' \
         -d "$body" "$api/api/history" >/dev/null 2>&1; then
      sent=$((sent+1))
    else
      # Server went away mid-flush: KEEP the row. Dropping it would lose the
      # only record that the send happened at all.
      printf '%s\n' "$line" >> "$tmp"; kept=$((kept+1))
    fi
  done < "$f"
  if [[ "$kept" -eq 0 ]]; then rm -f "$f"; else mv "$tmp" "$f" 2>/dev/null || true; fi
  rm -f "$tmp" 2>/dev/null || true
  [[ "$sent" -gt 0 ]] && echo "${GREEN}reconciled${RESET} $sent previously-unstamped send(s) into the audit trail" >&2
  return 0
}

_send_via_api() {
  local name="$1" text="$2" nb="${3:-}"
  local tname; tname=$(tmux_name "$name")
  local AMUX_API="${AMUX_API:-https://localhost:8824}"
  local body resp rc
  body=$(MSG="$text" NB="$nb" python3 -c "
import json, os
d = {'text': os.environ['MSG']}
if os.environ.get('NB'):
    d['no_board'] = True          # AC-183: server skips autotask card creation
print(json.dumps(d))")
  resp=$(_curl -sk -m 15 -X POST -H 'Content-Type: application/json' \
    -H "X-Amux-Worker: ${AMUX_WORKER:-${AMUX_SESSION:-}}" \
    -d "$body" "$AMUX_API/api/workers/$name/send" 2>/dev/null) || resp=""
  if [[ -n "$resp" ]]; then
    rc=0
    RESP="$resp" TGT="$name" python3 - <<'PYEOF' || rc=$?
import json, os, sys
try:
    d = json.loads(os.environ["RESP"])
except Exception:
    sys.exit(1)
tgt = os.environ["TGT"]
if d.get("error") or d.get("ok") is False:
    print(f"send to {tgt} FAILED: {d.get('error') or d.get('message')}")
    sys.exit(2)
print(f"sent to {tgt} (origin-stamped): {d.get('message', 'ok')}")
PYEOF
    # A send that REACHED the server is the only moment we know it is
    # answering — so it is the moment to reconcile anything sent unstamped
    # while it was down (AMUX-2670). Best-effort: never let reconciliation
    # affect the result of the send the user actually asked for.
    [[ $rc -eq 0 ]] && { _flush_unstamped_ledger || true; return 0; }
    [[ $rc -eq 2 ]] && return 1   # server understood and refused — do NOT fall back
  fi
  # Retry: the server restarts when the builder installs a new binary (it
  # self-adopts and relaunches); a 1-2s wait often recovers. Three tries over
  # ~4s before falling back to raw tmux.
  local _retry
  for _retry in 1 2; do
    sleep 2
    resp=$(_curl -sk -m 5 -X POST -H 'Content-Type: application/json' \
      -H "X-Amux-Worker: ${AMUX_WORKER:-${AMUX_SESSION:-}}" \
      -d "$body" "$AMUX_API/api/workers/$name/send" 2>/dev/null) || resp=""
    if [[ -n "$resp" ]]; then
      rc=0
      RESP="$resp" TGT="$name" python3 - <<'PYEOF' || rc=$?
import json, os, sys
try:
    d = json.loads(os.environ["RESP"])
except Exception:
    sys.exit(1)
tgt = os.environ["TGT"]
if d.get("error") or d.get("ok") is False:
    sys.exit(2)
print(f"sent to {tgt} (origin-stamped, retry {os.environ.get('_R','')}): {d.get('message', 'ok')}")
PYEOF
      # Same reconciliation point as the first attempt: the server answered.
      [[ $rc -eq 0 ]] && { _flush_unstamped_ledger || true; return 0; }
      [[ $rc -eq 2 ]] && return 1
    fi
  done
  if [[ "$(session_backend "$name")" == "herdr" ]]; then
    echo "${RED}FAILED${RESET} to send to $name: amux server unreachable after retries, and herdr workers can only be driven through the server. NOTHING was delivered." >&2
    return 1
  fi
  # ── Raw-tmux last resort (AMUX-1987) ────────────────────────────────────
  # This path used to print a GREEN "sent to <name>" followed by the entire
  # message body, with no check that tmux had accepted anything. That echo is
  # the most confirmation-shaped output the tool produces, and it was emitted
  # on the one path that can silently deliver nothing — a real message was lost
  # this way and the sender never re-sent, because they had been told it landed.
  #
  # Two honest changes: verify what CAN be verified (the session exists, tmux
  # accepted the keys) and hard-fail if not; and never claim delivery, because
  # typing into a pane IS NOT delivery. If the pane has a full-screen picker or
  # modal open, the keystrokes go to the picker and the message evaporates —
  # exactly the failure this codebase already documents for peek output.
  echo "${YELLOW}warning:${RESET} amux server unreachable — falling back to raw tmux (UNSTAMPED, unaudited)" >&2
  if ! tmux has-session -t "=$tname" 2>/dev/null; then
    echo "${RED}FAILED${RESET} to send to $name: tmux session '$tname' does not exist. NOTHING was delivered." >&2
    return 1
  fi
  if ! tmux send-keys -t "=$tname:" -l "$text" 2>/dev/null; then
    echo "${RED}FAILED${RESET} to send to $name: tmux rejected the message body. NOTHING was delivered." >&2
    return 1
  fi
  sleep 0.05
  if ! tmux send-keys -t "=$tname:" Enter 2>/dev/null; then
    echo "${RED}FAILED${RESET} to send to $name: body typed but Enter was rejected — the message is sitting UNSENT in the pane." >&2
    return 1
  fi
  # RECORD IT LOCALLY SO IT CAN BE REPORTED LATER (AMUX-2670). Without this a
  # fallback send is indistinguishable from one that never happened: the server
  # was unreachable, so nothing server-side can know it occurred, and the only
  # trace is a stderr line in whatever terminal ran it. The ledger is flushed to
  # POST /api/history on the next send that reaches the server.
  _record_unstamped_send "$name" "$text"
  # Deliberately does NOT echo the body, and deliberately does not say "sent".
  echo "${YELLOW}injected${RESET} into $name via raw tmux — DELIVERY UNVERIFIED, no origin stamp, no audit." >&2
  echo "  Keystrokes reached the pane. If a picker/modal was open they went there instead." >&2
  echo "  Confirm it arrived, or re-send with \`amux send\` once the server is back:" >&2
  echo "    curl -sk \"\$AMUX_URL/api/workers/$name/peek?lines=200\"" >&2
  return 0
}

cmd_stop() {
  local name
  name=$(resolve_session "${1:-}")
  if [[ "$(session_backend "$name")" == "herdr" ]]; then
    if ! is_running "$name"; then
      echo "${DIM}$name is not running${RESET}"
      return
    fi
    # Prefer the server's graceful stop (transcript snapshot + /exit); if the
    # server is down, close the pane directly — loud, like the tmux kill below.
    if _stop_via_api "$name"; then
      return
    fi
    need_herdr
    local pane
    pane=$(sed -n 's/^CC_HERDR_PANE_ID=//p' "$CC_SESSIONS/$name.env" | tail -1 | tr -d '"')
    if [[ -n "$pane" ]] && herdr --session "$(herdr_session_name)" pane close "$pane" >/dev/null 2>&1; then
      echo "${RED}stopped${RESET} $name (pane closed — server was unreachable, no transcript snapshot)"
    else
      die "failed to stop $name: server unreachable and pane close failed"
    fi
    return
  fi
  need_tmux

  local tname
  tname=$(tmux_name "$name")
  if is_running "$name"; then
    tmux kill-session -t "=$tname"
    echo "${RED}stopped${RESET} $name"
  else
    echo "${DIM}$name is not running${RESET}"
  fi
}

cmd_rm() {
  local name
  name=$(resolve_session "${1:-}")

  # Stop if running
  if is_running "$name" 2>/dev/null; then
    cmd_stop "$name"
  fi

  rm -f "$CC_SESSIONS/$name.env"
  echo "${RED}removed${RESET} $name"
}

cmd_info() {
  local name
  name=$(resolve_session "${1:-}")
  load_session "$name"

  echo "${BOLD}$name${RESET}"
  echo "  dir:   ${CC_DIR:-"(not set)"}"
  echo "  flags: ${CC_FLAGS:-"(none)"}"
  if is_running "$name" 2>/dev/null; then
    echo "  status: ${GREEN}running${RESET}"
  else
    echo "  status: ${DIM}stopped${RESET}"
  fi
}

cmd_ls() {
  local i=1
  local has_any=false

  for f in "$CC_SESSIONS"/*.env; do
    [[ -f "$f" ]] || continue
    has_any=true
    local name
    name=$(basename "$f" .env)
    load_session "$name"

    local status_icon status_color
    if is_running "$name" 2>/dev/null; then
      status_icon="*"
      status_color="$GREEN"
    else
      status_icon=" "
      status_color="$DIM"
    fi

    # Build flag summary
    local flag_summary=""
    if [[ "${CC_FLAGS:-}" == *"--dangerously-skip-permissions"* ]]; then
      flag_summary+=" ${YELLOW}YOLO${RESET}"
    fi
    local model_match
    if model_match=$(echo "${CC_FLAGS:-}" | sed -n 's/.*--model \([^ ]*\).*/\1/p' 2>/dev/null) && [[ -n "$model_match" ]]; then
      flag_summary+=" ${CYAN}$model_match${RESET}"
    fi

    # Preview last output line if running
    local preview=""
    if is_running "$name" 2>/dev/null; then
      if [[ "$(session_backend "$name")" == "herdr" ]]; then
        local agent
        agent=$(herdr_agent_of "$name")
        preview=$(herdr --session "$(herdr_session_name)" agent read "$agent" --source recent-unwrapped --lines 3 --format text 2>/dev/null | grep -v '^$' | tail -1 | cut -c1-60)
      else
        preview=$(tmux capture-pane -t "=$(tmux_name "$name"):" -p -S -3 2>/dev/null | grep -v '^$' | tail -1 | cut -c1-60)
      fi
      [[ -n "$preview" ]] && preview=" ${DIM}│ $preview${RESET}"
    fi

    printf " %s${status_color}%s${RESET} ${BOLD}%-16s${RESET} %s%s%s\n" \
      "$i" "$status_icon" "$name" "${DIM}${CC_DIR:-}${RESET}" "$flag_summary" "$preview"
    ((i++))
  done

  if ! $has_any; then
    echo "${DIM}No workers registered. Run: amux register <name>${RESET}"
  fi
}

cmd_dashboard() {
  need_tmux
  clear

  echo "${BOLD}${BLUE}  amux${RESET} ${DIM}v${CC_VERSION}${RESET}"
  echo ""
  cmd_ls
  echo ""
  echo "${DIM}Commands: [n]umber to attach, p[n] to peek, s[n] to send, q to quit${RESET}"
  echo ""

  while true; do
    read -rp "${CYAN}amux>${RESET} " input || break
    case "$input" in
      q|quit|exit)
        break
        ;;
      ls|list)
        cmd_ls
        ;;
      p[0-9]*)
        local num="${input#p}"
        local name
        name=$(resolve_session "$num" 2>/dev/null) && cmd_peek "$name" || echo "${RED}invalid${RESET}"
        ;;
      s[0-9]*)
        # s1 fix the bug → send "fix the bug" to session 1
        local rest="${input#s}"
        local num="${rest%% *}"
        local text="${rest#* }"
        [[ "$text" == "$num" ]] && text=""
        local name
        if name=$(resolve_session "$num" 2>/dev/null); then
          if [[ -n "$text" ]]; then
            cmd_send "$name" "$text"
          else
            read -rp "  msg> " text
            [[ -n "$text" ]] && cmd_send "$name" "$text"
          fi
        else
          echo "${RED}invalid${RESET}"
        fi
        ;;
      [0-9]*)
        local name
        name=$(resolve_session "$input" 2>/dev/null) && cmd_attach "$name" || echo "${RED}invalid${RESET}"
        ;;
      "")
        ;;
      *)
        # Try as session name
        local name
        if name=$(resolve_session "$input" 2>/dev/null); then
          cmd_attach "$name"
        else
          echo "${RED}unknown:${RESET} $input"
        fi
        ;;
    esac
  done
}

cmd_defaults() {
  local subcmd="${1:-show}"
  case "$subcmd" in
    show)
      if [[ -s "$CC_DEFAULTS" ]]; then
        echo "${BOLD}Global defaults:${RESET}"
        cat "$CC_DEFAULTS"
      else
        echo "${DIM}No defaults set. Run: amux defaults edit${RESET}"
      fi
      ;;
    edit)
      "${EDITOR:-vi}" "$CC_DEFAULTS"
      ;;
    reset)
      : > "$CC_DEFAULTS"
      echo "${GREEN}defaults reset${RESET}"
      ;;
    *)
      die "usage: amux defaults [show|edit|reset]"
      ;;
  esac
}

cmd_stop_all() {
  for f in "$CC_SESSIONS"/*.env; do
    [[ -f "$f" ]] || continue
    local name
    name=$(basename "$f" .env)
    if is_running "$name" 2>/dev/null; then
      cmd_stop "$name"
    fi
  done
}

cmd_start_all() {
  for f in "$CC_SESSIONS"/*.env; do
    [[ -f "$f" ]] || continue
    local name
    name=$(basename "$f" .env)
    if ! is_running "$name" 2>/dev/null; then
      cmd_start "$name"
    fi
  done
}

# Build and send a status transition, INCLUDING the gate-satisfying fields.
# AMUX-2325: the status verbs used to send only {"status":...}. There was no
# CLI way to pass gate_ack / gate_checked / type / override_doing, so the
# moment a gate fired — which is most cards — the only way forward was a
# hand-rolled `curl -X PATCH`, and a hand-rolled curl usually omits
# X-Amux-Session. The gate system was therefore MANUFACTURING the unattributed
# writes it depends on being attributed (found by the Claude/Gemini test pair
# on ATC-1, reproduced fleet-wide on RH-* and GE-*). The honest path has to be
# the easy path; a rule saying "remember the header" is not a fix.
# Reject a FLAG sitting in the ISSUE-ID slot, for every board verb that takes one.
#
# Without this, `amux board <verb> --help` sent the flag as the id: PATCH
# /api/board/--help, answered {"error":"item not found","id":"--help"}. The help
# request was spent as a failed WRITE and the caller got a not-found for a card
# they never named.
#
# I fixed this on 2026-08-14 (d7d5509) — for ONE verb. The log sweep the next day
# still found --help rows, timestamped AFTER that commit, because the other TEN
# id-taking verbs (needsyou, status, type, archive, reviewer, retitle, ask,
# status-update, claim, progress) each parse the id themselves and none of them
# checked. That commit claimed to guard "the CLASS, not the literal --help" and it
# did — within a single case arm. The class was the VERBS.
#
# So the check lives in one function now, called from every site, which is the
# only shape that cannot drift back apart.
_board_id_guard() {
  local verb="$1" id="$2"
  case "$id" in
    --help|-h|help)
      echo "Usage: amux board $verb <ISSUE-ID> [...]  — run 'amux board' for the full list" >&2
      exit 0 ;;
    -*)
      die "amux board $verb: '$id' looks like a flag, not an ISSUE-ID." ;;
  esac
}


_board_transition() {
  local id="$1" status="$2"; shift 2
  local ack="" newtype="" override="" rev="" outcome="" trigger="" force_reason=""
  local reviewer="" want_stdin=""
  local checked=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --outcome) outcome="${2:-}"; [[ -n "$outcome" ]] || die "--outcome needs text"; shift 2 ;;
      # --outcome-stdin / --outcome-file: the same escape `send` has had since
      # AMUX-1888, for the same reason. An inline double-quoted --outcome is
      # evaluated by YOUR SHELL before amux sees it, so backticks and $(...)
      # inside it are EXECUTED, not recorded. Outcomes are the field most likely
      # to contain a command: on 2026-08-06 an outcome quoting a git invocation
      # in backticks reached the card as "resolved the last commit with , which
      # is a SUBSTRING search" — the command silently eaten, the sentence left
      # dangling, and the shell erroring separately so the board write still
      # looked like it succeeded. send and `board add` both had --stdin; the
      # one field that routinely quotes shell did not.
      # DEFERRED, not read here (AF-16). Reading stdin mid-parse meant a LATER
      # unknown flag died with the heredoc already consumed, so the refusal
      # destroyed the very outcome text needed to satisfy the retry — ethos
      # rule 6, and it cost ~40 lines of re-authored review on AF-15. The read
      # now happens after argv validates, so a bad invocation leaves stdin
      # untouched and the same heredoc can simply be piped again.
      --outcome-stdin) want_stdin=1; shift ;;
      --outcome-file) [[ -r "${2:-}" ]] || die "--outcome-file needs a readable path"
                      outcome="$(cat "$2")"; shift 2 ;;
      # --trigger records the EXTERNAL condition a card is parked on, into
      # source_ref/last_verified_at — the fields the board already has and
      # already renders (is:sourcestale). Without a verb the only way to set
      # them was a hand-rolled PATCH, which is the same unaudited back door
      # AMUX-2325 was about, and it is the reason a parked card could sleep
      # forever: nothing machine-readable said what it was waiting for.
      --trigger) trigger="${2:-}"; [[ -n "$trigger" ]] || die "--trigger needs text"; shift 2 ;;
      --ack) ack=1; shift ;;
      --checked)
        shift
        # Consume criteria until the next flag. Quote each one; they are the
        # gate strings the server handed back verbatim.
        while [[ $# -gt 0 && "$1" != --* ]]; do checked+=("$1"); shift; done ;;
      --type) newtype="${2:-}"; [[ -n "$newtype" ]] || die "--type needs a value"; shift 2 ;;
      --override-doing) override=1; shift ;;
      # --reviewer NAMES the peer a card is handed to (AF-16). `amux board
      # review <ID>` could set the STATUS but not the reviewer, and the review
      # gate rests entirely on the reviewer's own X-Amux-Session being the
      # required sign-off ("the author cannot close it") — so a card could
      # reach `review` with reviewer=None, which is a card nobody has been
      # asked to look at. Completing the handoff meant a hand-rolled PATCH,
      # i.e. the unattributed back door AMUX-2325 is about, reached from the
      # audited path for want of one flag.
      --reviewer) reviewer="${2:-}"; [[ -n "$reviewer" ]] || die "--reviewer needs a session name"; shift 2 ;;
      --rev) rev="${2:-}"; shift 2 ;;
      --force) force_reason="${2:-}"; [[ -n "$force_reason" ]] || die "--force requires a reason (why you are bypassing the gate)"; shift 2 ;;
      *) die "amux board: unknown flag '$1'
Usage: amux board <status> <ID> [--checked \"crit\" ...] [--ack] [--type T] [--reviewer W] [--override-doing] [--trigger \"cond\"] [--force \"reason\"]" ;;
    esac
  done
  # Now that argv is known-good, drain stdin. See --outcome-stdin above: doing
  # this inside the loop meant an unknown flag AFTER it swallowed the heredoc
  # and then died, and the retry had nothing left to pipe.
  if [[ -n "$want_stdin" ]]; then
    outcome="$(cat)"; [[ -n "$outcome" ]] || die "--outcome-stdin got empty input"
  fi
  # Record the outcome as its OWN write, BEFORE attempting the transition.
  # A PATCH is atomic, so `{"desc":...,"status":"done"}` that trips the gate
  # discards the outcome text TOO — and the retry then has nothing to satisfy
  # "Outcome recorded in the item" with, so it fails again for a new reason.
  # THE REVIEWER IS WRITTEN FIRST TOO, for the same reason (AMUX-3534).
  #
  # `amux board review <ID> --reviewer <peer>` on a GATED card refused the
  # transition, correctly, and silently discarded the reviewer: the PATCH is
  # atomic, so a gate 409 rolls back the whole body. Observed 2026-08-23 on
  # AMUX-3527 — card stayed `doing`, reviewer never set, and the 409 body lists
  # the criteria and the type escape while saying NOTHING about the flag that
  # was passed. So half the command evaporated and nothing distinguished that
  # from success.
  #
  # Naming the peer is a fact about the handoff and is independent of whether
  # the move is permitted. A refusal should cost the transition, not the
  # handoff — which is exactly the argument the outcome block below already
  # makes, one field over. The failure is easy to miss in ordinary work: you
  # fix the gate, re-run, it succeeds, and you never learn the first attempt
  # left a card in review with nobody asked to look at it. That is the
  # condition --reviewer was added to prevent.
  #
  # Sent in the STATUS body as well, deliberately. It is idempotent, and if
  # this pre-write fails for a reason the transition survives, the second copy
  # still lands.
  if [[ -n "$reviewer" ]]; then
    local _rvresp _rvcurl=0
    _rvresp=$(_curl -sk -X PATCH -H 'Content-Type: application/json' \
      -H "X-Amux-Worker: ${AMUX_WORKER:-${AMUX_SESSION:-}}" \
      -d "$(V="$reviewer" python3 -c 'import json,os;print(json.dumps({"reviewer":os.environ["V"]}))')" \
      "${AMUX_API:-https://localhost:8824}/api/board/$id" 2>/dev/null) || _rvcurl=$?
    if [[ "$_rvcurl" -ne 0 ]]; then
      die "cannot reach the board at ${AMUX_API:-https://localhost:8824} (curl exit $_rvcurl).
NOTHING was applied — not the reviewer, and not the '$status' transition.
The card is unchanged."
    fi
    # Do NOT discard this response: a dropped reviewer that looks saved is the
    # whole defect (AC-323's shape, now on a fourth field).
    printf '%s' "$_rvresp" | python3 -c '
import sys, json
try: d = json.load(sys.stdin)
except Exception:
    sys.stderr.write("warning: reviewer NOT set — server sent no JSON. "
                     "The transition below was still attempted; check its result.\n"); sys.exit(0)
if d.get("error") or d.get("blocked"):
    sys.stderr.write("warning: reviewer NOT set: %s\n" % (d.get("error") or "blocked")); sys.exit(0)
ign = [f for f in (d.get("ignored_fields") or []) if f]
if ign:
    sys.stderr.write("warning: reviewer NOT set — server ignored %s\n" % ", ".join(ign))
'
  fi

  # mixpeek-orchestrator hit this three times on 2026-08-04 (MO-3076 x2,
  # MO-3077). Two writes, not one: the outcome survives a refused transition.
  if [[ -n "$outcome" ]]; then
    local _obody
    _obody=$(O="$outcome" python3 -c 'import json,os;print(json.dumps({"desc_append":os.environ["O"]}))')
      # Do NOT discard this response. This write exists so the outcome survives
      # a refused transition — piping it to /dev/null made a DROPPED outcome
      # look identical to a saved one. AC-323 shape a third time (board
      # progress, --trigger stamp, now here), found by the sweep
      # mixpeek-frustrations suggested rather than by it being reported.
    # CAPTURE curl's OWN exit status, do not pipe it straight into python.
    #
    # AEAB-36. This was `curl ... | python3 -c ...`, and the python deliberately
    # exits 0 on failure so a lost outcome does not block the transition below.
    # `set -euo pipefail` (line 19) defeated that completely: on a TRANSPORT
    # failure curl exits non-zero, `pipefail` makes the pipeline return curl's
    # status rather than python's, and `set -e` aborts the whole script right
    # here — AFTER python has printed "outcome NOT recorded".
    #
    # So the user saw one warning, scoped to the OUTCOME, and the status
    # transition never ran and never said so. Observed live on 2026-08-19
    # closing AEAB-34, while the server happened to be restarting to adopt a new
    # build: status stayed `review`, desc unchanged, and the natural reading of
    # that warning — "status moved, prose lost" — was the exact opposite of the
    # truth. Reproduced deterministically with AMUX_API pointed at a dead port:
    # one warning line, exit 7, no transition.
    #
    # A code path written to be non-fatal was made fatal by a shell option one
    # line from the top of the file, in precisely the case it was designed to
    # survive.
    local _oresp _ocurl=0
    _oresp=$(_curl -sk -X PATCH -H 'Content-Type: application/json' \
      -H "X-Amux-Worker: ${AMUX_WORKER:-${AMUX_SESSION:-}}" -d "$_obody" \
      "${AMUX_API:-https://localhost:8824}/api/board/$id" 2>/dev/null) || _ocurl=$?
    if [[ "$_ocurl" -ne 0 ]]; then
      # Unreachable for the outcome means unreachable for the transition. Say
      # BOTH facts, because reporting only the first is what made this
      # dangerous, and stop rather than pretending to try.
      die "cannot reach the board at ${AMUX_API:-https://localhost:8824} (curl exit $_ocurl).
NOTHING was applied — not the outcome, and not the '$status' transition.
The card is unchanged. Re-run when the server is back; if it just restarted to
adopt a build, that is expected and a retry normally succeeds."
    fi
    printf '%s' "$_oresp" | python3 -c '
import sys, json
try: d = json.load(sys.stdin)
except Exception:
    sys.stderr.write("warning: outcome NOT recorded — server sent no JSON. "
                     "The transition below was still attempted; check its result.\n"); sys.exit(0)
if d.get("error") or d.get("blocked"):
    sys.stderr.write("warning: outcome NOT recorded: %s\n" % (d.get("error") or "blocked")); sys.exit(0)
ign = [f for f in (d.get("ignored_fields") or []) if f]
if ign:
    sys.stderr.write("warning: outcome NOT recorded — server ignored %s\n" % ", ".join(ign))
'
  fi
  local body
  body=$(S="$status" A="$ack" T="$newtype" O="$override" R="$rev" G="$trigger" F="$force_reason" V="$reviewer" python3 -c '
import json, os, sys, time
b = {"status": os.environ["S"]}
if os.environ.get("A"): b["gate_ack"] = True
if os.environ.get("T"): b["type"] = os.environ["T"]
if os.environ.get("V"): b["reviewer"] = os.environ["V"]
if os.environ.get("O"): b["override_doing"] = True
if os.environ.get("R"): b["rev"] = int(os.environ["R"])
if os.environ.get("F"): b["force"] = True; b["desc_append"] = "[FORCED] " + os.environ["F"]
# Stamp last_verified_at alongside source_ref: a trigger with no verification
# time is indistinguishable from one checked a month ago, and the staleness
# view keys on exactly that field. Setting one without the other would make
# every parked card read as stale the instant it was parked.
if os.environ.get("G"):
    b["source_ref"] = os.environ["G"]
    b["last_verified_at"] = int(time.time())
crit = sys.argv[1:]
if crit: b["gate_checked"] = crit
print(json.dumps(b))' ${checked[@]+"${checked[@]}"})
  # Same AEAB-36 trap as the outcome write above, and WORSE here because this
  # one is not piped: `result=$(_board_transition ...)` under `set -e` aborted
  # the caller the instant curl failed at the transport level, so
  # `amux board done <ID>` against an unreachable server printed ABSOLUTELY
  # NOTHING and exited 7. Not a warning, not an error, not the id — the purest
  # form of the silent-failure class this file already guards against in three
  # other places, sitting on the sanctioned path.
  #
  # A dropped connection and a refused transition must never look alike: one
  # means "nothing happened, retry", the other means "the board said no".
  local _tresp _tcurl=0
  _tresp=$(_curl -sk -X PATCH \
    -H 'Content-Type: application/json' \
    -H "X-Amux-Worker: ${AMUX_WORKER:-${AMUX_SESSION:-}}" \
    -d "$body" \
    "${AMUX_API:-https://localhost:8824}/api/board/$id" 2>/dev/null) || _tcurl=$?
  if [[ "$_tcurl" -ne 0 ]]; then
    printf '%s\n' "cannot reach the board at ${AMUX_API:-https://localhost:8824} (curl exit $_tcurl).
The '$status' transition was NOT applied and the card is unchanged — this is a
transport failure, not a refused gate. Re-run when the server is back." >&2
    return 1
  fi
  printf '%s' "$_tresp"
}

# The board's valid item types, ASKED FOR rather than carried.
#
# Extracted from the `type` verb, which learned this the hard way: it used to
# hold a hardcoded list that drifted — advertising `task` and `decision`, both
# rejected, and omitting `tripwire` — so following the tool's own usage line
# produced "unknown type 'decision'" and sent you looking at your card instead
# of at the CLI (AMUX-2479). `add --type` needs the same list, and a SECOND copy
# is how that drift happens again, so there is one implementation and no literal
# list anywhere in this file. On an unreachable server it returns a POINTER, not
# a guess: confidently wrong help is worse than none.
_board_valid_types() {
  local _resp _code _body _t
  # -w captures the STATUS so a transport failure and a 200-with-an-unexpected
  # -shape cannot print the same sentence. They did, for every session: this
  # helper read ["fields"]["valid_types"] while the server publishes `types` at
  # top level (board.rs, KNOWN_TYPES), so `amux board add --help` on a perfectly
  # healthy server said "server unreachable" and pointed the reader at the
  # AMUX-3046 stranded-port hunt instead of at a key-path bug one line away.
  # The note above already said confidently wrong help is worse than none; this
  # separates the two failures so the message can keep that promise.
  _resp=$(_curl -sk --max-time 3 -w '\n%{http_code}' "$AMUX_API/api/board/contract" 2>/dev/null)
  _code="${_resp##*$'\n'}"
  _body="${_resp%$'\n'*}"
  if [[ "$_code" != "200" ]]; then
    echo "(server unreachable at ${AMUX_API} (http=${_code:-000}) — see GET /api/board/contract)"
    return
  fi
  # Read BOTH spellings: `types` is what the server publishes, the nested one is
  # the historical shape this helper was written against. Accepting either means
  # the next rename degrades to the other key rather than blanking the list.
  _t=$(printf '%s' "$_body" | python3 -c 'import json,sys
d = json.load(sys.stdin)
t = d.get("types") or (d.get("fields") or {}).get("valid_types") or []
print(" ".join(t))' 2>/dev/null)
  [[ -n "$_t" ]] && echo "$_t" \
    || echo "(server answered 200 but published no type list — contract shape changed; see GET /api/board/contract)"
}

# Refuse an argument that LOOKS like a flag but is not one this verb knows.
#
# AEAB-17: every board verb taking positional text used `*) text="$1"` as its
# catch-all, so an unsupported or mistyped flag became part of the TEXT with
# exit 0 and no warning. The failure is invisible at the call site — the command
# prints the card id it created and looks like it worked.
#
# Only `--`-prefixed arguments are refused. A positional title is legitimate and
# must keep working; something starting with `--` is a mistake often enough that
# refusing it is right, and the escape (--stdin/--file) is named in the message
# so a title that genuinely begins with dashes is still expressible.
_board_bad_flag() {
  local verb="$1" arg="$2"; shift 2
  die "amux board $verb: unknown option '$arg'
accepted here: $*
If '$arg' was meant as literal text, pass it via --stdin or --file so it is
never parsed as a flag. Unknown flags used to be folded silently into the
title/text (AEAB-17), which produced cards with a scratch path in the title
and an empty body."
}

_board_add_usage() {
  cat <<EOF
Usage: amux board add <title>
       amux board add --stdin | --file <path>          (title, unevaluated by your shell)

Optional:
  --desc <text> | --desc-stdin | --desc-file <path>    card body
  --type <type>                                        the GATE is derived from this
  --help                                               this text

types: $(_board_valid_types)

Prefer --stdin/--file for a title and --desc-stdin/--desc-file for a body: inline
text is evaluated by YOUR shell first, so backticks and \$(...) in it are EXECUTED
before amux ever sees them (AMUX-1888).
EOF
}

# Outcome-based exit for board mutations (AMUX-2140): the CLI used to report
# the TRANSPORT (curl ok = exit 0) while the server refused the write — every
# `$?` caller and every `&& echo moved` printed success on blocked mutations,
# and a refused status PATCH left desc/status contradicting each other
# fleet-visible. Codes: 0 ok · 3 gate not acknowledged · 4 WIP/holding limit ·
# 5 rev mismatch · 1 other refusal or malformed response. Refusals print the
# server body to STDERR so pipelines keep clean stdout.
_board_outcome() {
  # Optional args: the id and status the CALLER attempted. Not decoration —
  # the WIP-limit 409 body carries no `attempted_status`, so a hint derived
  # only from the response could never fire on the refusal that needs it most
  # (caught by running it, not by reading it). The caller always knows.
  python3 -c '
import sys, json
_argv = sys.argv[1:]
raw = sys.stdin.read()
try:
    d = json.loads(raw)
except Exception:
    # STRIP FIRST. Every caller reaches this via `echo "$result" | ...`, and
    # echo appends a newline unconditionally — so on an empty server reply
    # `raw` was "\n", which is TRUTHY, so `or "empty response"` never fired and
    # this wrote a bare newline to stderr. The command then exited 1 having
    # printed nothing on either stream: a silent failure from the sanctioned
    # path, which is the exact class this whole function exists to end.
    # Caught 2026-08-11 when `amux board status-update` (a 405 with an empty
    # body) failed in total silence.
    body = raw.strip()[:300]
    sys.stderr.write((body or "empty response from the server — the endpoint "
                              "may not be routed on this build") + "\n")
    sys.exit(1)
err = (d.get("error") or "") if isinstance(d, dict) else ""
ok = isinstance(d, dict) and not err and d.get("ok") is not False
if ok:
    # A caller whose write is NOT a status transition passes its own label
    # (argv[2]). Without it this printed "<id> -> <current status>" for a
    # tag-only write, which reads as a transition that silently did not
    # happen \u2014 AC-222: I filed a bug against `needsyou` on exactly that
    # misread, then routed around a working command with a raw PATCH.
    label = (_argv[2] if len(_argv) > 2 else "") or d.get("status") or d.get("title") or "ok"
    print(d.get("id", "?"), "\u2192", label)
    # A 200 does not mean the server applied everything you sent. Reported by
    # mixpeek-frustrations: `board backlog --trigger` stored source_ref but
    # silently dropped last_verified_at, so the card parked with a good trigger
    # and NOTHING to expire it — the exact guard --trigger exists to arm. The
    # success line and the silent skip were indistinguishable.
    ign = [f for f in (d.get("ignored_fields") or []) if f]
    if ign:
        sys.stderr.write(
            "warning: the server IGNORED %s on this write — the transition "
            "happened, those field(s) did not.\n" % ", ".join(ign))
        sys.exit(6)
    sys.exit(0)
sys.stderr.write(json.dumps(d) + "\n")
e = err.lower()
# Name the ATTRIBUTED command that gets past this refusal (AMUX-2325). The
# server body explains the escape in HTTP terms (gate_ack / override_doing),
# which is how a blocked agent ends up hand-rolling an unattributed curl.
# Print the honest `amux board` form instead, quoting the gate criteria the
# server just handed back so they can be acknowledged individually rather
# than blanket-acked.
def _q(s):
    return "\"" + str(s).replace("\\", "\\\\").replace("\"", "\\\"") + "\""
iid = d.get("item") or d.get("id") or (_argv[0] if _argv else "<ID>")
tgt = d.get("attempted_status") or (_argv[1] if len(_argv) > 1 else "")
if "gate" in e:
    gate = d.get("gate") or []
    if tgt and gate:
        sys.stderr.write(
            "\nSatisfy these, then acknowledge the ones that are TRUE:\n"
            + "".join("   [ ] " + str(g) + "\n" for g in gate)
            + "\n  amux board " + tgt + " " + iid + " --checked "
            + " ".join(_q(g) for g in gate) + "\n"
            "\nIf a criterion does not apply because the card is mistyped "
            "(item_type=" + str(d.get("item_type") or "?") + "), correct the TYPE "
            "rather than acking something untrue:\n"
            # AC-249: derive from valid_types as published by the server. The
            # hardcoded list named decision and task, neither of which the
            # validator accepts, and omitted escalation/blocker/tripwire/watch,
            # which it does accept -- wrong in BOTH directions from a string
            # that had drifted from _ITEM_TYPES. No hardcoded fallback: a stale
            # list that looks authoritative is the whole defect.
            # NOTE: this block is inside python3 -c QUOTED-WITH-SINGLE-QUOTES,
            # so an apostrophe here closes the bash string and breaks the CLI
            # for every session. Keep this comment apostrophe-free.
            "  " + (d.get("cli_wrong_type")
                    or ("amux board type " + iid + " <"
                        + ("|".join(d.get("valid_types") or [])
                           or "see GET /api/board/contract") + ">")) + "\n")
    sys.exit(3)
if "holding" in e or "doing" in e or "wip" in e:
    if tgt:
        sys.stderr.write("\nFinish or demote the held card, or hold both deliberately:\n"
                         "  amux board " + tgt + " " + iid + " --override-doing\n")
    sys.exit(4)
if "rev mismatch" in e:
    sys.exit(5)
sys.exit(1)' "${1:-}" "${2:-}" "${3:-}"
}

cmd_board() {
  local AMUX_API="${AMUX_API:-https://localhost:8824}"
  local subcmd="${1:-help}"; shift 2>/dev/null || true

  case "$subcmd" in
    needsyou|needs-you)
      # Mark a card as blocked-on-human and RECORD THE ASK (AMUX-2167/2171):
      # additive tag (no clobber) + the question into the History, so Focus
      # mode and the card both show WHAT is needed, not just that it's stuck.
      local id="${1:-}"; [[ -n "$id" ]] || die "Usage: amux board needsyou <ISSUE-ID> [\"the question / decision needed\"]"
      _board_id_guard "needsyou" "$id"
      shift 2>/dev/null || true
      local ask="$*"
      # A FLAG IS NOT AN ASK. This verb takes free prose, so an unrecognised
      # `--flag` was silently adopted AS the question: `amux board needsyou <id>
      # --stdin < file` printed "tagged needs:you", discarded the file entirely,
      # and wrote the literal ask "NEEDS-YOU: --stdin" onto the card. I did it
      # twice (AMUX-2446, AMUX-2454) before noticing, and the second one buried
      # the herdr measurement that was the whole point of the card.
      # Reporting success while recording garbage is worse than refusing: the
      # ledger looks written-to and a reviewer believes it.
      case "$ask" in
        --*) die "amux board needsyou: '$ask' looks like a flag, not a question.
This verb takes free prose only:  amux board needsyou $id \"the decision needed\"
For long text use:                amux board progress $id \"\$(cat file)\"" ;;
      esac
      # SIGN-IN ASK -> attach a resume deep link into THIS session's live browser
      # (AMUX-3073). The reported gap was that even after raising needs-you, the
      # note could not say "click here" — there was no route to a session's
      # browser view. There is now (#browser=<session>), so a sign-in-shaped ask
      # gets the link attached automatically: the capability reaches the agent by
      # DEFAULT rather than requiring it to know the URL shape. Opt-out — if the
      # agent already supplied its own #browser= link we leave the ask untouched.
      local _signin_link=""
      case "$(printf '%s' "$ask" | tr '[:upper:]' '[:lower:]')" in
        *sign*in*|*signin*|*log*in*|*login*|*authenticat*|*captcha*|*2fa*|*mfa*|*credential*|*password*)
          case "$ask" in
            *'#browser='*) : ;;  # agent supplied its own resume link — respect it
            *) _signin_link="${AMUX_API}/#browser=${AMUX_WORKER:-${AMUX_SESSION:-amux}}"
               # SAME LINE, not a newline: Focus-mode and the server both extract
               # the NEEDS-YOU marker with a single-line ([^\n]+) match, so a link
               # on a second line would be dropped from the triage surface where
               # Ethan actually reads the ask — it would survive only in the raw
               # desc. Keep it on the marker line so it reaches Focus mode.
               ask="${ask} · Resume (click to sign in): ${_signin_link}" ;;
          esac ;;
      esac
      local cur result
      cur=$(_curl -sk "$AMUX_API/api/board/$id" | python3 -c "import sys,json;d=json.load(sys.stdin);i=d.get('item') or d;print(json.dumps(sorted(set((i.get('tags') or [])+['needs:you']))))" 2>/dev/null)
      [[ -n "$cur" ]] || die "card $id not found"
      local body
      body=$(TAGS="$cur" ASK="$ask" python3 -c "import os,json; b={'tags':json.loads(os.environ['TAGS'])}; a=os.environ['ASK'].strip(); b['desc_append']=('NEEDS-YOU: '+a) if a else b.get('desc_append'); print(json.dumps({k:v for k,v in b.items() if v is not None}))")
      result=$(_curl -sk -X PATCH -H 'Content-Type: application/json' -H "X-Amux-Worker: ${AMUX_WORKER:-${AMUX_SESSION:-}}" \
        -d "$body" "$AMUX_API/api/board/$id")
      # Label it as the TAG write it is. Without this the printer rendered the
      # card's unchanged status ("AC-221 -> todo"), which reads as a failed
      # transition (AC-222).
      echo "$result" | _board_outcome "$id" "" "tagged needs:you" || return $?
      [[ -n "$_signin_link" ]] && echo "  attached resume link (click to sign in): $_signin_link" >&2
      # AND MOVE IT. `needsyou` is also a real board STATUS — the one that
      # takes the card out of review/todo queues and into the owner's view —
      # and this verb tagging without moving left cards reading routed-to-
      # owner while the idle nudge kept re-firing at the agent (frustrations
      # 2026-08-11: the raw-PATCH workaround it forced is the unaudited path
      # CLAUDE.md warns about). The tag write above stays: tag carries the
      # ASK, status carries the QUEUE. If the transition bounces (gate), say
      # so loudly — a tagged-but-unmoved card is exactly the half-action this
      # verb used to hide.
      local tresult
      tresult=$(_board_transition "$id" "needsyou")
      echo "$tresult" | _board_outcome "$id" "needsyou" || {
        echo "amux board needsyou: tag applied but STATUS MOVE was refused (see above) — card is still in its old queue" >&2
        return 1
      }
      return 0
      ;;
    done|doing|todo|backlog|discard|discarded|review|verified)
      local status="$subcmd"
      # `discard` is the natural spelling and is exactly what the board's own
      # "captured prompt, not a unit of work" nudge tells you to run, but the
      # status column is `discarded`. Accept both so the sanctioned instruction
      # is walkable (AMUX-2140 class: a nudge naming a verb the CLI rejects is
      # theatre — the reader types what they were told and gets an error).
      [[ "$status" == "discard" ]] && status="discarded"
      local id="${1:-}"
      # An ID that starts with '-' is a FLAG in the id slot, never an issue id.
      # Without this, `amux board done --help` PATCHed /api/board/--help and the
      # server answered {"error":"item not found","id":"--help"} — 6 of those in
      # one 24h window (GET /api/logs/analyze?since_h=24). The help request was
      # silently spent as a failed write against a nonexistent card, and the
      # caller got a not-found for a card they never named. `send` already
      # guards this exact shape (see _send_usage); the board verbs did not.
      # Checking the CLASS (leading dash) rather than the literal --help, so
      # `amux board done --checked "x"` with a forgotten id also stops here
      # instead of PATCHing /api/board/--checked.
      case "$id" in
        --help|-h|help) _board_usage 2>/dev/null || true
                        echo "Usage: amux board $status <ISSUE-ID> [--checked \"crit\" ...] [--ack] [--type T] [--reviewer W] [--override-doing] [--trigger \"cond\"] [--force \"reason\"]" >&2
                        return 0 ;;
        -*) die "amux board $status: '$id' looks like a flag, not an ISSUE-ID. Usage: amux board $status <ISSUE-ID> [--checked \"crit\" ...] [--ack] [--type T]" ;;
      esac
      [[ -n "$id" ]] || die "Usage: amux board $status <ISSUE-ID> [--checked \"crit\" ...] [--ack] [--type T] [--reviewer W] [--override-doing] [--trigger \"cond\"] [--force \"reason\"]"
      shift
      local result
      result=$(_board_transition "$id" "$status" "$@")
      echo "$result" | _board_outcome "$id" "$status"
      return $?
      ;;
    status)
      local id="${1:-}"; local new_status="${2:-}";
      _board_id_guard "status" "$id"
      [[ -n "$id" && -n "$new_status" ]] || die "Usage: amux board status <ISSUE-ID> <status> [--checked \"crit\" ...] [--ack] [--type T] [--reviewer W] [--override-doing] [--trigger \"cond\"] [--force \"reason\"]"
      # `archived` is a BOOLEAN FLAG, not a status column. Forwarding it verbatim
      # PATCHed {status:"archived"} and 400'd ("unknown status") ~22x/day from lanes
      # confusing the flag with a status (AMUX-3086 producer B / AMUX-3108). Route the
      # clear intent to the dedicated verb instead of sending a doomed word. Only these
      # two are intercepted; every real status (blocked/armed/needsyou/...) still passes
      # through, and the server returns its own valid-status list for any other typo.
      case "$new_status" in
        archived|archive)
          die "amux board status: 'archived' is a boolean flag, not a status. Use:  amux board archive $id" ;;
        unarchive|unarchived)
          die "amux board status: 'unarchive' is not a status. Use:  amux board unarchive $id" ;;
      esac
      shift 2
      local result
      result=$(_board_transition "$id" "$new_status" "$@")
      echo "$result" | _board_outcome "$id" "$new_status"
      return $?
      ;;
    type)
      # The gate is DERIVED from the type, so correcting a mistyped card is the
      # honest exit from a gate that does not fit — not --force (ethos rule 3).
      # Without this verb the only way to retype was raw curl, which is how the
      # attribution was being lost in the first place (AMUX-2325).
      local id="${1:-}"; local new_type="${2:-}"
      _board_id_guard "type" "$id"
      if [[ -z "$id" || -z "$new_type" ]]; then
        # Ask the SERVER for the list instead of carrying a copy. The hardcoded one
        # had drifted: it advertised `task` and `decision` — both rejected — and
        # omitted `tripwire`. Following this tool's own usage line produced
        # "unknown type 'decision'", which is the worst kind of help: confidently
        # wrong, and it sends you looking at your card instead of at the CLI.
        # (Hit live on AMUX-2479, 2026-08-07.)
        # One implementation, in _board_valid_types — `add --type` needs the
        # same list and a second copy is how the drift below happens again.
        die "Usage: amux board type <ISSUE-ID> <type>
types: $(_board_valid_types)"
      fi
      local result
      result=$(T="$new_type" python3 -c 'import json,os;print(json.dumps({"type":os.environ["T"]}))' \
        | _curl -sk -X PATCH -H 'Content-Type: application/json' \
            -H "X-Amux-Worker: ${AMUX_WORKER:-${AMUX_SESSION:-}}" -d @- "$AMUX_API/api/board/$id")
      # Label it as the TYPE write it is. Argument-less, _board_outcome renders
      # the card's CURRENT status, so retyping a card printed "AMUX-2394 → doing"
      # — a status-transition arrow for a write that touches no status. Same
      # defect 1b667aa fixed for needsyou and status-update; this was the third
      # site, and the card that fixed the other two said there were two.
      echo "$result" | _board_outcome "$id" "" "type set to $new_type"
      return $?
      ;;
    archive|unarchive)
      # AMUX-2492. `archived` had no per-card setter anywhere — only the age-archive
      # sweep and a per-session bulk update could touch it, so an automated action had
      # no un-do and 17 cards across three cloud envs were stranded where no loop and
      # no view could reach them. Same shape as the `type` and `reviewer` verbs above
      # (AMUX-2325): a field the gates/visibility depend on, reachable only by raw curl
      # — which drops X-Amux-Session and produces exactly the unattributed writes the
      # ledger depends on not having.
      local _av=1; [[ "$subcmd" == "unarchive" ]] && _av=0
      local id="${1:-}"
      _board_id_guard "archive" "$id"
      [[ -n "$id" ]] || die "Usage: amux board $sub <ISSUE-ID>
archive   hides a card from every board view AND every autonomy loop (advance, pickup, rot)
unarchive brings it back — this is the un-do that did not exist before AMUX-2492"
      shift
      local _auth=""
      [[ "${1:-}" == "--authorized-by" ]] && { _auth="${2:-}"; shift 2; }
      local result
      result=$(A="$_av" W="$_auth" python3 -c 'import json,os
b={"archived": int(os.environ["A"])}
if os.environ.get("W"): b["authorized_by"]=os.environ["W"]
print(json.dumps(b))' \
        | _curl -sk -X PATCH -H 'Content-Type: application/json' \
            -H "X-Amux-Worker: ${AMUX_WORKER:-${AMUX_SESSION:-}}" -d @- "$AMUX_API/api/board/$id")
      echo "$result" | _board_outcome "$id" "" "${subcmd}d"
      return $?
      ;;
    reviewer)
      # review->done is gated on a NAMED reviewer's sign-off, and until now nothing
      # in the CLI could set that name — `amux board review <id> --reviewer X` died
      # on "unknown flag". So the only way to route a card for review was a raw
      # PATCH, which carries no X-Amux-Session. The review gate exists precisely to
      # make cross-session sign-off attributable, and the missing verb was
      # manufacturing the unattributed writes it depends on. Same defect as the
      # `type` verb above (AMUX-2325); this is the second instance, which is the
      # argument that every gate-relevant FIELD needs an attributed setter, not
      # just the ones someone tripped over.
      local id="${1:-}"; local who="${2:-}"
      _board_id_guard "reviewer" "$id"
      [[ -n "$id" && -n "$who" ]] || die "Usage: amux board reviewer <ISSUE-ID> <session>   (pass 'none' to clear)
Sets the session whose sign-off is required for review -> done."
      [[ "$who" == "none" ]] && who=""
      local result
      result=$(R="$who" python3 -c 'import json,os;print(json.dumps({"reviewer":os.environ["R"]}))' \
        | _curl -sk -X PATCH -H 'Content-Type: application/json' \
            -H "X-Amux-Worker: ${AMUX_WORKER:-${AMUX_SESSION:-}}" -d @- "$AMUX_API/api/board/$id")
      echo "$result" | _board_outcome "$id" "" "reviewer set to ${who:-none}"
      return $?
      ;;
    show|cat)
      # AF-66. Assignment/idle nudges tell agents to read a card with
      # `amux board show <ID>` -- and the verb did not exist, so it fell through
      # to the help text (exit 2). That instruction is emitted SPECIFICALLY when
      # the card body is withheld from the nudge (it contains an at-mention or a
      # leading slash, which opens Claude Code's file picker), i.e. exactly when
      # `show` is the ONLY way to read the card. The sanctioned path was
      # unwalkable in the one case it existed for, and the fallback is a raw
      # curl, which is how attribution gets lost (AMUX-2325 / AMUX-2140).
      local id="${1:-}"
      _board_id_guard "show" "$id"
      [[ -n "$id" ]] || die "Usage: amux board show <ISSUE-ID>"
      _curl -sk "$AMUX_API/api/board/$id" | python3 -c '
import json, sys
raw = sys.stdin.read()
try:
    d = json.loads(raw)
except ValueError:
    sys.exit("amux board show: server returned no JSON (restarting?) -- retry in a moment")
if d.get("error") or not d.get("id"):
    sys.exit("amux board show: " + str(d.get("error") or "no such card"))
print("%s  [%s]  type=%s" % (d["id"], d.get("status", "?"), d.get("type", "?")))
print(d.get("title") or "(no title)")
meta = [("session", d.get("session")), ("reviewer", d.get("reviewer")),
        ("owner_type", d.get("owner_type")), ("depends_on", d.get("depends_on")),
        ("source_ref", d.get("source_ref"))]
line = "  ".join("%s=%s" % (k, v) for k, v in meta if v)
if line:
    print(line)
desc = d.get("desc") or ""
if desc:
    print()
    print(desc)
log = d.get("log") or ""
if log:
    print()
    print("--- log ---")
    print(log)
'
      return $?
      ;;
    retitle)
      # AMUX-2604. Capture flags a card whose title has no referent ("This
      # should be one row", "Fix the logo") and asks the worker that received
      # the prompt to rewrite it self-contained — the worker being the only
      # party that ever had the missing context. That ask needs somewhere to
      # land: until now TITLE and DESC had no attributed setter either, so the
      # instruction would have read "fix your card" while the only route was a
      # raw PATCH with no X-Amux-Session. That is the third instance of the
      # `type`/`reviewer` defect above (AMUX-2325) and the one where the nudge
      # itself would have been manufacturing the unattributed writes.
      #
      # --stdin/--file are the preferred forms: an inline title is evaluated by
      # YOUR shell first, so `backticks` and $(...) in it are EXECUTED
      # (AMUX-1888) — and a rewritten title very often quotes code.
      local id="${1:-}"
      _board_id_guard "retitle" "$id"
      [[ -n "$id" ]] || die "Usage: amux board retitle <ISSUE-ID> <title> | --stdin | --file <path>
       amux board retitle <ISSUE-ID> --desc-stdin      (rewrite the body instead)
Rewrites a card's title (and/or desc) so it stands alone without the
conversation it was captured from."
      shift
      local new_title="" new_desc="" _mode=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --stdin|-)      new_title=$(cat); _mode=1; shift ;;
          --file)         [[ -n "${2:-}" && -r "${2:-}" ]] || die "usage: amux board retitle <ID> --file <path>"
                          new_title=$(cat "$2"); _mode=1; shift 2 ;;
