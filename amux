      # "--stdin", discarded the entire heredoc, and printed "progress noted".
      # A success line for a write that kept none of the body — and the silent verb
      # is the one the loud verb sends you to.
      #
      # Supporting --stdin outright is the better fix than only guarding: the fleet
      # convention in CLAUDE.md is to pass card text via stdin precisely because an
      # inline "$msg" is evaluated by the SHELL first, so backticks and $(...) inside
      # it are EXECUTED (AMUX-1888: a garbled message, a leaked credential, and a
      # stray rebase on a shared checkout). I hit exactly that on this card an hour
      # ago — two backticked identifiers were run as commands and silently dropped.
      local msg
      if [[ "${1:-}" == "--stdin" || "${1:-}" == "-" ]]; then
        msg=$(cat)
