cmd_serve() {
  # --help / -h short-circuit
  for _a in "$@"; do
    case "$_a" in
      -h|--help|help)
        cat <<EOF
${BOLD}amux serve${RESET} - start the web dashboard (Rust server, HTTPS)

${BOLD}Usage:${RESET}
  amux serve [port]

${BOLD}Args:${RESET}
  port                  TCP port to listen on. Optional; exported as AMUX_RS_PORT.
                        Default 8823; the installed launchd service uses 8824.

${BOLD}Environment:${RESET}
  AMUX_RS_PORT          Port to listen on (a positional port just sets this).
  AMUX_RS_LEGACY_PORT   Additionally answer the RETIRED port (8822) with the
                        same router/TLS/auth, so pre-cutover sessions holding a
                        baked-in AMUX_URL=https://localhost:8822 keep working.
                        Set in ~/.amux/server.env. Being retired: check
                        GET /api/debug/legacy-port for who still calls it, and
                        drop the var when that reads zero for 7 days.

${BOLD}Examples:${RESET}
  amux serve
  amux serve 8824

${BOLD}Note:${RESET} \`--bind\` and \`--no-tls\` are GONE. They were Python-server flags;
the Rust server takes no argv, always binds 0.0.0.0, and always serves HTTPS
(plain HTTP is redirected). Passing them now exits with an error rather than
being silently ignored. Normally you do not run this by hand at all — the
launchd agent com.amux.server-rs owns the process.

${BOLD}Security note:${RESET} the 0.0.0.0 bind exposes the dashboard on every network
interface this host is connected to (including public Wi-Fi LANs and public IPs).
Layer a firewall rule, or use Tailscale, for anything beyond localhost.
EOF
        return 0
        ;;
    esac
  done
  # The server is the Rust binary (the Python amux-server.py was removed
  # 2026-08-09; git history has it). It takes NO argv — port comes from
  # AMUX_RS_PORT — so map the old positional-port spelling onto the env var.
  local server="$HOME/.local/bin/amux-server-rs"
  [[ -x "$server" ]] || server="$(command -v amux-server-rs 2>/dev/null || true)"
  [[ -n "$server" && -x "$server" ]] || die "amux-server-rs not found — run ./install.sh from the amux checkout"
  if [[ "${1:-}" =~ ^[0-9]+$ ]]; then
    export AMUX_RS_PORT="$1"; shift
  fi
  [[ $# -gt 0 ]] && die "amux serve takes only an optional port now (extra args: $*)"
  exec "$server"
}


# ---------------------------------------------------------------------------
# amux iac — the instance as declarative YAML (AMUX-2679)
#
# NOT `amux config`: that is already an alias for `amux defaults`
# (show|edit|reset), and shadowing a working user-facing verb to save four
# characters is how a CLI acquires a surprise.
#
# The SERVER speaks JSON like every other amux contract; YAML lives here,
# where the human is. python3 + pyyaml do the conversion, so no endpoint has
# to be different from all the others just to be configurable.
# ---------------------------------------------------------------------------
cmd_config() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    export)
      _curl -sk "${AMUX_API:-https://localhost:8824}/api/config/export" \
      | python3 -c '
import sys, json, yaml
d = json.load(sys.stdin)
d.pop("note", None)
sys.stdout.write(yaml.safe_dump(d, sort_keys=False, allow_unicode=True, default_flow_style=False))
'
      ;;
    apply)
      local f="${1:-}"
      [[ -n "$f" && -r "$f" ]] || die "usage: amux iac apply <file.yaml>   (reads a file; use - for stdin)"
      local body
      body=$(python3 -c '
import sys, json, yaml
raw = sys.stdin.read() if sys.argv[1] == "-" else open(sys.argv[1]).read()
doc = yaml.safe_load(raw) or {}
if not isinstance(doc, dict):
    sys.stderr.write("config must be a YAML mapping (got %s)\n" % type(doc).__name__); sys.exit(2)
print(json.dumps(doc))
' "$f") || die "could not parse $f as YAML"
