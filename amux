cmd_order() {
  local amount="" merchant="" purpose="" session="${AMUX_SESSION:-}" item_name=""
  local url="" quantity="1" auto_submit="" profile="default"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --amount)      amount="${2:-}"; shift 2 ;;
      --merchant)    merchant="${2:-}"; shift 2 ;;
      --purpose)     purpose="${2:-}"; shift 2 ;;
      --session)     session="${2:-}"; shift 2 ;;
      --item)        item_name="${2:-}"; shift 2 ;;
      --url)         url="${2:-}"; shift 2 ;;
      --quantity)    quantity="${2:-}"; shift 2 ;;
      --auto-submit) auto_submit="true"; shift ;;
      --profile)     profile="${2:-}"; shift 2 ;;
      --help|-h)
        cat <<'HELP'
Usage: amux order --amount <USD> --merchant <name> --purpose <why> [--url <page>]

Tell the harness to complete an order. When --url is provided the harness
drives the entire flow: it starts a headless browser, navigates to the page,
walks through the checkout (set quantity, add to cart, proceed to checkout),
fills all fields from its own store, and optionally submits. No credential
ever enters your session.

  --amount       charge in USD (required)
  --merchant     who you are paying (required)
  --purpose      what for (required)
  --url          product/event page URL (harness drives full checkout)
  --quantity     ticket/item quantity (default: 1)
  --auto-submit  click the submit/place-order button after filling
  --item         vault item name filter (optional; uses the first active item)
  --profile      Chrome profile to use (default: default)
  --session      override session (default: $AMUX_SESSION)
HELP
        return 0
        ;;
      *) die "amux order: unknown flag '$1' (try --help)" ;;
    esac
  done
  [[ -n "$amount" ]]   || die "amux order: --amount is required"
  [[ -n "$merchant" ]] || die "amux order: --merchant is required"
  [[ -n "$purpose" ]]  || die "amux order: --purpose is required"
  local body result
  body=$(A="$amount" M="$merchant" P="$purpose" S="$session" I="$item_name" \
    U="$url" Q="$quantity" AS="$auto_submit" PR="$profile" python3 -c '
import json, os
d = {
  "amount_usd": float(os.environ["A"]),
  "currency": "USD",
  "merchant": os.environ["M"],
  "purpose": os.environ["P"],
  "session": os.environ["S"],
  "item_name": os.environ["I"],
  "quantity": int(os.environ["Q"]),
  "profile": os.environ["PR"],
}
if os.environ["U"]:
  d["url"] = os.environ["U"]
if os.environ["AS"]:
  d["auto_submit"] = True
print(json.dumps(d))' 2>/dev/null) || die "amux order: bad --amount (must be a number)"
  result=$(_curl -sk -X POST -H 'Content-Type: application/json' \
    -H "X-Amux-Session: ${AMUX_SESSION:-}" \
    -d "$body" "$AMUX_API/api/browser/complete-order")
  local ok filled
  ok=$(echo "$result" | python3 -c 'import json,sys; d=json.load(sys.stdin); print("1" if d.get("ok") else "0")' 2>/dev/null || echo 0)
  if [[ "$ok" == "1" ]]; then
    filled=$(echo "$result" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(", ".join(d.get("filled",[])))' 2>/dev/null || echo "?")
    echo "order form filled by the harness (fields: $filled)"
    local submitted
    submitted=$(echo "$result" | python3 -c 'import json,sys; d=json.load(sys.stdin); s=d.get("submit",{}); print("yes" if s.get("submitted") else "no")' 2>/dev/null || echo "?")
    [[ "$submitted" == "yes" ]] && echo "order submitted"
  else
    local emsg
    emsg=$(echo "$result" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("error","unknown error"))' 2>/dev/null || echo "$result")
    echo "amux order: $emsg" >&2
    return 1
  fi
}

cmd_tunnel() {
  local AMUX_API="${AMUX_API:-https://localhost:8824}"
  local subcmd="${1:-status}"; shift 2>/dev/null || true

  # PREFLIGHT (AF-63). /api/tunnel/* is NOT routed in the rust server -- the
  # endpoints were never ported at the python cutover, so every verb here hits a
  # 404. Without this guard the CLI lies in two different directions:
  #   status: the 404 body has no "configured" key, so `not d.get(configured)`
  #           was true and it printed "not configured -- set AMUX_TUNNEL_TOKEN
  #           in ~/.amux/server.env", exit 0. That sends the reader to add a
  #           CREDENTIAL for a route that does not exist; they would edit
  #           server.env, restart the server, and be exactly as broken.
  #   stop:   `curl ... >/dev/null && echo "tunnel stopped"` -- curl exits 0 on
  #           an HTTP 404 without -f, so it reported success for an operation
  #           that reached no handler at all.
  # Found by the 2026-08-16 log sweep via route.callers_have_routes, which names
  # all 7 call sites; nothing else could see it, because a CLI that exits 0 is
  # invisible to every check that looks at exit codes.
  local _tunnel_code
  _tunnel_code=$(_curl -sk -o /dev/null -w '%{http_code}' "$AMUX_API/api/tunnel/status" 2>/dev/null || echo 000)
  if [[ "$_tunnel_code" == "404" ]]; then
    echo "amux tunnel: not available in this server build (HTTP 404 -- /api/tunnel/* is not routed)." >&2
    echo "  The verb exists in this CLI but the endpoints were never ported to the rust server." >&2
    echo "  Setting AMUX_TUNNEL_TOKEN will NOT help; that is a different failure." >&2
    echo "  Tracked as AF-63." >&2
    return 1
  fi

  case "$subcmd" in
    start)
      local port="${1:-}"
      local payload='{}'
      [[ -n "$port" ]] && payload="{\"port\":$port}"
      _curl -sk -X POST -H 'Content-Type: application/json' -d "$payload" \
        "$AMUX_API/api/tunnel/start" | python3 -c "
import sys, json
raw = sys.stdin.read()
try:
    d = json.loads(raw)
except ValueError:
    # amux-server restarts on save; a mid-restart request returns nothing.
    sys.exit('amux server not responding (restarting?) — retry in a moment')
if d.get('error'):
    sys.exit('error: ' + str(d['error']))
print(('already running → ' if d.get('already') else 'tunnel up → ') + (d.get('url') or '(registering)'))
"
      ;;
    stop)
      # Check the STATUS, not curl's exit code: curl returns 0 for a 404/500
      # unless -f is passed, which is how this printed "tunnel stopped" against
      # a route that does not exist (AF-63).
      local _stop_code
      _stop_code=$(_curl -sk -o /dev/null -w '%{http_code}' -X POST "$AMUX_API/api/tunnel/stop" 2>/dev/null || echo 000)
      if [[ "$_stop_code" == 2* ]]; then
        echo "tunnel stopped"
      else
        echo "amux tunnel stop: server returned HTTP $_stop_code -- tunnel NOT stopped" >&2
        return 1
      fi
      ;;
    status|"")
      _curl -sk "$AMUX_API/api/tunnel/status" | python3 -c "
import sys, json
raw = sys.stdin.read()
try:
    d = json.loads(raw)
except ValueError:
    sys.exit('amux server not responding (restarting?) — retry in a moment')
if not d.get('configured'):
    print('not configured — set AMUX_TUNNEL_TOKEN in ~/.amux/server.env')
    print('(the tunnel needs an active amux cloud subscription)')
    sys.exit(0)
print('running :', d.get('running'))
print('url     :', d.get('url') or '-')
print('target  :', d.get('target') or '-')
print('requests:', d.get('requests', 0))
if d.get('error'): print('error   :', d['error'])
"
      ;;
    url)
      _curl -sk "$AMUX_API/api/tunnel/status" | python3 -c "
import sys, json
raw = sys.stdin.read()
try:
    u = json.loads(raw).get('url')
except ValueError:
    sys.exit('amux server not responding (restarting?) — retry in a moment')
print(u) if u else sys.exit('tunnel not running')
"
      ;;
    help|-h|--help)
      _tunnel_help
      ;;
    *)
      # Same exit-0-on-unknown trap as `amux board` had: fail loudly instead,
      # so a caller can distinguish "ran" from "silently printed help".
      echo "${RED}unknown tunnel subcommand:${RESET} $subcmd" >&2
      _tunnel_help >&2
      exit 2
      ;;
  esac
}

