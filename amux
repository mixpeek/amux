# ── computer use (AMUX-5300) ────────────────────────────────────────────────
# Rung 3 of the access ladder: amux browser, then CDP into the real Chrome,
# then a CUA Docker desktop driven by pixels. A thin client of
# /api/computer/*; every call carries X-Amux-Session because the server keys
# one sandbox per lane and refuses unattributed calls.
_computer_usage() {
  cat <<'EOF'
amux computer — a disposable Linux desktop (CUA) for sites rungs 1-2 cannot reach

  amux computer start                  Launch (or reuse) this lane's sandbox; prints the context
  amux computer status                 Every sandbox fleet-wide, idle clocks, caps
  amux computer screenshot             PNG on disk; prints the path (Read it)
  amux computer click X Y              Left click at screen pixels
  amux computer double-click X Y
  amux computer move X Y
  amux computer type TEXT...           Type text at the focus
  amux computer key KEY                enter, tab, escape, ctrl+l, ctrl+shift+t
  amux computer scroll DX DY           DY > 0 scrolls down
  amux computer open URL [--profile NAME]
                                       Chromium in the sandbox; --profile copies that
                                       amux profile's cookies in first (read-only)
  amux computer context                Ladder, verbs, and which profile has cookies for which site
  amux computer stop                   Remove the sandbox (idle ones stop after 15 min anyway)

Ladder: 1) amux browser  2) CDP into Ethan's real Chrome  3) amux computer.
Loop: screenshot, read coordinates off the image, act, screenshot to confirm.
EOF
}

_computer_call() { # <METHOD> <path> [json-body] [max-seconds]
  local method="$1" path="$2" body="${3:-}" max="${4:-120}"
  local args=(-sk -m "$max" -X "$method" -H "X-Amux-Session: ${AMUX_SESSION:-${AMUX_WORKER:-}}")
  [[ -n "$body" ]] && args+=(-H 'Content-Type: application/json' -d "$body")
  _curl "${args[@]}" "$AMUX_API/api/computer/$path" 2>/dev/null
}

_computer_json() { # python3 builds the body so quotes and newlines in TEXT survive
  python3 -c 'import json,sys; a=sys.argv[1:]; print(json.dumps(dict(zip(a[::2], a[1::2]))))' "$@"
}

_computer_print() { # <verb> ; reads the response on stdin
  VERB="$1" python3 -c '
import json, os, sys
raw = sys.stdin.read()
verb = os.environ["VERB"]
try:
    d = json.loads(raw)
except ValueError:
    sys.exit("amux computer %s: server gave no JSON (%r). Is amux running? (amux url)" % (verb, raw[:200]))
if not isinstance(d, dict) or d.get("error"):
    msg = d.get("error") if isinstance(d, dict) else d
    print("amux computer %s FAILED: %s" % (verb, msg), file=sys.stderr)
    for k in ("held_by", "hint"):
        if isinstance(d, dict) and d.get(k):
            print("  %s: %s" % (k, d[k]), file=sys.stderr)
    sys.exit(1)
if verb == "start":
    print("%s %s  image=%s%s  vnc=%s" % ("reused" if d.get("reused") else "started", d.get("name"),
          d.get("image"), " (built now)" if d.get("image_built") else "", d.get("vnc_url")))
    print()
    print(d.get("context") or "")
elif verb == "screenshot":
    print(d["path"])
    print("  %sx%s, %s bytes%s" % (d.get("width"), d.get("height"), d.get("size"),
          ("; pruned %d old shot(s), keeping %d" % (d["pruned"], d["kept_per_lane"])) if d.get("pruned") else ""), file=sys.stderr)
elif verb == "status":
    if not d.get("measured"):
        print("UNMEASURED: %s" % d.get("why_unmeasured")); sys.exit(1)
    lim = d.get("limits", {})
    print("%d running, %d slot(s) free of %s  (%s RAM / %s CPUs each, idle stop %ss)" % (
        d.get("running", 0), d.get("slots_free", 0), lim.get("max"), lim.get("memory"), lim.get("cpus"), lim.get("idle_s")))
    for s in d.get("sandboxes", []):
        print("  %-28s %-8s idle=%ss stop_in=%ss  %s" % (s.get("lane"), s.get("state"), s.get("idle_s"),
              s.get("idle_stop_in_s"), s.get("vnc_url") or ""))
elif verb == "context":
    print(d.get("text", ""))
elif verb == "stop":
    print("removed %s" % d.get("name") if d.get("removed") else "no sandbox was running for %s" % d.get("lane"))
elif verb == "open":
    c = d.get("cookies") or {}
    print("opened %s%s" % (d.get("url"), ("  (+%s cookies from profile %s, read from a %s browser)" % (
        c.get("imported"), c.get("profile"), c.get("read_from"))) if c else ""))
else:
    print("ok %s %s" % (d.get("command"), json.dumps(d.get("params"))))
'
}

cmd_computer() {
  local AMUX_API="${AMUX_API:-$(cmd_url)}"
  local sub="${1:-}"; shift || true
  local resp
  case "$sub" in
    start)
      echo "starting (15-20s; the first start after an image change also builds it, a few minutes)..." >&2
      resp=$(_computer_call POST start '{}' 1800) ;;
    status|ls)    resp=$(_computer_call GET status) ;;
    context|ctx)  resp=$(_computer_call GET context) ;;
    screenshot|shot) resp=$(_computer_call POST screenshot '{}') ;;
    click|double-click|double_click|move)
      [[ $# -ge 2 && "$1" =~ ^-?[0-9]+$ && "$2" =~ ^-?[0-9]+$ ]] || die "usage: amux computer $sub X Y   (integer screen pixels)"
      local verb="${sub//-/_}"
      resp=$(_computer_call POST "$verb" "{\"x\":$1,\"y\":$2}") ;;
    type)
      [[ $# -ge 1 ]] || die "usage: amux computer type TEXT"
      resp=$(_computer_call POST type "$(_computer_json text "$*")") ;;
    key)
      [[ $# -ge 1 ]] || die "usage: amux computer key KEY   (enter, ctrl+l)"
      resp=$(_computer_call POST key "$(_computer_json key "$1")") ;;
    scroll)
      [[ $# -ge 2 && "$1" =~ ^-?[0-9]+$ && "$2" =~ ^-?[0-9]+$ ]] || die "usage: amux computer scroll DX DY   (integers; DY > 0 scrolls down)"
      resp=$(_computer_call POST scroll "{\"dx\":$1,\"dy\":$2}") ;;
    open)
      local url="" profile=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --profile) profile="${2:-}"; shift 2 ;;
          --profile=*) profile="${1#--profile=}"; shift ;;
          *) url="$1"; shift ;;
        esac
      done
      [[ -n "$url" ]] || die "usage: amux computer open URL [--profile NAME]"
      if [[ -n "$profile" ]]; then
        resp=$(_computer_call POST open "$(_computer_json url "$url" profile "$profile")" 180)
      else
        resp=$(_computer_call POST open "$(_computer_json url "$url")" 90)
      fi ;;
    stop)         resp=$(_computer_call POST stop '{}') ;;
    ""|help|-h|--help)
      _computer_usage
      resp=$(_computer_call GET context '' 15)
      if [[ -n "$resp" ]]; then
        echo
        echo "Live context (GET /api/computer/context):"
        printf '%s' "$resp" | _computer_print context
      fi
      return 0 ;;
    *) die "amux computer: unknown subcommand '$sub' (try: amux help computer)" ;;
  esac
  [[ -z "$resp" ]] && die "amux server unreachable at ${AMUX_API}"
  local verb="$sub"
  [[ "$verb" == "ls" ]] && verb=status
  [[ "$verb" == "ctx" ]] && verb=context
  [[ "$verb" == "shot" ]] && verb=screenshot
  printf '%s' "$resp" | _computer_print "$verb"
}

# ── delegated bulk reads ────────────────────────────────────────────────────
# Large, untargeted file reads are navigation/compression work. The primary
# worker keeps the question and judgment; this client sends caller-read bytes
# to the server's existing configurable helper-model seam. The server never
# receives a filesystem path it can open, which matters for remote/Tailscale
# callers: a label cannot become a read primitive on the host.
_delegate_read_body() {
  QUESTION="${QUESTION:-}" python3 - "$@" <<'PY'
import json, os, pathlib, sys

paths = sys.argv[1:]
if not paths:
    sys.stderr.write("amux delegate read: at least one file is required\n")
    raise SystemExit(2)
if len(paths) > 16:
    sys.stderr.write("amux delegate read: at most 16 files may be delegated at once\n")
    raise SystemExit(2)

files = []
total = 0
for raw in paths:
    path = pathlib.Path(raw)
    if not path.is_file():
        sys.stderr.write(f"amux delegate read: not a readable file: {raw}\n")
        raise SystemExit(2)
    try:
        content = path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        # GMA-123: this died on the FIRST byte of any PNG (0x89) with a raw
        # traceback, and the bulk-read guard was actively routing images here —
        # the guard's remedy could not open the file type the guard blocks. For
        # a lane that ships images, the blocked artifact IS the deliverable.
        #
        # A binary branch is not the fix. The helper is a text summarizer; it
        # cannot look at a picture. The primary model can, so the honest answer
        # names the path AND the thing that actually works, which the filer found
        # by re-reading the guard rather than from anything this command said.
        sys.stderr.write(
            f"amux delegate read: {raw} is not UTF-8 text, so the helper cannot read it.\n"
            "If it is an image, do NOT delegate — read it with the primary model, which\n"
            "can see images, using an explicit small limit so the bulk-read guard allows it:\n"
            f"    Read({raw}, limit=350)\n"
            "That alone satisfies the guard; downscaling is not required.\n"
        )
        raise SystemExit(2)
    except OSError as exc:
        sys.stderr.write(f"amux delegate read: cannot read {raw}: {exc}\n")
        raise SystemExit(2)
    total += len(content.encode("utf-8"))
    if total > 512 * 1024:
        sys.stderr.write("amux delegate read: file content exceeds the 512 KiB request limit\n")
        raise SystemExit(2)
    files.append({"path": raw, "content": content})

body = {"question": os.environ.get("QUESTION", ""), "files": files}
task = os.environ.get("TASK", "").strip()
if task:
    body["task"] = task
print(json.dumps(body, ensure_ascii=False, separators=(",", ":")))
PY
}

cmd_delegate() {
  local AMUX_API="${AMUX_API:-$(cmd_url)}"
  local sub="${1:-}"; [[ $# -gt 0 ]] && shift
  case "$sub" in
    read)
      local question="" task="" as_json=0 arg rc=0 resp token=""
      local -a files=() auth=()
      while [[ $# -gt 0 ]]; do
        arg="$1"; shift
        case "$arg" in
          --question)
            [[ $# -gt 0 ]] || die "amux delegate read: --question needs text"
            question="$1"; shift ;;
          --question-stdin) question="$(cat)" ;;
          --for)
            [[ $# -gt 0 ]] || die "amux delegate read: --for needs a task id"
            task="$1"; shift ;;
          --json) as_json=1 ;;
          --) files+=("$@"); break ;;
          -*) die "amux delegate read: unknown option '$arg'" ;;
          *) files+=("$arg") ;;
        esac
      done
      [[ -n "${question//[[:space:]]/}" ]] || die \
        "amux delegate read: provide --question <text> or --question-stdin"
      [[ ${#files[@]} -gt 0 ]] || die "amux delegate read: at least one file is required"

      # Remote clients need the same bearer as amux-rs; localhost bypasses it.
      # Never put the token in the payload or in a diagnostic breadcrumb.
      if [[ -s "$CC_HOME/auth_token" ]]; then
        token="$(tr -d '\r\n' < "$CC_HOME/auth_token")"
        [[ -n "$token" ]] && auth=(-H "Authorization: Bearer $token")
      fi
      resp=$(QUESTION="$question" TASK="$task" _delegate_read_body "${files[@]}" | \
        _curl -sk --max-time 100 -X POST -H 'Content-Type: application/json' \
          -H "X-Amux-Session: ${AMUX_SESSION:-}" "${auth[@]}" --data-binary @- \
          "$AMUX_API/api/lookup/bulk" 2>/dev/null) || rc=$?
      [[ "$rc" -eq 0 ]] || die \
        "amux delegate read: request failed (exit $rc); no helper result was produced"
      RESP="$resp" AS_JSON="$as_json" python3 - <<'PY'
import json, os, sys
raw = os.environ.get("RESP", "")
try:
    data = json.loads(raw)
except Exception:
    sys.stderr.write("amux delegate read: server returned non-JSON or no body\n")
    raise SystemExit(1)
if os.environ.get("AS_JSON") == "1":
    print(json.dumps(data, ensure_ascii=False, separators=(",", ":")))
    raise SystemExit(1 if data.get("error") else 0)
if data.get("error"):
    sys.stderr.write(f"amux delegate read: {data['error']}\n")
    raise SystemExit(1)
text = str(data.get("text") or "").strip()
if not text:
    sys.stderr.write("amux delegate read: helper returned an empty answer\n")
    raise SystemExit(1)
print(text)
sys.stderr.write(
    "amux delegate: verdict=completed "
    f"via={data.get('via', '?')} files={data.get('n_considered', '?')} "
    f"lines={data.get('input_lines', '?')} bytes={data.get('input_bytes', '?')} "
    f"elapsed_ms={data.get('elapsed_ms', '?')} "
    f"board={data.get('board_evidence', {}).get('verdict', '?')}:"
    f"{data.get('board_evidence', {}).get('card_id', '-')}\n"
)
PY
      ;;
    ""|help|-h|--help)
      cat <<'EOF'
Usage: amux delegate read --question <text> -- <file> [file ...]
       amux delegate read --question-stdin [--for <TASK-ID>] -- <file> [file ...]

Compress up to 16 files (512 KiB total) with the configured fast helper model.
The helper returns path:line evidence but cannot edit, use tools, debug, or make
architecture/product/security decisions; those stay with the primary worker.
The measured receipt is attached to the current board task. Use --for when a
worker has several active tasks and the intended parent would be ambiguous.

Use --json to retain all receipt fields, including the board evidence verdict.
EOF
      ;;
    *) die "amux delegate: unknown subcommand '$sub' (try: read)" ;;
  esac
}

