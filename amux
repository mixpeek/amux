      if grep -qi '^x-amux-truncated: 1' "$_hdr" 2>/dev/null; then
        local _tt _tr
        _tt=$(grep -i '^x-amux-terminal-total:' "$_hdr" | tr -d '\r' | awk '{print $2}')
        _tr=$(grep -i '^x-amux-terminal-returned:' "$_hdr" | tr -d '\r' | awk '{print $2}')
        echo "${DIM}— showing ${_tr:-?} of ${_tt:-?} done/verified/discarded cards (newest first, fleet-wide cap)."
        echo "  YOUR terminal cards may be entirely outside this list. To see them:"
        echo "    amux board ls --mine        # this session, uncapped"
        echo "    curl -sk \"\$AMUX_API/api/board?session=\$AMUX_SESSION&done_limit=0\"${RESET}"
      fi
      rm -f "$_hdr"
      ;;
    help|*)
      # An UNKNOWN verb must not exit 0. `amux board note X "..."` printed this
      # help and returned success — the exact AMUX-2140 shape, where following
      # an instruction produces a success signal and no effect. Help asked for
      # explicitly still exits 0; a typo'd or invented verb exits 2.
      local _rc=0
      if [[ -n "$subcmd" && "$subcmd" != "help" && "$subcmd" != "-h" && "$subcmd" != "--help" ]]; then
        echo "amux board: unknown verb '$subcmd'" >&2
        _rc=2
      fi
      cat <<EOF
${BOLD}amux board${RESET} — manage board issues from the CLI

  amux whoami                      Live worker identity vs inherited env (mismatch warns)
  amux board ls [--all]            List open issues (--all includes archived)
  amux board add <title>           Create a new todo issue
    --type T                       set the type at create time (the GATE is derived from it)
    --desc/--desc-stdin/--desc-file  give the card a body in the same write
                                   (--stdin/--file for the TITLE. Unknown flags are
                                    REFUSED, not folded into the title — AEAB-17.)
  amux board claim <ID>            Atomically claim a todo/backlog card for this worker
  amux board assign <ID> <worker>  Reassign a card to a worker (the claim 409's sanctioned exit)
  amux board needsyou <ID> [ask]   Mark a card as blocked on the human (surfaces in Needs-you).
                                   A sign-in/login ask auto-gets a clickable resume link into
                                   this session's live browser view (Ethan clicks to sign in).
  amux board ask <ID> [question]   Ask the owning worker to post a status update
  amux board status-update <ID> …  (for the owning worker) post status to the board
                                   (prose, --stdin or --file <path>; NOT the gate flags below)
  amux board done <ID>             Move issue to done
  amux board doing <ID>            Move issue to doing (in progress)
  amux board review <ID>           Move issue to in review
  amux board todo <ID>             Move issue to todo
  amux board backlog <ID>          Move issue to backlog
  amux board status <ID> <status>  Set any status
  amux board type <ID> <type>      Correct a card's type (the gate is DERIVED from it)
  amux board retitle <ID> <title>  Rewrite a title/desc so the card stands alone
                                   (--stdin/--file preferred; --desc-stdin for the body)

  The status-CHANGE verbs (done, doing, review, todo, backlog, status) take the
  gate-satisfying flags, so a gated move never needs a hand-rolled curl (which is
  how attribution gets lost). ${BOLD}status-update, needsyou, progress and ask do NOT${RESET}
  — they take prose, or --stdin/--file. Handing one of them --outcome-file used to
  record the flag string itself as the message; it now refuses:
    --checked "crit" ["crit" ...]  acknowledge the criteria that are TRUE
    --ack                          acknowledge the whole gate at once
    --outcome "what happened"      record the outcome FIRST, as its own write,
                                   so a refused transition cannot discard it
    --outcome-stdin                read the outcome from stdin ${GREEN}(preferred)${RESET}
    --outcome-file <path>          read the outcome from a file
                                   Inline text is evaluated by YOUR shell, so
                                   \`backticks\` and \$(...) in an outcome are
                                   EXECUTED, not recorded. Use stdin whenever the
                                   text quotes a command:
                                     amux board done ID --checked "..." --outcome-stdin <<'EOF'
                                     ... \`git log --grep=x\` stays literal ...
                                     EOF
    --type T                       retype in the same write
    --reviewer W                   name the peer this card is handed to. \`amux board review ID --reviewer W\`
                                     sets the STATUS; the review gate rests on the
                                     REVIEWER's sign-off, so a card in review with
                                     no reviewer is one nobody was asked to look at
    --override-doing               hold a second card in doing deliberately
    --trigger "external condition"  park on an EXTERNAL blocker: records it as the
                                   card's source_ref and stamps last_verified_at, so a
                                   stale trigger is detectable (is:sourcestale) instead
                                   of the card sleeping forever
    --force "reason"               bypass a gate that cannot be satisfied honestly
                                   (e.g. peer's dirt in a shared checkout). The reason
                                   is recorded on the card and the bypass is audited.
  e.g.  amux board review AC-12 --checked "Findings written up" "Ready for eyes"

  amux board import gh:owner/repo#N [--workspace W] [--project P]
                                   Import GH issue as board task(s)
  amux board progress <ID> <msg>   Add progress note (posts to GH if linked)
EOF
      return $_rc
      ;;
  esac
}

cmd_serve() {
  # --help / -h short-circuit
  for _a in "$@"; do
    case "$_a" in
      -h|--help|help)
        cat <<EOF
${BOLD}amux serve${RESET} - start the web dashboard (Rust server, HTTPS)

${BOLD}Usage:${RESET}
  amux serve [port]

${BOLD}Args:${RESET}
  port                  TCP port to listen on. Optional; exported as AMUX_RS_PORT.
                        Default 8823; the installed launchd service uses 8824.

${BOLD}Environment:${RESET}
  AMUX_RS_PORT          Port to listen on (a positional port just sets this).
  AMUX_RS_LEGACY_PORT   Additionally answer the RETIRED port (8822) with the
                        same router/TLS/auth, so pre-cutover sessions holding a
                        baked-in AMUX_URL=https://localhost:8822 keep working.
                        Set in ~/.amux/server.env. Being retired: check
                        GET /api/debug/legacy-port for who still calls it, and
                        drop the var when that reads zero for 7 days.

${BOLD}Examples:${RESET}
  amux serve
  amux serve 8824

${BOLD}Note:${RESET} \`--bind\` and \`--no-tls\` are GONE. They were Python-server flags;
the Rust server takes no argv, always binds 0.0.0.0, and always serves HTTPS
(plain HTTP is redirected). Passing them now exits with an error rather than
being silently ignored. Normally you do not run this by hand at all — the
launchd agent com.amux.server-rs owns the process.

${BOLD}Security note:${RESET} the 0.0.0.0 bind exposes the dashboard on every network
interface this host is connected to (including public Wi-Fi LANs and public IPs).
Layer a firewall rule, or use Tailscale, for anything beyond localhost.
EOF
        return 0
        ;;
    esac
  done
  # The server is the Rust binary (the Python amux-server.py was removed
  # 2026-08-09; git history has it). It takes NO argv — port comes from
  # AMUX_RS_PORT — so map the old positional-port spelling onto the env var.
  local server="$HOME/.local/bin/amux-server-rs"
  [[ -x "$server" ]] || server="$(command -v amux-server-rs 2>/dev/null || true)"
  [[ -n "$server" && -x "$server" ]] || die "amux-server-rs not found — run ./install.sh from the amux checkout"
  if [[ "${1:-}" =~ ^[0-9]+$ ]]; then
    export AMUX_RS_PORT="$1"; shift
  fi
  [[ $# -gt 0 ]] && die "amux serve takes only an optional port now (extra args: $*)"
  exec "$server"
}


# ---------------------------------------------------------------------------
# amux iac — the instance as declarative YAML (AMUX-2679)
#
# NOT `amux config`: that is already an alias for `amux defaults`
# (show|edit|reset), and shadowing a working user-facing verb to save four
# characters is how a CLI acquires a surprise.
#
# The SERVER speaks JSON like every other amux contract; YAML lives here,
# where the human is. python3 + pyyaml do the conversion, so no endpoint has
# to be different from all the others just to be configurable.
# ---------------------------------------------------------------------------
cmd_config() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    export)
      _curl -sk "${AMUX_API:-https://localhost:8824}/api/config/export" \
      | python3 -c '
import sys, json, yaml
d = json.load(sys.stdin)
d.pop("note", None)
sys.stdout.write(yaml.safe_dump(d, sort_keys=False, allow_unicode=True, default_flow_style=False))
'
      ;;
    apply)
      local f="${1:-}"
      [[ -n "$f" && -r "$f" ]] || die "usage: amux iac apply <file.yaml>   (reads a file; use - for stdin)"
      local body
      body=$(python3 -c '
import sys, json, yaml
raw = sys.stdin.read() if sys.argv[1] == "-" else open(sys.argv[1]).read()
doc = yaml.safe_load(raw) or {}
if not isinstance(doc, dict):
    sys.stderr.write("config must be a YAML mapping (got %s)\n" % type(doc).__name__); sys.exit(2)
print(json.dumps(doc))
' "$f") || die "could not parse $f as YAML"
      _curl -sk -X PUT -H 'Content-Type: application/json' -d "$body" \
        "${AMUX_API:-https://localhost:8824}/api/config/apply" \
      | python3 -c '
import sys, json
try: d = json.load(sys.stdin)
except Exception:
    sys.stderr.write("apply failed: server sent no JSON\n"); sys.exit(1)
if d.get("error"):
    sys.stderr.write("apply refused: %s\n" % d["error"]); sys.exit(1)
print(d.get("summary", "applied"))
for c in d.get("changed", []): print("  changed   %s" % c)
for u in d.get("unchanged", []): print("  unchanged %s" % u)
errs = d.get("errors") or []
for e in errs: sys.stderr.write("  ERROR %s: %s\n" % (e.get("item"), e.get("error")))
sys.exit(1 if errs else 0)
'
      ;;
    skin)
      # What a given worker actually renders with, after the layer merge.
      local w="${1:-}"
      _curl -sk "${AMUX_API:-https://localhost:8824}/api/skin?worker=${w}" \
      | python3 -c '
import sys, json, yaml
d = json.load(sys.stdin)
print("# layers applied: %s" % ", ".join(d.get("layers") or ["(none)"]))
sys.stdout.write(yaml.safe_dump(d.get("skin") or {}, sort_keys=False, allow_unicode=True))
'
      ;;
    *)
      cat <<'USAGE'
amux iac — the instance as declarative YAML

  amux iac export             dump skins, columns and worker declarations
  amux iac apply <file.yaml>  apply it (idempotent; says what changed)
  amux iac skin [worker]      the RESOLVED skin, and which layers made it

Apply DECLARES workers; it does not start them. `amux workers start <name>`
is the separate verb, so a mistyped apply cannot spawn a fleet.
USAGE
      ;;
  esac
}


# ── CRM ──────────────────────────────────────────────────────────────────────
# AMUX-2932. Global ~/.claude/CLAUDE.md has documented `amux crm add` to every
# session in every project for months; the verb did not exist and the HTTP API
# behind it did not either (405, no route) until AMUX-2929 ported it.
#
# EVERY WRITE CARRIES X-Amux-Session. Python's version of this verb did NOT,
# and that is the whole reason CLAUDE.md tells agents to prefer `amux <verb>`
# over a hand-rolled curl: a raw curl is unattributed by construction. Adding
# the verb without the header would have rebuilt the trap it exists to close.
cmd_crm() {
  local AMUX_API="${AMUX_API:-https://localhost:8824}"
  local sub="${1:-list}"; shift 2>/dev/null || true
  # key=value pairs -> JSON, bare words -> the name. Done in python so a name
  # with spaces, quotes or a `$` survives; building this JSON in bash is how
  # you get a contact called `$(whoami)`.
  _crm_json() {
    python3 -c '
import sys, json
fields = {}; name = []
for a in sys.argv[1:]:
    if "=" in a and not a.startswith("="):
        k, v = a.split("=", 1); fields[k] = v
    else:
        name.append(a)
if name: fields["name"] = " ".join(name)
print(json.dumps(fields))' "$@"
  }
  case "$sub" in
    add)
      [ $# -gt 0 ] || die "Usage: amux crm add \"Name\" [company=X] [email=Y] [role=Z] [phone=P]"
      local json; json=$(_crm_json "$@")
      _curl -sk -X POST -H 'Content-Type: application/json' \
        -H "X-Amux-Session: ${AMUX_SESSION:-}" \
        -d "$json" "$AMUX_API/api/crm/contacts" | python3 -c '
import json, sys
d = json.load(sys.stdin)
if d.get("error"): print("error:", d["error"], file=sys.stderr); sys.exit(1)
print(d.get("id", "?"), "created")'
      ;;
    update|set)
      local cid="${1:-}"; [ -n "$cid" ] || die "Usage: amux crm update PPL-1 company=X email=Y"
      shift 2>/dev/null || true
      [ $# -gt 0 ] || die "amux crm update: nothing to set. Give key=value pairs."
      local json; json=$(_crm_json "$@")
      _curl -sk -X PATCH -H 'Content-Type: application/json' \
        -H "X-Amux-Session: ${AMUX_SESSION:-}" \
        -d "$json" "$AMUX_API/api/crm/contacts/$cid" | python3 -c '
import json, sys
d = json.load(sys.stdin)
if not d.get("ok"): print("error:", d.get("error", "failed"), file=sys.stderr); sys.exit(1)
print("updated")'
      ;;
    get|show)
      local cid="${1:-}"; [ -n "$cid" ] || die "Usage: amux crm get PPL-1"
      _curl -sk "$AMUX_API/api/crm/contacts/$cid" | python3 -c '
import json, sys
c = json.load(sys.stdin)
if c.get("error"): print("error:", c["error"], file=sys.stderr); sys.exit(1)
print(c.get("id"), "-", c.get("name"))
for f in ("company", "role", "email", "phone", "linkedin", "twitter"):
    if c.get(f): print("  %-9s %s" % (f + ":", c[f]))
if c.get("tags"): print("  %-9s %s" % ("tags:", ", ".join(c["tags"])))
if c.get("notes"): print("  %-9s %s" % ("notes:", c["notes"]))
for i in c.get("interactions", [])[:5]:
    print("  %s  %-6s %s" % (i.get("date", ""), i.get("type", ""), (i.get("notes") or "")[:60]))'
      ;;
    log)
      local cid="${1:-}"; [ -n "$cid" ] || die "Usage: amux crm log PPL-1 \"what happened\" [follow_up_date=YYYY-MM-DD]"
      shift 2>/dev/null || true
      local json; json=$(python3 -c '
import sys, json
fields = {"type": "other"}; notes = []
for a in sys.argv[1:]:
    if "=" in a and not a.startswith("="):
        k, v = a.split("=", 1); fields[k] = v
    else:
        notes.append(a)
if notes: fields["notes"] = " ".join(notes)
print(json.dumps(fields))' "$@")
      _curl -sk -X POST -H 'Content-Type: application/json' \
        -H "X-Amux-Session: ${AMUX_SESSION:-}" \
        -d "$json" "$AMUX_API/api/crm/contacts/$cid/interactions" | python3 -c '
import json, sys
d = json.load(sys.stdin)
if d.get("error"): print("error:", d["error"], file=sys.stderr); sys.exit(1)
print("logged", d.get("id", ""))'
      ;;
    followups|fu)
      # Read the body defensively, like `tunnel status` and `alert` already do.
      # Unparseable input used to reach `json.load` directly and print a raw
      # Python traceback — loud, but naming json/__init__.py rather than the
      # server, so "amux is down" and "amux crm is broken" looked identical.
      # AEAB-37: this is NOT the AEAB-36 silent-abort shape, which is what that
      # card originally claimed; it is a smaller instrument defect in the same
      # family. See the card for the correction.
      _curl -sk "$AMUX_API/api/crm/followups" | python3 -c '
import json, sys
raw = sys.stdin.read()
try: items = json.loads(raw)
except ValueError: sys.exit("amux server not responding at %s (restarting?) — retry in a moment" % __import__("os").environ.get("AMUX_API", "the configured API"))
if isinstance(items, dict) and items.get("error"): sys.exit("error: %s" % items["error"])
if not items: print("No pending follow-ups"); sys.exit(0)
for i in items:
    print(i.get("follow_up_date", ""), i.get("name", ""), "-", i.get("follow_up_note", ""))'
      ;;
    list|ls|"")
      _curl -sk "$AMUX_API/api/crm/contacts$([ -n "${1:-}" ] && printf '?q=%s' "$1")" | python3 -c '
import json, sys
raw = sys.stdin.read()
try: cs = json.loads(raw)
except ValueError: sys.exit("amux server not responding at %s (restarting?) — retry in a moment" % __import__("os").environ.get("AMUX_API", "the configured API"))
# An error OBJECT is not an empty list. Iterating a dict yields its KEYS, so
# without this the loop below called .get() on a string and died with an
# AttributeError that named neither the server nor the error it returned.
if isinstance(cs, dict) and cs.get("error"): sys.exit("error: %s" % cs["error"])
if not cs: print("No contacts"); sys.exit(0)
for c in cs:
    print("%-8s %-28s %s" % (c.get("id", ""), (c.get("name") or "")[:28], c.get("company", "")))'
      ;;
    help|--help|-h)
      cat <<'EOH'
amux crm — contacts, notes and follow-ups (HTTP: /api/crm/*)

  amux crm list [query]                     List contacts (optional name/company/role search)
  amux crm get PPL-1                        One contact with tags and recent interactions
  amux crm add "Name" [company=X email=Y]   Create; extra key=value pairs set fields
  amux crm update PPL-1 role=CTO            Update whitelisted fields
  amux crm log PPL-1 "spoke re pricing" [follow_up_date=2026-09-01]
  amux crm followups                        Pending follow-ups, soonest first

Writes carry X-Amux-Session, so the audit trail names who made them.
EOH
      ;;
    *) die "amux crm: unknown subcommand: $sub  (try: amux crm help)" ;;
  esac
}

