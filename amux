# Outcome-based exit for board mutations (AMUX-2140): the CLI used to report
# the TRANSPORT (curl ok = exit 0) while the server refused the write — every
# `$?` caller and every `&& echo moved` printed success on blocked mutations,
# and a refused status PATCH left desc/status contradicting each other
# fleet-visible. Codes: 0 ok · 3 gate not acknowledged · 4 WIP/holding limit ·
# 5 rev mismatch · 1 other refusal or malformed response (including a
# continuation refusal, which --checked cannot clear). Refusals print the
# server body to STDERR so pipelines keep clean stdout.
# _board_move_finish <rc> <response> <id> <status>: after a status move,
# (1) on a refusal, end with ONE line naming the refusal: the reason used to
#     sit pages up, and `| tail -1` showed only a hint (gs12-restore and
#     gs12-templates, 2026-10-01: "amux board doing GT-186" read as a hint);
# (2) on success, read the card back a moment later and warn if another writer
#     (board-drive re-asserting a lane's live claim, for one) has already
#     changed it: "amux board todo GR-24" printed "-> todo" while the card read
#     doing seconds later. Exit 3 then, so a script can tell.
_board_move_finish() {
  local rc="$1" resp="$2" id="$3" want="$4" got
  if [ "$rc" -ne 0 ]; then
    printf '%s' "$resp" | ID="$id" W="$want" python3 -c '
import json, os, sys
try:
    d = json.loads(sys.stdin.read())
except Exception:
    d = {}
why = (d.get("error") or d.get("why") or "see the response above") if isinstance(d, dict) else "see the response above"
code = d.get("code") if isinstance(d, dict) else None
sys.stderr.write("amux board: %s was NOT moved to %s: %s%s\n" % (os.environ["ID"], os.environ["W"], str(why)[:240], " [" + str(code) + "]" if code else ""))
' || true
    return "$rc"
  fi
  case "$want" in todo|doing|done|backlog|verified|discarded|review) ;; *) return 0 ;; esac
  sleep 1
  got=$(_curl -sk "${AMUX_API:-$(cmd_url)}/api/board/$id" 2>/dev/null | python3 -c 'import sys,json
try: print(json.load(sys.stdin).get("status",""))
except Exception: print("")')
  if [ -n "$got" ] && [ "$got" != "$want" ]; then
    echo "amux board: WARNING $id reads '$got' a second after the move to '$want': another writer changed it (board-drive re-asserts a card its lane is working on). Check: amux board show $id" >&2
    return 3
  fi
  return 0
}

_board_outcome() {
  local _board_response
  _board_response="$(cat)"
  printf '%s' "$_board_response" | _board_require_ack "${1:-?}" "board write" || return $?
  # Optional args: the id and status the CALLER attempted. Not decoration —
  # the WIP-limit 409 body carries no `attempted_status`, so a hint derived
  # only from the response could never fire on the refusal that needs it most
  # (caught by running it, not by reading it). The caller always knows.
  printf '%s' "$_board_response" | python3 -c '
import sys, json
_argv = sys.argv[1:]
raw = sys.stdin.read()
try:
    d = json.loads(raw)
except Exception:
    # STRIP FIRST. Every caller reaches this via `echo "$result" | ...`, and
    # echo appends a newline unconditionally — so on an empty server reply
    # `raw` was "\n", which is TRUTHY, so `or "empty response"` never fired and
    # this wrote a bare newline to stderr. The command then exited 1 having
    # printed nothing on either stream: a silent failure from the sanctioned
    # path, which is the exact class this whole function exists to end.
    # Caught 2026-08-11 when `amux board status-update` (a 405 with an empty
    # body) failed in total silence.
    body = raw.strip()[:300]
    sys.stderr.write((body or "empty response from the server — the endpoint "
                              "may not be routed on this build") + "\n")
    sys.exit(1)
err = (d.get("error") or "") if isinstance(d, dict) else ""
ok = isinstance(d, dict) and not err and d.get("ok") is not False
if ok:
    # A caller whose write is NOT a status transition passes its own label
    # (argv[2]). Without it this printed "<id> -> <current status>" for a
    # tag-only write, which reads as a transition that silently did not
    # happen \u2014 AC-222: I filed a bug against `needsyou` on exactly that
    # misread, then routed around a working command with a raw PATCH.
    label = (_argv[2] if len(_argv) > 2 else "") or d.get("status") or d.get("title") or "ok"
    print(d.get("id", "?"), "\u2192", label)
    # DIVERTED is not IGNORED, and the difference is what the caller does next
    # (AMUX-3791). Ignored means "set it somewhere else"; diverted means "it IS
    # set, stop looking in the field you named". `board backlog --trigger` on an
    # autofix-filed card writes the condition into the card BODY, because
    # source_ref holds the dedupe signature that stops the detector re-filing.
    # Without this line the command printed "<id> -> backlog", and verifying the
    # way the flag implies \u2014 read back source_ref \u2014 returned the old value and
    # read as a silent drop. That false negative cost a probe against a live
    # card and nearly a bug report against code behaving correctly. stderr and
    # exit 0: nothing went wrong, so it must not look like a failure or change
    # the stdout shape any script is parsing.
    for dv in (d.get("diverted_fields") or []):
        if not isinstance(dv, dict):
            continue
        # QUOTE THE VALUE THE SERVER ECHOED BACK, not a generic noun. The whole
        # point of this line is that a caller can confirm the write WITHOUT
        # opening the card, and "the value was recorded" sends them to look
        # anyway. The first draft reached for the status LABEL here, which
        # `board backlog` never passes, so every real invocation printed the
        # generic fallback.
        #
        # NO APOSTROPHE OR SINGLE QUOTE BELOW, INCLUDING IN COMMENTS. This
        # function is a python3 -c block delimited by single quotes, so one
        # apostrophe anywhere in it takes the fleet CLI down at load. The first
        # draft of this hunk did exactly that; the save gate caught it and the
        # CLI was broken fleet-wide until it was stashed.
        val = dv.get("value") or ""
        if len(val) > 73:
            val = val[:72] + "..."
        shown = "\"" + val + "\"" if val else "the value"
        sys.stderr.write(
            "note: %s was recorded in the card %s, not in `%s` \u2014 %s\n"
            % (shown,
               (dv.get("landed_in") or "?").upper(),
               dv.get("field") or "?",
               dv.get("why") or "no reason given"))
    # A REVIEW HANDOFF THE REVIEWER CANNOT RECEIVE (AMUX-4662).
    #
    # The server has answered reviewer_notified false, with a full reason, since
    # AMUX-3771, and this function threw it away. So the sanctioned command
    # printed one line and the author learned days later that nobody was ever
    # asked. Measured 2026-09-15 on a throwaway card against PAUSED
    # amux-testing: the API named the refusal in reviewer_notify_reason, the CLI
    # said only "AMUX-4707 -> review". Before that, four real cards were handed
    # to that same paused lane over five hours with no word.
    #
    # NO APOSTROPHE OR SINGLE QUOTE IN THIS BLOCK, per the warning above: the
    # whole function is a python3 -c argument delimited by single quotes.
    #
    # stderr and exit 0, deliberately. The transition DID happen and the card is
    # in review; what did not happen is the notification. A nonzero exit here
    # would tell every caller the move failed, which is a different and false
    # claim, and would break scripts that check the status code of a move that
    # worked.
    if d.get("reviewer_notified") is False:
        sys.stderr.write(
            "warning: the card moved to review, but the REVIEWER WAS NOT TOLD. %s\n"
            % (d.get("reviewer_notify_reason") or "no reason given"))
        sys.stderr.write(
            "  Nothing will reach them until that is resolved. Name a reachable "
            "reviewer with `amux board reviewer %s <lane>`, or resume the lane.\n"
            % (d.get("id") or "<ID>"))
    # A 200 does not mean the server applied everything you sent. Reported by
    # mixpeek-frustrations: `board backlog --trigger` stored source_ref but
    # silently dropped last_verified_at, so the card parked with a good trigger
    # and NOTHING to expire it — the exact guard --trigger exists to arm. The
    # success line and the silent skip were indistinguishable.
    ign = [f for f in (d.get("ignored_fields") or []) if f]
    dep = d.get("request_dependency")
    if isinstance(dep, dict) and dep.get("linked"):
        sys.stderr.write(
            "dependency: %s requeued in todo and now depends on %s; requester WIP released\n"
            % (dep.get("parent") or "?", dep.get("child") or d.get("id") or "?"))
    if ign:
        sys.stderr.write(
            "warning: the server IGNORED %s on this write — the transition "
            "happened, those field(s) did not.\n" % ", ".join(ign))
        sys.exit(6)
    sys.exit(0)
sys.stderr.write(json.dumps(d) + "\n")
e = err.lower()
# AMUX-5270: the owner already answered this ask. Say what to do in one line
# instead of leaving it inside the JSON dump. No apostrophes in this block.
if isinstance(d, dict) and d.get("code") == "covered_by_standing_approval":
    _sa = d.get("standing_approval") or {}
    sys.stderr.write("\nALREADY APPROVED (" + str(_sa.get("id")) + "): " + str(_sa.get("instruction") or "") + "\n"
                     "  If it does not really cover this ask, PATCH again with standing_approval_decline set to why.\n")
    sys.exit(1)
# Name the ATTRIBUTED command that gets past this refusal (AMUX-2325). The
# server body explains the escape in HTTP terms (gate_ack / override_doing),
# which is how a blocked agent ends up hand-rolling an unattributed curl.
# Print the honest `amux board` form instead, quoting the gate criteria the
# server just handed back so they can be acknowledged individually rather
# than blanket-acked.
def _q(s):
    return "\"" + str(s).replace("\\", "\\\\").replace("\"", "\\\"") + "\""
iid = d.get("item") or d.get("id") or (_argv[0] if _argv else "<ID>")
tgt = d.get("attempted_status") or (_argv[1] if len(_argv) > 1 else "")
if "gate" in e:
    gate = d.get("gate") or []
    if tgt and gate:
        sys.stderr.write(
            "\nSatisfy these, then acknowledge the ones that are TRUE:\n"
            + "".join("   [ ] " + str(g) + "\n" for g in gate)
            + "\n  amux board " + tgt + " " + iid + " --checked "
            + " ".join(_q(g) for g in gate) + "\n")
        # AF-571: print the RETYPE remedy only when retyping is actually the
        # remedy. The gate resolves card -> worker -> group -> global -> type
        # default, and only the last of those moves when you change the type.
        # The server already tells us which we got: it emits how_to_ack.
        # gate_source exactly when the gate came from a NON-type scope, with
        # the words "retyping will NOT change it" in it. This block used to
        # print the retype advice unconditionally, so a group-scoped gate
        # produced a response that contradicted itself: an accurate JSON field
        # saying retyping does nothing, and a closing line, last and carrying
        # the only runnable command, saying to retype.
        #
        # The damage is not the wasted command. That closing line is what makes
        # an author believe the gate has an honest exit; sending them to the one
        # remedy that provably cannot work pushes them toward acking something
        # untrue, which is what the line exists to prevent (ethos rule 3).
        _hta = d.get("how_to_ack") or {}
        _gsrc = _hta.get("gate_source")
        if _gsrc:
            sys.stderr.write(
                "\nRETYPING WILL NOT CHANGE THIS GATE.\n"
                "  " + str(_gsrc) + "\n"
                "  What would change it: satisfy the criteria above; or hand the card\n"
                "  to the lane the criterion is about, with\n"
                "    amux board assign " + iid + " <lane> && amux board todo " + iid + "\n"
                "  or change the gate at the scope that owns it.\n")
            sys.exit(3)
        sys.stderr.write(
            "\nIf a criterion does not apply because the card is mistyped "
            "(item_type=" + str(d.get("item_type") or "?") + "), correct the TYPE "
            "rather than acking something untrue:\n"
            # AC-249: derive from valid_types as published by the server. The
            # hardcoded list named decision and task, neither of which the
            # validator accepts, and omitted escalation/blocker/tripwire/watch,
            # which it does accept -- wrong in BOTH directions from a string
            # that had drifted from _ITEM_TYPES. No hardcoded fallback: a stale
            # list that looks authoritative is the whole defect.
            # NOTE: this block is inside python3 -c QUOTED-WITH-SINGLE-QUOTES,
            # so an apostrophe here closes the bash string and breaks the CLI
            # for every session. Keep this comment apostrophe-free.
            "  " + (d.get("cli_wrong_type")
                    or ("amux board type " + iid + " <"
                        + ("|".join(d.get("valid_types") or [])
                           or "see GET /api/board/contract") + ">")) + "\n")
    sys.exit(3)
# AMUX-4570. A continuation refusal names doing in its code
# (doing_requires_next_action, doing_next_action_not_a_sentence) and has
# nothing to do with a held card. The WIP test below used to match any error
# containing doing, so this refusal printed the override-doing hint and exited
# 4, pointing at the one remedy that cannot clear it. Print the server remedy.
if err in ("doing_requires_next_action", "doing_next_action_not_a_sentence"):
    why = d.get("why") or ""
    if why:
        sys.stderr.write("\n" + str(why) + "\n")
    how = str(d.get("how") or "amux board next <ID> \"<what the next actor should do>\"")
    sys.stderr.write("\nSet the next action, then claim again:\n  " + how.replace("<ID>", iid) + "\n")
    esc = d.get("escape")
    if esc:
        sys.stderr.write("  or, only when the next action is genuinely unknowable:\n  "
                         + str(esc).replace("<ID>", iid) + "\n")
    sys.exit(1)
# AMUX-4731. BRANCH ON THE CODE, NOT ON THE PRESENCE OF `holding`.
#
# Two different refusals send `holding` and they mean different things: the
# doing-WIP refusal sends a LIST of held cards, todo_wip_limit_reached sends an
# INTEGER queue depth. The test below used to accept either, so a todo-WIP
# refusal printed the doing remedy and exited 4, naming --override-doing, which
# cannot clear a todo limit. The server had already sent four correct remedies
# in how_to_fix in the same body, and they were discarded for a hardcoded line.
#
# This is the SECOND repair of this arm. AMUX-4570 (the comment above) fixed the
# identical class by special-casing two error codes by name and left the
# predicate underneath unchanged, so the next refusal carrying `holding` walked
# straight back in. Its own instruction, print the server remedy, is what this
# does: a hardcoded remedy cannot disagree with the run, which is why the defect
# survived a round of fixing (ethos rule 4).
#
# NO APOSTROPHE IN THIS BLOCK. The whole function is a python3 -c argument
# delimited by single quotes, so one apostrophe breaks the CLI for every session.
def _remedies(v):
    # how_to_fix is a DICT at two server sites and a bare STRING at a third, so
    # a reader that assumes either shape prints nothing for the other. Both are
    # real today (api/board.rs 4957, 10839, and 5100).
    if isinstance(v, dict):
        return [str(x) for x in v.values() if x]
    if isinstance(v, str) and v.strip():
        return [v.strip()]
    return []

code = (d.get("code") or "") if isinstance(d, dict) else ""
if code == "todo_wip_limit_reached":
    why = d.get("why") or ""
    if why:
        sys.stderr.write("\n" + str(why) + "\n")
    # The specific cards the dispatcher has already stopped dealing. Far more
    # use than a generic close something, and the server computed them.
    stale = [c for c in (d.get("close_these_first") or []) if isinstance(c, dict)]
    if stale:
        sys.stderr.write("\nOldest untouched todo cards on this lane:\n")
        for c in stale[:5]:
            sys.stderr.write("  %s  %s%s\n" % (
                c.get("id") or "?",
                str(c.get("title") or "")[:58],
                "  (already undispatchable)" if c.get("already_undispatchable") else ""))
    rem = _remedies(d.get("how_to_fix"))
    if rem:
        sys.stderr.write("\nWhat clears it:\n")
        for r in rem:
            sys.stderr.write("  " + r.replace("<ID>", iid) + "\n")
    # ITS OWN EXIT CODE. Reusing the doing-WIP exit 4 makes the two
    # indistinguishable to any script, and they need opposite remedies.
    sys.exit(7)
# A real WIP refusal carries a holding list and the error already holding doing.
if d.get("holding") or "holding" in e or "wip" in e:
    # PREFER THE COMMAND THE SERVER SENT. It emits `cli` for this refusal, so
    # the hardcoded form below is a second copy that can drift from it, which is
    # the defect this whole block is about. Fall back only when it is absent.
    cli = d.get("cli")
    if cli:
        sys.stderr.write("\nFinish or demote the held card, or hold both deliberately:\n"
                         "  " + str(cli).replace("<ID>", iid) + "\n")
    elif tgt:
        sys.stderr.write("\nFinish or demote the held card, or hold both deliberately:\n"
                         "  amux board " + tgt + " " + iid + " --override-doing\n")
    sys.exit(4)
if "rev mismatch" in e:
    sys.exit(5)
sys.exit(1)' "${1:-}" "${2:-}" "${3:-}"
}

_board_archive_arg_error() {
  local operation="$1" item="$2" reason="$3" hint="$4" payload
  echo "error: amux board $operation: $hint. No board change was sent." >&2
  # Argument values can contain private outcome text. Emit only the validated
  # item identity and a fixed reason, through the existing diagnostic surface.
  payload=$(OP="$operation" ITEM="$item" WHY="$reason" python3 -c 'import json,os
print(json.dumps({"kind":"cli-argument-refused","operation":os.environ["OP"],
 "item":os.environ["ITEM"],"reason":os.environ["WHY"],"measured":True,"n_considered":1}))')
  command curl -sk --connect-timeout 1 --max-time 2 -X POST \
    -H 'Content-Type: application/json' -d "$payload" \
    "$AMUX_API/api/client-debug" >/dev/null 2>&1 || true
  exit 2
}

cmd_board() {
  local AMUX_API="${AMUX_API:-https://localhost:8824}"
  local subcmd="${1:-help}"; shift 2>/dev/null || true

  case "$subcmd" in
    graph)
      # A projection of the board, not another store or planner. --check is a
      # CI gate; --json preserves the whole versioned snapshot for replay.
      local graph_json=0 graph_check=0 graph_result
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --json) graph_json=1 ;;
          --check) graph_check=1 ;;
          --help|-h) echo "Usage: amux board graph [--json] [--check]
Typed task/worker/artifact/message graph, provenance, dependency layers and integrity findings.
--check exits 1 for an invalid graph; unavailable measurements exit 2.
This is structural build order. Workflow readiness: GET /api/board/ready."; return 0 ;;
          *) die "amux board graph: unknown option '$1'" ;;
        esac
        shift
      done
      local graph_path="/api/graph/board/verify"
      [[ "$graph_json" == 1 ]] && graph_path="/api/graph/board"
      graph_result=$(_curl -fsk "$AMUX_API$graph_path") || {
        echo "amux board graph: graph measurement unavailable from $AMUX_API$graph_path" >&2
        return 2
      }
      printf '%s' "$graph_result" | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
