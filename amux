cmd_pin() {
  local file="${1:-}"
  if [[ -z "$file" || "$file" == "-h" || "$file" == "--help" ]]; then
    echo "Usage: amux pin <file> [--opacity 0.85] [--x 800] [--y 200] [--width 400] [--height 500]"
    echo "Float a file as an always-on-top macOS overlay window."
    echo "Supports full markdown rendering with interactive checkboxes and editing."
    return 0
  fi

  # Resolve relative paths
  [[ "$file" = /* ]] || file="$(pwd)/$file"

  if [[ ! -f "$file" ]]; then
    die "File not found: $file"
  fi

  local overlay
  overlay="$(dirname "$(command -v amux 2>/dev/null || echo "$0")")/pinned-overlay"
  if [[ ! -x "$overlay" ]]; then
    overlay="$(cd "$(dirname "$0")" && pwd)/scripts/pinned-overlay"
  fi
  if [[ ! -x "$overlay" ]]; then
    die "pinned-overlay binary not found. Compile with: swiftc -O -parse-as-library -o scripts/pinned-overlay scripts/pinned-overlay.swift -framework Cocoa -framework WebKit"
  fi

  shift
  "$overlay" "$file" "$@" &
  disown
  echo "Pinned: $(basename "$file")"
}

cmd_alert() {
  # NEVER fire on help/empty (the 38-SMS night, 2026-08-03): a session ran
  # `amux alert --help` to LEARN the command and each probe sent Ethan a real
  # iMessage — the sanctioned instruction was the failure (AMUX-2140 class).
  case "${1:-}" in
    -h|--help|"")
      echo "Usage: amux alert \"<what happened + what you need>\" \"<short why-now>\""
      echo "FIRE ALARM: pushes + texts the owner's PHONE. Not for status updates."
      return 0 ;;
  esac
  # Urgent owner alert — USE SPARINGLY. Fires an in-app push + iMessage to the
  # amux owner (Ethan). For anything a session needs the owner to see NOW.
  local AMUX_API="${AMUX_API:-https://localhost:8824}"
  local msg="${1:-}"
  [[ -n "$msg" ]] || die "Usage: amux alert \"<message>\" [reason]
This is a FIRE ALARM — only for things that need the owner immediately
(prod down, data at risk, a go/no-go only they can make). Not for status updates."
  local reason="${2:-}"
  local sess="${AMUX_SESSION:-cli}"
  # Pass X-Amux-Session so the server stamps the TRUE origin (from the tmux
  # identity) into the owner_alerts ledger — the body 'session' is only a CLAIM.
  # This is what makes a safety-critical alert first-hand verifiable (AMUX-1795).
  _curl -sk -X POST -H 'Content-Type: application/json' \
    -H "X-Amux-Worker: ${AMUX_WORKER:-${AMUX_SESSION:-}}" \
    -d "$(python3 -c 'import json,sys; print(json.dumps({"message":sys.argv[1],"reason":sys.argv[2],"session":sys.argv[3]}))' "$msg" "$reason" "$sess")" \
    "$AMUX_API/api/alert/owner" | python3 -c "
import sys, json
raw = sys.stdin.read()
try: d = json.loads(raw)
except ValueError: sys.exit('amux server not responding')
if d.get('error'): sys.exit('alert failed: ' + str(d['error']))
if d.get('deduped'): print('(deduped — an identical alert fired <60s ago)'); sys.exit(0)
# STANDING APPROVAL (AMUX-5270): the owner already answered this ask, so the
# server did not page him. Checked BEFORE delivered_any, which is false here
# by design (nobody was paged) and must not read as a failed fire alarm.
sa = d.get('standing_approval') or {}
if sa.get('applied'):
    print('NOT PAGED: covered by standing approval %s. %s' % (sa.get('id'), sa.get('instruction', '')))
    sys.exit(0)
if sa.get('verdict') == 'standing_approval_cap_reached':
    sys.stderr.write('note: %s\n' % sa.get('instruction', ''))
ch = d.get('channels', {})
detail = ', '.join('%s: %s' % (k, v) for k, v in ch.items()) or '(no channels)'
# KEY OFF THE SERVER'S EXPLICIT VERDICT, never the presence of a channels map
# (AMUX-3151/GCA-96): leading with 'sent' + exit 0 on a zero-channel delivery is
# a lying fire alarm that swallowed real security escalations. delivered_any is
# authoritative; the string fallback only covers an older server that predates it.
delivered = d.get('delivered_any')
if delivered is None:
    delivered = any((str(v).lower() == 'sent') if k == 'push' else (str(v).lower() in ('twilio', 'imessage'))
                    for k, v in ch.items())
if not delivered:
    sys.stderr.write('ALERT FAILED — the owner was NOT paged (reached no channel): %s\n' % detail)
    fb = d.get('fallback') or 'no channel delivered — post to the board and say so in your turn output'
    sys.stderr.write(fb + '\n')
    sys.exit(3)
# PARTIAL IS NOT DELIVERED (AMUX-3619). The zero-channel case above has been
# handled since AMUX-3151; the case that was not is SOME channels failing, which
# printed a bare 'alert delivered' while push and SMS were both dead. Measured
# 2026-08-24 on a real disk escalation: 1 of 3 channels reached anything, and the
# line led with the word 'delivered'. The per-channel detail was always in the
# string; what was wrong is that the SUMMARY reported the best outcome instead of
# the worst, which is the one-output-two-states shape on the fire alarm itself.
failed = [k for k, v in ch.items() if str(v).lower().startswith(('error', 'failed', 'not '))]
# An UNPINNED destination is a delivery that may not have reached the OWNER: the
# server falls back to the freshest connected account, which can change without
# anyone touching alert config. Not a failure, and not a clean success either.
unpinned = [k for k, v in ch.items() if 'UNPINNED' in str(v)]
if failed:
    sys.stderr.write('ALERT ONLY PARTLY DELIVERED — %d of %d channel(s) FAILED (%s): %s\n'
                     % (len(failed), len(ch), ', '.join(failed), detail))
    if unpinned:
        sys.stderr.write('and %s has no pinned destination (set AMUX_OWNER_EMAIL) — it went to '
                         'whichever account connected most recently\n' % ', '.join(unpinned))
    sys.stderr.write('The owner may not have been reached. Say so in your turn output rather '
                     'than treating this as paged.\n')
    sys.exit(0)
if unpinned:
    sys.stderr.write('alert delivered, but %s has no pinned destination (set AMUX_OWNER_EMAIL)\n'
                     % ', '.join(unpinned))
print('alert delivered →', detail)
"
}

_approvals_usage() {
  cat <<USAGE
${BOLD}amux approvals${RESET}: standing approvals, asks the owner has already answered (AMUX-5270)

  amux approvals ls [--all] [--session <w>]   active approvals (resolved for <w>, default you)
  amux approvals add --stdin                  OWNER ONLY: create one from a JSON object on stdin
  amux approvals revoke <SA-n>                OWNER ONLY: revoke (kept on record, never erased)
  amux approvals uses [--limit N]             every ask an approval answered (the owner's FYI feed)
  amux approvals check "<ask text>"           would this ask be covered? records nothing

  JSON fields: title, allowed (plain sentence), category (budget|customer_outbound|prod_data|
  credential|access|decision), limits, max_per_day, max_amount_usd, require_terms (list),
  scope (global|group:<g>|worker:<w>), source, expires_at (unix seconds).

  An ask covered by one of these is already approved: act, then report on your card.
  Kill switch: AMUX_STANDING_APPROVALS=0 (worker > group > global).
USAGE
}

cmd_approvals() {
  local sub="${1:-ls}"; shift 2>/dev/null || true
  # Send the worker identity whenever there is one: the server refuses writes
  # from a worker, and omitting the header would let a lane approve itself.
  local me="${AMUX_WORKER:-${AMUX_SESSION:-}}"
  local -a who=()
  [[ -n "$me" ]] && who=(-H "X-Amux-Worker: $me")
  case "$sub" in
    ls|list)
      local q="" all="" sess="$me"
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --all)     all=1; shift ;;
          --session) sess="${2:-}"; shift 2 ;;
          *)         die "amux approvals ls: unknown argument '$1'" ;;
        esac
      done
      q="?session=$(printf '%s' "$sess" | python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.stdin.read()))')"
      [[ -n "$all" ]] && q="$q&all=1"
      _curl -sk ${who[@]+"${who[@]}"} "$AMUX_API/api/approvals/standing$q" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit("amux server not responding")
if "approvals" not in d:
    sys.exit("approvals: " + str(d.get("error") or d))
rows = d["approvals"]
scope = ("resolved for " + d["session"]) if d.get("session") else "all scopes"
print("%d standing approval(s), %s (%d recorded in total)%s" % (
    len(rows), scope, d.get("total_recorded", 0),
    "" if d.get("enabled", True) else " -- SWITCHED OFF for this lane (AMUX_STANDING_APPROVALS=0)"))
for a in rows:
    state = "" if a.get("active") else " [revoked/expired]"
    print("")
    print("%s  %s  [%s, %s]%s" % (a["id"], a["title"], a["category"], a["scope"], state))
    print("  allowed: " + a["allowed"])
    print("  limits:  " + a["limits_line"])
    if a.get("source"):
        print("  source:  " + a["source"])
'
      ;;
    add)
      [[ "${1:-}" == "--stdin" ]] || die "Usage: amux approvals add --stdin  (JSON object on stdin)"
      local body; body="$(cat)"
      printf '%s' "$body" | python3 -c 'import json,sys; json.load(sys.stdin)' 2>/dev/null \
        || die "amux approvals add: stdin is not a JSON object"
      printf '%s' "$body" | _curl -sk -X POST -H 'Content-Type: application/json' ${who[@]+"${who[@]}"} \
          -d @- "$AMUX_API/api/approvals/standing" | python3 -c '
import json, sys
d = json.load(sys.stdin)
if not d.get("ok"):
    sys.exit("approvals add REFUSED: %s%s" % (d.get("error"), (" -- " + d["how"]) if d.get("how") else ""))
a = d["approval"]
print("created %s: %s [%s, %s] limits: %s" % (a["id"], a["title"], a["category"], a["scope"], a["limits_line"]))
'
      ;;
    revoke|rm)
      local id="${1:-}"
      [[ -n "$id" ]] || die "Usage: amux approvals revoke <SA-n>"
      _curl -sk -X DELETE ${who[@]+"${who[@]}"} "$AMUX_API/api/approvals/standing/$id" | python3 -c '
import json, sys
d = json.load(sys.stdin)
if not d.get("ok"):
    sys.exit("approvals revoke REFUSED: " + str(d.get("error")))
print("revoked " + d["approval"]["id"])
'
      ;;
    uses|fyi)
      local limit=20
      [[ "${1:-}" == "--limit" ]] && limit="${2:-20}"
      _curl -sk "$AMUX_API/api/approvals/standing/uses?limit=$limit" | python3 -c '
import json, sys, time
d = json.load(sys.stdin)
print("%d of %d use(s)" % (d.get("shown", 0), d.get("total", 0)))
for u in d.get("uses", []):
    t = time.strftime("%Y-%m-%d %H:%M", time.localtime(u["ts"]))
    print("%s  %s %-11s %-8s %s: %s" % (t, u["approval"], u["verdict"], u["door"], u["session"] or "-", u["ask"][:120]))
'
      ;;
    check)
      local text="${1:-}"
      [[ -n "$text" ]] || die "Usage: amux approvals check \"<ask text>\""
      TEXT="$text" SESS="$me" python3 -c 'import json,os; print(json.dumps({"text": os.environ["TEXT"], "session": os.environ["SESS"]}))' \
        | _curl -sk -X POST -H 'Content-Type: application/json' -d @- "$AMUX_API/api/approvals/standing/check" \
        | python3 -c '
import json, sys
d = json.load(sys.stdin).get("standing_approval", {})
print(("COVERED by %s: " % d.get("id")) + d.get("instruction", "") if d.get("applied")
      else "not covered (%s): %s" % (d.get("verdict"), d.get("reason") or d.get("instruction", "")))
'
      ;;
    help|--help|-h) _approvals_usage ;;
    *) _approvals_usage; return 1 ;;
  esac
}

# Read-only API access (AMUX-5432): GET only, so a chat delegate's allowlist
# can permit it without permitting any change. `amux get api/email/inbox?count=5`
cmd_get() {
  local path="${1:-}"
  [[ -n "$path" ]] || die "usage: amux get <api path>   (GET only, e.g. api/email/inbox?count=5)"
  path="${path#/}"
  [[ "$path" == api/* || "$path" == health* ]] || path="api/$path"
  local AMUX_API="${AMUX_API:-$(cmd_url)}"
  _curl -sk -m 60 -H "X-Amux-Session: ${AMUX_SESSION:-}" "$AMUX_API/$path" || die "server unreachable"
  echo
}

# A worker's Chat asks a read-only background job on the worker's own agent
# (AMUX-5432, docs/design/chat-delegate.md). It never touches the live worker.
#   amux delegate-job run [--worker W] [--mode auto|fork|fresh] [--wait S] (--stdin | --prompt TEXT)
#   amux delegate-job status <job-id>
#   amux delegate-job ls [W]
cmd_delegate_job() {
  local sub="${1:-}"; shift || true
  local AMUX_API="${AMUX_API:-$(cmd_url)}"
  case "$sub" in
    run)
      local worker="" mode="auto" wait=120 prompt="" from_stdin=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --worker|-w) worker="${2:-}"; shift 2 ;;
          --mode) mode="${2:-auto}"; shift 2 ;;
          --wait) wait="${2:-120}"; shift 2 ;;
          --prompt|-p) prompt="${2:-}"; shift 2 ;;
          --stdin) from_stdin=1; shift ;;
          *) die "unknown option: $1" ;;
        esac
      done
      [[ "$from_stdin" == 1 ]] && prompt="$(cat)"
      [[ -n "$prompt" ]] || die "the question is empty (use --stdin or --prompt)"
      [[ -n "$worker" ]] || worker="${AMUX_SESSION%@chat}"
      local body resp id
      body=$(WORKER="$worker" MODE="$mode" WAIT="$wait" PROMPT="$prompt" python3 -c '
import json, os
print(json.dumps({"worker": os.environ["WORKER"], "mode": os.environ["MODE"],
                  "wait_s": float(os.environ["WAIT"] or 0), "prompt": os.environ["PROMPT"]}))')
      resp=$(_curl -sk -m 30 -X POST -H 'Content-Type: application/json' \
        -H "X-Amux-Session: ${AMUX_SESSION:-}" -d "$body" "$AMUX_API/api/chat-delegate") || die "server unreachable"
      id=$(printf '%s' "$resp" | python3 -c 'import json,sys
d=json.load(sys.stdin)
if not d.get("ok"): sys.stderr.write("refused: "+str(d.get("error"))+"\n"); sys.exit(1)
print(d["job"]["id"])') || exit 1
      local deadline=$(( $(date +%s) + ${wait%.*} )) job
      while :; do
        job=$(_curl -sk -m 20 -H "X-Amux-Session: ${AMUX_SESSION:-}" "$AMUX_API/api/chat-delegate/$id?consume=1") || job=""
        if printf '%s' "$job" | python3 -c 'import json,sys; sys.exit(0 if json.load(sys.stdin).get("status")=="done" else 1)' 2>/dev/null; then
          printf '%s' "$job" | python3 -c 'import json,sys
d=json.load(sys.stdin)
print(d.get("record",""))
print()
print(d.get("result",""))'
          return 0
        fi
        if (( $(date +%s) >= deadline )); then
          echo "job $id is still running. Its answer will be posted into this chat when it finishes."
          return 0
        fi
        sleep 2
      done ;;
    status)
      [[ -n "${1:-}" ]] || die "usage: amux delegate-job status <job-id>"
      _curl -sk -m 20 "$AMUX_API/api/chat-delegate/$1" || die "server unreachable"; echo ;;
    ls|list)
      local w="${1:-${AMUX_SESSION%@chat}}"
      _curl -sk -m 20 "$AMUX_API/api/chat-delegate?worker=$w" | python3 -c 'import json,sys
for j in json.load(sys.stdin).get("jobs", []):
    print(j.get("id"), j.get("status"), j.get("outcome",""), j.get("provider"), j.get("mode"), (j.get("prompt") or "")[:60])' ;;
    *) die "usage: amux delegate-job run|status|ls" ;;
  esac
}

cmd_whoami() {
  # Live identity vs inherited env (MG audit #8 / AMUX-2203): $AMUX_SESSION is
  # per-process and inherited from whoever launched the pane; `claude --resume`
  # in another pane moves a conversation between sessions silently, and a
  # session once disowned its own card by trusting conversation history over
  # the live binding. The tmux pane is the ground truth when present.
  local env_id="${AMUX_SESSION:-}"
  local live_id=""
  if [[ -n "${TMUX:-}" ]]; then
    live_id=$(_own_pane_session)
    live_id="${live_id#amux-}"
  fi
  echo "env  AMUX_SESSION : ${env_id:-'(unset)'}"
  if [[ -n "$live_id" ]]; then
    echo "live tmux pane   : $live_id"
    if [[ -n "$env_id" && "$env_id" != "$live_id" ]]; then
      echo ""
      echo "⚠ MISMATCH: this process INHERITED '$env_id' but is RUNNING in '$live_id'."
      echo "  Board writes, sends and commits will be attributed to '$env_id'."
      echo "  The live pane is the ground truth — a resumed transcript carries its"
      echo "  old identity. Export AMUX_SESSION='$live_id' if this pane is home."
      return 1
    fi
    echo "match: identity is consistent"
  else
    echo "live tmux pane   : (not inside tmux — env is all we have; treat with care)"
  fi
  return 0
}

# amux url — print the canonical amux API base, resolved from the server-written
# ~/.amux/endpoint.json so it self-heals past a STALE $AMUX_URL. AMUX-3046: a lane
# started before a port move carries the retired address in its PROCESS env for
# life (env can't be re-read live), so `curl $AMUX_URL/...` fails at connect and
# reads as "server down". Scripts should use `$(amux url)` in place of $AMUX_URL —
# it survives the NEXT port move too, unlike hardcoding :8824 in every caller.
#
# DEFAULT is a PURE FILE READ (no HTTP probe): probing per-call across ~48 lanes
# would flood the server to ask where the server is. `--verify` opts into a probe.
# amux fresh <session> — recycle a worker's CONVERSATION, keep the worker.
#
# Why this exists (AMUX-3742). A lane resumes the same Claude conversation
# forever, so it accumulates compaction generations. Measured 2026-08-26 over
# every transcript active since 08-05: amux lanes median 8, max 215; a raw
# terminal sits at 0. Same model, same effort, same first-turn token baseline —
# the difference is that the lane answers from a summary of a summary while a
# fresh terminal reads primary sources. That is the whole "raw claude performs
# better than amux claude" report.
#
# The remedy lived in the server the whole time and reached nobody: the
# dashboard rendered "New conversation" only on a STOPPED worker, and the API
# answered 409 while running. Every live lane is running, so on all 50 of them
# the one control that fixes this was hidden AND refused.
#
# The worker survives untouched: env, board cards, memory, groups, name, tags.
# Only the conversation starts over. Deliberately never automatic — the
# conversation is the lane's accumulated work and discarding it is the owner's
# call (ethos rule 8).
cmd_fresh() {
  local yes=0 name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -y|--yes) yes=1; shift ;;
      *)        name="$1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || die "usage: amux fresh <session> [-y]"
  name=$(resolve_session "$name") || return 1

  local api="${AMUX_API:-$(cmd_url)}"
  # State the cost before paying it. The generation count is what makes this a
  # decision instead of a guess, so it is fetched even when -y skips the prompt.
  local gens
  gens=$(_curl -sk "$api/api/debug/context-health" 2>/dev/null | N="$name" python3 -c "
import json,os,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
for l in d.get('lanes',[]):
    if l.get('session')==os.environ['N']:
        print(l.get('generations') if l.get('measured') else 'unmeasured')
        break
")
  echo "${BOLD}$name${RESET} — conversation has been compacted ${BOLD}${gens:-?}${RESET} time(s)."
  echo "${DIM}The worker keeps its env, board cards, memory and groups. Only the conversation restarts.${RESET}"
  if [[ "$yes" -ne 1 ]]; then
    if [[ ! -t 0 ]]; then
      die "not a terminal — re-run with -y to confirm discarding this conversation"
    fi
    printf "Discard it and restart on a fresh conversation? [y/N] "
    local reply; read -r reply
    [[ "$reply" == "y" || "$reply" == "Y" ]] || { echo "${DIM}unchanged${RESET}"; return 0; }
  fi

  local resp rc=0
  resp=$(_curl -sk -X PATCH -H 'Content-Type: application/json' \
    -H "X-Amux-Session: ${AMUX_SESSION:-}" \
    -d '{"new_conversation":true,"restart":true}' \
    "$api/api/sessions/$name/config" 2>/dev/null) || rc=$?
  [[ "$rc" -eq 0 ]] || die "cannot reach the amux server at $api (curl exit $rc) — NOTHING was changed"
  # Read the BODY, never the exit code: a 409 is a perfectly successful curl.
  echo "$resp" | python3 -c "
import json,sys
raw=sys.stdin.read()
try: d=json.loads(raw)
except Exception: sys.exit('unexpected response: '+raw[:200])
if d.get('error'):
    msg=d['error']
    if d.get('escape'): msg += chr(10)+'  try: '+d['escape']
    sys.exit(msg)
print(d.get('message','ok') + (' (was %s generations deep)' % d['generations'] if d.get('generations') is not None else ''))
"
}

cmd_url() {
  local literal="https://localhost:8824"   # last-resort floor; appended, never an else-branch
  local retired_floor="8822"                # only consulted when endpoint.json is unreadable
  local ep="$CC_HOME/endpoint.json"
  local resolved="" src=""

  # 1. endpoint.json is authoritative and self-updating (the server rewrites it
  #    every boot with canonical_url + retired_ports). Canonical WINS; a stale
  #    env is ignored whenever the file is present.
  if [ -r "$ep" ]; then
    resolved=$(sed -n 's/.*"canonical_url"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$ep" | head -1)
    [ -n "$resolved" ] && src="endpoint.json:$ep"
  fi

  # 2. File missing/garbled: trust $AMUX_URL only if its port is not the retired
  #    floor (without the file we cannot read retired_ports).
  if [ -z "$resolved" ] && [ -n "${AMUX_URL:-}" ]; then
    local port="${AMUX_URL##*:}"; port="${port%%/*}"
    case " $retired_floor " in
      *" $port "*) : ;;                     # retired -> fall through to the literal
      *) resolved="$AMUX_URL"; src="env" ;;
    esac
  fi

  # 3. Unconditional literal — a conditional fallback is not a fallback: it would
  #    remove the only working candidate exactly when file+env both fail.
  [ -z "$resolved" ] && { resolved="$literal"; src="literal"; }

  printf '%s\n' "$resolved"

  if [ "${1:-}" = "--verify" ]; then
    # A dead port returns an EMPTY body, not a connection refusal, so liveness
    # asserts the /health body looks like an amux server — not merely that the
    # socket answered (something else may have grabbed the port).
    if _curl -sk -m 3 "$resolved/health" 2>/dev/null | grep -q '"server"'; then
      printf 'amux url: %s (via %s) — /health responds as an amux server\n' "$resolved" "$src" >&2
      return 0
    fi
    printf 'amux url: %s (via %s) — WARNING: /health did not respond as an amux server (dead/wrong port?)\n' "$resolved" "$src" >&2
    return 1
  fi
  return 0
}

# ── grid ─────────────────────────────────────────────────────────────────────
# Tile N worker terminals across a display. The whole implementation lives in
# scripts/amux-grid.sh; this is a thin exec so that a macOS/AppleScript feature
# cannot add surface area to the CLI every lane runs on Linux too.
#
# `~/.local/bin/amux` is a SYMLINK into the repo, so resolve the link before
# looking for a sibling script: dirname of the symlink is ~/.local/bin, where
# scripts/ does not exist.
cmd_grid() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    local target; target="$(readlink "$src")"
    case "$target" in
      /*) src="$target" ;;
      *)  src="$(dirname -- "$src")/$target" ;;
    esac
  done
  dir="$(cd -- "$(dirname -- "$src")" && pwd)"
  local sh="$dir/scripts/amux-grid.sh"
  [ -x "$sh" ] || { echo "amux grid: missing $sh" >&2; return 1; }
  "$sh" "$@"
}

# ── Main dispatch ────────────────────────────────────────────────────────────
#
# Source guard: when this script is run normally as `amux ...`, BASH_SOURCE[0]
# equals $0 and the dispatch block runs. When sourced (e.g. from tests via
# `source amux`), $0 is the parent shell's $0 and the guard skips dispatch.
# This lets the test suite source the script to access helper functions
# without triggering CLI side effects.
#
# AF-928. That last sentence used to be false: this guard correctly skipped
# the dispatch `case`, but the file's tail (further down, unconditional
# `exit "$?"` right before the closing `}`) still ran either way, and `exit`
# terminates the CURRENT SHELL regardless of how execution got there — there
# is no bash mechanism that makes it behave like `return` just because the
# file was sourced. So `source amux` killed the sourcing shell before any
# code after the `source` line ever ran. No existing test exercised the
# pattern (grepped for `source amux`: zero hits), which is how a comment can
# describe a capability nothing had tried to use.
#
# THE FIX IS AN EARLY, INVERTED CHECK — placed further down, right before
# dispatch begins, AFTER every function in this file (including
# _warn_stale_amux_url below) is defined — not a change to the tail. Moving
# the tail's `exit "$?"` inside the `then` block was the obvious first
# attempt and it reddens test-cli-offset-safe.sh: that test requires the
# file's literal last two non-blank lines to be `exit "$?"` then `}`, at
# column 0, so bash always parses to the closing `}` before running anything
# (AMUX-3891 — a live-edited, constantly-invoked symlinked CLI can otherwise
# resume a read at a shifted byte offset). That invariant is real and left
# untouched. Instead: when sourced, `return` before dispatch OR the tail's
# `exit` are ever reached — `return` at the top level of a sourced file is
# exactly what bash provides for this, and it is unreachable dead code (never
# evaluated) on the direct-invocation path, where that condition is false.
# One-time-per-session warning when $AMUX_URL points at a DEAD port (mvs-infra,
# AMUX-2944). A session started before the 8822 compat bind was removed carries
# the retired value for its whole life — env can't be re-read live — and a raw
# `curl $AMUX_URL/...` PATCH then exits 0 with an EMPTY body, indistinguishable
# from a successful write (mvs-infra silently lost a board PATCH this way). This
# CLI is fine (it resolves AMUX_API=8824); the warning is so the SESSION stops
# trusting $AMUX_URL for raw curls and repairs its own shell. Cheap: one 2s probe
# gated by a per-session marker. ALWAYS returns 0 — a hot path 48 lanes run must
# never break because a diagnostic failed.
_warn_stale_amux_url() {
  local api="${AMUX_API:-https://localhost:8824}"
  local url="${AMUX_URL:-}"
  if [ -z "$url" ] || [ "$url" = "$api" ]; then return 0; fi
  local marker="${TMPDIR:-/tmp}/amux-url-warn-${AMUX_SESSION:-unknown}"
  if [ -f "$marker" ]; then return 0; fi
  if _curl -sk -m 2 -o /dev/null "$url/health" 2>/dev/null; then return 0; fi
  touch "$marker" 2>/dev/null || true
  {
    echo "amux: WARNING — \$AMUX_URL ($url) does not answer; this CLI is fine (it uses $api)."
    echo "  But raw 'curl \$AMUX_URL/...' will SILENTLY FAIL — exit 0, empty body, looks exactly like a successful write."
    echo "  Repair your shell for raw curls:  export AMUX_URL=$api"
  } >&2
  return 0
}

# ── Named clearance signals (AMUX-5237) ─────────────────────────────────────
#
# A card waits on a NAMED signal instead of a peer's pane: gs-3-bucket-objects
# regex-polled mvs-infra's peek for "clearance" and got a false positive, and
# mixpeek-frustrations held ~145 cards on an approval already given in prose.
#   amux signal wait <CARD> <name>       park YOUR card (blocked_on=signal:<name>)
#   amux signal raise <name> --note ...  record it, clear every wait, wake lanes
#   amux signal ls | show <name>         history and current waiters
_signal_usage() {
  cat <<USAGE
${BOLD}amux signal${RESET} — wait on, or raise, a named clearance signal

  amux signal wait <CARD> <name>              park YOUR card until <name> is raised
  amux signal raise <name> [--note <text>]    raise it: clears every waiting card,
                                              wakes each owning lane with the note
  amux signal raise <name> --note-stdin       note read from stdin
  amux signal show <name>                     raises of <name> and cards waiting on it
  amux signal ls                              recent raises and all live waits

  Names: 1-64 chars of [a-z0-9._-]. The wait is stored as blocked_on="signal:<name>",
  so dispatch skips the card until the raise clears it. You may wait only on your own
  card. Use a signal for an event another actor produces (a clearance, an approval),
  not for work you could do yourself.
USAGE
}

# _land_status: the queue as land will serve it, the holder, and an estimate.
# MO-4104: refuse a doomed ticket at enqueue, in seconds, instead of at the
# head of the queue after a full gate run that sends a whole batch back. The
# repo supplies the check: $AMUX_LAND_PRECHECK, else an executable
# .githooks/land-precheck in the checkout. It is called as
# `<check> <base> <tip>` (base = the remote branch) and a non-zero exit refuses
# the ticket with the check's own output. Measured 2026-10-01: 7 of the 10
# refusals whose log named the leg were commit-body or render guards that take
# seconds, and each cost a batch a full gate (mixpeek-override, MO-4104). A
# check that times out (AMUX_LAND_PRECHECK_TIMEOUT_S, default 180) or cannot
# run is logged as unmeasured and the ticket queues: the gate still runs.
_land_precheck() {
  local remote="$1" branch="$2" tip="$3" me="$4" log="$5" chk top out rc t0 full budget="${AMUX_LAND_PRECHECK_TIMEOUT_S:-900}"
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  git fetch -q "$remote" "$branch" 2>/dev/null || true
  local _pc_chk _pc_tmp
  _land_precheck_resolve "$remote/$branch"
  chk="$_pc_chk"
  [ -n "$chk" ] || return 0
  git rev-parse -q --verify "$remote/$branch^{commit}" >/dev/null 2>&1 || {
    printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "enqueue precheck unmeasured: no $remote/$branch" >> "$log"; return 0; }
  # The base is pinned to a SHA once, here, and that SHA is what the check
  # gets: on 2026-10-04 22:05Z gs12-spend's precheck was handed the ref name,
  # read a base from 2026-09-19 (ef8e6a6c10a) while the ref was briefly wrong,
  # swept 4,165 published commits and refused on them; a minute later the same
  # merge-base was correct. An implausibly long range is reported unmeasured,
  # never refused, so no lane is told to rewrite published history.
  local _pc_base _pc_tip _pc_n
  _pc_base="$(git rev-parse -q --verify "$remote/$branch^{commit}" 2>/dev/null)"
  _pc_tip="$(git rev-parse "$tip")"
  _pc_n="$(git rev-list --count "$_pc_base..$_pc_tip" 2>/dev/null || echo 0)"
  if [ "${_pc_n:-0}" -gt "${AMUX_LAND_PRECHECK_MAX_RANGE:-300}" ]; then
    printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "WARN enqueue precheck unmeasured: the range $(git rev-parse --short "$_pc_base")..$(git rev-parse --short "$_pc_tip") is $_pc_n commits (over ${AMUX_LAND_PRECHECK_MAX_RANGE:-300}); the base is suspect, so nothing is refused on it and the gate still runs" >> "$log"
    return 0
  fi
  t0=$(date +%s); rc=0
  out="$(cd "$top" && AMUX_LAND_PRECHECK_TIMEOUT_S="$budget" AMUX_LAND_PRECHECK_MODE="enqueue" perl -e "$_LAND_PC_TIMEOUT_PL" "$budget" $chk "$_pc_base" "$_pc_tip" 2>&1)" || rc=$?
  [ -n "$_pc_tmp" ] && rm -rf -- "${_pc_tmp:?}"
  full="$HOME/.amux/logs/land/$(date -u +%Y%m%dT%H%M%SZ)-$me-$$-precheck.log"
  mkdir -p "${full%/*}"; printf '%s\n' "$out" > "$full"
  case "$(_land_precheck_verdict "$rc" "$out")" in
    pass) printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "enqueue precheck passed in $(( $(date +%s) - t0 ))s (rc $rc)" >> "$log"; return 0 ;;
    unmeasured)
      printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "enqueue precheck unmeasured (rc $rc after $(( $(date +%s) - t0 ))s: timed out, killed or could not run, no verdict in its output); queued anyway, the gate still runs every leg. Output: $full" >> "$log"; return 0 ;;
  esac
  printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "enqueue precheck refused (rc $rc, $(( $(date +%s) - t0 ))s); not queued. Output: $full" >> "$log"
  printf '%s\n' "$out" | tail -30 >&2
  local _fx; _fx="$(_land_inflight_fixes "$remote" "$branch" "$out" "$me")"
  if [ -n "$_fx" ]; then
    printf '%s\n' "$_fx" | sed 's/^/amux land: already being fixed: /' >&2
    printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "precheck refusal names a file a queued ticket already changes: $(printf '%s' "$_fx" | tr '\n' ';')" >> "$log"
  fi
  echo "amux land: refused before queueing: the repository's land precheck failed on this range (full output $full). Fix the commits and run amux land again." >&2
  return 1
}

# _land_inflight_fixes <remote> <branch> <refusal text> <me>: queued tickets
# (other lanes) whose commits change a file the refusal names, one line each.
# On 2026-10-04 four lanes each wrote the same one-line marker fix for a test
# the precheck refused, because each saw only its own refusal.
_land_inflight_fixes() {
  local remote="$1" branch="$2" text="$3" me="$4" key q tk who sha f base
  key="$(printf '%s %s' "$(git remote get-url "$remote" 2>/dev/null)" "$branch" | shasum | cut -c1-16)"
  q="$HOME/.amux/locks/land-$key.q"
  [ -d "$q" ] || return 0
  for tk in $(ls "$q" 2>/dev/null | sort); do
    { read -r who; read -r sha; } < "$q/$tk" 2>/dev/null || continue
    [ -n "$sha" ] && [ "$who" != "$me" ] || continue
    base="$(git merge-base "$remote/$branch" "$sha" 2>/dev/null)" || continue
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      printf '%s' "$text" | grep -qF -- "$f" && { echo "$who's queued ticket $tk changes $f"; break; }
    done <<< "$(git diff --name-only "$base" "$sha" 2>/dev/null)"
  done
}

# Wall-clock bound for the land precheck. `alarm; exec` signalled only the
# check's own pid, while `$(...)` waited for every child still holding the
# pipe, so a 420 s budget ran 21 min at load 54 (2026-10-02 13:09-13:30Z,
# gs12-gates' composed batch of 15). The check now runs in its own process
# group, and on timeout the WHOLE group gets TERM then KILL, so the capture
# returns. Exit status: the check's own, 128+signal, or 142 on timeout.
_LAND_PC_TIMEOUT_PL='my $t = shift; my $pid = fork;
die "fork: $!" unless defined $pid;
if (!$pid) { setpgrp(0, 0); exec @ARGV or exit 127 }
$SIG{ALRM} = sub { kill "TERM", -$pid; sleep 3; kill "KILL", -$pid; waitpid($pid, 0); exit 142 };
alarm $t; waitpid($pid, 0); alarm 0;
exit(($? & 127) ? 128 + ($? & 127) : ($? >> 8));'

# _land_precheck_resolve <remote/branch>: sets _pc_chk (command to run) and
# _pc_tmp (a private dir to remove afterwards, or ""). Order: $AMUX_LAND_PRECHECK,
# then the remote branch's COMMITTED .githooks (extracted whole, so the script's
# sibling files resolve), then the checkout's own copy. A lane whose branch
# predates the precheck had no file in its worktree, so the composed-batch check
# silently never ran on two refused six-lane batches (2026-10-02 08:48Z, 09:17Z).
_land_precheck_resolve() {
  local ref="$1" top
  _pc_chk="${AMUX_LAND_PRECHECK:-}"; _pc_tmp=""
  [ -n "$_pc_chk" ] && return 0
  top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if git cat-file -e "$ref:.githooks/land-precheck" 2>/dev/null; then
    _pc_tmp="$(mktemp -d "${TMPDIR:-/tmp}/amux-precheck.XXXXXX")"
    if git archive "$ref" .githooks 2>/dev/null | tar -x -C "$_pc_tmp" 2>/dev/null && [ -f "$_pc_tmp/.githooks/land-precheck" ]; then
      chmod +x "$_pc_tmp/.githooks/land-precheck"
      _pc_chk="$_pc_tmp/.githooks/land-precheck"; return 0
    fi
    rm -rf -- "${_pc_tmp:?}"; _pc_tmp=""
  fi
  [ -n "$top" ] && [ -x "$top/.githooks/land-precheck" ] && _pc_chk="$top/.githooks/land-precheck"
  return 0
}

# _land_precheck_verdict <rc> <output>: pass | refuse | unmeasured.
# The alarm that bounds the check survives its exec, so it covers the check's
# cleanup too: at load 30-40 the legs finished, the verdict was printed, and
# SIGALRM (rc 142) still landed, so a pass AND a refusal both read as
# unmeasured and the refused range queued (gs12-templates, 2026-10-02 08:48Z
# and 08:55Z). On a timeout the OUTPUT decides: a failure line is a refusal,
# the check's own "land-precheck: ... passed" line is a pass, anything else is
# unmeasured.
_land_precheck_verdict() {
  local rc="$1" out="$2"
  # Any death by a signal (rc > 128: 142 our alarm, 143 SIGTERM, 137 SIGKILL)
  # or by timeout(1) (124) is a check that did not finish, not a refusal:
  # gs12-spend's precheck was SIGTERMed mid-leg at 237 s and read as refused,
  # so the lane could not queue at all (mixpeek-override, 2026-10-02 09:05Z).
  local killed=0
  case "$rc" in 124|126|127) killed=1 ;; *) [ "$rc" -gt 128 ] 2>/dev/null && killed=1 ;; esac
  case "$rc" in
    0) if printf '%s\n' "$out" | grep -qiE '^land-precheck: .*nothing checked'; then echo unmeasured; else echo pass; fi; return ;;
  esac
  if [ "$killed" = 1 ]; then
      # UNMEASURED before "passed": the check's own kill line reads "UNMEASURED:
      # stopped by SIGTERM after 419s ... (the legs before it passed)", and the
      # pass test matched it, so killed checks were logged as passes and their
      # batches went to a 35-minute gate (gs12-retrievers 18:23Z, 2026-10-02).
      if printf '%s\n' "$out" | grep -qE '✗|(^|[^A-Za-z])FAIL|REFUSED'; then echo refuse
      elif printf '%s\n' "$out" | grep -qE '^land-precheck: .*UNMEASURED'; then echo unmeasured
      elif printf '%s\n' "$out" | grep -qE '^land-precheck: .*passed'; then echo pass
      else echo unmeasured; fi
      return
  fi
  echo refuse
}

# The check is told its budget in AMUX_LAND_PRECHECK_TIMEOUT_S (always set,
# default 420), so a script with its own internal limit can align with it.
# _land_precheck_exec <base> <tip>: run the repository's land precheck in
# BATCH mode (AMUX_LAND_PRECHECK_MODE=batch: judge only, write nothing) and
# print its output. rc 0 pass, 1 refused, 2 no check or unmeasured.
_land_precheck_exec() {
  local top chk out rc=0 budget="${AMUX_LAND_PRECHECK_TIMEOUT_S:-900}"
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 2
  local _pc_chk _pc_tmp
  _land_precheck_resolve "$1"
  chk="$_pc_chk"
  [ -n "$chk" ] || { printf 'land-precheck: none found in %s or this checkout\n' "$1"; return 2; }
  out="$(cd "$top" && AMUX_LAND_PRECHECK_TIMEOUT_S="$budget" AMUX_LAND_PRECHECK_MODE="batch" perl -e "$_LAND_PC_TIMEOUT_PL" "$budget" $chk "$1" "$(git rev-parse "$2")" 2>&1)" || rc=$?
  [ -n "$_pc_tmp" ] && rm -rf -- "${_pc_tmp:?}"
  printf '%s\n' "$out"
  printf '%s\n' "$rc" > "${TMPDIR:-/tmp}/amux-precheck-rc.$$"
  case "$(_land_precheck_verdict "$rc" "$out")" in pass) return 0 ;; unmeasured) return 2 ;; *) return 1 ;; esac
}

# _land_pick_tree <onto> <commit>: the tree of CHERRY-PICKING <commit> onto
# <onto>, on stdout; rc 1 on a conflict. `git merge-tree --write-tree onto c`
# merges against their natural merge base, which for the second and later
# commits of a replayed series re-applies the earlier originals over their
# replayed copies and reports conflicts a rebase never sees (gs12-model,
# 2026-10-02: 25 commits that `git rebase origin/main` applied cleanly were
# refused at 9c2921edd78). git 2.39 has no --merge-base, so the base is forced
# with a throwaway commit: <onto>'s tree on <commit>'s parent, whose merge base
# with <commit> is exactly that parent.
_land_pick_tree() {
  local onto="$1" c="$2" parent syn out rc=0
  if parent="$(git rev-parse -q --verify "$c^" 2>/dev/null)"; then
    syn="$(git commit-tree "$(git rev-parse "$onto^{tree}")" -p "$parent" -m "amux land pick base" 2>/dev/null)" || return 1
  else
    syn="$onto"
  fi
  out="$(git merge-tree --write-tree --name-only "$syn" "$c" 2>/dev/null)" || rc=$?
  if [ "$rc" = 1 ] && [ -n "$parent" ]; then
    # REGENERABLE PATHS (gs12-data, 2026-10-02: three stops on zero-base's
    # generated files whose only difference was the "# source-digest:" line).
    # When every conflicted path matches a repo-declared glob
    # (`git config --add amux.landRegenerable <glob>`), drop the commit's own
    # change to those paths, keep the onto side, and replay the rest; the
    # repository's push hook re-renders them from the pushed tree.
    local globs paths p g ok=1 idx tree2 c2
    globs="$(git config --get-all amux.landRegenerable 2>/dev/null || true)"
    paths="$(printf '%s\n' "$out" | sed -n '2,/^$/p' | sed '/^$/d')"
    if [ -n "$globs" ] && [ -n "$paths" ]; then
      while read -r p; do
        local hit=0
        # shellcheck disable=SC2053  # $g is a glob on purpose
        while read -r g; do [ -n "$g" ] && [[ "$p" == $g ]] && { hit=1; break; }; done <<< "$globs"
        [ "$hit" = 1 ] || { ok=0; break; }
      done <<< "$paths"
      if [ "$ok" = 1 ]; then
        idx="$(mktemp "${TMPDIR:-/tmp}/amux-land-idx.XXXXXX")"
        if GIT_INDEX_FILE="$idx" git read-tree "$c" 2>/dev/null; then
          while read -r p; do
            if git cat-file -e "$parent:$p" 2>/dev/null; then
              GIT_INDEX_FILE="$idx" git update-index --cacheinfo "$(git ls-tree "$parent" -- "$p" | awk '{print $1","$3}'),$p" 2>/dev/null || ok=0
            else
              GIT_INDEX_FILE="$idx" git update-index --force-remove -- "$p" 2>/dev/null || ok=0
            fi
          done <<< "$paths"
          tree2="$(GIT_INDEX_FILE="$idx" git write-tree 2>/dev/null || true)"
        else
          ok=0
        fi
        rm -f -- "${idx:?}"
        if [ "$ok" = 1 ] && [ -n "$tree2" ] && c2="$(git commit-tree "$tree2" -p "$parent" -m "amux land: $c without regenerable paths" 2>/dev/null)"; then
          rc=0; out="$(git merge-tree --write-tree --name-only "$syn" "$c2" 2>/dev/null)" || rc=$?
          if [ "$rc" = 0 ]; then
            printf '%s %s %s\n' "$(date -u +%FT%TZ)" "${AMUX_WORKER:-${AMUX_SESSION:-$(whoami)}}" \
              "regenerable conflict in $(git rev-parse --short "$c") resolved to the onto side for: $(printf '%s ' $paths)(the push hook must re-render them)" >> "$HOME/.amux/logs/land.log"
            # Tell the holder this attempt kept main's copy of generated
            # files, so _land_regenerate re-renders them before the push.
            # $$ is the land process's pid inside this command substitution.
            : > "${TMPDIR:-/tmp}/amux-land-regen.$$"
          fi
        fi
      fi
    fi
  fi
  [ "$rc" = 0 ] || return 1
  printf '%s\n' "${out%%$'\n'*}"
}

# _land_regenerate <tip>: re-render repo-declared regenerable paths on <tip>
# and print the commit to push (a new one on top of <tip>, or <tip> itself).
# rc 1 when the command fails: a push would carry a stale render.
#
# gs12-data, 2026-10-02: a regenerable replay keeps main's copy of generated
# files, but the lane's range changed one of their INPUTS (poetry.lock feeds
# zero-base's digest), so the push carried a stale render and the hook refused
# it, four times in one day. The repository declares the command and the input
# paths it reads:
#   git config amux.landRegenerate '"$AMUX_LAND_REPO"/server/.venv/bin/python research/cicd/zero-base/zb/generate.py'
#   git config --add amux.landRegenerateInput research/cicd/zero-base
#   git config --add amux.landRegenerateInput server/poetry.lock
# The command runs in a scratch extract of <tip> holding only the inputs (the
# whole Mixpeek tree is 4.2 GB; zero-base's inputs are 33 MB), with
# AMUX_LAND_REPO set to this checkout for its venv, under
# AMUX_LAND_REGENERATE_TIMEOUT_S (default 300). Files it leaves that match an
# amux.landRegenerable glob replace <tip>'s copies; matching files it removed
# are deleted.
# _land_regen_extract <tip> <inputs>: print a directory holding exactly what
# `git archive <tip> -- <inputs>` would extract, kept between lands so only
# changed files are written. The directory has no .git (generators see a plain
# tree, as with a fresh extract); its index lives beside it, and git's own stat
# check proves it clean. rc 1 means use a fresh extract. Runs under the land
# lock, which is per repo and branch and keys the directory.
_land_regen_extract() {
  local tip="$1" inputs="$2" key dir idx fidx tidx T
  [ "${AMUX_LAND_REGEN_REUSE:-1}" = 1 ] || return 1
  [ -n "$inputs" ] || return 1
  key="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null | git hash-object --stdin | cut -c1-12)" || return 1
  dir="${AMUX_LAND_REGEN_ROOT:-$HOME/.amux/land-regen}/$key-$(printf '%s' "${branch:-main}" | tr '/' '_')"
  idx="$dir.index"
  mkdir -p "$dir" || return 1
  # The tree a fresh extract would hold: the tip's entries under the inputs,
  # submodules excluded (an archive never extracts them).
  fidx="$(mktemp "${TMPDIR:-/tmp}/amux-land-regen-f.XXXXXX")"; tidx="$fidx.t"; rm -f -- "${fidx:?}"
  # shellcheck disable=SC2086  # one pathspec per line on purpose
  T="$(GIT_INDEX_FILE="$fidx" git read-tree "$tip" 2>/dev/null \
    && GIT_INDEX_FILE="$fidx" git ls-files -s -z -- $inputs 2>/dev/null \
       | tr '\0' '\n' | awk '$1 != "160000"' | tr '\n' '\0' \
       | GIT_INDEX_FILE="$tidx" git update-index -z --index-info 2>/dev/null \
    && GIT_INDEX_FILE="$tidx" git write-tree 2>/dev/null)"
  rm -f -- "${fidx:?}" "${tidx:?}"
  [ -n "$T" ] || return 1
  # Sparse checkout OFF: the repo's own sparse patterns must not hide files.
  local G=(env GIT_INDEX_FILE="$idx" git -c core.hooksPath=/dev/null -c core.sparseCheckout=false -c core.sparseCheckoutCone=false --work-tree="$dir")
  "${G[@]}" read-tree --reset -u "$T" >/dev/null 2>&1 || return 1
  # Tracked files a previous run's generators changed, then everything untracked.
  local dirty; dirty="$("${G[@]}" diff-files --name-only -z 2>/dev/null | tr '\0' '\n')"
  if [ -n "$dirty" ]; then
    printf '%s\n' "$dirty" | tr '\n' '\0' | "${G[@]}" checkout-index -f -z --stdin >/dev/null 2>&1 || return 1
  fi
  "${G[@]}" clean -fdqx >/dev/null 2>&1 || return 1
  # PROOF: no skip-worktree entries, nothing modified, nothing untracked.
  [ -z "$("${G[@]}" ls-files -v 2>/dev/null | grep -v '^H ' | head -1)" ] || return 1
  "${G[@]}" diff-files --quiet >/dev/null 2>&1 || return 1
  [ -z "$("${G[@]}" ls-files --others 2>/dev/null | head -1)" ] || return 1
  _land_log "regenerate extract: reused $dir at $(git rev-parse --short "$tip") (verdict=land_regen_extract_reused)"
  printf '%s\n' "$dir"
}

_land_regenerate() {
  local tip="$1" cmd inputs globs tmp idx rc=0 out t0 tree new n=0 p g hit
  local budget="${AMUX_LAND_REGENERATE_TIMEOUT_S:-300}"
  # Several generators may be declared (git config --add amux.landRegenerate):
  # they run in order in one extract, so a later one sees an earlier one's
  # output (gen_plane_artifacts reads zero-base's resources.yaml).
  cmd="$(git config --get-all amux.landRegenerate 2>/dev/null || true)"
  [ -n "$cmd" ] || { printf '%s\n' "$tip"; return 0; }
  # Nothing to render when no declared input changed between origin and the
  # stack: the generated files are a function of the inputs, so they cannot
  # move. Measured 2026-10-03: the step cost 275 s of compute's 31-minute
  # pre-gate window (mixpeek-override).
  local _inputs_chk _changed
  _inputs_chk="$(git config --get-all amux.landRegenerateInput 2>/dev/null || true)"
  if [ -n "$_inputs_chk" ] && [ -n "${remote:-}" ] && [ -n "${branch:-}" ]; then
    # shellcheck disable=SC2086  # one pathspec per line on purpose
    _changed="$(git diff --name-only "$remote/$branch" "$tip" -- $_inputs_chk 2>/dev/null | head -1)"
    if [ -z "$_changed" ]; then
      _land_log "regenerate skipped: no declared input changed between $remote/$branch and $(git rev-parse --short "$tip")"
      printf '%s\n' "$tip"; return 0
    fi
  fi
  globs="$(git config --get-all amux.landRegenerable 2>/dev/null || true)"
  inputs="$(git config --get-all amux.landRegenerateInput 2>/dev/null || true)"
  # A PERSISTENT EXTRACT, reconciled to <tip> by blob hash, instead of a fresh
  # one per land (fseventsd escalation 20261007-030851: mixpeek's inputs
  # include all of server/, so every land wrote and deleted tens of thousands
  # of files in TMPDIR). It is a plain directory outside any repository, like
  # the fresh extract, and _land_regen_extract proves its contents equal
  # <tip>'s before a generator runs; on any doubt it falls back to a fresh
  # extract. (d08ba296 used a sparse git worktree instead and rendered wrong
  # output, because generators enumerating files through git saw tracked
  # files it never wrote; reverted in 5a595e21.) AMUX_LAND_REGEN_REUSE=0 off.
  local reused=0
  if tmp="$(_land_regen_extract "$tip" "$inputs")"; then
    reused=1
  else
    tmp="$(mktemp -d "${TMPDIR:-/tmp}/amux-land-regen.XXXXXX")"
    # shellcheck disable=SC2086  # one pathspec per line on purpose
    if ! git archive "$tip" ${inputs:+-- $inputs} | tar -x -C "$tmp" 2>/dev/null; then
      rm -rf -- "${tmp:?}"
      _land_log "regenerate: could not extract $(git rev-parse --short "$tip") (inputs: ${inputs:-whole tree}); nothing pushed"
      return 1
    fi
  fi
  _matches() {
    local q="$1" gg
    # shellcheck disable=SC2053  # $gg is a glob on purpose
    while read -r gg; do [ -n "$gg" ] && [[ "$q" == $gg ]] && return 0; done <<< "$globs"
    return 1
  }
  local before after
  before="$(cd "$tmp" && find . -type f | sed 's|^\./||' | while read -r p; do _matches "$p" && printf '%s\n' "$p"; done | sort)"
  t0=$(date +%s)
  # The PRIMARY checkout, not this worktree: a lane landing from
  # .worktrees/<lane> has no server/.venv, so "$AMUX_LAND_REPO"/server/.venv
  # failed with rc 127 for gs12-compute at 23:26Z on 2026-10-02. The common
  # git dir's parent is the primary checkout for a plain clone and a worktree.
  local top; top="$(cd "$(git rev-parse --path-format=absolute --git-common-dir)/.." && pwd)" || top="$(git rev-parse --show-toplevel)"
  local one own run_cmd _t1 _times=""
  out=""
  while IFS= read -r one; do
    [ -n "$one" ] || continue
    # A generator may name its own inputs: `inputs=<pathspec> [<pathspec>...]
    # :: <command>`. It runs only when one of THOSE changed between origin and
    # the stack. The union check above let one broad input (env_census's
    # server/**/*.py) run all six Mixpeek generators on every landing, 132 s
    # under the lock while 16 lanes waited (MO-4354, 2026-10-04); the OpenAPI
    # render alone is 50 s and its inputs moved on 10 of the last 60 landings.
    run_cmd="$one"; own=""
    if [[ "$one" == inputs=*" :: "* ]]; then
      own="${one%% :: *}"; own="${own#inputs=}"; run_cmd="${one#* :: }"
      if [ -n "${remote:-}" ] && [ -n "${branch:-}" ]; then
        # shellcheck disable=SC2086  # pathspecs, one per word, on purpose
        if [ -z "$(git diff --name-only "$remote/$branch" "$tip" -- $own 2>/dev/null | head -1)" ]; then
          _times="$_times${_times:+, }skipped ${run_cmd:0:40}"
          continue
        fi
      fi
    fi
    _t1=$(date +%s)
    out="$out$(cd "$tmp" && AMUX_LAND_REPO="$top" AMUX_LAND_TREE="$tmp" perl -e "$_LAND_PC_TIMEOUT_PL" "$budget" bash -c "$run_cmd" 2>&1)
" || { rc=$?; cmd="$run_cmd"; break; }
    _times="$_times${_times:+, }$(( $(date +%s) - _t1 ))s ${run_cmd:0:40}"
  done <<< "$cmd"
  [ -n "$_times" ] && _land_log "regenerate legs: $_times"
  if [ "$rc" != 0 ]; then
    local log; log="$HOME/.amux/logs/land/$(date -u +%Y%m%dT%H%M%SZ)-${AMUX_WORKER:-${AMUX_SESSION:-$(whoami)}}-$$-regenerate.log"
    mkdir -p "${log%/*}"; printf '%s\n' "$out" > "$log"
    [ "$reused" = 1 ] || rm -rf -- "${tmp:?}"
    _land_log "regenerate failed (rc $rc after $(( $(date +%s) - t0 ))s: $cmd). Output: $log"
    return 1
  fi
  after="$(cd "$tmp" && find . -type f | sed 's|^\./||' | while read -r p; do _matches "$p" && printf '%s\n' "$p"; done | sort)"
  idx="$(mktemp "${TMPDIR:-/tmp}/amux-land-regen-idx.XXXXXX")"
  GIT_INDEX_FILE="$idx" git read-tree "$tip"
  while read -r p; do
    [ -n "$p" ] || continue
    local blob; blob="$(git hash-object -w "$tmp/$p")"
    GIT_INDEX_FILE="$idx" git update-index --add --cacheinfo "$( [ -x "$tmp/$p" ] && echo 100755 || echo 100644 ),$blob,$p"
  done <<< "$after"
  while read -r p; do
    [ -n "$p" ] || continue
    printf '%s\n' "$after" | grep -qxF -- "$p" || GIT_INDEX_FILE="$idx" git update-index --force-remove -- "$p"
  done <<< "$before"
  tree="$(GIT_INDEX_FILE="$idx" git write-tree)"
  rm -f -- "${idx:?}"; [ "$reused" = 1 ] || rm -rf -- "${tmp:?}"
  if [ "$tree" = "$(git rev-parse "$tip^{tree}")" ]; then
    _land_log "regenerate ran in $(( $(date +%s) - t0 ))s and changed nothing on $(git rev-parse --short "$tip")"
    printf '%s\n' "$tip"; return 0
  fi
  n="$(git diff --name-only "$tip" "$tree" | wc -l | tr -d ' ')"
  # Stamped with the holding lane: git commit-tree runs no commit hooks, so this
  # commit had no Amux-Session trailer and Mixpeek's session-stamp leg refused
  # it at the END of the gate (planes 22:11Z, retrievers 21:53Z, 2026-10-02),
  # marking a dozen innocent tickets "solo after refusals".
  new="$(git commit-tree "$tree" -p "$tip" -m "amux land: regenerate $n derived file(s) on the composed tree

Commands:
$cmd

Amux-Session: ${AMUX_WORKER:-${AMUX_SESSION:-amux-land}}")" || return 1
  _land_log "regenerate ran in $(( $(date +%s) - t0 ))s and re-rendered $n file(s) as $(git rev-parse --short "$new") on top of $(git rev-parse --short "$tip")"
  printf '%s\n' "$new"
}

# MO-4102: is this --priority push entitled to jump the queue? Prints the
# refusal and returns 1 when not. A range that cannot be measured is allowed and
# logged as unmeasured rather than refused on a guess.
_land_priority_check() {
  local remote="$1" branch="$2" tip="$3" reason="$4" me="$5" log="$6" files hit="" pat
  if [ -z "$reason" ]; then
    echo "amux land: --priority needs --reason <text>: it jumps every ordinary waiter, so the log has to say why" >&2
    return 1
  fi
  git fetch -q "$remote" "$branch" 2>/dev/null || true
  if ! files="$(git diff --name-only "$remote/$branch...$tip" 2>/dev/null)"; then
    printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "priority range unmeasured (no $remote/$branch...$tip); allowed; reason: $reason" >> "$log"
    return 0
  fi
  local f
  # A gate path matches at any directory level, so scripts/ci/ also covers a
  # monorepo's server/scripts/ci/, where mixpeek keeps its pre-commit checks
  # and their baselines (gs12-data, 2026-10-06: a baseline fix for a check
  # that reddened every lane's commit was refused as touching no gate path).
  while IFS= read -r f; do
    for pat in ${AMUX_LAND_PRIORITY_PATHS:-.githooks/ scripts/ci/ .github/workflows/ scripts/graft-push.sh}; do
      case "$f" in "$pat"*|*/"$pat"*) hit="$f"; break 2 ;; esac
    done
  done <<< "$files"
  if [ -n "$hit" ]; then
    printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "priority allowed: range touches gate path $hit; reason: $reason" >> "$log"
    return 0
  fi
  # Fix forward of a red on main: allowed with no grant when a card the reason
  # cites names this lane as the red's owner on one line (mixpeek-override,
  # 2026-10-03: a grant per CI red made every fix a round trip through it).
  if printf '%s' "$reason" | grep -qiE -- "${AMUX_LAND_PRIORITY_FIXFWD_RE:-fix[- ]?forward}"; then
    local card url text owner_re="${AMUX_LAND_PRIORITY_OWNER_RE:-owns|owner|routed to|fix[- ]?forward}"
    url="${AMUX_URL:-$(amux url 2>/dev/null || true)}"
    for card in $(printf '%s' "$reason" | grep -oE '\b[A-Z][A-Z0-9]*-[0-9]+\b' | sort -u); do
      [ -n "$url" ] || break
      text="$(curl -sk --connect-timeout 5 --max-time 10 "$url/api/board/$card" 2>/dev/null | python3 -c 'import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
print(d.get("title") or ""); print(d.get("desc") or "")' 2>/dev/null)"
      if printf '%s\n' "$text" | grep -F -- "$me" | grep -qiE -- "$owner_re"; then
        printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "priority allowed: fix forward, $card names $me as the red's owner; reason: $reason" >> "$log"
        return 0
      fi
    done
    printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "priority fix-forward unproven: no card in the reason names $me as an owner$([ -n "$url" ] || echo " (no amux url to read cards)"); reason: $reason" >> "$log"
  fi
  if printf '%s' "$reason" | grep -qiE -- "${AMUX_LAND_PRIORITY_GRANT_RE:-grant}"; then
    printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "priority allowed by grant; reason: $reason" >> "$log"
    return 0
  fi
  printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "priority refused: range touches no gate path and the reason names no grant; reason: $reason" >> "$log"
  echo "amux land: --priority refused: this range touches no gate path (${AMUX_LAND_PRIORITY_PATHS:-.githooks/ scripts/ci/ .github/workflows/ scripts/graft-push.sh}) and --reason names no grant. Queue it without --priority, ask the orchestrator for a grant and name it in --reason, or for a fix forward of a red on main cite the card that names you as its owner (--reason \"fix forward <CARD>\"): one line of that card must carry your lane name ($me) with owns, owner, routed to or fix forward, e.g. \"$me owns the red\"." >&2
  return 1
}

# MO-4102: move <lane>'s priority ticket(s) for this checkout's remote back
# into ordinary order. Leaves a marker the waiter acts on; a waiter on land code
# older than the marker cannot see it, and that is said.
_land_demote() {
  local lane="$1" url key q t n=0 old=0 me
  [ -n "$lane" ] || die "usage: amux land --demote <lane>"
  git rev-parse --git-dir >/dev/null 2>&1 || die "amux land --demote: run it inside the repository's checkout"
  url="$(git remote get-url origin 2>/dev/null)" || die "amux land --demote: no remote origin"
  key="$(printf '%s %s' "$url" main | shasum | cut -c1-16)"
  q="$HOME/.amux/locks/land-$key.q"
  me="${AMUX_WORKER:-${AMUX_SESSION:-$(whoami)}}"
  for t in "$q"/000*; do
    [ -e "$t" ] || continue
    [ "$(head -1 "$t" 2>/dev/null)" = "$lane" ] || continue
    printf '%s\n' "$me" > "$q/.demote-${t##*-}"
    n=$((n + 1))
    [ "$(sed -n 5p "$t" 2>/dev/null)" \< "2026-10-02.1" ] && old=$((old + 1))
  done
  printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "[$key] demote $lane: $n priority ticket(s) marked" >> "$HOME/.amux/logs/land.log"
  if [ "$n" = 0 ]; then echo "amux land: $lane has no priority ticket in this queue"; return 1; fi
  echo "amux land: marked $n priority ticket(s) of $lane; each moves to ordinary order on its waiter's next poll"
  [ "$old" -gt 0 ] && echo "amux land: $old of them run land code older than 2026-10-02.1 and will not see the marker; cancel and requeue those instead" >&2
  return 0
}

# _land_pid_cwd <pid> [pgid]: a land process's working directory WITHOUT
# depending on lsof being on PATH (gs12-gates, 2026-10-02: a lane whose PATH
# lacks /usr/sbin got exit 127 with no output from --adopt under set -e).
# The detached record (named by the wrapper pid, which is the waiter's pgid)
# carries the checkout on line 3; lsof by full path is the fallback. Never
# fails: prints nothing when neither source knows.
_land_pid_cwd() {
  local pid="$1" pgid="${2:-}" d="$HOME/.amux/locks/detached" r="" l=""
  for r in "$d/$pid" ${pgid:+"$d/$pgid"}; do
    [ -f "$r" ] && sed -n 3p "$r" 2>/dev/null | grep . && return 0
  done
  for l in "$(command -v lsof 2>/dev/null || true)" /usr/sbin/lsof /usr/bin/lsof; do
    [ -n "$l" ] && [ -x "$l" ] || continue
    "$l" -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1 || true
    return 0
  done
  return 0
}

# `amux land --adopt [pid|--all]` (promised to mixpeek-override, 2026-10-01):
# move this lane's waiters that run OLDER land code onto the installed code
# without losing their place. The old waiter is frozen (SIGSTOP keeps its pid
# alive, so no other waiter drops its ticket as dead), a detached land on the
# current code renames the ticket to its own pid, and only then is the old
# process group killed. If the rename does not happen within 60s the old
# waiter is resumed as it was. A waiter that holds the lock is never adopted.
_land_adopt() {
  local want="${1:-}" force_batch=0 me="${AMUX_WORKER:-${AMUX_SESSION:-$(whoami)}}" url key q lock t pid pgid cwd sha nb n=0 got mine=0 mk
  local all_lanes=0 who
  local force_head=0 _a
  # Flags in any order: --batch, --head, then an optional pid / --all / --all-lanes.
  for _a in "${1:-}" "${2:-}" "${3:-}"; do
    case "$_a" in --batch) force_batch=1 ;; --head) force_head=1 ;; esac
  done
  want=""
  for _a in "${1:-}" "${2:-}" "${3:-}"; do
    case "$_a" in --batch|--head|"") ;; *) want="$_a" ;; esac
  done
  # --all-lanes: every lane's older-code tickets, for the orchestrator after a
  # land release (one run instead of a broadcast). Each adopted waiter keeps
  # its own lane's name, so its result still reaches that lane.
  if [ "$want" = "--all-lanes" ]; then all_lanes=1; want="--all"; fi
  git rev-parse --git-dir >/dev/null 2>&1 || die "amux land --adopt: run it inside the repository's checkout"
  url="$(git remote get-url origin 2>/dev/null)" || die "amux land --adopt: no remote origin"
  key="$(printf '%s %s' "$url" main | shasum | cut -c1-16)"
  lock="$HOME/.amux/locks/land-$key"; q="$lock.q"
  for t in "$q"/*; do
    [ -e "$t" ] || continue
    who="$(sed -n 1p "$t" 2>/dev/null || true)"
    [ "$all_lanes" = 1 ] || [ "$who" = "$me" ] || continue
    pid="${t##*-}"
    [ -z "$want" ] || [ "$want" = "--all" ] || [ "$want" = "$pid" ] || continue
    mine=$((mine + 1))
    if [ "$(sed -n 5p "$t" 2>/dev/null || true)" = "$LAND_BEHAVIOR_VERSION" ]; then
      # Current code: nothing to adopt, but --batch still applies. The waiter
      # holds the flag in memory (and re-execs with its original --no-batch on
      # a self-upgrade), so it takes a marker and flips ITSELF (gs12-mvs,
      # 2026-10-02: --batch was refused on a self-upgraded ticket).
      local _marked=""
      if [ "$force_batch" = 1 ] && [ "$(sed -n 4p "$t" || true)" != 1 ]; then
        printf '%s\n' "$me" > "$q/.batch-$pid"; _marked="batchable"
      fi
      if [ "$force_head" = 1 ]; then
        printf '%s\n' "$me" > "$q/.head-$pid"; _marked="${_marked:+$_marked and }following its checkout's HEAD"
      fi
      if [ -n "$_marked" ]; then
        echo "amux land: ticket ${t##*/} runs $LAND_BEHAVIOR_VERSION; marked $_marked, the waiter switches on its next poll"
        printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "[$key] marked $who's ticket ${t##*/} $_marked" >> "$HOME/.amux/logs/land.log"
        mine=$((mine + 1)); continue
      fi
      echo "amux land: ticket ${t##*/} already runs $LAND_BEHAVIOR_VERSION; nothing to adopt"; continue
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      echo "amux land: ticket ${t##*/}: its waiter (pid $pid) is gone; skipped"; continue
    fi
    if [ "$(cat "$lock/pid" 2>/dev/null || true)" = "$pid" ]; then
      echo "amux land: pid $pid holds the lock; it finishes on its own code (not adopted)"; continue
    fi
    sha="$(sed -n 2p "$t")"; nb=""
    # Carry the lane's own choice; "0r" (solo after refusals) and, with
    # --adopt --batch, an older plain 0 come back batchable.
    case "$(sed -n 4p "$t" || true)" in 1|0r) ;; *) [ "$force_batch" = 1 ] || nb="--no-batch" ;; esac
    pgid="$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ' || true)"
    [ -n "$pgid" ] || pgid="$pid"
    cwd="$(_land_pid_cwd "$pid" "$pgid")"
    [ -n "$cwd" ] && [ -d "$cwd" ] || cwd="$(git rev-parse --show-toplevel)"
    mk="$q/.adopt-$pid"; rm -f -- "$mk"
    kill -STOP -- "-$pgid" 2>/dev/null || kill -STOP "$pid" 2>/dev/null || { echo "amux land: cannot pause pid $pid; skipped"; continue; }
    # Whatever happens next, never leave the old waiter frozen.
    # shellcheck disable=SC2064  # expanded now on purpose
    trap "kill -CONT -- '-$pgid' 2>/dev/null || kill -CONT '$pid' 2>/dev/null || true" EXIT INT TERM
    # Pin to the ticket's commit only when the checkout's HEAD is not that
    # commit or a descendant: an adopt used to pin EVERY ticket with --sha,
    # so commits made after queueing were left out even at its own turn
    # (gs12-mvs, 2026-10-02). --head always follows HEAD.
    local pin=(--sha "$sha")
    if [ "$force_head" = 1 ] || git -C "$cwd" merge-base --is-ancestor "$sha" HEAD 2>/dev/null; then pin=(); fi
    ( cd "$cwd" && AMUX_WORKER="$who" AMUX_LAND_ADOPT="${t##*/}" AMUX_LAND_PRECHECKED=1 AMUX_LAND_PRIORITY_CHECKED=1 bash "$0" land ${pin[@]+"${pin[@]}"} --detach $nb >/dev/null 2>&1 ) || true
    got=""
    for _ in $(seq 1 60); do
      [ -f "$mk" ] && { got="$(cat "$mk" 2>/dev/null || true)"; [ -n "$got" ] && break; }
      sleep 1
    done
    rm -f -- "$mk"
    if [ -n "$got" ] && [ "$got" != gone ] && [ "$(sed -n 1p "$q/$got" 2>/dev/null || true)" = "$who" ]; then
      kill -KILL -- "-$pgid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
      rm -f -- "$HOME/.amux/locks/detached/$pid" "$HOME/.amux/locks/detached/$pgid"
      printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "[$key] adopted $who's pid $pid at its place as $got (pid ${got##*-}, $LAND_BEHAVIOR_VERSION)" >> "$HOME/.amux/logs/land.log"
      echo "amux land: adopted pid $pid -> pid ${got##*-} (ticket $got) at the same queue place, on $LAND_BEHAVIOR_VERSION"
      n=$((n + 1))
    else
      kill -CONT -- "-$pgid" 2>/dev/null || kill -CONT "$pid" 2>/dev/null || true
      printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "[$key] adopt of pid $pid failed (${got:-no answer in 60s}); resumed the old waiter" >> "$HOME/.amux/logs/land.log"
      echo "amux land: adopt of pid $pid failed (${got:-no answer in 60s}); the old waiter was resumed unchanged" >&2
    fi
    trap - EXIT INT TERM
  done
  if [ "$mine" = 0 ]; then
    echo "amux land: no ticket of $me in this repository's queue ($q). Tickets are keyed by the lane name on their first line (AMUX_WORKER/AMUX_SESSION) and by the origin URL; see amux land --status"
  fi
  return 0
}

_land_status() {
  local remote=origin branch=main url key lock q me since n=0 t who mine="" med
  url="$(git remote get-url "$remote" 2>/dev/null)" || die "amux land --status: run it inside the repository's checkout"
  key="$(printf '%s %s' "$url" "$branch" | shasum | cut -c1-16)"
  lock="$HOME/.amux/locks/land-$key"; q="$lock.q"
  me="${AMUX_WORKER:-${AMUX_SESSION:-$(whoami)}}"
  if [ -d "$lock" ]; then
    since=$(cat "$lock/since" 2>/dev/null || echo 0)
    echo "holder: $(cat "$lock/who" 2>/dev/null || echo ?) (pid $(cat "$lock/pid" 2>/dev/null || echo ?)), current attempt $(( ($(date +%s) - since) / 60 )) min"
  else
    echo "holder: none"
  fi
  # Median minutes from acquired to landed/failed, from today's land.log.
  med=$(awk -v d="$(date -u +%Y-%m-%d)" -v k="[$key]" '
    index($1, d) == 1 && $NF == k {
      split($1, a, /[T:Z]/); s = a[2]*3600 + a[3]*60 + a[4]
      if ($3 == "acquired") st[$2] = s
      else if (($3 == "landed" || $3 == "push") && ($2 in st)) { print int((s - st[$2]) / 60); delete st[$2] }
    }' "$HOME/.amux/logs/land.log" 2>/dev/null | sort -n | awk '{ v[NR] = $1 } END { if (NR) print v[int((NR + 1) / 2)] }')
  for t in $(ls "$q" 2>/dev/null | sort); do
    n=$((n + 1)); who="$(head -1 "$q/$t" 2>/dev/null || echo ?)"
    local tag="" since_t
    [ "${t:0:3}" = "000" ] && tag="priority "
    since_t=$((10#${t%%-*}))
    [ "$tag" = "priority " ] && since_t=$(( $(date +%s) / 1000000000 * 1000000000 + 10#${t:3:9} ))
    # A ticket moved by --to-head carries no arrival time in its name ("waiting
    # 13183349 min", 2026-10-03); its file's mtime is the best record left.
    if [ "${t%%-*}" = 000000000000 ]; then
      tag="at head (--to-head) "
      since_t="$(stat -f %m "$q/$t" 2>/dev/null || stat -c %Y "$q/$t" 2>/dev/null || date +%s)"
    fi
    # Batch flag and land code beside each ticket (gs12-compute, 2026-10-02:
    # --status could not answer "is my ticket batchable now?").
    local bflag="" bver
    case "$(sed -n 4p "$q/$t" 2>/dev/null || true)" in 1) ;; 0r) bflag=", solo after refusals" ;; *) bflag=", no-batch" ;; esac
    bver="$(sed -n 5p "$q/$t" 2>/dev/null || true)"
    printf '%3d  %-24s %s%s\n' "$n" "$who" "$tag" "waiting $(( ($(date +%s) - since_t) / 60 )) min (pid ${t##*-}, land ${bver:-?}$bflag)"
    [ "$who" = "$me" ] && [ -z "$mine" ] && mine=$n
  done
  [ "$n" -gt 0 ] || echo "queue: empty"
  local df dp
  for df in "$HOME/.amux/locks/detached"/*; do
    [ -f "$df" ] || continue
    dp="${df##*/}"
    [ "$(sed -n 1p "$df")" = "$me" ] && kill -0 "$dp" 2>/dev/null \
      && echo "your detached land: pid $dp from $(sed -n 3p "$df" || echo '?') (amux land --cancel $dp, or --cancel --all)"
  done
  if [ -n "$mine" ]; then
    if [ -n "$med" ]; then
      echo "you ($me): position $mine; today's median hold is $med min, batches carry up to ${AMUX_LAND_BATCH_MAX:-6}; expect roughly $(( (mine + 5) / 6 * med ))-$(( mine * med )) min (fewer turns if batched, more if a batch is refused)"
    else
      echo "you ($me): position $mine; no completed holds today to estimate from"
    fi
  fi
}

# _land_to_head <waiter pid> --reason <text>: put one queued ticket at the
# head of the queue, ahead of granted priority tickets (mixpeek-override,
# 2026-10-03: the pushed-tree extract fix sat behind four aged and three
# priority tickets, and a demote of its lane would have demoted the fix too).
# Attributed; the waiter renames its own ticket on its next poll.
_land_to_head() {
  local want="${1:-}" reason="" me="${AMUX_WORKER:-${AMUX_SESSION:-$(whoami)}}" tk qd
  shift 1 2>/dev/null || true
  while [ $# -gt 0 ]; do case "$1" in --reason) reason="${2:-}"; shift 2 ;; *) shift ;; esac; done
  [ -n "$want" ] && [ -n "$reason" ] || { echo "usage: amux land --to-head <waiter pid from --status> --reason <text>" >&2; return 2; }
  for tk in "$HOME"/.amux/locks/land-*.q/*-"$want"; do
    [ -f "$tk" ] || continue
    qd="${tk%/*}"
    printf '%s\n%s\n' "$me" "$reason" > "$qd/.tohead-$want"
    printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "to-head: $(sed -n 1p "$tk")'s ticket ${tk##*/} (waiter $want) moves to the head; reason: $reason" >> "$HOME/.amux/logs/land.log"
    echo "amux land: $(sed -n 1p "$tk")'s ticket ${tk##*/} moves to the head of the queue on its waiter's next poll"
    return 0
  done
  echo "amux land: no queued ticket with waiter pid $want (amux land --status prints it)" >&2
  return 1
}

# _land_cancel_for <lane> <pid> --reason <text>: stop ANOTHER lane's queued
# land, by the waiter pid `amux land --status` prints. --cancel refuses a
# ticket that is not the caller's; an orchestrator pulling a stale tip out of
# a 15-push batch had no sanctioned way to do it (mixpeek-override, 14:49Z
# 2026-10-02, gs12-data's ticket). Attributed: the reason is required, the
# land log names both lanes, and the owning lane is told by amux send.
_land_cancel_for() {
  local lane="${1:-}" want="${2:-}" reason="" me="${AMUX_WORKER:-${AMUX_SESSION:-$(whoami)}}" tk tkwho pg n=0
  shift 2 2>/dev/null || true
  while [ $# -gt 0 ]; do case "$1" in --reason) reason="${2:-}"; shift 2 ;; *) shift ;; esac; done
  if [ -z "$lane" ] || [ -z "$want" ] || [ -z "$reason" ]; then
    echo "usage: amux land --cancel-for <lane> <waiter pid from --status> --reason <text>" >&2; return 2
  fi
  case "$want" in *[!0-9]*) echo "amux land: --cancel-for takes the waiter pid --status prints, got '$want'" >&2; return 2 ;; esac
  for tk in "$HOME"/.amux/locks/land-*.q/*-"$want"; do
    [ -f "$tk" ] || continue
    tkwho="$(sed -n 1p "$tk" 2>/dev/null)"
    if [ "$tkwho" != "$lane" ]; then
      echo "amux land: ticket ${tk##*/} belongs to $tkwho, not $lane; not cancelled" >&2; return 1
    fi
    pg="$(ps -o pgid= -p "$want" 2>/dev/null | tr -d ' ' || true)"
    if [ -n "$pg" ] && [ "$pg" != "$(ps -o pgid= -p $$ | tr -d ' ')" ]; then
      kill -TERM -- "-$pg" 2>/dev/null || kill -TERM "$want" 2>/dev/null || true
    else
      kill -TERM "$want" 2>/dev/null || true
    fi
    sleep 2; kill -0 "$want" 2>/dev/null && { kill -KILL -- "-${pg:-$want}" 2>/dev/null || kill -KILL "$want" 2>/dev/null || true; }
    rm -f -- "${tk:?}"
    [ -n "$pg" ] && rm -f -- "$HOME/.amux/locks/detached/$pg"
    printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "cancelled $lane's queued land (waiter pid $want, pgid ${pg:-?}, ticket ${tk##*/}); reason: $reason" >> "$HOME/.amux/logs/land.log"
    echo "amux land: cancelled $lane's queued land (waiter pid $want, ticket ${tk##*/}); $lane is told"
    command -v amux >/dev/null 2>&1 && printf '%s\n' "Your queued land (waiter pid $want, ticket ${tk##*/}) was cancelled by $me: $reason. Nothing was pushed for it; run amux land again when it is ready." \
      | amux send "$lane" --stdin >/dev/null 2>&1 || true
    n=$((n + 1))
  done
  [ "$n" -gt 0 ] && return 0
  # The HOLDER (mixpeek-override, 2026-10-02 20:17Z): main was red on four
  # tree-guard tests, so gates' 9-push hold was doomed to burn the 30-minute
  # guard leg and no one but gates could stop it. Stop the holder and every
  # process under it (its git push and hook), never its process group: a
  # foreground land shares a group with the lane's own shell. Its EXIT trap
  # releases the lock; batched waiters keep their tickets and their place.
  local lk lkwho kids k
  for lk in "$HOME"/.amux/locks/land-*; do
    [ -d "$lk" ] && [ -f "$lk/pid" ] || continue
    [ "$(cat "$lk/pid" 2>/dev/null)" = "$want" ] || continue
    lkwho="$(cat "$lk/who" 2>/dev/null)"
    if [ "$lkwho" != "$lane" ]; then
      echo "amux land: the holder with pid $want is $lkwho, not $lane; not cancelled" >&2; return 1
    fi
    printf 'by %s at %s: %s\n' "$me" "$(date -u +%FT%TZ)" "$reason" > "$lk/cancelled"
    kids="$want"; k="$want"
    while [ -n "$k" ]; do
      k="$(ps -A -o pid=,ppid= | awk -v set=" $k " 'index(set, " " $2 " ") {printf "%s ", $1}')"
      kids="$kids $k"
    done
    # Children first, so the hook and git push stop before the holder's trap runs.
    # shellcheck disable=SC2086  # word-split pid list on purpose
    for k in $(printf '%s\n' $kids | awk 'NF' | tail -r 2>/dev/null || printf '%s\n' $kids | awk 'NF' | tac); do
      [ "$k" = "$$" ] || kill -TERM "$k" 2>/dev/null || true
    done
    sleep 3
    kill -0 "$want" 2>/dev/null && kill -KILL "$want" 2>/dev/null
    [ "$(cat "$lk/pid" 2>/dev/null)" = "$want" ] && rm -rf -- "${lk:?}"
    printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "cancelled $lane's HOLD on ${lk##*/} (holder pid $want and its children); the queue moves on; reason: $reason" >> "$HOME/.amux/logs/land.log"
    echo "amux land: cancelled $lane's hold (holder pid $want); the lock is released and queued waiters keep their place; $lane is told"
    command -v amux >/dev/null 2>&1 && printf '%s\n' "Your amux land HOLD (holder pid $want) was cancelled by $me: $reason. Nothing was pushed for that attempt; your waiters keep their place. Run amux land again when it is ready." \
      | amux send "$lane" --stdin >/dev/null 2>&1 || true
    return 0
  done
  echo "amux land: no queued ticket or holder with pid $want (amux land --status prints both)" >&2
  return 1
}

# _land_refusal_spares <result text> <ticket sha> <base ref>: rc 0 when the
# refused batch's full output (named in the result as "full output <path>")
# names at least one file and none of them is in <base>..<sha>; rc 1 otherwise
# (a file of ours, no file named, or nothing readable), which keeps the old
# count-it behaviour.
_land_refusal_spares() {
  local res="$1" sha="$2" base="$3" log paths mine f
  log="$(printf '%s' "$res" | grep -oE 'full output [^ );]+' | head -1 | sed 's/^full output //')"
  [ -n "$log" ] && [ -r "$log" ] && [ -n "$sha" ] || return 1
  local _pre='(\.?[A-Za-z0-9_@+-]+/)+\.?[A-Za-z0-9_@+.-]+'
  # Failure lines plus the indented block under each (where a leg names its
  # files: "       1 schema(s)  server/scripts/ops/golden_known_item.py"), URLs
  # stripped so a remote like github.com/mixpeek/mixpeek.git is not a path.
  # Also a pre-commit block: "<hook name>....Failed" then its "- hook id" lines
  # and output (a traceback naming the check by its path inside the hook's
  # temp tree) up to the next "....Passed/Failed/Skipped" line (02:07Z
  # 2026-10-03: check-gcloudignore-allowlist crashed on a missing module and
  # 12 tickets went solo; the old reader found no file in it).
  paths="$( { awk '
      /\.\.\.+Failed[[:space:]]*$/ { inpc = 1; print; next }
      inpc && /\.\.\.+(Passed|Skipped)[[:space:]]*$/ { inpc = 0; next }
      inpc { print; next }
      /✗|FAIL|BLOCKED|REFUSED|refus|^error:|^fatal:/ && !/not refused|not a refusal/ { print; inb = 1; next }
      inb && /^[[:space:]]*$/ { next }
      inb && /^[[:space:]]+[^[:space:]]/ { print; next }
      { inb = 0 }' "$log" | sed -E 's#[A-Za-z][A-Za-z0-9+.-]*://[^[:space:]]+##g; s#[A-Za-z0-9.-]+\.(com|org|io|net|dev)/[^[:space:]]+##g' | grep -oE "$_pre" || true; } \
     | grep -E '\.' | sort -u)"
  # An absolute path inside a temp tree names a repo file by its tail: keep the
  # shortest suffix that exists at <base>, drop it if none does.
  local q out="" i parts
  while read -r q; do
    [ -n "$q" ] || continue
    # Any path not in the repo as written (a temp-tree path, or its tail when
    # a dotted directory like rs.Ab12 cut the match short, as on Linux CI)
    # names a repo file by its shortest existing suffix.
    if git cat-file -e "$base:$q" 2>/dev/null; then out="$out$q"$'\n'; continue; fi
    IFS=/ read -r -a parts <<< "$q"
    for ((i = ${#parts[@]} - 1; i >= 0; i--)); do
      local suf; suf="$(IFS=/; echo "${parts[*]:i}")"
      if git cat-file -e "$base:$suf" 2>/dev/null; then out="$out$suf"$'\n'; break; fi
    done
  done <<< "$paths"
  paths="$(printf '%s' "$out" | awk 'NF' | sort -u)"
  [ -n "$paths" ] || return 1
  mine="$(git diff --name-only "$(git merge-base "$base" "$sha" 2>/dev/null || echo "$base")" "$sha" 2>/dev/null)" || return 1
  [ -n "$mine" ] || return 1
  while read -r f; do
    [ -n "$f" ] || continue
    printf '%s\n' "$mine" | grep -qxF -- "$f" && return 1
    # A path printed relative to a subdirectory (server/...) still counts as ours.
    printf '%s\n' "$mine" | grep -qE -- "(^|/)${f//./\\.}$" && return 1
  done <<< "$paths"
  return 0
}

# _land_pid_owner <pid> <pgid>: the lane a running land belongs to, from land's
# own records only (the detached record for its wrapper, its queue ticket, or
# the lock it holds); empty when none names it. macOS ps cannot show another
# process's environment, so AMUX_WORKER is not readable from outside.
_land_pid_owner() {
  local pid="$1" pg="$2" f lk
  for f in "$HOME/.amux/locks/detached/$pg" "$HOME/.amux/locks/detached/$pid"; do
    [ -f "$f" ] && { sed -n 1p "$f"; return 0; }
  done
  for f in "$HOME"/.amux/locks/land-*.q/*-"$pid"; do
    [ -f "$f" ] && { sed -n 1p "$f"; return 0; }
  done
  for lk in "$HOME"/.amux/locks/land-*; do
    [ -f "$lk/pid" ] && [ "$(cat "$lk/pid" 2>/dev/null)" = "$pid" ] && { cat "$lk/who" 2>/dev/null; return 0; }
  done
  return 0
}

# _land_cancel [pid]: stop a detached `amux land` (whole process group: the
# wrapper, the land, its git push and hook). With a pid, that one (it must be
# this session's). Without, every detached land of this session started from
# THIS checkout (gs12-restore, 2026-10-01: keyed by session alone, --cancel in
# one worktree stopped another worktree's land and missed its own).
_land_cancel() {
  local want="${1:-}" me="${AMUX_WORKER:-${AMUX_SESSION:-$(whoami)}}" d="$HOME/.amux/locks/detached" f pid who where here n=0 all=0
  # --all: every detached land of this session, whatever checkout it came from
  # (gs12-retrievers, 2026-10-01: three --sha lands, --cancel stopped one).
  [ "$want" = "--all" ] && { all=1; want=""; }
  here="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
  for f in "$d"/*; do
    [ -f "$f" ] || continue
    pid="${f##*/}"; who="$(sed -n 1p "$f" 2>/dev/null)"; where="$(sed -n 3p "$f" 2>/dev/null)"
    [ "$who" = "$me" ] || continue
    if [ -n "$want" ]; then
      [ "$pid" = "$want" ] || continue
    elif [ "$all" = 1 ]; then
      :
    else
      # A record from before checkouts were recorded has no line 3 (gs12-cicd,
      # 2026-10-01: such a land was skipped and left queued). Read the
      # checkout from the process's own cwd instead of guessing.
      if [ -z "$where" ] && kill -0 "$pid" 2>/dev/null; then
        local _pcwd
        _pcwd="$(_land_pid_cwd "$pid")"
        [ -n "$_pcwd" ] && where="$(git -C "$_pcwd" rev-parse --show-toplevel 2>/dev/null || echo "$_pcwd")"
      fi
      [ "$where" = "$here" ] || continue
    fi
    if kill -0 "$pid" 2>/dev/null; then
      kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
      echo "amux land: cancelled detached land pid $pid (process group) for $me in ${where:-unknown checkout}"
      printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "cancelled detached land (pid $pid, ${where:-unknown checkout})" >> "$HOME/.amux/logs/land.log"
      n=$((n + 1))
    fi
    rm -f -- "${f:?}"
  done
  # Lands with no record at all (started before --cancel recorded them, or by
  # hand): find running `amux land` processes whose cwd is this checkout and
  # stop their process groups (gs12-tiering, 2026-10-01: a 16:31Z land was
  # invisible to --cancel and needed SIGKILL by hand).
  if [ -z "$want" ] && [ "$all" = 0 ]; then
    local pgid cmd pcwd ptop
    while read -r pid pgid cmd; do
      [ "$pid" != "$$" ] && [ "$pgid" != "$(ps -o pgid= -p $$ | tr -d ' ')" ] || continue
      case "$cmd" in *"amux land"*) ;; *) continue ;; esac
      case "$cmd" in *--cancel*|*--status*|*--help*) continue ;; esac
      pcwd="$(_land_pid_cwd "$pid" "$pgid")"
      [ -n "$pcwd" ] || continue
      ptop="$(git -C "$pcwd" rev-parse --show-toplevel 2>/dev/null || echo "$pcwd")"
      [ "$ptop" = "$here" ] || continue
      # A SHARED checkout runs every lane's lands from the same cwd, so the cwd
      # says nothing about whose land it is: gtm-videos' --cancel stopped
      # mixpeek-override's two detached lands (plan v42 and the minimal-spend
      # amendment) at 20:14Z on 2026-10-02 and nobody was told for 2 h 40 min.
      # Stop it only when land's own records say it is ours; a land with no
      # owner on record is listed and left alone.
      local powner
      powner="$(_land_pid_owner "$pid" "$pgid")"
      if [ "$powner" != "$me" ]; then
        echo "amux land: land pid $pid (process group $pgid) in $here belongs to ${powner:-an owner nobody recorded}; not cancelled" >&2
        printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "left land pid $pid (pgid $pgid, $here) alone: owner ${powner:-unrecorded}, not $me" >> "$HOME/.amux/logs/land.log"
        continue
      fi
      kill -TERM -- "-$pgid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
      sleep 3
      kill -0 "$pid" 2>/dev/null && { kill -KILL -- "-$pgid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true; }
      echo "amux land: cancelled unrecorded land pid $pid (process group $pgid) in $here"
      printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "cancelled unrecorded land (pid $pid, pgid $pgid, $here)" >> "$HOME/.amux/logs/land.log"
      n=$((n + 1))
    done < <(ps -Ao pid=,pgid=,command= 2>/dev/null | awk '/amux land/ && !/awk/')
  fi
  # The pid `--status` prints is the WAITER's (its ticket name); --cancel keyed
  # only on the detached wrapper, so it "found nothing" or left the waiter
  # alive (gs12-restore, gs12-compute, gs12-mvs, 2026-10-02). Accept it.
  if [ "$n" -eq 0 ] && [ -n "$want" ] && [ "$want" != "--all" ]; then
    local _url _key _q _t _pg
    _url="$(git remote get-url origin 2>/dev/null || true)"
    if [ -n "$_url" ]; then
      _key="$(printf '%s %s' "$_url" main | shasum | cut -c1-16)"; _q="$HOME/.amux/locks/land-$_key.q"
      for _t in "$_q"/*-"$want"; do
        [ -f "$_t" ] || continue
        [ "$(sed -n 1p "$_t")" = "$me" ] || { echo "amux land: ticket ${_t##*/} belongs to $(sed -n 1p "$_t"), not $me; not cancelled" >&2; return 1; }
        _pg="$(ps -o pgid= -p "$want" 2>/dev/null | tr -d ' ' || true)"
        kill -TERM -- "-${_pg:-$want}" 2>/dev/null || kill -TERM "$want" 2>/dev/null || true
        sleep 2; kill -0 "$want" 2>/dev/null && { kill -KILL -- "-${_pg:-$want}" 2>/dev/null || kill -KILL "$want" 2>/dev/null || true; }
        rm -f -- "${_t:?}"
        [ -n "$_pg" ] && rm -f -- "$d/$_pg"
        echo "amux land: cancelled the queued land of $me with waiter pid $want (process group ${_pg:-?}); ticket ${_t##*/} removed"
        printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "[$_key] cancelled waiter pid $want (pgid ${_pg:-?}) and removed ticket ${_t##*/}" >> "$HOME/.amux/logs/land.log"
        return 0
      done
    fi
  fi
  if [ "$n" -eq 0 ]; then
    local _what="this checkout ($here)"
    [ -n "$want" ] && _what="pid $want"
    echo "amux land: no detached land of $me found for $_what (a land launched by hand, without --detach, is not recorded: stop it with kill -TERM -- -<its process group>). Others of this session:"
    for f in "$d"/*; do
      [ -f "$f" ] && [ "$(sed -n 1p "$f")" = "$me" ] && kill -0 "${f##*/}" 2>/dev/null && echo "  pid ${f##*/} from $(sed -n 3p "$f" || echo '?')"
    done
  fi
  return 0
}

# LAND_BEHAVIOR_VERSION: bump ONLY when `amux land`'s behavior changes (queue
# order, locking, batching, push environment), not for comments or lint fixes.
# Each ticket records it, so scripts/pipeline-bottlenecks.py flags a waiter as
# running stale land code by version, not by the CLI's install time: every
# install moved that time, and on 2026-10-01 a lint-only install (b6a1172f)
# had eight waiters flagged for a cancel-and-requeue that would have cost
# each its place for nothing.
LAND_BEHAVIOR_VERSION="2026-10-02.54"

cmd_land() {
  # amux land [--remote origin] [--branch main] [--tries 8] [--max-hold 3600] [--no-batch] [--batch-max N] [--priority] [--detach] [--sha <commit>] | --cancel | --status
  #
  # Rebase this checkout onto the remote branch and push HEAD there, holding a
  # per-repo, per-branch lock for the whole fetch -> rebase -> push loop, so
  # lanes landing on the same branch QUEUE instead of racing. Reported from the
  # goal-spec-12 orchestration (2026-10-01): one commit lost seven push races in
  # a row on a busy main, each race costing a full pre-push gate run, and
  # workers serialized by hand. Inside the lock a non-fast-forward rejection
  # (another pusher that does not use land) is retried after a fresh fetch and
  # rebase; any other failure (a red hook, a rebase conflict) stops and returns.
  #
  # The lock is a directory under ~/.amux/locks (mkdir is atomic; macOS has no
  # flock). A lock whose holder pid is gone, or that has been held longer than
  # --max-hold seconds, is taken over with a warning, so a hung push cannot
  # block the queue forever. Waiters are served in arrival order (tickets in
  # <lock>.q).
  #
  # Batching: the holder also lands up to --batch-max / AMUX_LAND_BATCH_MAX (default 6; 3 until 2026-10-01, raised when the queue ran 13 deep)
  # waiters queued behind it that share its repository, so N queued pushes cost
  # one pre-push gate run instead of N. Measured 2026-10-01 on Mixpeek main: a
  # median 17-minute hold, waits of 18 to 100 minutes, the queue 7 deep. Each
  # waiter's commits are replayed in order onto the holder's rebased HEAD with
  # `git merge-tree`, keeping their author, message and trailers; the stack is
  # pushed without being checked out, so the hook gates the pushed tree. A
  # waiter whose commits conflict, or contain a merge, stays queued and lands on
  # its own turn. If the hook refuses a batch, the holder pushes its own commit
  # alone and every batched waiter stays queued, so nobody inherits another
  # lane's refusal. --no-batch keeps a lane out of batches in both roles.
  #
  # --priority queues ahead of every ordinary waiter (priority waiters keep
  # their own arrival order). A priority ticket is never batched by another
  # holder; as the holder it batches ordinary waiters like any other. For a push that makes every push behind it
  # cheaper, e.g. a faster gate (gs12-gates, 2026-10-01). It needs
  # --reason <text>, written to the ticket and land.log, and is refused when
  # the pushed range touches no gate path (AMUX_LAND_PRIORITY_PATHS, default
  # .githooks/ scripts/ci/ .github/workflows/ scripts/graft-push.sh) unless the
  # reason names a grant (AMUX_LAND_PRIORITY_GRANT_RE, default "grant"): seven
  # lanes queued ordinary work with it in one afternoon and two ordinary
  # waiters sat 109 and 114 min (mixpeek-override, MO-4102).
  # `amux land --demote <lane>` moves that lane's priority ticket back into
  # ordinary order at its arrival time; the waiter does the rename itself.
  #
  # `amux land --adopt [pid|--all]`, run in the lane's checkout, moves the
  # lane's waiters that run OLDER land code onto the installed code at the
  # same queue place (same ticket name, new pid). A lock holder is never
  # adopted, and a failed hand-off resumes the old waiter unchanged.
  # `--adopt --batch` also makes the ticket batchable again (for a ticket an
  # older land made solo after a refused batch). `--adopt --head` makes a
  # pinned ticket follow its checkout's HEAD again. `--adopt --all-lanes` adopts
  # every lane's older-code tickets in one run. From 2026-10-02.9 a waiter
  # also upgrades ITSELF in place when a newer land is installed.
  #
  # --detach queues and returns at once: land runs in its own session (macOS
  # has no setsid(1); python's os.setsid does it), output goes to a log under
  # ~/.amux/logs/land/, and the lane gets a message when it lands or stops
  # (AMUX_LAND_NOTIFY=0 skips the message, for a scheduled caller that checks
  # the result itself on its next run). `amux land --cancel` stops every
  # detached land of this lane, whole process group, and drops its ticket.
  # Claude Code kills a background command after 2 hours, and with the queue
  # 15 deep a lane lost its ticket that way at position 9 (gs12-templates,
  # 2026-10-01). A detached land is not the lane's child, so no limit reaches it.
  #
  # --sha <commit> lands a commit that is not this checkout's HEAD: for a lane
  # with no checkout of its own that builds commits with commit-tree on
  # origin/main (mixpeek-homepage-claude, 2026-10-01, whose direct grafts moved
  # main under a holder's 50-minute gate twice). Its commits are replayed onto
  # the remote tip with `git merge-tree`, as a batch replays a waiter's, and
  # pushed without a checkout, so the hook gates the pushed tree. A conflict
  # returns 2 with nothing pushed.
  #
  # Every wait, takeover, batch and outcome is a line in ~/.amux/logs/land.log;
  # a refused push keeps its full output under ~/.amux/logs/land/.
  local remote=origin branch=main tries=8 max_hold=3600 batch=1 priority=0 batch_max="${AMUX_LAND_BATCH_MAX:-}" detach=0 land_sha="" prio_reason=""
  local fwd_args=()
  local orig_args=(${1+"$@"})
  while [ $# -gt 0 ]; do
    case "$1" in
      --remote) remote="${2:?}"; fwd_args+=("$1" "$2"); shift 2 ;;
      --branch) branch="${2:?}"; fwd_args+=("$1" "$2"); shift 2 ;;
      --tries) tries="${2:?}"; fwd_args+=("$1" "$2"); shift 2 ;;
      --max-hold) max_hold="${2:?}"; fwd_args+=("$1" "$2"); shift 2 ;;
      --no-batch) batch=0; fwd_args+=("$1"); shift ;;
      --priority) priority=1; fwd_args+=("$1"); shift ;;
      --reason) prio_reason="${2:?}"; fwd_args+=("$1" "$2"); shift 2 ;;
      --demote) shift; _land_demote "${1:-}"; return $? ;;
      --adopt) shift; _land_adopt "${1:-}" "${2:-}" "${3:-}"; return $? ;;
      --batch-max) batch_max="${2:?}"; fwd_args+=("$1" "$2"); shift 2 ;;
      --detach) detach=1; shift ;;
      --sha) land_sha="${2:?}"; fwd_args+=("$1" "$2"); shift 2 ;;
      --cancel) shift; _land_cancel "${1:-}"; return $? ;;
      --cancel-for) shift; _land_cancel_for "$@"; return $? ;;
      --to-head) shift; _land_to_head "$@"; return $? ;;
      --status) _land_status; return $? ;;
      -h|--help) sed -n '/^cmd_land()/,/^  local remote/p' "$0" | grep '^  #' | sed 's/^  # \{0,1\}//'; return 0 ;;
      *) die "usage: amux land [--remote origin] [--branch main] [--tries 8] [--max-hold 3600] [--no-batch] [--batch-max N] [--priority --reason <text>] [--detach] [--sha <commit>] | amux land --cancel [pid|--all] | --cancel-for <lane> <pid> --reason <text> | --to-head <waiter pid> --reason <text> | --status | --demote <lane> | --adopt [pid|--all]" ;;
    esac
  done
  # CONTRACT RULE 5 (AH-380): where the server owns landing for this lane, queue
  # the commit there and return; the lane gets a message when it lands or is
  # refused. A 409 land_queue_off (the rule is off for this lane) or an
  # unreachable server falls through to the client queue below.
  # AMUX_LAND_CLIENT=1 forces the client path.
  if [ -n "${AMUX_SESSION:-}" ] && [ "${AMUX_LAND_CLIENT:-0}" != 1 ]; then
    local _q_sha _q_out _q_code _q_body
    _q_sha="${land_sha:-$(git rev-parse HEAD 2>/dev/null)}"
    if [ -n "$_q_sha" ]; then
      _q_body=$(python3 -c 'import json,sys; print(json.dumps({"sha": sys.argv[1], "priority": sys.argv[2] == "1", "reason": sys.argv[3]}))' "$_q_sha" "$priority" "$prio_reason")
      _q_out=$(_curl -sk -m 30 -w '\n%{http_code}' -X POST -H 'Content-Type: application/json' \
        -H "X-Amux-Session: $AMUX_SESSION" -d "$_q_body" "${AMUX_API:-$(cmd_url)}/api/land" 2>/dev/null) || _q_out=""
      _q_code="${_q_out##*$'\n'}"
      case "$_q_code" in
        202) echo "amux land: queued on the server (contract rule 5); you get a message when it lands or is refused. ${_q_out%$'\n'*}"; return 0 ;;
        # 400: the queue refused THIS request (unknown commit, a priority land
        # with no reason). Anything else (409 rule off, 404 from a server
        # without the route, unreachable) falls through to the client queue.
        400) echo "amux land: the server queue refused the request: ${_q_out%$'\n'*}" >&2; return 2 ;;
      esac
    fi
  fi
  if [ -n "$land_sha" ]; then
    git rev-parse --git-dir >/dev/null 2>&1 || die "amux land: not inside a git repository"
    land_sha="$(git rev-parse --verify -q "$land_sha^{commit}")" || die "amux land: --sha does not name a commit in this repository"
  else
    # Intermittent "not a git repository" from checkouts that were fine
    # seconds later (gs12-tiering 13:50Z and 15:10Z, the amux checkout 15:13Z,
    # 2026-10-01; cause not pinned). Retry briefly, and when it persists or
    # recovers, write what git saw to land.log so the next one names its cause.
    local _try _diag
    for _try in 1 2 3 4; do
      git rev-parse --is-inside-work-tree >/dev/null 2>&1 && break
      _diag="cwd=$PWD dotgit=$( [ -f .git ] && echo "file:$(head -c 200 .git)" || { [ -d .git ] && echo dir || echo missing; } ) core.bare=$( { git config --get core.bare 2>&1 || true; } | head -c 80) rev-parse=$( { git rev-parse --git-dir 2>&1 || true; } | head -c 160) GIT_DIR=${GIT_DIR:-} GIT_WORK_TREE=${GIT_WORK_TREE:-}"
      mkdir -p "$HOME/.amux/logs"
      printf '%s %s %s\n' "$(date -u +%FT%TZ)" "${AMUX_WORKER:-${AMUX_SESSION:-$(whoami)}}" "not-a-checkout attempt $_try: $_diag" >> "$HOME/.amux/logs/land.log"
      [ "$_try" -lt 4 ] && sleep 2
    done
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "amux land: not inside a git checkout (diagnostics in ~/.amux/logs/land.log)"
  fi
  local url key lock log me common
  # A land started from inside a git hook inherits GIT_DIR / GIT_WORK_TREE /
  # GIT_INDEX_FILE, and so does everything it runs (the precheck, the hook,
  # the generators, their tests). `git init` or a clone under GIT_DIR +
  # GIT_WORK_TREE re-initialises the REAL repository and writes core.worktree
  # into the shared config: reproduced 2026-10-03, and the value found at
  # 14:26Z was the batch holder's own worktree (gs12-restore). Land resolves
  # the repository from its cwd, so it clears them.
  local _gv _gvs=""
  for _gv in GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR; do
    if [ -n "${!_gv:-}" ]; then _gvs="$_gvs $_gv=${!_gv}"; unset "$_gv"; fi
  done
  url="$(git remote get-url "$remote" 2>/dev/null)" || die "amux land: no remote '$remote'"
  key="$(printf '%s %s' "$url" "$branch" | shasum | cut -c1-16)"
  lock="$HOME/.amux/locks/land-$key"
  log="$HOME/.amux/logs/land.log"
  me="${AMUX_WORKER:-${AMUX_SESSION:-$(whoami)}}"
  common="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)"
  mkdir -p "$HOME/.amux/locks" "$HOME/.amux/logs"
  if [ "$priority" = 1 ] && [ "${AMUX_LAND_PRIORITY_CHECKED:-}" != 1 ]; then
    _land_priority_check "$remote" "$branch" "${land_sha:-HEAD}" "$prio_reason" "$me" "$log" || return 2
  fi
  # --detach runs the precheck in the DETACHED process, never here: at load it
  # takes 2-6 min, which overran the caller's tool timeout and got the
  # detaching call itself killed (gs12-spend, 2026-10-02 09:05Z, a --detach
  # call SIGTERMed at 237 s). A refusal still reaches the lane in the
  # completion message ("refused before queueing").
  if [ "${AMUX_LAND_PRECHECKED:-}" != 1 ] && [ "$detach" != 1 ]; then
    _land_precheck "$remote" "$branch" "${land_sha:-HEAD}" "$me" "$log" || return 3
  fi
  if [ "$detach" = 1 ]; then
    local dlog dpid _f _here _there
    # One session landing from several checkouts is legal, but --cancel and
    # the completion message are per checkout, so say so (gs12-restore,
    # 2026-10-01: three detached lands from three worktrees of one session).
    _here="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
    for _f in "$HOME/.amux/locks/detached"/*; do
      [ -f "$_f" ] || continue
      [ "$(sed -n 1p "$_f")" = "$me" ] && kill -0 "${_f##*/}" 2>/dev/null || continue
      _there="$(sed -n 3p "$_f")"
      # Same checkout, no --sha: the pending land pushes this checkout's HEAD
      # at its turn, commits made since included, so a second ticket only
      # costs every lane behind it a slot and a no-op gate run (gs12-cicd,
      # 2026-10-01: three --detach calls from one worktree held three slots).
      # Only a queued ticket of this lane that carries the current HEAD counts:
      # a ticket pinned with --sha never follows HEAD, and saying it did let 47
      # commits wait ~5 h in a queue that did not hold them (gs12-spend,
      # 2026-10-02). Unpinned tickets refresh to HEAD every poll.
      if [ -z "$land_sha" ] && [ "$_there" = "$_here" ]; then
        local _head_now _tk _held=""
        _head_now="$(git rev-parse HEAD)"
        for _tk in "$lock.q"/*; do
          [ -f "$_tk" ] || continue
          [ "$(sed -n 1p "$_tk")" = "$me" ] && [ "$(sed -n 2p "$_tk")" = "$_head_now" ] && { _held="${_tk##*/}"; break; }
        done
        if [ -n "$_held" ]; then
          echo "amux land: already queued from this checkout (ticket $_held, detached pid ${_f##*/}) and it carries HEAD $(git rev-parse --short HEAD). Not queuing another. Status: amux land --status"
          return 0
        fi
        echo "amux land: note: the land queued from this checkout (pid ${_f##*/}) does not carry HEAD $(git rev-parse --short HEAD) (pinned to another commit); queuing HEAD as well." >&2
      fi
      [ -n "$_there" ] && [ "$_there" != "$_here" ] && echo "amux land: note: $me already has a detached land queued from $_there (pid ${_f##*/}); this one is for $_here. Cancel per checkout with: amux land --cancel (run in that checkout) or amux land --cancel <pid>." >&2
    done
    dlog="$HOME/.amux/logs/land/$(date -u +%Y%m%dT%H%M%SZ)-$me-detached.log"
    mkdir -p "${dlog%/*}"
    # The runner re-runs land without --detach, then tells the lane how it
    # ended: the last land.log lines are the outcome, the log the detail.
    AMUX_LAND_PRIORITY_CHECKED="$priority" AMUX_LAND_ME="$me" AMUX_LAND_DLOG="$dlog" AMUX_LAND_SELF="$0" python3 -c '
import os, sys, subprocess
os.setsid()
me, dlog, amux = os.environ["AMUX_LAND_ME"], os.environ["AMUX_LAND_DLOG"], os.environ["AMUX_LAND_SELF"]
with open(dlog, "ab") as out:
    rc = subprocess.call(["bash", amux, "land"] + sys.argv[1:], stdout=out, stderr=out, stdin=subprocess.DEVNULL)
tail = [l for l in open(dlog, errors="replace").read().splitlines() if l.startswith("amux land:")][-3:]
msg = f"amux land (detached) finished with rc {rc}:\n" + "\n".join(tail) + f"\nFull output: {dlog}"
try:
    os.remove(os.path.expanduser(f"~/.amux/locks/detached/{os.getpid()}"))
except OSError:
    pass
if os.environ.get("AMUX_LAND_NOTIFY") == "0":
    sys.exit(0)
p = subprocess.Popen(["bash", amux, "send", me, "--stdin"], stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
p.communicate(msg.encode())
' ${fwd_args[@]+"${fwd_args[@]}"} > /dev/null 2>&1 < /dev/null &
    dpid=$!
    disown "$dpid" 2>/dev/null || true
    # The wrapper is its own session leader, so its pid is the process group
    # of the whole land; --cancel kills that group (gs12-gates, 2026-10-01:
    # killing the printed pid alone left the child land queued).
    mkdir -p "$HOME/.amux/locks/detached"
    printf '%s\n%s\n%s\n' "$me" "$dlog" "$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)" > "$HOME/.amux/locks/detached/$dpid"
    printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "detached land started (pid $dpid, log $dlog)" >> "$log"
    echo "amux land: detached (pid $dpid). Output: $dlog. You get a message when it lands or stops; nothing to poll. Stop it with: amux land --cancel"
    return 0
  fi
  # Each line ends with the repository's lock key, so per-repository readings
  # (--status's median hold) are not mixed with other repositories' lands.
  _land_log() { printf '%s %s %s [%s]\n' "$(date -u +%FT%TZ)" "$me" "$*" "$key" >> "$log"; echo "amux land: $*" >&2; }
  # _land_pushing <pid>: does that process have a live `git push` or pre-push
  # hook among its descendants?
  _land_pushing() {
    local frontier="$1" next found=1 p
    for _ in 1 2 3 4 5 6 7 8; do
      next=""
      for p in $frontier; do next="$next $(pgrep -P "$p" 2>/dev/null | tr '\n' ' ')"; done
      [ -n "${next// /}" ] || break
      for p in $next; do
        if ps -o command= -p "$p" 2>/dev/null | grep -qE 'git push|git-push|pre-push'; then found=0; break 2; fi
      done
      frontier="$next"
    done
    return "$found"
  }
  local deferred_logged=""

  # _land_conflicts: print the paths this land's commits conflict on against
  # the remote tip, or nothing. A land that conflicts with origin can never
  # land, so it says so and stops instead of waiting its turn (gs12-model,
  # 2026-10-01: an hour at queue position 18 for a land that could not land).
  _land_conflicts() {
    local mine; mine="${land_sha:-$(git rev-parse HEAD)}"
    git fetch -q "$remote" "$branch" 2>/dev/null || return 0
    local out; out="$(git merge-tree --write-tree --name-only "$remote/$branch" "$mine" 2>/dev/null)" && return 0
    # Paths the repo declares regenerable (amux.landRegenerable) are not
    # conflicts: the replay keeps the onto side and the push hook re-renders
    # them (gs12-data, 2026-10-02: three "nothing queued" stops on zero-base
    # generated files differing only in their source-digest line).
    local globs p g hit
    globs="$(git config --get-all amux.landRegenerable 2>/dev/null || true)"
    printf '%s\n' "$out" | sed -n '2,/^$/p' | sed '/^$/d' | while read -r p; do
      hit=0
      # shellcheck disable=SC2053  # $g is a glob on purpose
      [ -n "$globs" ] && while read -r g; do [ -n "$g" ] && [[ "$p" == $g ]] && { hit=1; break; }; done <<< "$globs"
      [ "$hit" = 1 ] || printf '%s\n' "$p"
    done | head -10 | tr '\n' ' '
  }
  [ -n "$_gvs" ] && _land_log "cleared inherited git environment before landing:$_gvs (a git init or clone under it rewrites the shared config)"
  # SHARED-CONFIG GUARD (mixpeek-override, 2026-10-03 ~13:4xZ): a lane's
  # scratch script wrote core.worktree into the shared .git/config, pointing
  # at another lane's scratchpad, and every lane's git in the main checkout and
  # un-overridden worktrees read THAT directory as the tree: phantom dirt in
  # nine lanes until someone unset it. A shared config carries no
  # core.worktree and no core.bare=true for a repository with a working tree;
  # refuse at the first land and name the value. AMUX_LAND_ALLOW_CORE_WORKTREE=1
  # for a repository that really is laid out that way.
  if [ "${AMUX_LAND_ALLOW_CORE_WORKTREE:-0}" != 1 ]; then
    local _shared_cfg _cwt _cbare
    _shared_cfg="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/config"
    _cwt="$(git config --file "$_shared_cfg" --get core.worktree 2>/dev/null || true)"
    _cbare="$(git config --file "$_shared_cfg" --get core.bare 2>/dev/null || true)"
    if [ -n "$_cwt" ] || [ "$_cbare" = true ]; then
      _land_log "refused: the shared git config $_shared_cfg sets ${_cwt:+core.worktree=$_cwt }${_cbare:+core.bare=$_cbare }; every lane's git reads that as its tree. Remove it (git config --file $_shared_cfg --unset core.worktree) and land again; nothing queued"
      return 2
    fi
  fi
  local _cf
  _cf="$(_land_conflicts)"
  if [ -n "$_cf" ]; then
    # Name the commit that was compared and where it came from: a --sha land
    # reported a stale checkout's conflicts once (mixpeek-override, 18:58Z
    # 2026-10-01) and nothing in the log could say which commit was checked.
    local _src="the checkout HEAD"
    [ -n "$land_sha" ] && _src="--sha"
    _land_log "conflicts with $remote/$branch on: $_cf; nothing queued (checked $(git rev-parse --short "${land_sha:-HEAD}") from $_src; args: ${orig_args[*]:-none}). Rebase onto $remote/$branch, resolve, and land again"
    return 2
  fi

  # FIFO (gs12-compute, 2026-10-01): with only the mkdir lock, whichever waiter
  # polled first after a release won, and one waited 6030s behind later
  # arrivals. Each waiter drops a ticket named by its arrival time and pid into
  # "$lock.q"; only the oldest live ticket may take the lock. A ticket whose pid
  # is gone is removed by whoever sees it. A holder that takes a waiter into its
  # batch writes the outcome to "$lock.r/<ticket>".
  local q="$lock.q" rdir="$lock.r" tname waited=0 announced=0 head pos t res batchable="$batch" anon_refused=0 _vchk="" _newv="" _cur_head=""
  mkdir -p "$q" "$rdir"
  # A ticket's NAME is its place: waiters, including ones started before
  # --priority existed, find the head by sorting names. Ordinary tickets are a
  # 12-digit zero-padded epoch (0017...). A priority ticket is "000" plus the
  # epoch's last 9 digits, which sorts ahead of every ordinary one and keeps
  # priority tickets in arrival order among themselves.
  if [ "$priority" = 1 ]; then
    tname="000$(printf '%09d' $(( $(date +%s) % 1000000000 )))-$$"
  else
    tname="$(printf '%012d' "$(date +%s)")-$$"
    # RESUME (mixpeek-override, 2026-10-03): a long stack that conflicted with
    # origin at its turn after an 80-95 min wait went to the BACK on its
    # re-enqueue and repeated (templates three times, data once). A conflict
    # stop records this lane's arrival time; the lane's next land within
    # AMUX_LAND_RESUME_S (default 1800) takes it back.
    local _rs="$q/.resume-$me"
    if [ -f "$_rs" ] && [ "$(sed -n 2p "$_rs" 2>/dev/null)" = "$common" ] \
       && [ $(( $(date +%s) - $(sed -n 3p "$_rs" 2>/dev/null || echo 0) )) -le "${AMUX_LAND_RESUME_S:-1800}" ]; then
      local _ra; _ra="$(sed -n 1p "$_rs")"
      if [ -n "$_ra" ] && [ "$_ra" -lt "$(date +%s)" ] 2>/dev/null; then
        tname="$(printf '%012d' "$_ra")-$$"
        printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$me" "resumed its queue place from $(date -u -r "$_ra" +%H:%MZ 2>/dev/null || echo "$_ra") after a conflict stop and rebase [$key]" >> "$log"
      fi
    fi
    rm -f -- "$_rs"
  fi
  # _land_heal_core_worktree <phase>: something inside a land hold writes
  # core.worktree=<the holder's own worktree> into the SHARED .git/config
  # (gc41 at 14:26Z, codegen-land/wt at 15:36Z, 2026-10-03), and while it is
  # there every lane's git reads that worktree as its tree. A linked worktree
  # never needs it, so the holder removes its own value after each phase and
  # logs which phase it found it after: that both ends the fleet-wide window
  # and narrows the writer down.
  _land_heal_core_worktree() {
    local phase="$1" cfg val top
    cfg="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/config"
    val="$(git config --file "$cfg" --get core.worktree 2>/dev/null || true)"
    [ -n "$val" ] || return 0
    top="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    if [ "$(cd "$val" 2>/dev/null && pwd -P)" = "$(cd "$top" 2>/dev/null && pwd -P)" ]; then
      git config --file "$cfg" --unset-all core.worktree 2>/dev/null || true
      _land_log "WARN removed core.worktree=$val from the shared $cfg after $phase (this hold's own worktree; it makes every lane's git read this tree)"
    else
      _land_log "WARN the shared $cfg holds core.worktree=$val (not this hold's worktree) after $phase; left for its owner"
    fi
  }
  # _land_leg_summary <timed log> <total s>: a pre-push leg prints its verdict
  # when it FINISHES, so a leg runs from the line printed just before its first
  # line to its own last line; log the five slowest with the push's total.
  # (.45 credited each gap to the line BEFORE it: on 2026-10-04 13:50Z it
  # reported "session-stamp 26s" for env-census's 26 s, and gs12-gates was
  # asked to speed up a 0.1 s leg, GG-63.)
  _land_leg_summary() {
    [ -s "$1" ] || return 0
    local top
    top="$(awk '
      { t=$1; sub(/s$/,"",t); line=$0; sub(/^ *[0-9.]+s /,"",line)
        if (match(line,/^[A-Za-z0-9_.-]+:/)) { leg=substr(line,1,RLENGTH-1)
          if (!(leg in seen)) { seen[leg]=1; n++; name[n]=leg; begin[leg]=prev }
          end_[leg]=t }
        prev=t }
      END { for (i=1;i<=n;i++) { d=end_[name[i]]-begin[name[i]]; if (d>=1) printf "%.0f %s\n", d, name[i] } }' "$1" \
      | sort -nr | head -5 | awk '{printf "%s%s %ss", (NR>1?", ":""), $2, $1}')"
    _land_log "push took ${2}s; slowest legs: ${top:-none over 1s}. Timed output: $1"
  }
  # _land_mark_resume: a conflict stop keeps this lane's arrival time for its
  # rebased re-enqueue (see RESUME above).
  _land_mark_resume() {
    local _arr
    case "$tname" in 000000000000-*) _arr="$(date +%s)" ;; 000*) _arr=$(( $(date +%s) / 1000000000 * 1000000000 + 10#${tname:3:9} )) ;; *) _arr=$((10#${tname%%-*})) ;; esac
    printf '%s\n%s\n%s\n' "$_arr" "$common" "$(date +%s)" > "$q/.resume-$me" 2>/dev/null || true
  }
  _land_ticket() { printf '%s\n%s\n%s\n%s\n%s\n%s\n' "$me" "${land_sha:-$(git rev-parse HEAD)}" "$common" "$batchable" "$LAND_BEHAVIOR_VERSION" "$prio_reason" > "${q:?}/${tname:?}"; }
  if [ -n "${AMUX_LAND_ADOPT:-}" ]; then
    # --adopt: take over an old-code waiter's ticket, keeping its NAME (its
    # arrival time, so its place) and only swapping the pid suffix.
    local _old="${AMUX_LAND_ADOPT}"
    tname="${_old%-*}-$$"
    # The adopting command waits for THIS marker, never for a name match: a
    # same-second ticket of another lane shares the prefix (gs12-tiering,
    # 2026-10-02: adopt reported another lane's pid and its own was dropped).
    if [ "$_old" = "$tname" ]; then
      # Self-upgrade: the waiter exec'd the new code in place, same pid, so
      # the ticket already has the right name.
      [ -e "${q:?}/${tname:?}" ] || die "amux land: ticket $tname vanished during self-upgrade; nothing to resume"
      _land_log "self-upgraded at its place to $LAND_BEHAVIOR_VERSION (ticket $tname, pid $$)"
    elif ! mv -- "${q:?}/${_old:?}" "${q:?}/${tname:?}" 2>/dev/null; then
      echo gone > "${q:?}/.adopt-${_old##*-}"
      die "amux land --adopt: ticket $_old is gone; nothing adopted"
    else
      echo "$tname" > "${q:?}/.adopt-${_old##*-}"
      _land_log "adopted ticket ${_old} (land code $(sed -n 5p "${q:?}/${tname:?}" 2>/dev/null || echo ?)) at its place, now on $LAND_BEHAVIOR_VERSION"
    fi
  fi
  _land_ticket
  if [ "$priority" = 1 ]; then
    local _ord=0 _f
    for _f in "$q"/*; do [ -e "$_f" ] || continue; case "${_f##*/}" in 000*) ;; *) _ord=$((_ord + 1)) ;; esac; done
    # Only a real priority ticket says so: an adopted (demoted) name re-exec'd
    # with --priority still in its arguments logged this and read as the
    # demote being undone (gs12-templates 01:15Z and 03:16Z, 2026-10-03).
    [ "${tname:0:3}" = 000 ] && _land_log "queued with --priority ahead of $_ord ordinary waiter(s); reason: $prio_reason"
  fi
  # Expanded NOW: these are locals, gone by the time an EXIT trap runs, and a
  # `${x:?}` guard on an unset name fails the exit status (rc 1 on success).
  # shellcheck disable=SC2064  # expanded now on purpose, see the comment above
  trap "rm -f -- '${q:?}/${tname:?}' '${rdir:?}/${tname:?}'" EXIT
  # INT/TERM must END the process, then EXIT cleans up. A trap that only ran
  # the cleanup let a cancelled waiter live on, and its HEAD refresh rewrote
  # the ticket: gs12-mvs's 13730 survived `--cancel` and took main at 14:46:01Z
  # (2026-10-02). The holder's lock trap below relies on this too.
  trap 'exit 143' INT TERM
  while :; do
    if [ -f "${rdir:?}/${tname:?}" ]; then
      res="$(cat "${rdir:?}/${tname:?}")"; rm -f -- "${rdir:?}/${tname:?}"
      case "$res" in
        landed\ *)
          if [ -n "$land_sha" ]; then
            rm -f -- "${q:?}/${tname:?}"
            _land_log "landed in a batch: ${res#landed } (--sha $(git rev-parse --short "$land_sha"))"
            return 0
          fi
          # Bring a CLEAN checkout to the tip; a dirty one is left as it is
          # (the lane is working in it) and told so below.
          if [ -z "$(git status --porcelain --untracked-files=no 2>/dev/null)" ]; then
            if git fetch -q "$remote" "$branch" && ! git rebase -q "$remote/$branch" 2>/dev/null; then
              git rebase --abort 2>/dev/null || true
            fi
          else
            git fetch -q "$remote" "$branch" 2>/dev/null || true
            if [ -z "$(git log --format=%H --cherry-pick --right-only "$remote/$branch...HEAD" 2>/dev/null)" ]; then
              rm -f -- "${q:?}/${tname:?}"
              _land_log "landed in a batch: ${res#landed }; checkout left as is (uncommitted changes), rebase onto $remote/$branch when ready"
              return 0
            fi
          fi
          if [ -z "$(git rev-list "$remote/$branch..HEAD" 2>/dev/null)" ]; then
            rm -f -- "${q:?}/${tname:?}"
            _land_log "landed in a batch: ${res#landed }; this checkout is now at $remote/$branch"
            return 0
          fi
          # Committed more while queued: the rest keeps this ticket's place.
          _land_ticket
          _land_log "a batch landed part of this checkout (${res#landed }); the rest keeps its place in the queue"
          ;;
        *excluded:\ its\ commits\ conflict*)
          _cf="$(_land_conflicts)"
          if [ -n "$_cf" ]; then
            rm -f -- "${q:?}/${tname:?}"
            _land_mark_resume
            _land_log "left out of a batch: conflicts with $remote/$branch itself on: $_cf; stopping, since it cannot land. Rebase, resolve, and land again within ${AMUX_LAND_RESUME_S:-1800}s to keep this place"
            return 2
          fi
          _land_log "left out of a batch ($res); conflicts only with the batch ahead, not with $remote/$branch; keeping its place"
          ;;
        *refused\ the\ batch\ on\ your\ commit*)
          rm -f -- "${q:?}/${tname:?}"
          _land_log "the push hook refused a batch on this lane's commit (MO-4104); stopping. ${res#excluded: }"
          printf 'amux land: %s\n' "$res" >&2
          return 1
          ;;
        *)
          # After a refused batch nobody knows whose commit was refused, so
          # this lane lands alone rather than poisoning the next batch too.
          # A refusal that named nobody used to make every waiter in that batch
          # solo for good; with blame read from FAIL lines and the composed
          # precheck, one anonymous refusal is not evidence against this lane
          # (2026-10-02: four lanes went solo after one 07:42Z batch, about an
          # hour of extra drain on a 15-deep queue). The second one is: go solo,
          # marked "0r" so --adopt can tell it from a lane's own --no-batch.
          # A refusal whose named files are all outside this lane's own commits
          # is not evidence against it either: gates' 13-lane batch at 01:08Z
          # on 2026-10-03 was refused by two defects already on origin
          # (gke_ephemeral.sh, a spec schema path), and 12 innocent tickets went
          # solo at 10-15 min each. Count it only when the output names a file
          # this lane touched, or names no file at all.
          case "$res" in *refused*)
            if _land_refusal_spares "$res" "$(sed -n 2p "$q/$tname" 2>/dev/null)" "$remote/$branch"; then
              _land_log "batch refusal named only files outside this lane's commits; not counted against it (still batchable)"
            else
              anon_refused=$((anon_refused + 1))
              [ "$anon_refused" -ge 2 ] && [ "$batchable" = 1 ] && { batchable="0r"; _land_ticket; }
            fi ;;
          esac
          _land_log "left out of a batch ($res); keeping its place in the queue"
          ;;
      esac
    fi
    # Keep the ticket's commit current: a batch replays what the ticket names,
    # and a lane that rebased while waiting was excluded for conflicts its
    # queue-time commit had (gs12-planes, 2026-10-01: three exclusions after a
    # clean rebase at 18:25Z).
    if [ -z "$land_sha" ] && [ -f "${q:?}/${tname:?}" ] && [ "$(sed -n 2p "$q/$tname")" != "$(git rev-parse HEAD 2>/dev/null)" ]; then
      _land_ticket
    fi
    # Already landed? A ticket whose commit is an ancestor of the remote tip
    # has nothing left to push: another holder's batch carried it. Such a
    # waiter used to sit in the queue until its own turn, skipped by every
    # batch ("already in the stack"): gs12-compute's 8a794fe3d76 waited 244
    # min on 2026-10-03 after it had landed. Reads the local remote ref, which
    # every land in the repository keeps fresh; no fetch per poll.
    local _tk_sha
    _tk_sha="$(sed -n 2p "${q:?}/${tname:?}" 2>/dev/null || true)"
    if [ -n "$_tk_sha" ] && git merge-base --is-ancestor "$_tk_sha" "$remote/$branch" 2>/dev/null; then
      rm -f -- "${q:?}/${tname:?}"
      _land_log "already on $remote/$branch ($(git rev-parse --short "$_tk_sha") landed in another holder's batch); leaving the queue, nothing left to land"
      return 0
    fi
    for t in "$q"/*; do
      [ -e "$t" ] || continue
      kill -0 "${t##*-}" 2>/dev/null || { _land_log "dropped the ticket of a waiter that exited ($(head -1 "$t" 2>/dev/null || echo ?), pid ${t##*-})"; rm -f -- "${t:?}"; }
    done
    head="$(ls "$q" | sort | head -1)"
    # SELF-UPGRADE (mixpeek-override, 2026-10-02: every land release cost a
    # broadcast to 8-11 lanes, and lanes that missed it kept the old failure
    # mode in the batch). A WAITER whose installed CLI now carries a different
    # LAND_BEHAVIOR_VERSION re-execs the new code in place: same pid, so the
    # same ticket name, place and flags, and a foreground land keeps its
    # output. Checked every 30 s, never by a holder. AMUX_LAND_SELF_UPGRADE=0
    # opts out.
    if [ "${AMUX_LAND_SELF_UPGRADE:-1}" = 1 ] && [ $(( $(date +%s) - ${_vchk:-0} )) -ge 60 ]; then
      _vchk=$(date +%s)
      _newv="$(grep -m1 '^LAND_BEHAVIOR_VERSION=' "$0" 2>/dev/null | cut -d'"' -f2 || true)"
      if [ -n "$_newv" ] && [ "$_newv" != "$LAND_BEHAVIOR_VERSION" ] && [ -e "${q:?}/${tname:?}" ]; then
        _land_log "land code $_newv is installed (this waiter runs $LAND_BEHAVIOR_VERSION); re-executing at its place"
        trap - EXIT INT TERM
        # Made batchable after starting with --no-batch: carry that across the
        # exec, which replays the original arguments.
        [ "$batchable" = 1 ] && [ "$batch" != 1 ] && printf 'self-upgrade\n' > "${q:?}/.batch-$$"
        local _ex=() _skip=0 _x
        for _x in ${orig_args[@]+"${orig_args[@]}"}; do
          if [ "$_skip" = 1 ]; then _skip=0; continue; fi
          if [ "$_x" = "--sha" ] && [ -z "$land_sha" ]; then _skip=1; continue; fi
          _ex+=("$_x")
        done
        AMUX_LAND_ADOPT="$tname" AMUX_LAND_PRECHECKED=1 AMUX_LAND_PRIORITY_CHECKED=1 exec bash "$0" land ${_ex[@]+"${_ex[@]}"}
      fi
    fi
    # HEAD marker (`amux land --adopt --head`): stop pinning, follow HEAD.
    if [ -e "${q:?}/.head-$$" ]; then
      if [ -n "$land_sha" ]; then
        _land_log "now follows its checkout's HEAD (was pinned to $(git rev-parse --short "$land_sha" 2>/dev/null || echo ?)); marked by $(cat "${q:?}/.head-$$" 2>/dev/null || echo ?)"
        land_sha=""
      fi
      rm -f -- "${q:?}/.head-$$"
    fi
    # A ticket that follows HEAD carries the CURRENT HEAD, so a holder that
    # batches it takes commits made after queueing (gs12-mvs, 2026-10-02).
    if [ -z "$land_sha" ]; then
      _cur_head="$(git rev-parse HEAD 2>/dev/null || true)"
      if [ -n "$_cur_head" ] && [ "$_cur_head" != "$(sed -n 2p "${q:?}/${tname:?}" 2>/dev/null || true)" ]; then
        _land_ticket
        _land_log "ticket refreshed to HEAD $(git rev-parse --short "$_cur_head")"
      fi
    fi
    # BATCH marker (`amux land --adopt --batch` on a current ticket).
    if [ -e "${q:?}/.batch-$$" ]; then
      if [ "$batchable" != 1 ]; then
        batchable=1; _land_ticket
        _land_log "made batchable by $(cat "${q:?}/.batch-$$" 2>/dev/null || echo ?) (--adopt --batch)"
      fi
      rm -f -- "${q:?}/.batch-$$"
    fi
    # DEMOTE (MO-4102): `amux land --demote <lane>` leaves "$q/.demote-<pid>";
    # the waiter moves ITS OWN priority ticket back into ordinary order at its
    # arrival time, the same self-rename aging does in the other direction.
    if [ -e "${q:?}/.demote-$$" ] && [ "${tname:0:3}" = "000" ]; then
      _demoted_self=1
      local demoted _arr
      _arr=$(( $(date +%s) / 1000000000 * 1000000000 + 10#${tname:3:9} ))
      demoted="$(printf '%012d' "$_arr")-$$"
      if mv -- "${q:?}/${tname:?}" "${q:?}/${demoted:?}" 2>/dev/null; then
        _land_log "demoted by $(cat "${q:?}/.demote-$$" 2>/dev/null || echo ?): ticket back in ordinary order at its arrival time"
        tname="$demoted"
        # The demote sticks: every re-exec (self-upgrade on a new install, a
        # lost lock) replays orig_args, and --priority came back each time
        # (templates' pid 83291 re-queued with priority three times after two
        # demotes, 2026-10-03). Drop it and its --reason from the replay too.
        priority=0
        local _da=() _dskip=0 _dx
        for _dx in ${orig_args[@]+"${orig_args[@]}"}; do
          if [ "$_dskip" = 1 ]; then _dskip=0; continue; fi
          case "$_dx" in --priority) continue ;; --reason) _dskip=1; continue ;; esac
          _da+=("$_dx")
        done
        orig_args=(${_da[@]+"${_da[@]}"})
        # shellcheck disable=SC2064  # expanded now on purpose: locals are gone when the trap runs
        trap "rm -f -- '${q:?}/${tname:?}' '${rdir:?}/${tname:?}'" EXIT
        head="$(ls "$q" | sort | head -1)"
      fi
      rm -f -- "${q:?}/.demote-$$"
    fi
    # AGING (gs12-retrievers, 2026-10-01: the first ordinary ticket waited
    # 4h20m while four --priority tickets passed it). Past
    # AMUX_LAND_PRIORITY_AGING_S (default 14400; 7200 until 2026-10-02, when the
    # orchestrator chose 4 h so a granted gate fix outranks a 2 h waiter but not
    # a 4 h one) an ordinary waiter renames ITS
    # OWN ticket into the priority range, keeping its arrival time, so plain
    # name order (what every waiter, old or new, serves by) puts it ahead of
    # priority tickets that arrived after it. Only a ticket's own waiter
    # renames it.
    # Never re-age a ticket this waiter was demoted out of: the next poll aged
    # it straight back, so --demote was a no-op on exactly the old tickets it
    # exists for (mixpeek-override, 2026-10-02).
    # The threshold is also readable from the repository's git config
    # (amux.landPriorityAgingS), read on every poll, so an operator can park
    # aging for a night without restarting a single waiter (mixpeek-override,
    # 2026-10-03: aged tickets stacked ahead of the one gate fix).
    local _age_s; _age_s="$(git config --get amux.landPriorityAgingS 2>/dev/null || true)"
    _age_s="${_age_s:-${AMUX_LAND_PRIORITY_AGING_S:-14400}}"
    # TO HEAD: `amux land --to-head <pid>` leaves "$q/.tohead-<pid>" (".head-"
    # is --adopt --head's marker, which consumed it first); the waiter
    # renames its own ticket to the front of the queue, ahead of every
    # priority ticket, keeping its pid.
    if [ -e "${q:?}/.tohead-$$" ] && [ "${tname#000000000000-}" = "$tname" ]; then
      local _hd="000000000000-$$"
      if mv -- "${q:?}/${tname:?}" "${q:?}/${_hd}" 2>/dev/null; then
        _land_log "moved to the head of the queue by $(head -1 "${q:?}/.tohead-$$" 2>/dev/null || echo ?): $(sed -n 2p "${q:?}/.tohead-$$" 2>/dev/null)"
        tname="$_hd"; _demoted_self=1
        # shellcheck disable=SC2064  # expanded now on purpose: locals are gone when the trap runs
        trap "rm -f -- '${q:?}/${tname:?}' '${rdir:?}/${tname:?}'" EXIT
        head="$(ls "$q" | sort | head -1)"
      fi
      rm -f -- "${q:?}/.tohead-$$"
    fi
    if [ "${_demoted_self:-0}" != 1 ] && [ "${tname:0:3}" != "000" ] && [ $(( $(date +%s) - 10#${tname%%-*} )) -gt "$_age_s" ]; then
      local aged
      aged="000$(printf '%09d' $(( 10#${tname%%-*} % 1000000000 )))-$$"
      if mv -- "${q:?}/${tname:?}" "${q:?}/${aged:?}" 2>/dev/null; then
        _land_log "waited past ${_age_s}s; ticket aged into the priority order at its arrival time"
        tname="$aged"
        # shellcheck disable=SC2064  # expanded now on purpose: locals are gone when the trap runs
        trap "rm -f -- '${q:?}/${tname:?}' '${rdir:?}/${tname:?}'" EXIT
        head="$(ls "$q" | sort | head -1)"
      fi
    fi
    if [ "$head" = "$tname" ] && mkdir "$lock" 2>/dev/null; then break; fi
    local hpid hsince hwho
    hpid="$(cat "$lock/pid" 2>/dev/null || true)"; hwho="$(cat "$lock/who" 2>/dev/null || true)"
    # No `since` yet means a holder between its mkdir and its first write.
    # Reading that as 0 made it look decades old: gs12-cicd deleted
    # gs12-retrievers' brand-new lock at 12:10:44Z and two lanes pushed at
    # once. The directory's own mtime is the floor.
    hsince="$(cat "$lock/since" 2>/dev/null || stat -f %m "$lock" 2>/dev/null || stat -c %Y "$lock" 2>/dev/null || date +%s)"
    # Only the head of the queue may take a lock over, so waiters behind it
    # cannot race each other into the same decision.
    # A holder whose `git push` or pre-push hook is still running is slow,
    # not stuck: taking it over makes it lose its race and re-run a 50-minute
    # gate (mixpeek-override, 2026-10-01, on gs12-gates' .githooks push). Time
    # takes over only a holder with no push in flight, or one past a hard cap
    # of 3x --max-hold, so a truly hung push cannot block the queue forever.
    local held_s=$(( $(date +%s) - ${hsince:-$(date +%s)} )) timed_out=0
    if [ "$held_s" -gt "$max_hold" ]; then
      if [ -n "$hpid" ] && _land_pushing "$hpid" && [ "$held_s" -le $(( max_hold * 3 )) ]; then
        [ "${deferred_logged:-}" = "$hpid" ] || _land_log "holder ${hwho:-?} (pid $hpid) passed --max-hold ${max_hold}s with its push still running; waiting (hard cap $(( max_hold * 3 ))s)"
        deferred_logged="$hpid"
      else
        timed_out=1
      fi
    fi
    if [ "$head" = "$tname" ] && [ -d "$lock" ] && { { [ -n "$hpid" ] && ! kill -0 "$hpid" 2>/dev/null; } || [ "$timed_out" = 1 ]; }; then
      if [ -n "$hpid" ] && kill -0 "$hpid" 2>/dev/null; then
        _land_log "taking over a lock on $branch whose current attempt passed --max-hold ${max_hold}s (holder ${hwho:-?} pid $hpid STILL ALIVE, attempt since $hsince); its push may still land"
      else
        _land_log "taking over a stale lock on $branch (holder ${hwho:-?} pid ${hpid:-?} is gone, since $hsince)"
      fi
      rm -rf -- "${lock:?}"; continue
    fi
    if [ "$announced" = 0 ]; then
      pos="$(ls "$q" | sort | grep -n -x -F "$tname" | cut -d: -f1)"
      if [ -n "$hwho" ]; then
        _land_log "waiting: $branch is being landed by $hwho (pid ${hpid:-?}); queue position ${pos:-?}"
      else
        _land_log "waiting: queue position ${pos:-?} on $branch, behind $(head -1 "$q/$head" 2>/dev/null || echo ?)"
      fi
      announced=1
    fi
    # Only the first two waiters need a 5 s poll (the head takes the lock, the
    # next one is ready behind it). Every poll forks the whole interpreter a few
    # dozen times, and at ~36 waiters that was about 4 cores of a 28-core host
    # at load 40 (mixpeek-override, 2026-10-03 05:16Z; MO-3964), enough to push
    # the composed precheck past its budget. The rest poll every
    # AMUX_LAND_WAIT_POLL_S (default 30).
    local _ps=5 _top2
    _top2="$(ls "$q" 2>/dev/null | sort | head -2)"
    case $'\n'"$_top2"$'\n' in *$'\n'"$tname"$'\n'*) ;; *) _ps="${AMUX_LAND_WAIT_POLL_S:-30}" ;; esac
    sleep "$_ps"; waited=$((waited + _ps))
  done
  rm -f -- "${q:?}/${tname:?}"
  echo $$ > "$lock/pid"; date +%s > "$lock/since"; echo "$me" > "$lock/who"
  # shellcheck disable=SC2064  # $lock is a local: it must be expanded when the trap is set
  # Remove the lock only while this process still owns it. An unconditional
  # rm deleted the NEXT holder's lock after a takeover (2026-10-01 11:18Z:
  # gs12-model's exit freed gs12-spend's hold and gs12-mvs pushed beside it).
  # A hold cancelled by another lane (--cancel-for) names who and why in the
  # holder's OWN output: gs12-compute's detached log ended at "batching ..."
  # with neither, and it read as a crash (2026-10-02 20:31Z).
  trap "[ -f '${lock:?}/cancelled' ] && [ \"\$(cat '${lock:?}/pid' 2>/dev/null)\" = '$$' ] && echo \"amux land: this hold was cancelled \$(cat '${lock:?}/cancelled'); nothing was pushed for this attempt\"; [ \"\$(cat '${lock:?}/pid' 2>/dev/null)\" = '$$' ] && rm -rf -- '${lock:?}'" EXIT
  [ "$waited" -gt 0 ] && _land_log "acquired $branch after waiting ${waited}s"

  # LANDING WINDOW (Ethan, 2026-10-04 15:31 ET, harness efficiency): with
  # `git config amux.landMinIntervalS N`, a holder whose branch was pushed less
  # than N seconds ago keeps the lock until N has passed, so waiters that
  # arrive meanwhile join its batch. Mixpeek pushed every 3 to 5 min against a
  # 17-min Fast Checks run, so every run was superseded and none with shards
  # concluded that day. Priority holders do not wait. Unset or 0: unchanged.
  local _win; _win="$(git config --get amux.landMinIntervalS 2>/dev/null || true)"
  case "$_win" in ''|*[!0-9]*) _win=0 ;; esac
  # Which priority holders skip the window: grants and fix-forwards always;
  # a gate-path-only priority too unless `amux.landWindowExemptGatePath` is
  # false (mixpeek-override narrowed it on 2026-10-04 after 5 gate-path
  # priority pushes in one hour went around a 15-minute window).
  local _win_skip=0
  if [ "$priority" = 1 ]; then
    if [ "$(git config --bool --get amux.landWindowExemptGatePath 2>/dev/null || echo true)" != false ] \
       || printf '%s' "${prio_reason:-}" | grep -qiE -- "${AMUX_LAND_PRIORITY_GRANT_RE:-grant}|${AMUX_LAND_PRIORITY_FIXFWD_RE:-fix[- ]?forward}"; then
      _win_skip=1
    else
      _land_log "landing window applies to this --priority push: amux.landWindowExemptGatePath is false and its reason names no grant or fix-forward"
    fi
  fi
  if [ "$_win" -gt 0 ] && [ "$_win_skip" = 0 ] && [ -f "$lock.lastpush" ]; then
    local _lp _rem; _lp="$(cat "$lock.lastpush" 2>/dev/null || echo 0)"
    case "$_lp" in ''|*[!0-9]*) _lp=0 ;; esac
    _rem=$(( _lp + _win - $(date +%s) ))
    if [ "$_rem" -gt 0 ]; then
      _land_log "landing window: $branch was pushed $(( $(date +%s) - _lp ))s ago; holding ${_rem}s so this push carries the waiters that queue meanwhile (amux.landMinIntervalS=$_win)"
      sleep "$_rem"
      date +%s > "$lock/since"
    fi
  fi

  # _land_stack <tip>: replay queued waiters' commits onto <tip>. Sets
  # stack_tip and stack_in ("<ticket> <lane>" lines) in this shell. A waiter it
  # cannot take is told why and keeps its place.
  local stack_tip stack_in
  _land_stack() {
    # Batch size: --batch-max, then AMUX_LAND_BATCH_MAX, then the REPOSITORY's
    # `git config amux.landBatchMax` (shared by every worktree, read at each
    # push, so one command retunes a whole queue without restarting a land;
    # mixpeek-override, 2026-10-02, depth 30), then 6.
    local max="$batch_max"
    [ -n "$max" ] || max="$(git config --get amux.landBatchMax 2>/dev/null || true)"
    case "$max" in ''|*[!0-9]*) max=6 ;; esac
    local n=0 tk who wsha wcommon wbatch base c tree msg new t0 ok seen=" " made
    stack_tip="$1"; stack_in=""; stack_map=""
    # Every skip names itself (mixpeek-override, 2026-10-02 16:09Z: 7 of 22
    # batchable waiters were left out with no log line, and no check rerun
    # afterwards could say why). One line per ticket per stack build.
    local _st0; _st0=$(date +%s)
    _sk() { _land_log "batch skipped $(head -1 "$q/$1" 2>/dev/null || echo ?) ticket $1: $2"; }
    [ "$batch" = 1 ] && [ "$max" -gt 0 ] || return 0
    for tk in $(ls "$q" 2>/dev/null | sort); do
      [ "$n" -lt "$max" ] || break
      # A --priority ticket lands alone in both roles (gs12-gates, 2026-10-01:
      # gs12-cicd batched its priority ticket at 16:57Z).
      # A GRANTED priority ticket (its reason on line 6) lands alone; an AGED one
      # (no reason) batches like any other: five aged tickets each took a solo
      # holder turn, about 2.7 h for a queue one batch clears (mixpeek-override,
      # 2026-10-02 14:35Z).
      case "$tk" in 000*) [ -n "$(sed -n 6p "$q/$tk" 2>/dev/null || true)" ] && continue ;; esac
      case "$batch_skip" in *" $tk "*) continue ;; esac
      kill -0 "${tk##*-}" 2>/dev/null || { _sk "$tk" "its waiter is gone"; continue; }
      who=""; wsha=""; wcommon=""; wbatch=""
      { read -r who; read -r wsha; read -r wcommon; read -r wbatch; } < "$q/$tk" 2>/dev/null || true
      [ "$wbatch" = 1 ] || { _sk "$tk" "not batchable (flag ${wbatch:-?})"; continue; }
      [ "$wcommon" = "$common" ] || { _sk "$tk" "another repository ($wcommon)"; continue; }
      git cat-file -e "$wsha^{commit}" 2>/dev/null || { _sk "$tk" "commit ${wsha:0:10} not in this object store"; continue; }
      # One lane with two land processes queues the same commit twice
      # (gs12-restore, 2026-10-01); replaying it again adds an empty duplicate.
      case "$seen" in *" $wsha "*) _sk "$tk" "same commit as a ticket already in the batch"; continue ;; esac
      seen="$seen$wsha "
      base="$(git merge-base "$stack_tip" "$wsha" 2>/dev/null)" || { _sk "$tk" "no merge base with the stack"; continue; }
      [ "$base" != "$wsha" ] || { _sk "$tk" "${wsha:0:10} is already in the stack"; continue; }
      if [ -n "$(git rev-list --merges "$base..$wsha")" ]; then
        echo "excluded: its range contains a merge commit" > "$rdir/$tk"; continue
      fi
      t0="$stack_tip"; ok=1; made=""
      for c in $(git rev-list --reverse "$base..$wsha"); do
        tree="$(_land_pick_tree "$stack_tip" "$c")" || { ok=0; break; }
        [ -n "$tree" ] || { ok=0; break; }
        # Already in the stack (an equal change landed ahead): nothing to add.
        [ "$tree" != "$(git rev-parse "$stack_tip^{tree}")" ] || continue
        msg="$(git log -1 --format=%B "$c")"
        new="$(GIT_AUTHOR_NAME="$(git log -1 --format=%an "$c")" GIT_AUTHOR_EMAIL="$(git log -1 --format=%ae "$c")" \
               GIT_AUTHOR_DATE="$(git log -1 --format=%aD "$c")" git commit-tree "$tree" -p "$stack_tip" -m "$msg")" || { ok=0; break; }
        stack_tip="$new"; made="$made $new $c"
      done
      if [ "$ok" = 0 ]; then
        stack_tip="$t0"
        echo "excluded: its commits conflict with the batch ahead of it" > "$rdir/$tk"; continue
      fi
      [ "$stack_tip" != "$t0" ] || { _sk "$tk" "replaying ${wsha:0:10} adds nothing to the stack (its changes are already in it)"; continue; }
      stack_in="${stack_in}${tk} ${who}
"
      stack_map="${stack_map}${tk}${made}
"
      n=$((n + 1))
    done
    if [ -n "$stack_in" ]; then
      _land_log "stack built in $(( $(date +%s) - _st0 ))s ($(printf '%s' "$stack_in" | grep -c .) waiter(s))"
    fi
    return 0
  }
  # _land_named_waiters <verdict lines> <batch tip>: tickets of batched
  # waiters whose commits (replayed or original) a FAILURE line names by a 10+
  # character sha prefix. Only the verdict lines, and never the tip: the hook
  # prints the commit it gates (the tip, the last waiter's replayed commit) on
  # a status line, and that read as blame (gs12-compute, 2026-10-02, stopped
  # for an ops-registry refusal its commits did not touch).
  _land_named_waiters() {
    local line tk c hit
    while read -r line; do
      [ -n "$line" ] || continue
      tk="${line%% *}"; hit=""
      for c in ${line#* }; do
        # The tip counts only as the SUBJECT of a line ("  675c52705d drops 8 of
        # the 8 lines ..."): as context ("red at <tip>") it named the wrong lane,
        # but skipping it outright dropped all three waiters of retrievers'
        # 18:52Z batch when the tip's own commit was the one refused.
        if [ "${c:0:10}" = "${2:0:10}" ]; then
          printf '%s\n' "$1" | grep -qiE -- "^[[:space:]]*${c:0:10}[0-9a-f]* (drops|reverts|removes|adds|re-adds|deletes|touches)" && { hit=1; break; }
          continue
        fi
        printf '%s' "$1" | grep -qi -- "${c:0:10}" && { hit=1; break; }
      done
      [ -n "$hit" ] && printf '%s ' "$tk"
    done <<< "$stack_map"
    _land_file_named_waiters "$1"
  }
  # _land_blame_lines <full output>: the failure lines, plus every line of a
  # FAILED leg ("qdrant-refs: ✗ REFUSED" then "qdrant-refs:  <file>: 10
  # reference(s)"): a leg names its files on detail lines that carry no failure
  # word, so blame never saw them and a 15-ticket batch sent its holder alone
  # (2026-10-02 12:39Z). Lines saying they are not a refusal never count.
  _land_blame_lines() {
    local fail legs
    fail="$(printf '%s\n' "$1" | grep -E '✗|FAIL|BLOCKED|REFUSED|refus|^error:|^fatal:' | grep -viE 'not refused|not a refusal' || true)"
    legs="$(printf '%s\n' "$fail" | grep -oE '^[A-Za-z0-9_.-]+:' | sort -u || true)"
    printf '%s\n' "$fail"
    # The indented block under a failure line is its detail ("stale-copy-drop:
    # ✗ ..." then "  675c52705d drops 8 of the 8 lines ..."), with no leg prefix
    # for the grep below to find (retrievers' 18:52Z batch, 2026-10-02).
    printf '%s\n' "$1" | awk '
      /✗|FAIL|BLOCKED|REFUSED|refus|^error:|^fatal:/ && !/not refused|not a refusal/ { inb = 1; next }
      inb && /^[[:space:]]+[^[:space:]]/ { print; next }
      { inb = 0 }' || true
    [ -n "$legs" ] || return 0
    printf '%s\n' "$1" | grep -F -f <(printf '%s\n' "$legs") | grep -viE 'not refused|not a refusal' || true
  }
  # _land_file_named_waiters <verdict lines>: tickets whose ORIGINAL commits
  # touch a file a failure line names ("FAIL (committed content): <file> has
  # ruff lint violations"). Only when EVERY named file belongs to some waiter:
  # a file no waiter touches (drift already on main, or the holder's own) fails
  # every composition, so dropping waiters for it would be wrong and the holder
  # goes alone as before. mixpeek-override, 2026-10-02 11:37Z: a batch of 11
  # refused on files owned by two lanes landed 1 ticket instead of 8.
  _land_file_named_waiters() {
    local paths line tk c f owned="" all=1 owners=""
    # Every path on a FAILURE line; on a leg's detail lines only a path written
    # as a subject ("<file>:" or "<file>:14:1:"), never one inside a hint such
    # as "python3 scripts/ci/check_no_qdrant_refs.py --update-baseline".
    local _pre='(\.?[A-Za-z0-9_@+-]+/)+\.?[A-Za-z0-9_@+.-]+'
    paths="$( { printf '%s\n' "$1" | grep -E '✗|FAIL|BLOCKED|REFUSED|refus|^error:|^fatal:' | grep -oE "$_pre" || true
               printf '%s\n' "$1" | grep -vE '✗|FAIL|BLOCKED|REFUSED|refus|^error:|^fatal:' | grep -oE "$_pre:" | sed 's/:$//' || true; } \
             | grep -E '\.' | sort -u)"
    [ -n "$paths" ] || return 0
    while read -r line; do
      [ -n "$line" ] || continue
      tk="${line%% *}"
      local files="" i=0
      for c in ${line#* }; do
        i=$((i + 1)); [ $((i % 2)) = 0 ] || continue   # pairs are "replayed original"
        files="$files
$(git diff-tree --no-commit-id --name-only -r "$c" 2>/dev/null || true)"
      done
      while read -r f; do
        [ -n "$f" ] || continue
        if printf '%s\n' "$files" | grep -qxF -- "$f"; then
          owned="$owned
$f"
          case " $owners " in *" $tk "*) ;; *) owners="$owners $tk" ;; esac
        fi
      done <<< "$paths"
    done <<< "$stack_map"
    while read -r f; do
      [ -n "$f" ] || continue
      printf '%s\n' "$owned" | grep -qxF -- "$f" || { all=0; break; }
    done <<< "$paths"
    if [ "$all" = 1 ] && [ -n "$owners" ]; then
      printf '%s ' $owners
    elif [ -n "$owners" ]; then
      _land_log "a refusal names files of waiters ($owners) and files no waiter touches; not dropping anyone on a partial match"
    fi
  }
  # _land_tell <message>: write the outcome to every batched waiter; a landed
  # waiter's ticket is removed so the next holder does not batch it again.
  _land_tell() {
    local tk rest
    while read -r tk rest; do
      [ -n "$tk" ] || continue
      echo "$1" > "$rdir/$tk"
      case "$1" in landed\ *) rm -f -- "${q:?}/${tk:?}" ;; esac
    done <<< "$stack_in"
  }

  local i out rc full verdicts lanes solo=0 _force_replay=0 batch_skip=" " stack_map="" named
  # A --priority holder lands alone again (mixpeek-override, 2026-10-02: the
  # granted one-line Fast Checks fix batched six lanes, 23 min into the gate,
  # and any one of them could refuse it). AMUX_LAND_PRIORITY_BATCH=1 restores
  # MO-4077's batching for a holder that wants it.
  [ "$priority" = 1 ] && [ "${AMUX_LAND_PRIORITY_BATCH:-0}" != 1 ] && solo=1
  for i in $(seq 1 "$tries"); do
    # --max-hold bounds ONE attempt, not the whole hold. A batch, its refusal
    # and the solo re-push ran past 3600s on 2026-10-01 and a waiter took over
    # a live holder mid-push (11:09Z). A takeover also checks the pid is gone
    # or this stamp is older than --max-hold.
    # Still ours? A holder whose lock was taken over must not push beside the
    # new holder; it re-queues from scratch instead.
    if [ "$(cat "$lock/pid" 2>/dev/null)" != "$$" ]; then
      _land_log "lost the lock on $branch to $(cat "$lock/who" 2>/dev/null || echo ?) before attempt $i; re-queuing"
      trap - EXIT INT TERM
      exec bash "$0" land ${orig_args[@]+"${orig_args[@]}"}
    fi
    date +%s > "$lock/since"
    rm -f "${TMPDIR:-/tmp}/amux-land-regen.$$"
    git fetch -q "$remote" "$branch" || { _land_log "fetch failed (attempt $i)"; sleep 5; continue; }
    # A dirty tree cannot be rebased, and a lane often keeps working while its
    # land waits hours (gs12-templates, 2026-10-01). Land HEAD by replay then,
    # never touching the tree; a clean tree still rebases so HEAD is the
    # pushed commit and the hook takes its fast path.
    local _replay_head=""
    if [ -z "$land_sha" ] && [ "${_force_replay:-0}" = 1 ]; then
      _replay_head="$(git rev-parse HEAD)"
    elif [ -z "$land_sha" ] && [ -n "$(git status --porcelain --untracked-files=no 2>/dev/null)" ]; then
      _replay_head="$(git rev-parse HEAD)"
      _land_log "checkout has uncommitted changes; landing HEAD $(git rev-parse --short HEAD) by replay without touching the tree"
    elif [ -z "$land_sha" ] && [ "${AMUX_LAND_REBASE_CHECKOUT:-0}" != 1 ]; then
      # Never rebase inside the lane's checkout (gs12-cicd, 2026-10-03): a
      # holder's `git rebase` checks origin's tree out into the worktree, and
      # when it conflicted (13:28Z, zb-evals.yml) and the abort did not fully
      # restore a sparse worktree, the checkout was left with origin's files
      # under the stack's HEAD and index: 2,331 files "changed", and any
      # uncommitted work there would have been overwritten. Replay builds the
      # same commits with no checkout at all. AMUX_LAND_REBASE_CHECKOUT=1
      # restores the old clean-tree rebase.
      _replay_head="$(git rev-parse HEAD)"
    fi
    if [ -n "$land_sha$_replay_head" ]; then
      local land_sha_eff="${land_sha:-$_replay_head}"
      # Replay the commit's own range onto the remote tip, no checkout.
      local own_tip c tree base
      own_tip="$(git rev-parse "$remote/$branch")"
      base="$(git merge-base "$own_tip" "$land_sha_eff")"
      if [ "$base" != "$land_sha_eff" ]; then
        for c in $(git rev-list --reverse "$base..$land_sha_eff"); do
          tree="$(_land_pick_tree "$own_tip" "$c")" || tree=""
          if [ -z "$tree" ]; then
            _land_mark_resume
            _land_log "$(git rev-parse --short "$land_sha_eff") conflicts with $remote/$branch at $(git rev-parse --short "$c"); nothing pushed. Rebase and land again within ${AMUX_LAND_RESUME_S:-1800}s to keep this place"
            return 2
          fi
          [ "$tree" != "$(git rev-parse "$own_tip^{tree}")" ] || continue
          own_tip="$(GIT_AUTHOR_NAME="$(git log -1 --format=%an "$c")" GIT_AUTHOR_EMAIL="$(git log -1 --format=%ae "$c")" \
                     GIT_AUTHOR_DATE="$(git log -1 --format=%aD "$c")" git commit-tree "$tree" -p "$own_tip" -m "$(git log -1 --format=%B "$c")")"
        done
      fi
      if [ "$own_tip" = "$(git rev-parse "$remote/$branch")" ]; then
        _land_log "$(git rev-parse --short "$land_sha_eff") is already on $remote/$branch; nothing to push"
        return 0
      fi
      stack_tip="$own_tip"; stack_in=""
    else
      if ! git rebase -q "$remote/$branch"; then
        git rebase --abort 2>/dev/null
        # With regenerable paths declared, a rebase conflict may be one the
        # replay can resolve; retry this attempt by replay before giving up.
        if [ "${_force_replay:-0}" != 1 ] && [ -n "$(git config --get-all amux.landRegenerable 2>/dev/null || true)" ]; then
          _force_replay=1
          _land_log "rebase onto $remote/$branch conflicted; retrying by replay (regenerable paths are declared)"
          continue
        fi
        _land_mark_resume
        _land_log "rebase onto $remote/$branch conflicted; nothing pushed. Resolve and land again within ${AMUX_LAND_RESUME_S:-1800}s to keep this place"
        return 2
      fi
      stack_tip="$(git rev-parse HEAD)"; stack_in=""
    fi
    # A --priority holder pushes alone: it jumped the queue to land fast, and
    # a batch carries other lanes' risk. Measured 2026-10-01: gs12-gates'
    # priority push batched three lanes at 15:05Z, a planes schema test in one
    # of them refused the batch at 15:54Z, and the priority push started over.
    # MO-4077 made a --priority holder batch again; 2026-10-02 reverted that
    # to the default above (AMUX_LAND_PRIORITY_BATCH=1 opts back in).
    # Priority TICKETS are never taken into another holder's batch.
    [ "$solo" = 1 ] || _land_stack "$stack_tip"
    lanes="$(printf '%s' "$stack_in" | awk 'NF {printf "%s%s", sep, $2; sep=", "}')"
    [ -z "$lanes" ] || _land_log "batching ${lanes} behind this push (one gate run)"
    # A regenerable replay kept main's generated files; re-render them from
    # the pushed tree when the repository declares how (amux.landRegenerate).
    # amux.landRegenerateWhen=always (the default once a command is declared)
    # renders on EVERY pushed stack: a batch of two lanes that each rendered
    # their own commit can still leave the composed tree stale (gs12-planes'
    # 17:34Z batch on 2026-10-02 refused on generated/MANIFEST.json and two
    # lifecycle files). =conflict renders only after a regenerable replay.
    local _rg_when; _rg_when="$(git config --get amux.landRegenerateWhen 2>/dev/null || echo always)"
    if [ -f "${TMPDIR:-/tmp}/amux-land-regen.$$" ] || { [ "$_rg_when" = always ] && [ -n "$(git config --get-all amux.landRegenerate 2>/dev/null || true)" ]; }; then
      rm -f "${TMPDIR:-/tmp}/amux-land-regen.$$"
      local _rg
      # A failing generator must never stop the queue: land .27 stopped every
      # Mixpeek holder in seconds when a batched commit made the plane
      # generator read a file outside the declared inputs (20:16Z 2026-10-02).
      # Push unrendered and let the gate judge the render; a stale-render
      # refusal costs one lane, a stopped queue costs all of them.
      if _rg="$(_land_regenerate "$stack_tip")"; then
        _land_heal_core_worktree "regenerate"
        stack_tip="$_rg"
      else
        _land_log "WARN regenerate failed on the composed stack; pushing it unrendered, the gate judges the render (see the regenerate log above)"
      fi
    fi
    # A batch can fail only once COMPOSED (the ops registry goes stale from two
    # lanes' changes that each pass alone; six batches refused that way on
    # 2026-10-01/02 after a full gate each). Run the repository's precheck on
    # the composed stack first: seconds instead of a gate (gs12-gates measured
    # 46 s at load 22). It judges and writes nothing in batch mode.
    # AMUX_LAND_PRECHECK_BATCH=0 skips it.
    # Under the fast gate the push itself runs the same precheck-mode legs on
    # the same stack, so a batch precheck here is that work twice under the
    # lock (MO-4354). The push path drops a waiter its refusal names (MO-4104)
    # the same way this block does.
    local _fg_on=0
    { [ "${AMUX_LAND_FAST_GATE:-}" = 1 ] || [ "$(git config --bool --get amux.landFastGate 2>/dev/null)" = true ]; } && _fg_on=1
    [ -n "$lanes" ] && [ "$_fg_on" = 1 ] && [ "${AMUX_LAND_PRECHECK_BATCH:-1}" = 1 ] && \
      _land_log "batch precheck skipped: the fast-gate push runs the same legs on this stack"
    if [ -n "$lanes" ] && [ "$_fg_on" = 0 ] && [ "${AMUX_LAND_PRECHECK_BATCH:-1}" = 1 ]; then
      local _pc_out _pc_rc=0 _pc_t0 _pc_named _pc_tk _pc_rest _pc_excl=""
      _pc_t0=$(date +%s)
      _pc_out="$(_land_precheck_exec "$(git rev-parse "$remote/$branch")" "$stack_tip")" || _pc_rc=$?
      _land_heal_core_worktree "the composed precheck"
      # A check killed at its budget is UNMEASURED, and pushing an unmeasured
      # batch spends a whole gate run: both batches refused at the gate on
      # 2026-10-02 had timed out here first (mixpeek-override). Re-run it once
      # with AMUX_LAND_PRECHECK_RETRY_TIMEOUT_S (default twice the budget) and
      # AMUX_LAND_PRECHECK_ATTEMPT=2 before pushing anything.
      if [ "$_pc_rc" = 2 ] && grep -q . "${TMPDIR:-/tmp}/amux-precheck-rc.$$" 2>/dev/null && [ "$(cat "${TMPDIR:-/tmp}/amux-precheck-rc.$$")" != 0 ]; then
        local _pc_rb="${AMUX_LAND_PRECHECK_RETRY_TIMEOUT_S:-$(( ${AMUX_LAND_PRECHECK_TIMEOUT_S:-900} * 2 ))}"
        _land_log "composed batch precheck unmeasured after $(( $(date +%s) - _pc_t0 ))s; re-running once with a ${_pc_rb}s budget before any gate run"
        _pc_rc=0; _pc_t0=$(date +%s)
        _pc_out="$(AMUX_LAND_PRECHECK_ATTEMPT=2 AMUX_LAND_PRECHECK_TIMEOUT_S="$_pc_rb" _land_precheck_exec "$(git rev-parse "$remote/$branch")" "$stack_tip")" || _pc_rc=$?
        _land_heal_core_worktree "the composed precheck retry"
      fi
      # Keep EVERY composed check's output and its raw exit status: a pass in
      # 425 s against a 420 s budget (a killed check judged by its verdict
      # line) could not be audited, because only refusals were saved
      # (gs12-gates, 2026-10-02, gs12-mvs 14:55:50Z).
      local _pc_raw; _pc_raw="$(cat "${TMPDIR:-/tmp}/amux-precheck-rc.$$" 2>/dev/null || echo ?)"; rm -f "${TMPDIR:-/tmp}/amux-precheck-rc.$$"
      full="$HOME/.amux/logs/land/$(date -u +%Y%m%dT%H%M%SZ)-$me-$$-a$i-batchcheck.log"
      mkdir -p "${full%/*}"; printf '%s\n' "$_pc_out" > "$full"
      if [ "$_pc_rc" = 1 ]; then
        _pc_named="$(_land_named_waiters "$(_land_blame_lines "$_pc_out")" "$stack_tip")"
        if [ -n "$_pc_named" ]; then
          for _pc_tk in $_pc_named; do
            batch_skip="$batch_skip$_pc_tk "
            _pc_rest="$(printf '%s\n' "$stack_in" | awk -v t="$_pc_tk" '$1==t {print $2}')"
            _pc_excl="$_pc_excl${_pc_excl:+, }$_pc_rest"
            echo "excluded: the push hook refused the batch on your commit (land precheck, full output $full); fix it and run amux land again" > "$rdir/$_pc_tk"
            rm -f -- "${q:?}/${_pc_tk:?}"
          done
          _land_log "composed batch with ${lanes} failed the land precheck on ${_pc_excl}'s commit in $(( $(date +%s) - _pc_t0 ))s; retrying without it, no gate run spent. Output: $full"
        else
          _land_tell "excluded: the composed batch failed the land precheck (full output $full); landing on your own turn"
          _land_log "composed batch with ${lanes} failed the land precheck naming no waiter in $(( $(date +%s) - _pc_t0 ))s; pushing this lane alone, no gate run spent. Output: $full"
          solo=1
        fi
        continue
      fi
      [ "$_pc_rc" = 0 ] && _land_log "composed batch passed the land precheck in $(( $(date +%s) - _pc_t0 ))s (rc $_pc_raw$([ "$_pc_raw" = 0 ] || echo ', judged by its verdict line')). Output: $full"
      [ "$_pc_rc" = 2 ] && _land_log "composed batch precheck unmeasured after $(( $(date +%s) - _pc_t0 ))s ($(printf '%s\n' "$_pc_out" | grep -E '^land-precheck:' | tail -1 | cut -c1-120)); pushing the batch to the gate"
    fi
    # `|| rc=$?`, not `; rc=$?`: this CLI runs under set -e, and a rejected
    # push in a bare assignment would exit the script before the retry.
    # AMUX_LAND_HOLDER_PID marks this push as the lock holder's, so a pre-push
    # hook can refuse any OTHER push to the branch while a land is in its gate
    # (a direct push moves the tip and forces the holder's gate to start over:
    # gtm ticks and homepage grafts did that to gs12-gates' 50-minute gate on
    # 2026-10-01). AMUX_LAND_LOCK names the lock to compare against.
    # Without GH_TOKEN/GITHUB_TOKEN (mixpeek-override, MO-4077, 2026-10-01):
    # a lane's exported App token expires within the hour, and Mixpeek's
    # pre-push hook asked GitHub whether its CI twins are active with it, read
    # the 401 body as the answer, and ran its slow legs in full instead of
    # deferring them at 60s: a median hold of 23.7 min, 33 to 67 in the
    # afternoon. gh's own stored login answers when the variables are unset,
    # and git's credential helper already ignores them.
    # Every line of the push (and its hook) is also written with its elapsed
    # time to a -timed.log beside the hook output, and the slowest legs are
    # logged: "what is the biggest time suck of the pre-push?" (Ethan,
    # 2026-10-03) had no answer because the hook records no per-leg time.
    local _tl _t0p
    _tl="$HOME/.amux/logs/land/$(date -u +%Y%m%dT%H%M%SZ)-$me-$$-a$i-timed.log"; mkdir -p "${_tl%/*}"
    _t0p=$(date +%s)
    # FAST GATE (Ethan, 2026-10-03 16:21 ET, for the goal-spec-12 build): with
    # `git config amux.landFastGate true` in the repository (or
    # AMUX_LAND_FAST_GATE=1) the push runs the repository's hook in its
    # land-precheck mode, judge only: every seconds-cheap leg (secrets,
    # tree-revert, identity, ratchets) and none of the slow ones (clippy cold
    # build, mirror-tests, repo-state/tree/workflow guards), which CI on main
    # still runs. Off by default; unset the config to restore the full gate.
    local _fg_env=""
    if [ "${AMUX_LAND_FAST_GATE:-}" = 1 ] || [ "$(git config --bool --get amux.landFastGate 2>/dev/null)" = true ]; then
      _fg_env="LAND_PRECHECK=1 AMUX_LAND_PRECHECK_MODE=batch"
      _land_log "fast gate: pushing with the hook's seconds-cheap legs only (amux.landFastGate); the slow legs run in CI on $branch"
    fi
    # A push that never reached the remote (DNS, connect, TLS) is retried with
    # backoff instead of stopping: on 2026-10-03 23:30-23:50Z the router's DNS
    # timed out and gs12-obs's land stopped on "Could not resolve host:
    # github.com" as if the hook had refused it, so the lane re-ran it by hand.
    local _net=0 _net_max="${AMUX_LAND_NET_RETRIES:-8}" _net_wait
    while :; do
    rc=0; out="$(set -o pipefail; env -u GH_TOKEN -u GITHUB_TOKEN $_fg_env AMUX_LAND_HOLDER_PID=$$ AMUX_LAND_LOCK="$lock" git push "$remote" "$stack_tip:$branch" 2>&1 \
      | AMUX_TL="$_tl" perl -MTime::HiRes=time -ne 'BEGIN{$|=1; $t0=time; open($o,">>",$ENV{AMUX_TL}) or die} printf $o "%8.1fs %s", time-$t0, $_; print')" || rc=$?
    _land_leg_summary "$_tl" "$(( $(date +%s) - _t0p ))"
    _land_heal_core_worktree "the push and its hook (rc $rc)"
    if [ $rc -ne 0 ] && [ "$_net" -lt "$_net_max" ] && printf '%s\n' "$out" | grep -qE "^(fatal: unable to access .*: (Could not resolve host|Failed to connect|Couldn't connect|Connection timed out|Operation timed out|Connection reset|Recv failure|SSL_ERROR_SYSCALL|The requested URL returned error: 5[0-9][0-9])|fatal: unable to connect|ssh: Could not resolve hostname|error: RPC failed|send-pack: unexpected disconnect)"; then
      _net=$((_net + 1))
      _net_wait=$(( ${AMUX_LAND_NET_BACKOFF_S:-60} * _net )); [ "$_net_wait" -gt 180 ] && _net_wait=180
      _land_log "WARN push did not reach $remote (network: $(printf '%s\n' "$out" | grep -m1 -oE "(Could not resolve host[^']*|Failed to connect[^']*|Couldn't connect[^']*|Connection timed out|Operation timed out|Connection reset[^']*|Recv failure[^']*|SSL_ERROR_SYSCALL|returned error: 5[0-9][0-9]|unable to connect[^']*|Could not resolve hostname[^']*|RPC failed[^']*|unexpected disconnect[^']*)")); retry $_net of $_net_max in ${_net_wait}s, holding the lock"
      sleep "$_net_wait"; _t0p=$(date +%s); continue
    fi
    break
    done
    # Keep the whole hook output for EVERY attempt, landed or refused
    # (gs12-spend, 2026-10-01: the deciding line sits above the ERROR list, so
    # a tail lost it; gs12-gates, 2026-10-02: a batch landed a stale
    # openapi.json the spec leg refuses on that tree, and with no output kept
    # nobody could read which branch the hook took).
    full="$HOME/.amux/logs/land/$(date -u +%Y%m%dT%H%M%SZ)-$me-$$-a$i.log"
    mkdir -p "${full%/*}"
    find "${full%/*}" -name '*.log' -mtime +14 -delete 2>/dev/null || true
    printf '%s\n' "$out" > "$full"
    if [ $rc -eq 0 ]; then
      if [ -n "$lanes" ]; then
        _land_tell "landed $(git rev-parse --short "$stack_tip") on $branch, batched by $me"
        _land_log "landed $(git rev-parse --short "$stack_tip") on $branch (attempt $i), with ${lanes}. Hook output: $full"
      else
        _land_log "landed $(git rev-parse --short "$stack_tip") on $branch (attempt $i). Hook output: $full"
      fi
      printf '%s\n' "$out" | tail -3
      date +%s > "$lock.lastpush" 2>/dev/null || true
      return 0
    fi
    if printf '%s' "$out" | grep -qE 'non-fast-forward|fetch first|\[rejected\]|cannot lock ref'; then
      _land_log "lost a race to a push outside land (attempt $i); refetching"
      continue
    fi
    # FAIL, not only FAILED: primitives-audit writes "FAIL <sha> <subject>"
    # beside "ok <sha>" lines for every other commit, and that per-commit FAIL
    # is the line that names whose commit refused the batch (mixpeek-override,
    # 2026-10-02 07:42Z: six waiters lost their batch to gs12-templates'
    # d8615192bb9 while land read the refusal as naming nobody).
    # A line that says it is NOT a refusal never counts: "openapi-codegen-copies:
    # ... last written b6bfd70f7e9 ... Reported, not refused." named a waiter's
    # commit and land dropped that waiter for it (gs12-gates, 2026-10-02 10:45Z).
    verdicts="$(printf '%s\n' "$out" | grep -E '✗|FAIL|BLOCKED|REFUSED|refus|^error:|^fatal:' | grep -viE 'not refused|not a refusal' | head -40)"
    if [ -n "$lanes" ]; then
      # MO-4104: when the refusal NAMES a batched waiter's commit (replayed or
      # original sha, 10+ hex chars), drop that waiter and retry the rest of the
      # batch: one bad commit no longer sends five good lanes back to the queue.
      named="$(_land_named_waiters "$(_land_blame_lines "$out")" "$stack_tip")"
      if [ -n "$named" ]; then
        local _tk _rest _excl=""
        for _tk in $named; do
          batch_skip="$batch_skip$_tk "
          _rest="$(printf '%s\n' "$stack_in" | awk -v t="$_tk" '$1==t {print $2}')"
          _excl="$_excl${_excl:+, }$_rest"
          echo "excluded: the push hook refused the batch on your commit (full output $full); fix it and run amux land again" > "$rdir/$_tk"
          rm -f -- "${q:?}/${_tk:?}"
        done
        _land_log "batch with ${lanes} refused on ${_excl}'s commit (attempt $i, rc $rc); retrying the batch without it. Full output: $full"
        continue
      fi
      # A refusal that names no waiter blames nobody: push this lane alone, and
      # the batched waiters keep their places and land on their own turns.
      _land_tell "excluded: the batch was refused by the push hook (full output $full); landing on your own turn"
      _land_log "batch with ${lanes} refused (attempt $i, rc $rc); pushing this lane alone. Full output: $full"
      solo=1
      continue
    fi
    printf '%s\n' "$out" | tail -20
    if [ -n "$verdicts" ]; then
      printf '\namux land: verdict lines from the push:\n%s\n' "$verdicts" >&2
    fi
    _land_log "push failed (attempt $i, rc $rc), not a race; stopping. Full output: $full"
    if [ -n "$verdicts" ]; then
      printf '%s\n' "$verdicts" | sed 's/^/    /' >> "$log"
    fi
    return "$rc"
  done
  _land_log "gave up after $tries attempts on $branch"
  return 1
}

# `amux cdp ...`: rung 2 of the access ladder (Ethan's real Chrome over CDP),
# from ANY checkout. The helper lives in the amux repo's skills/, which lanes
# in other repos never see; they probed fixed ports (9222, 9223, 9229) and
# filed "no CDP port" while Chrome listened on 9333 (2026-10-02: GS-146,
# GS-159, GS-169, GM-25 sat in needsyou on that). The helper finds the port
# itself through Chrome's DevToolsActivePort file.
cmd_cdp() {
  local script="${AMUX_CDP_SCRIPT:-}" c
  if [ -z "$script" ]; then
    for c in "$HOME/Dev/amux/skills/chrome-cdp/scripts/cdp.mjs" "$HOME/.amux/skills/chrome-cdp/scripts/cdp.mjs"; do
      [ -f "$c" ] && { script="$c"; break; }
    done
  fi
  [ -n "$script" ] || die "amux cdp: the chrome-cdp helper is not on this machine (set AMUX_CDP_SCRIPT to its cdp.mjs)"
  command -v node >/dev/null 2>&1 || die "amux cdp: node is not installed"
  if [ $# -eq 0 ]; then
    node "$script" 2>&1 | sed -n '1,30p'
    echo
    echo "Ethan's Chrome carries his live sign-ins. Start with: amux cdp list; then amux cdp open <url>, amux cdp eval <target> <js>, amux cdp shot <target>."
    echo "Stop at any password, CAPTCHA or 2-step prompt: that rung is Ethan's."
    return 0
  fi
  node "$script" "$@"
}

cmd_signal() {
  local sub="${1:-help}"; shift 2>/dev/null || true
  local me="${AMUX_WORKER:-${AMUX_SESSION:-}}"
  case "$sub" in
    wait)
      local card="${1:-}" name="${2:-}"
      [[ -n "$card" && -n "$name" ]] || die "Usage: amux signal wait <CARD> <name>"
      local result
      result=$(N="$name" python3 -c 'import json,os; print(json.dumps({"blocked_on": "signal:" + os.environ["N"].strip()}))' \
        | _curl -sk -X PATCH -H 'Content-Type: application/json' \
            -H "X-Amux-Worker: $me" -d @- "$AMUX_API/api/board/$card")
      echo "$result" | _board_outcome "$card" "" "waiting on signal $name" || return $?
      # The event may already have happened. Say so, with who and when, rather
      # than letting the card wait for a raise that already came and went.
      _curl -sk "$AMUX_API/api/signals/$(printf '%s' "$name" | tr 'A-Z' 'a-z')" 2>/dev/null \
        | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
last = d.get("last_raised")
if last:
    note = (" (note: " + last["note"] + ")") if last.get("note") else ""
    print("note: " + d["name"] + " was last raised by " + last["raised_by"] + " at "
          + last["raised_at_iso"] + note + ". If that was the event you need, unpark the card: "
          "amux board unblock <CARD>.", file=sys.stderr)
' || true
      ;;
    raise)
      local name="${1:-}"; shift 2>/dev/null || true
      [[ -n "$name" ]] || die "Usage: amux signal raise <name> [--note <text> | --note-stdin]"
      local note=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --note)       note="${2:-}"; shift 2 ;;
          --note-stdin) note="$(cat)"; shift ;;
          *)            die "amux signal raise: unknown argument '$1'" ;;
        esac
      done
      local resp
      resp=$(NOTE="$note" python3 -c 'import json,os; print(json.dumps({"note": os.environ["NOTE"]}))' \
        | _curl -sk -X POST -H 'Content-Type: application/json' \
            -H "X-Amux-Worker: $me" -d @- "$AMUX_API/api/signals/$name") || die "cannot reach the server to raise $name"
      RESP="$resp" python3 - <<'PY'
import json, os, sys
try:
    d = json.loads(os.environ["RESP"])
except Exception:
    print("signal raise: unreadable response: " + os.environ["RESP"][:200], file=sys.stderr)
    sys.exit(1)
if not d.get("ok"):
    print("signal raise FAILED: " + str(d.get("error") or d), file=sys.stderr)
    sys.exit(1)
cleared = d.get("cleared") or []
print(f"raised {d['name']} at {d['raised_at_iso']} (id {d['id']}): cleared {len(cleared)} waiting card(s)")
for w in d.get("woken") or []:
    print(f"  {w['session'] or '(unowned)'}: {', '.join(w['cards'])} -> {w['delivery']}")
PY
      ;;
    show)
      local name="${1:-}"
      [[ -n "$name" ]] || die "Usage: amux signal show <name>"
      _curl -sk "$AMUX_API/api/signals/$name" | python3 -m json.tool
      ;;
    ls|list)
      _curl -sk "$AMUX_API/api/signals" | python3 -m json.tool
      ;;
    help|--help|-h) _signal_usage ;;
    *) _signal_usage; return 1 ;;
  esac
}

# AF-928's actual check: everything below this point (dispatch, and the
# tail's unconditional `exit "$?"`) must never run when sourced. Placed here,
# not near the top comment, because every function above — including
# _warn_stale_amux_url just defined — must already exist for a sourced test
# to use it.
if [[ "${BASH_SOURCE[0]:-$0}" != "${0}" ]]; then
  return 0
fi

# Always true from here on (the sourced case already returned above) --
# kept as an `if` rather than de-indenting this whole block, to keep this
# fix a minimal, reviewable diff rather than a full-file reformat.
if [[ "${BASH_SOURCE[0]:-$0}" == "${0}" ]]; then
  ensure_dirs
  # Every verb must resolve the same installation as `amux url`; most legacy
  # verbs otherwise fall back to the production port even with a custom home.
  AMUX_API="${AMUX_API:-$(cmd_url)}"
  _warn_stale_amux_url
  # Ship any transport failures the PREVIOUS invocations could not report,
  # before doing this one's work. No-op (one file test) when there are none.
  _flush_transport_breadcrumbs

  case "${1:-}" in
    register|reg)     shift; cmd_register "$@" ;;
    worktree|wt)      shift; cmd_worktree "$@" ;;
    start)            shift; cmd_start "$@" ;;
    exec|run)         shift; cmd_exec "$@" ;;
    attach|a)         shift; cmd_attach "$@" ;;
    grid)             shift; cmd_grid "$@" ;;
    peek|p)           shift; cmd_peek "$@" ;;
    send)             shift; cmd_send "$@" ;;
    stop|kill)        shift; cmd_stop "$@" ;;
    pause)            shift; cmd_pause "$@" ;;
    resume|unpause)   shift; cmd_resume "$@" ;;
    server)           shift; cmd_server "$@" ;;
    rm|remove|del)    shift; cmd_rm "$@" ;;
    ls|list)          shift; cmd_ls "$@" ;;
    info)             shift; cmd_info "$@" ;;
    defaults|config)  shift; cmd_defaults "$@" ;;
    start-all)        cmd_start_all ;;
    stop-all)         cmd_stop_all ;;
    pause-all)        cmd_pause_all ;;
    resume-all)       cmd_resume_all ;;
    serve|web)        shift; cmd_serve "$@" ;;
    board|b)          shift; cmd_board "$@" ;;
    signal)           shift; cmd_signal "$@" ;;
    land)             shift; cmd_land "$@" ;;
    browser|br)      shift; cmd_browser "$@" ;;
    cdp)              shift; cmd_cdp "$@" ;;
    computer|cu)     shift; cmd_computer "$@" ;;
    delegate)        shift; cmd_delegate "$@" ;;
    delegate-job|dj) shift; cmd_delegate_job "$@" ;;
    get)              shift; cmd_get "$@" ;;
    crm)              shift; cmd_crm "$@" ;;
    order)            shift; cmd_order "$@" ;;
    tunnel|t)         shift; cmd_tunnel "$@" ;;
    alert)            shift; cmd_alert "$@" ;;
    approvals)        shift; cmd_approvals "$@" ;;
    iac)              shift; cmd_config "$@" ;;
    whoami)           cmd_whoami ;;
    fresh)            shift; cmd_fresh "$@" ;;
    url)              shift; cmd_url "$@" ;;
    pin)              shift; cmd_pin "$@" ;;
    help|--help|-h)
      # `amux help computer` is how the access-ladder rule names this verb.
      if [[ "${2:-}" == "computer" || "${2:-}" == "cu" ]]; then cmd_computer help; else cmd_help; fi ;;
    version|--version|-v) echo "amux v${CC_VERSION}" ;;
    "")               cmd_dashboard ;;
    *)
      # Try as session name shortcut
      name=$(resolve_session "$1" 2>/dev/null) && cmd_attach "$name" || {
        echo "${RED}unknown command:${RESET} $1"
        echo "Run ${BOLD}amux help${RESET} for usage"
        exit 1
      }
      ;;
  esac
fi

exit "$?"
}
