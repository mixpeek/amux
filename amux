#!/usr/bin/env bash
# amux — phone-friendly Claude Code worker manager built on tmux
# Usage: amux [command] [args...]
#
# LEGACY CLIENT, pending amux-rs verb parity: this bash CLI is an HTTP client
# of the Rust server — it is NOT part of the removed Python server, and the
# fleet's muscle memory (amux send/board/alert) runs through it. Keep it working
# until crates/amux-cli covers every verb.
#
# It talks to 8824, the canonical port (AMUX_RS_PORT, what install.sh sets).
# 8822 is the RETIRED address, answered only by a countdown bind for pre-cutover
# processes — see crates/amux-server/src/legacy_port.rs. Do not point anything
# new at it. Override with AMUX_API for a non-default server.
#
# Publish this Bash client with `make install-cli` (ATE-136): the installed
# copy is a validated snapshot, not a symlink into a mutable checkout. The
# historical incident below predates that installer; retain the read-once
# wrapper for direct checkout invocations and older symlink installations.

set -euo pipefail

# ── READ THE WHOLE SCRIPT BEFORE RUNNING ANY OF IT (AMUX-3891) ──────────────
#
# Everything below lives inside one `{ ... }` compound command, and the script
# ends with `exit` INSIDE it. That is not style. bash does not slurp a script:
# it reads and executes incrementally, holding an open fd and a BYTE OFFSET.
# Rewrite the file in place under a running interpreter and bash resumes at an
# offset that now points into different bytes.
#
# This file is the one place in the fleet where that is a routine event rather
# than a freak one. `~/.local/bin/amux` is a symlink straight into the working
# tree (see the header above — that liveness is deliberate and worth keeping),
# ~50 lanes invoke it constantly, and the file is edited constantly. Every
# editor write, `git checkout`, `git stash` and branch switch rewrites it in
# place while somebody is mid-invocation.
#
# Observed 2026-08-29 20:28 by mixpeek-homepage-claude: a `board retitle` whose
# write SUCCEEDED (card read back, 3095 chars, title intact) then died with
#
#   /Users/ethan/.local/bin/amux: line 3784: syntax error near unexpected token `;'
#   exit=2
#
# Line 3784 is the `version|--version|-v)` arm of the dispatch, and `bash -n`
# on the same path passed immediately after. The file was fine; the PARSE was
# not. The worktree file's mtime was inside the second that invocation ran.
#
# The spurious exit 2 is the BENIGN outcome, and that is the reason this is
# worth a wrapper rather than a shrug. A caller that checks exit codes reads 2
# as a failed write and retries — and `board retitle` / `status-update` are not
# idempotent for a reader, so a double write is how a desc gets clobbered by a
# stale copy. Worse, a shifted offset can land MID-FUNCTION and execute a
# fragment of a command. That failure is unbounded and will not look like an
# update problem when it happens.
#
# Atomic temp+rename in the UPDATER is the standard fix and does not apply here:
# there is no installer to fix. The writers are each lane's editor and git
# itself, which is exactly what CLAUDE.md means by "live on save, and so also
# live on `git checkout`, `stash`, or a branch switch". So the reader is
# hardened instead. Wrapped this way bash must parse to the closing brace before
# executing anything, and the trailing `exit` means it never seeks back to the
# file afterwards — a rewrite mid-run cannot be observed by a process that has
# already read everything it will ever read.
#
# KEEP THE CLOSING BRACE AND `exit` AS THE LAST TWO STATEMENTS. Appending a new
# top-level command after them re-opens exactly this hole for whatever you
# append. `scripts/test-cli-offset-safe.sh` fails if the shape is broken.
{

CC_VERSION="0.3.0"

# ── Migration from cc/cmux → amux ───────────────────────────────────────────
# Migrate legacy dirs to ~/.amux if new one doesn't exist
if [[ ! -d "$HOME/.amux" ]]; then
  for _old in "$HOME/.cmux" "$HOME/.cc"; do
    if [[ -d "$_old" ]]; then
      mv "$_old" "$HOME/.amux"
      echo "Migrated $_old → ~/.amux"
      break
    fi
  done
fi

CC_HOME="${CC_HOME:-$HOME/.amux}"
CC_SESSIONS="$CC_HOME/sessions"
CC_DEFAULTS="$CC_HOME/defaults.env"

# A localhost AMUX_API or AMUX_URL on a port that endpoint.json does not name is
# stale: the server rewrites endpoint.json on every boot, while a lane's env is
# fixed for its life. On 2026-10-05 a reboot raced two servers; the one on the
# compiled-in default 8823 won the database for two minutes, restarted the
# fleet, and every lane kept AMUX_URL=AMUX_API=8823 after the real server took
# 8824 back. Every CLI verb then failed with curl exit 7 (mixpeek-finances,
# 11:4xZ) while `amux url` (which already reads endpoint.json) answered 8824.
# A remote override (cloud) is left alone. Logged once per lane and port to
# cli-transport.jsonl, which the next reachable call ships to the server log.
_amux_heal_url() {
  local ep="$CC_HOME/endpoint.json" c v name mark
  [ -r "$ep" ] || return 0
  c=$(sed -n 's/.*"canonical_url"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$ep" | head -1)
  [ -n "$c" ] || return 0
  for name in AMUX_API AMUX_URL; do
    v="${!name:-}"
    [ -n "$v" ] || continue
    case "$v" in https://localhost:*|http://localhost:*|https://127.0.0.1:*|http://127.0.0.1:*) ;; *) continue ;; esac
    [ "${v%/}" = "${c%/}" ] && continue
    printf -v "$name" '%s' "$c"; export "${name?}"
    mark="$CC_HOME/state/url-healed.${AMUX_SESSION:-${AMUX_WORKER:-none}}.${v##*:}"
    if [ ! -e "$mark" ]; then
      mkdir -p "$CC_HOME/state" 2>/dev/null && : > "$mark" 2>/dev/null
      printf '{"ts":%s,"event":"stale_env_url_healed","var":"%s","from":"%s","to":"%s","session":"%s","cli":"bash"}\n' \
        "$(date -u +%s)" "$name" "$v" "$c" "${AMUX_SESSION:-${AMUX_WORKER:-}}" >> "$CC_HOME/cli-transport.jsonl" 2>/dev/null || true
    fi
  done
}
_amux_heal_url

# MR-43: recover AMUX_SESSION from the tmux pane name when it is empty inside
# a lane that IS running in its amux-launched pane (spawn always injects it —
# session_verbs.rs — so this is loss in-process, not absence at launch).
# Fixed ONCE here rather than at each of this script's 30+ AMUX_SESSION call
# sites, so every X-Amux-Session/X-Amux-Worker header downstream benefits
# without a separate edit per site. Scoped to amux- prefixed panes: a human's
# own tmux session (or no tmux at all) leaves AMUX_SESSION exactly as unset as
# before this.
# The caller's OWN pane name, or nothing. Without -t, display-message answers
# for the most recently active client's session whenever the caller is not in
# a pane (a shell schedule, launchd, cron), so a send from outside tmux was
# stamped with a random lane: 55 pipeline-bottleneck messages carried amux,
# canvas-app-use-cases, amux-app and gainz as their sender (2026-10-04).
_own_pane_session() {
  [[ -n "${TMUX_PANE:-}" ]] || return 0
  tmux display-message -p -t "$TMUX_PANE" '#S' 2>/dev/null || true
}

if [[ -z "${AMUX_SESSION:-}" ]]; then
  _mr43_tname="$(_own_pane_session)"
  if [[ "$_mr43_tname" == amux-* ]]; then
    export AMUX_SESSION="${_mr43_tname#amux-}"
  fi
  unset _mr43_tname
fi

# AMUX-4033: a STALE $AMUX_SESSION, which the empty check above cannot see.
#
# Renaming a running worker moves its env file and renames its tmux session,
# then re-exports AMUX_SESSION into the tmux SESSION environment — which only
# reaches processes started afterwards. The agent already running in that pane
# keeps the OLD name for its entire life, so every call it makes attributes to
# a session that no longer exists. Measured 2026-09-02, one minute after
# renaming leadership-coaching -> leadership-coach: the lane's own hooks posted
# `leadership-coaching` and took an unbroken run of HTTP 404s.
#
# The correction is deliberately NARROW: only when the claimed name has NO
# session file AND the pane's own name HAS one. That is the renamed case and
# the typo case (a lane once ran 4h15m as `amax-gtm`, 138 reports, every one a
# 404), and it cannot hijack a deliberate cross-session claim, because there the
# claimed session exists and this leaves it alone.
if [[ -n "${AMUX_SESSION:-}" && ! -f "$CC_HOME/sessions/$AMUX_SESSION.env" ]]; then
  _stale_tname="$(_own_pane_session)"
  if [[ "$_stale_tname" == amux-* ]]; then
    _stale_true="${_stale_tname#amux-}"
    if [[ "$_stale_true" != "$AMUX_SESSION" && -f "$CC_HOME/sessions/$_stale_true.env" ]]; then
      export AMUX_SESSION_STALE="$AMUX_SESSION"
      export AMUX_SESSION="$_stale_true"
    fi
  fi
  unset _stale_tname _stale_true
fi

# ── Colors (disabled when not a tty or TERM is dumb) ────────────────────────
if [[ -t 1 ]] && [[ "${TERM:-dumb}" != "dumb" ]]; then
  BOLD=$'\033[1m' DIM=$'\033[2m' RESET=$'\033[0m'
  RED=$'\033[31m' GREEN=$'\033[32m' YELLOW=$'\033[33m'
  BLUE=$'\033[34m' CYAN=$'\033[36m'
else
  BOLD='' DIM='' RESET='' RED='' GREEN='' YELLOW='' BLUE='' CYAN=''
fi

# ── Helpers ──────────────────────────────────────────────────────────────────

die() { echo "${RED}error:${RESET} $*" >&2; exit 1; }

# AF-927. Every CC_WORKTREE=1 cleanup path force-removes the worker's
# ephemeral worktree (`git worktree remove --force`, the exact flag that
# overrides git's own refusal to drop a dirty worktree) with no check first.
# That is fine for the common case -- a worktree with nothing uncommitted in
# it -- and silent data loss for the uncommon one: real work never committed
# before `amux stop`/`amux rm` ran, or a crash routed through the same path.
# This does not block the removal (breaking a script that calls `amux stop`
# unconditionally is its own regression), it makes the loss OBSERVABLE
# instead of silent, which is the minimum ethos rule 4 asks for.
warn_if_worktree_dirty() {
  local wt_dir="$1"
  [[ -d "$wt_dir" ]] || return 0
  local dirty
  dirty=$(git -C "$wt_dir" status --porcelain --untracked-files=all 2>/dev/null) || return 0
  [[ -z "$dirty" ]] && return 0
  echo "${YELLOW}warn: removing $wt_dir with uncommitted work still in it:${RESET}" >&2
  echo "$dirty" | sed 's/^/  /' >&2
}

# ── Every server call goes through _curl ─────────────────────────────────────
#
# A CONNECT TIMEOUT, in one place, because a per-call-site flag is a thing every
# future call site has to remember and not one of the 41 sites did. Re-measured
# against upstream/main at rebase time: 41 curl invocations, 0 with
# --connect-timeout, 8 carrying only -m.
#
# Without one, an unreachable server does not FAIL — it HANGS, and none of the
# error handling in this file can run while curl is still waiting. Measured
# 2026-08-23 (AEAB-46): a dead localhost port on WSL2 drops the SYN instead of
# refusing it, so `amux board done <id> --outcome ...` sat until its CALLER gave
# up after two minutes and printed nothing. AEAB-36's "cannot reach the board —
# NOTHING was applied" die() was already right there and could not fire. Pointed
# at a host that fails fast (DNS, curl exit 6) the same command printed it
# correctly — so the instrument could report the shape of failure that was
# already obvious and not the one that looks like a wedged CLI.
#
# `-m`/`--max-time` is a DIFFERENT knob and stays at the call site: it caps the
# whole transfer, and `peek --live` or `send` may legitimately be slow. The eight
# sites that already had `-m` still hung for their full budget on a dropped
# connect, which is why adding more of it was never the fix.
_curl() {
  local rc=0
  # AF-723: 5s was tuned against AEAB-46's dropped-SYN hang (a genuinely dead
  # peer), not against a heavily-loaded LOCAL box. Measured 2026-09-12 on a
  # box at load 19-24 / amux-server-rs at ~239% CPU: `amux send`'s first
  # attempt reported "the server was unreachable" (empty curl response —
  # this connect-timeout firing) while /health answered in 8-9ms moments
  # apart, and the very next retry (2s later, same request) succeeded and
  # was dedup'd by the server as already-accepted — so the FIRST attempt had
  # actually connected and been processed; only the CLIENT's own report of
  # it was wrong. 10s keeps failing fast on a truly dead peer (still well
  # short of the multi-minute hang AEAB-46 exists to prevent) while giving
  # real headroom for connection setup delayed by local CPU/scheduling
  # contention rather than a genuinely unreachable server.
  # Contract rule 10 (AH-387): a lane's minted identity rides every request.
  # Kept out of "$@" so the transport breadcrumb below never writes it to disk.
  local _id=()
  [[ -n "${AMUX_WORKER_TOKEN:-}" ]] && _id=(-H "X-Amux-Worker-Token: ${AMUX_WORKER_TOKEN}")
  command curl --connect-timeout "${AMUX_CURL_CONNECT_TIMEOUT:-10}" ${_id[@]+"${_id[@]}"} "$@" || rc=$?
  if [[ "$rc" -ne 0 ]]; then _transport_breadcrumb "$rc" "$@"; fi
  return "$rc"
}

# The second half of the fix: make the NEXT transport failure self-announcing.
#
# A CLI that cannot reach the server also cannot report that it could not reach
# the server — the request never arrives, so nothing lands in the request log and
# a sweep of /api/logs/analyze sees a silence identical to "nobody ran anything".
# So the note is written to disk here and shipped on the next invocation that CAN
# reach the server (_flush_transport_breadcrumbs).
#
# Recorded: the curl exit code, the method, and the URL with its QUERY STRING
# stripped — so scheme and host and path, not the path alone — never the body and
# never the headers. A breadcrumb whose own payload leaks an outcome's prose or an
# auth header into a log the whole fleet reads costs more than the hang did. The
# host is kept deliberately: AMUX_API pointing somewhere unexpected is one of the
# things this breadcrumb exists to make visible.
_transport_breadcrumb() {
  local rc="$1"; shift
  local url="" method="GET" prev="" a
  for a in "$@"; do
    case "$a" in http://*|https://*) url="$a" ;; esac
    if [[ "$prev" == "-X" ]]; then method="$a"; fi
    prev="$a"
  done
  printf '{"ts":%s,"curl_exit":%s,"method":"%s","url":"%s","session":"%s","cli":"bash"}\n' \
    "$(date -u +%s)" "$rc" "$method" "${url%%\?*}" \
    "${AMUX_SESSION:-${AMUX_WORKER:-}}" \
    >> "$CC_HOME/cli-transport.jsonl" 2>/dev/null || true
}

# Ship the backlog to /api/client-debug, which logs the whole payload at INFO in
# ~/.amux/logs/server-rs.log and serves it back from
# GET /api/client-debug?kind=cli-transport-failure. That is what turns "my amux
# command hung once" from a thing one operator saw into a thing a log sweep finds.
#
# ALWAYS returns 0: a diagnostic that can break a hot path 48 lanes run is worse
# than no diagnostic.
#
# What it deletes, it delivered. The first version of this function read the
# NEWEST 200 lines, posted those, and then cleared the WHOLE file — so on a
# backlog of 201 every older breadcrumb was destroyed unsent, and the truncate
# reported success. That is the shape this PR fixes one layer up, one layer down:
# a composite operation taking its success signal from the part that worked. It
# also raced: ~48 lanes share CC_HOME, so a `>>` landing between the read and the
# `: >` was lost even inside the window.
#
# So the file is ROTATED, not truncated. mv is atomic within the directory: the
# snapshot is exactly what gets posted, concurrent appends land in a fresh file
# while it drains, and the snapshot is removed only on a 2xx — any other answer
# puts it back for the next invocation to retry. There is no per-post row cap
# because that cap is what ate the evidence; the snapshot can only grow while the
# server is unreachable, and the first command that reaches it ships all of it.
_flush_transport_breadcrumbs() {
  local f="$CC_HOME/cli-transport.jsonl"
  [[ -s "$f" ]] || return 0
  local snap="$f.sending.$$"
  mv "$f" "$snap" 2>/dev/null || return 0
  local body code
  body=$(F="$snap" python3 -c '
import json, os
rows = []
with open(os.environ["F"]) as fh:
    for line in fh.read().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            rows.append(json.loads(line))
        except Exception:
            pass
print(json.dumps({"kind": "cli-transport-failure", "n": len(rows), "rows": rows}))
' 2>/dev/null) || { _restore_transport_snapshot "$snap" "$f"; return 0; }
  # command curl, NOT _curl: a failed flush must not breadcrumb its own failure,
  # which would be an unbounded pile of notes about not being able to send notes.
  code=$(command curl -sk --connect-timeout 3 -m 5 -o /dev/null -w '%{http_code}' \
    -X POST -H 'Content-Type: application/json' -d "$body" \
    "${AMUX_API:-https://localhost:8824}/api/client-debug" 2>/dev/null || echo 000)
  case "$code" in
    2??) rm -f "$snap" 2>/dev/null || true ;;
    *) _restore_transport_snapshot "$snap" "$f" ;;
  esac
  return 0
}

# Appended back rather than moved back, because a fresh $f may already exist from
# a lane that failed while this snapshot was in flight — clobbering it would lose
# the very breadcrumbs this function exists to keep.
_restore_transport_snapshot() {
  cat "$1" >> "$2" 2>/dev/null && rm -f "$1" 2>/dev/null
  return 0
}

need_tmux() {
  command -v tmux &>/dev/null || die "tmux is required. Install with: brew install tmux"
}

ensure_dirs() {
  # Read-only verbs (including `board ls` inside a sandboxed Codex worker)
  # must not require a write to the server's home. The defaults loader already
  # treats a missing file as empty, and defaults edit/reset create it on demand.
  [[ -d "$CC_SESSIONS" ]] || mkdir -p "$CC_SESSIONS"
}

# Resolve session name from partial match or alias
resolve_session() {
  local query="$1"
  # Exact match first
  if [[ -f "$CC_SESSIONS/$query.env" ]]; then
    echo "$query"
    return
  fi
  # Prefix match
  local matches=()
  for f in "$CC_SESSIONS"/*.env; do
    [[ -f "$f" ]] || continue
    local name
    name=$(basename "$f" .env)
    if [[ "$name" == "$query"* ]]; then
      matches+=("$name")
    fi
  done
  if [[ ${#matches[@]} -eq 1 ]]; then
    echo "${matches[0]}"
    return
  elif [[ ${#matches[@]} -gt 1 ]]; then
    die "ambiguous: '$query' matches ${matches[*]}"
  fi
  # Number lookup (for dashboard shortcuts)
  if [[ "$query" =~ ^[0-9]+$ ]]; then
    local i=1
    for f in "$CC_SESSIONS"/*.env; do
      [[ -f "$f" ]] || continue
      if [[ "$i" -eq "$query" ]]; then
        basename "$f" .env
        return
      fi
      ((i++))
    done
  fi
  die "worker '$query' not found"
}

# Load session config into env vars
load_session() {
  local name="$1"
  local file="$CC_SESSIONS/$name.env"
  [[ -f "$file" ]] || die "worker '$name' not found"
  # The worker's own file decides where and how it runs. `source` only ADDS,
  # so a CC_WORKTREE=1 exported by whatever shell ran `amux start` survived for
  # a worker whose file never set it: the amux lane came back from a fleet
  # restore (2026-09-25 17:50) inside ~/.amux/worktrees/amux instead of its
  # repo. Drop inherited values of the keys that pick the checkout and lifecycle.
  local _k _dropped=""
  for _k in CC_WORKTREE CC_WORKTREE_REPO CC_PROJECT CC_EPHEMERAL CC_DIR CC_PROVIDER; do
    if [[ -n "${!_k+x}" ]]; then _dropped+=" $_k=${!_k}"; unset "$_k"; fi
  done
  # shellcheck disable=SC1090
  source "$file"
  # Values left by an earlier load_session in this process (cmd_ls loops over
  # every worker) are cleared too, silently: only an OUTSIDE value is news.
  if [[ -n "$_dropped" && -z "${_AMUX_WORKER_LOADED:-}" ]]; then
    echo "${DIM}amux: ignored inherited${_dropped} for $name; its own file decides (verdict=inherited_worker_env_ignored)${RESET}" >&2
  fi
  _AMUX_WORKER_LOADED="$name"
}

# Load global defaults
load_defaults() {
  [[ -f "$CC_DEFAULTS" ]] && source "$CC_DEFAULTS"
  # Load ~/.amux/server.env so CLI-spawned sessions see the same AMUX_* knobs
  # the server process uses (e.g. AMUX_CLAUDE_CMD). Parsed manually rather than
  # `source`d so values are never shell-expanded — mirrors the server's env
  # loader (crates/amux-server/src/config.rs), which treats entries as literal
  # key=value pairs and is safe for values containing $, backticks, etc.
  local _se="$CC_HOME/server.env"
  if [[ -f "$_se" ]]; then
    local _k _v
    while IFS='=' read -r _k _v; do
      # Trim all leading/trailing whitespace (matches Python's .strip()).
      # Standard glob [![:space:]] — no extglob needed.
      _k="${_k#"${_k%%[![:space:]]*}"}"; _k="${_k%"${_k##*[![:space:]]}"}"
      _v="${_v#"${_v%%[![:space:]]*}"}"; _v="${_v%"${_v##*[![:space:]]}"}"
      [[ -z "$_k" || "$_k" == \#* || -z "$_v" ]] && continue
      export "$_k=$_v"
    done < "$_se"
  fi
}

# Get tmux session name (prefixed to avoid conflicts)
tmux_name() { echo "amux-$1"; }

tmux_has_session_exact() {
  local target="$1"
  local timeout="${AMUX_TMUX_PROBE_TIMEOUT_S:-3}"
  case "$timeout" in ''|*[!0-9]*) timeout=3 ;; esac
  (( timeout < 1 )) && timeout=1
  local rc
  local shell_flags="$-"
  set +e
  perl -e 'alarm shift; exec @ARGV' "$timeout" tmux has-session -t "$target" >/dev/null 2>&1
  rc=$?
  case "$shell_flags" in *e*) set -e ;; *) set +e ;; esac
  [[ "$rc" -eq 142 ]] && return 124
  return "$rc"
}

# Migrate a cmux-* or cc-* tmux session to amux-* if needed
migrate_tmux() {
  local name="$1"
  local rc
  local shell_flags
  shell_flags="$-"
  set +e
  tmux_has_session_exact "=amux-$name"
  rc=$?
  case "$shell_flags" in *e*) set -e ;; *) set +e ;; esac
  [[ "$rc" -eq 0 ]] && return 0
  [[ "$rc" -eq 124 ]] && return 124
  for old_prefix in "cmux-" "cc-"; do
    shell_flags="$-"
    set +e
    tmux_has_session_exact "=${old_prefix}${name}"
    rc=$?
    case "$shell_flags" in *e*) set -e ;; *) set +e ;; esac
    [[ "$rc" -eq 124 ]] && return 124
    if [[ "$rc" -eq 0 ]]; then
      tmux rename-session -t "=${old_prefix}${name}" "amux-$name" 2>/dev/null || true
      break
    fi
  done
  return 0
}

# ─── herdr backend helpers ───────────────────────────────────────────────────
# Mirror of the server's _backend_of_cfg: CC_BACKEND in the session env wins,
# then $AMUX_BACKEND, default tmux. herdr sessions live in one headless named
# herdr session (AMUX_HERDR_SESSION, default "amux") that the SERVER owns, so
# start/stop go through the server API; attach/peek can talk to herdr direct.

herdr_session_name() { echo "${AMUX_HERDR_SESSION:-amux}"; }

session_backend() {
  local name="$1" b=""
  if [[ -f "$CC_SESSIONS/$name.env" ]]; then
    b=$(sed -n 's/^CC_BACKEND=//p' "$CC_SESSIONS/$name.env" | tail -1 | tr -d '"' | tr '[:upper:]' '[:lower:]')
  fi
  [[ -n "$b" ]] || b=$(printf '%s' "${AMUX_BACKEND:-tmux}" | tr '[:upper:]' '[:lower:]')
  if [[ "$b" == "herdr" ]]; then echo "herdr"; else echo "tmux"; fi
}

# Persisted herdr agent name for an amux session (server writes CC_HERDR_AGENT
# on first start; empty until then).
herdr_agent_of() {
  local name="$1"
  [[ -f "$CC_SESSIONS/$name.env" ]] || return 0
  sed -n 's/^CC_HERDR_AGENT=//p' "$CC_SESSIONS/$name.env" | tail -1 | tr -d '"'
}

need_herdr() {
  command -v herdr &>/dev/null || die "herdr is required for herdr-backend workers. Install herdr or set AMUX_BACKEND=tmux"
}

# Does the SERVER own this worker's start, and with it the worker's workspace?
# True for the providers whose launch is delegated (AMUX-3164), and for every
# project or ephemeral worker whatever its provider: the server gives those the
# project's single checkout or a <repo>/.worktrees/<name> fan-out workspace and
# enforces the project's start permit. Both `cmd_start` branches read this one
# function, so the CLI can never create a worktree for a start it hands away
# (DESKT-55: 8 detached 3.6 GB worktrees under ~/.amux/worktrees, made by
# `amux start` for project workers whose server-side start was then refused,
# and never used or removed).
server_owns_start() { # <provider> <CC_PROJECT> <CC_EPHEMERAL>
  case "$1" in codex|ollama|gemini|muse) return 0 ;; esac
  [[ -n "${2:-}" || "${3:-}" == "1" ]]
}

_start_via_api() {
  local name="$1"
  local AMUX_API="${AMUX_API:-https://localhost:8824}"
  local resp
  resp=$(_curl -sk -m 90 -X POST -H "X-Amux-Session: ${AMUX_SESSION:-}" \
    "$AMUX_API/api/sessions/$name/start" 2>/dev/null) || resp=""
  if [[ -z "$resp" ]]; then
    # herdr AND codex/ollama start through the server now (AMUX-3164), so this is
    # no longer herdr-specific. A stranded lane whose $AMUX_URL is the retired
    # 8822 (AMUX-3046) hits this even when the server is up — use `$(amux url)`.
    die "amux server unreachable at ${AMUX_API} — this worker starts through the server (amux serve). If the server IS up, your \$AMUX_URL may be the retired 8822 (AMUX-3046) — retry with: AMUX_URL=\$(amux url) amux start ${name}. NOTHING was started."
  fi
  local rc=0
  RESP="$resp" TGT="$name" python3 - <<'PYEOF' || rc=$?
import json, os, sys
try:
    d = json.loads(os.environ["RESP"])
except Exception:
    sys.exit(1)
tgt = os.environ["TGT"]
if d.get("error") or d.get("ok") is False:
    print(f"start {tgt} FAILED: {d.get('error') or d.get('message')}")
    sys.exit(1)
print(f"started {tgt}: {d.get('message', 'ok')}")
PYEOF
  return $rc
}

_stop_via_api() {
  local name="$1"
  local AMUX_API="${AMUX_API:-https://localhost:8824}"
  local resp
  resp=$(_curl -sk -m 15 -X POST -H "X-Amux-Session: ${AMUX_SESSION:-}" \
    "$AMUX_API/api/sessions/$name/stop" 2>/dev/null) || resp=""
  if [[ -z "$resp" ]]; then
    return 1
  fi
  # A non-empty body is NOT proof of success: an error JSON or a proxy's
  # HTML page must fall through to the direct pane-close fallback, not
  # masquerade as a graceful stop.
  if ! RESP="$resp" python3 - <<'PYEOF'
import json, os, sys
try:
    d = json.loads(os.environ["RESP"])
except Exception:
    sys.exit(1)
if not isinstance(d, dict) or d.get("error") or d.get("ok") is False:
    sys.exit(1)
PYEOF
  then
    return 1
  fi
  echo "${RED}stopping${RESET} $name (graceful, via server)"
  return 0
}

# Check if tmux session is alive.
# NOTE: tmux's -t prefix-matches session names by default, so a bare
# "amux-foo" would also match a running "amux-foo-worker". Prefix the
# target with '=' to force an exact match. Name resolution / abbreviation
# is already handled safely upstream by resolve_session().
is_running() {
  if [[ "$(session_backend "$1")" == "herdr" ]]; then
    local agent
    agent=$(herdr_agent_of "$1")
    [[ -n "$agent" ]] || return 1
    herdr --session "$(herdr_session_name)" agent get "$agent" >/dev/null 2>&1
    return $?
  fi
  local migrate_rc
  local shell_flags
  shell_flags="$-"
  set +e
  migrate_tmux "$1"
  migrate_rc=$?
  case "$shell_flags" in *e*) set -e ;; *) set +e ;; esac
  [[ "$migrate_rc" -eq 124 ]] && return 124
  tmux_has_session_exact "=$(tmux_name "$1")"
}
_amux_tmpfile() {
  # A temp file a SANDBOXED AGENT can actually create.
  #
  # Muse Code sandboxes filesystem writes to the workspace and offers no per-directory
  # grant — no `--add-dir`, only `--disable-sandbox` or a named permission profile — so
  # $TMPDIR is denied and a bare `mktemp` fails with "Operation not permitted". A muse
  # worker hit exactly this on `amux board ls`, whose header capture is PURE DIAGNOSTICS,
  # and the whole board read died on it: the agent could not close its own card and had to
  # ask a human to do it. Codex is unaffected only because its sandbox grants $TMPDIR.
  #
  # Try the normal temp directories, then fall back to the working directory — the one
  # place a workspace-sandboxed agent can always write. Callers must tolerate failure
  # rather than die: a diagnostic file is never worth losing the command.
  local d f
  for d in "${TMPDIR:-/tmp}" /tmp .; do
    [ -d "$d" ] || continue
    f=$(mktemp "${d%/}/.amux.XXXXXX" 2>/dev/null) && { printf '%s\n' "$f"; return 0; }
  done
  return 1
}


# ─── Shell-safe flag quoting ─────────────────────────────────────────────────
#
# Common runner: spawn python3, isolate stderr to a temp file, check exit
# code, surface diagnostic on failure. Used by both quote_flags (one-string
# form) and quote_argv (multi-arg form) so the stderr-isolation pattern
# lives in one place. SECURITY: never echoes the input arguments back on
# failure — they may contain secrets — only the input length and python's
# stderr.
_run_py_safe() {
  local script="$1"
  shift
  local result err err_file
  local rc=0
  err_file=$(_amux_tmpfile) || {
    echo "amux: error: no writable temp directory (tried $TMPDIR, /tmp, .)" >&2
    return 1
  }
  # `|| rc=$?` is critical: under set -e (which the source-guard makes
  # possible if a sourcing script enables it), a naked `result=$(...); rc=$?`
  # would abort the function on python3 failure BEFORE rc is captured,
  # bypassing the error handler.
  result=$(python3 -c "$script" "$@" 2>"$err_file") || rc=$?
  if (( rc != 0 )); then
    err=$(<"$err_file")
    rm -f "$err_file"
    local n_args=$#
    echo "amux: error: python3 helper failed (exit $rc, $n_args input args): $err" >&2
    return 1
  fi
  rm -f "$err_file"
  printf '%s' "$result"
}

# Tokenize a stored flag string and re-quote each token shell-safely.
# Mirror of the server's shell_quote_flags (crates/amux-server/src/api/
# session_verbs.rs) — see that function for full rationale. Required
# because zsh glob-expands unquoted '[1m]' in
# model IDs like 'claude-opus-4-6[1m]', failing with 'no matches found'
# before claude is even invoked.
#
# Implementation note: this delegates to python3's shlex rather than using
# native bash word-splitting. Bash's IFS-based splitting (arr=( $s ),
# read -ra) ignores embedded quotes in multi-word flag values AND triggers
# pathname expansion (globbing) on the input. xargs has subtle escape-rule
# differences from shlex on macOS vs GNU. Using python3 guarantees 100%
# parity with the server's _shell_quote_flags so the same test fixtures
# verify both code paths.
#
# PERFORMANCE: each invocation spawns a python interpreter (~30-50ms).
# Acceptable for a once-per-session-spawn helper. Do NOT call this inside
# loops or hot paths.
quote_flags() {
  local s="$1"
  [[ -z "$s" ]] && return 0
  _run_py_safe '
import sys, shlex
s = sys.argv[1]
try:
    print(" ".join(shlex.quote(t) for t in shlex.split(s)))
except ValueError:
    print(shlex.quote(s))
' "$s"
}

# Quote a list of already-tokenized argv elements (each $1, $2, ... is one
# argument). Used in cmd_start for inline arguments passed via
# `amux start NAME -- ...`. printf '%q' uses bash-only $'...' syntax that
# breaks under dash; shlex.quote uses universal POSIX single-quoting.
quote_argv() {
  (( $# == 0 )) && return 0
  _run_py_safe '
import sys, shlex
print(" ".join(shlex.quote(a) for a in sys.argv[1:]))
' "$@"
}

# Parse Claude Code flags from args, split into CC_FLAGS array and remaining args
# Sets: CC_FLAGS_STR (for storage), CC_DIR, CC_EXTRA_ARGS
parse_claude_flags() {
  CC_FLAGS=()
  CC_DIR=""
  CC_EXTRA_ARGS=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      # Flags that take a value
      --model|--permission-mode|--system-prompt|--append-system-prompt|\
      --mcp-config|--allowedTools|--allowed-tools|--disallowedTools|--disallowed-tools|\
      --add-dir|--effort|--settings|--setting-sources|--tools|\
      --plugin-dir|--agents|--agent|--betas|--debug-file|--json-schema|\
      --fallback-model|--max-budget-usd|--session-id|--file|--strict-mcp-config)
        CC_FLAGS+=("$1" "$2")
        shift 2
        ;;
      # Boolean flags
      --dangerously-skip-permissions|--allow-dangerously-skip-permissions|\
      --yolo|--verbose|--chrome|--no-chrome|--debug|\
      --disable-slash-commands|--no-session-persistence|--ide|--fork-session)
        # --yolo is an alias for --dangerously-skip-permissions
        if [[ "$1" == "--yolo" ]]; then
          CC_FLAGS+=("--dangerously-skip-permissions")
        else
          CC_FLAGS+=("$1")
        fi
        shift
        ;;
      # Working directory — resolve to absolute path, create if needed.
      # We previously fell back to the literal $2 if cd failed, which silently
      # let relative paths slip into the session env file (CC_DIR=./foo). On
      # next start the relative path would resolve from whatever pwd happened
      # to be, and Claude Code would write files into the wrong tree. Now we
      # die loudly instead.
      --dir)
        mkdir -p "$2" || die "cannot create --dir: $2"
        CC_DIR="$(cd "$2" && pwd)" || die "cannot resolve --dir to absolute path: $2"
        shift 2
        ;;
      # Everything else goes to extra args
      *)
        CC_EXTRA_ARGS+=("$1")
        shift
        ;;
    esac
  done
  CC_FLAGS_STR="${CC_FLAGS[*]:-}"
}

# ── Commands ─────────────────────────────────────────────────────────────────

cmd_register() {
  local name="${1:-}"
  # A flag in the name slot is never a worker name (AMUX-3116). `amux register
  # --help` used to register a worker literally named "--help" in the cwd instead
  # of printing usage; a leading-dash name is a mistake, not an identifier. Same
  # guard the board verbs carry (see the `-*) die` case there).
  case "$name" in
    ""|-h|--help|help) die "usage: amux register <name> [--model opus] [--yolo] [--dir /path] [--worktree] [--worktree-profile p[,p2]] [claude flags...]" ;;
    -*) die "amux register: '$name' looks like a flag, not a worker name. Put the name first: amux register <name> [flags]" ;;
  esac
  shift

  # Worktree flags are amux's, not claude's: take them out before the rest is
  # parsed as claude flags (AMUX-5341). --worktree-profile implies --worktree.
  local wt="" wt_profile="" reg_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --worktree) wt=1; shift ;;
      --worktree-profile) [[ -n "${2:-}" ]] || die "--worktree-profile needs a profile name (see: amux worktree <name> profiles)"
                          wt=1; wt_profile="$2"; shift 2 ;;
      --worktree-profile=*) wt=1; wt_profile="${1#*=}"; shift ;;
      *) reg_args+=("$1"); shift ;;
    esac
  done
  if [[ -n "$wt_profile" && ! "$wt_profile" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*(,[A-Za-z0-9][A-Za-z0-9_-]*)*$ ]]; then
    die "--worktree-profile '$wt_profile' is not a profile name (names joined by commas)"
  fi
  set -- ${reg_args[@]+"${reg_args[@]}"}

  parse_claude_flags "$@"

  # Always persist an absolute CC_DIR. If --dir wasn't passed, use $(pwd) which
  # is already absolute. Refuse to write a relative path because it would be
  # resolved against pwd at start time — easy way for Claude Code to scribble
  # files into the wrong tree.
  local resolved_dir="${CC_DIR:-$(pwd)}"
  case "$resolved_dir" in
    /*) ;;  # absolute, ok
    *) die "CC_DIR must be absolute, got: $resolved_dir" ;;
  esac

  local file="$CC_SESSIONS/$name.env"
  # MERGE, do not truncate (AMUX-3117). Re-registering an existing worker used to
  # `cat >` the file down to CC_NAME/CC_DIR/CC_FLAGS, SILENTLY WIPING every other
  # CC_* key it does not manage — CC_DESC and CC_TAGS were lost this way, and
  # re-register is the only path to set flags (the PATCH-flags gap, AMUX-3115), so
  # the destructive path was on the happy path (gtm-engine, 2026-08-14). Preserve
  # every existing CC_* assignment except the three this verb owns, verbatim (no
  # re-parse, so quoting/JSON values survive intact).
  local preserved=""
  if [[ -f "$file" ]]; then
    preserved=$(grep -E '^CC_[A-Za-z0-9_]+=' "$file" 2>/dev/null \
                | grep -vE '^(CC_NAME|CC_DIR|CC_FLAGS)=' || true)
    # A flag given now replaces the stored value rather than duplicating it.
    [[ -n "$wt" ]] && preserved=$(printf '%s\n' "$preserved" | grep -vE '^CC_WORKTREE=' || true)
    [[ -n "$wt_profile" ]] && preserved=$(printf '%s\n' "$preserved" | grep -vE '^CC_WORKTREE_PROFILE=' || true)
  fi
  {
    echo "# amux session: $name"
    echo "# registered: $(date -Iseconds)"
    echo "CC_NAME=\"$name\""
    echo "CC_DIR=\"$resolved_dir\""
    echo "CC_FLAGS=\"${CC_FLAGS_STR}\""
    [[ -n "$wt" ]] && echo "CC_WORKTREE=\"1\""
    [[ -n "$wt_profile" ]] && echo "CC_WORKTREE_PROFILE=\"$wt_profile\""
    [[ -n "$preserved" ]] && printf '%s\n' "$preserved"
  } > "$file"

  echo "${GREEN}registered${RESET} ${BOLD}$name${RESET} → $resolved_dir"
  [[ -n "$preserved" ]] && echo "  ${DIM}preserved: $(printf '%s\n' "$preserved" | sed -E 's/=.*//' | paste -sd, -)${RESET}"
  [[ -n "$CC_FLAGS_STR" ]] && echo "  flags: $CC_FLAGS_STR"
}

# amux worktree <name> [show|profiles|widen <profile-or-folder>...|profile <p>]
# (AMUX-5341). A worker's worktree can be sparse when its repo ships
# scripts/worktree.sh; this shows the profile, folders and size, lists the
# repo's profiles, widens the checkout, or sets the profile the next
# worktree is created with (empty string clears it).
cmd_worktree() {
  local name="${1:-}" sub="${2:-show}"
  case "$name" in
    ""|-h|--help|help) die "usage: amux worktree <name> [show|profiles|widen <profile-or-folder>...|profile <p>]" ;;
  esac
  shift; [[ $# -gt 0 ]] && shift
  local base="$AMUX_API/api/sessions/$name/worktree" out code
  case "$sub" in
    show)     out=$(_curl -sk -m 60 "$base") || die "server unreachable" ;;
    profiles) out=$(_curl -sk -m 60 "$base/profiles") || die "server unreachable" ;;
    widen)
      [[ $# -gt 0 ]] || die "usage: amux worktree $name widen <profile-or-folder>..."
      local body; body=$(python3 -c 'import json,sys; print(json.dumps({"widen": sys.argv[1:]}))' "$@")
      out=$(_curl -sk -m 150 -X POST -H 'Content-Type: application/json' \
        -H "X-Amux-Session: ${AMUX_SESSION:-}" -d "$body" "$base") || die "server unreachable" ;;
    profile)
      local body; body=$(python3 -c 'import json,sys; print(json.dumps({"worktree_profile": sys.argv[1]}))' "${1:-}")
      out=$(_curl -sk -m 20 -X PATCH -H 'Content-Type: application/json' \
        -H "X-Amux-Session: ${AMUX_SESSION:-}" -d "$body" "$AMUX_API/api/sessions/$name/config") || die "server unreachable" ;;
    *) die "amux worktree: unknown subcommand '$sub' (show|profiles|widen|profile)" ;;
  esac
  printf '%s' "$out" | python3 -c '
import json, sys
d = json.load(sys.stdin)
if d.get("error"):
    print("error:", d["error"], file=sys.stderr); sys.exit(1)
if "profiles" in d:
    if not d.get("supported"):
        print(d.get("why") or "this repo has no scripts/worktree.sh"); sys.exit(0)
    for p in d["profiles"]:
        mark = "*" if p["name"] == d.get("current") else " "
        print("%s %-12s %5.2fG  %s" % (mark, p["name"], p["tracked_gb"], "(everything)" if p["full"] else " ".join(p["folders"])))
elif "worktree" in d:
    if not d["worktree"]:
        print("no worktree (profile for next create: %s)" % (d.get("profile") or "repo default")); sys.exit(0)
    kb = d.get("size_kb")
    print("path:    ", d["path"])
    print("profile: ", d.get("profile") or "repo default")
    print("size:    ", "%.2fG" % (kb / 1048576) if kb is not None else "unmeasured (%s)" % d.get("why_unmeasured"))
    print("folders: ", "(full checkout)" if d["full"] else " ".join(d["folders"]))
else:
    print(d.get("output") or d.get("message") or "ok")
'
}

# The lane's OWN conversation id, from its meta. Empty when it has never had
# one, which is exactly the case `--continue` gets wrong in a shared directory.
_lane_conversation_id() {
  local n="$1" f="$CC_SESSIONS/$1.meta.json"
  [[ -f "$f" ]] || return 0
  NAME="$n" META="$f" python3 - <<'PYEOF' 2>/dev/null || true
import json, os, sys
try:
    cid = (json.load(open(os.environ["META"])) or {}).get("cc_conversation_id") or ""
except Exception:
    sys.exit(0)
if not isinstance(cid, str) or not cid.strip():
    sys.exit(0)
# Only offer an id whose transcript still exists: `claude --resume <missing>`
# fails, and the whole point here is to avoid a launch that silently does
# something else.
home = os.path.expanduser("~/.claude/projects")
for d in os.listdir(home) if os.path.isdir(home) else []:
    if os.path.isfile(os.path.join(home, d, cid.strip() + ".jsonl")):
        print(cid.strip())
        break
PYEOF
}

# Does any OTHER lane declare the same working directory? If so, "the newest
# conversation here" is not a statement about this lane.
_workdir_shared_with_another_lane() {
  local me="$1" dir="$2" f other odir
  [[ -n "$dir" ]] || return 1
  # TRAILING SLASHES ARE NOT A DIFFERENT DIRECTORY. Measured in the fleet:
  # `/Users/ethan/Dev/amux` carries 8 lanes and `/Users/ethan/Dev/amux/`
  # another 5, and Claude Code's project encoding maps both to one place — so
  # a verbatim compare would call 13 co-tenants two groups of unshared lanes
  # and resume every one of them with `--continue` (AMUX-5033).
  dir="${dir%/}"
  for f in "$CC_SESSIONS"/*.env; do
    [[ -f "$f" ]] || continue
    other=$(basename "$f" .env)
    [[ "$other" == "$me" ]] && continue
    odir=$(sed -n 's/^CC_DIR="\(.*\)"$/\1/p' "$f" | tail -1)
    [[ "${odir%/}" == "$dir" ]] && return 0
  done
  return 1
}

cmd_start() {
  local name dry_run=false detach=false
  # AMUX_API is referenced bare below (the tmux `-e AMUX_URL=$AMUX_API` inject at
  # the real-launch path, and the codex/ollama server delegation) but was never
  # declared local here the way _api_start / _api_stop / send all do, so under
  # `set -u` a real `amux start` (non-dry-run) died with "AMUX_API: unbound
  # variable" whenever AMUX_API wasn't already exported. Dry-run returns before
  # that line, which is why it hid.
  #
  # Resolve via cmd_url (the endpoint.json self-heal), NOT the raw $AMUX_URL. A
  # pre-cutover lane carries the retired 8822 in $AMUX_URL for life (AMUX-3046),
  # and since codex/ollama now DELEGATE their launch to this base (AMUX-3164), a
  # raw-$AMUX_URL fallback made `amux start` fail "server unreachable" on a
  # stranded lane even with the server up, and injected the dead 8822 into every
  # NEW worker (the `-e AMUX_URL=` below). cmd_url ignores a retired-port env and
  # falls to the canonical base, so both paths self-heal. An explicit AMUX_API
  # (a non-default server) still wins.
  local AMUX_API="${AMUX_API:-$(cmd_url)}"
  name=$(resolve_session "${1:-}")
  shift 2>/dev/null || true
  # Strip our own flags before inline claude args. Placed before `--` so
  # `amux start NAME --detach -- --some-claude-flag` still works.
  #   --detach / -d : start the tmux session but don't attach (scripts, CI, boot)
  while [[ "${1:-}" == "--dry-run" || "${1:-}" == "--detach" || "${1:-}" == "-d" ]]; do
    case "$1" in
      --dry-run)    dry_run=true ;;
      --detach|-d)  detach=true ;;
    esac
    shift
  done
  # herdr backend: the server owns the herdr session, so start goes through
  # the server API (herdr agent start + readiness detection live there).
  if [[ "$(session_backend "$name")" == "herdr" ]]; then
    if $dry_run; then
      echo "${BOLD}$name${RESET} (herdr backend — started via server API: POST /api/sessions/$name/start)"
      return
    fi
    _start_via_api "$name" || return 1
    if $detach; then
      echo "  ${DIM}detached — attach with: amux attach $name${RESET}"
      return
    fi
    need_herdr
    local agent
    agent=$(herdr_agent_of "$name")
    if [[ -n "$agent" ]]; then
      herdr --session "$(herdr_session_name)" agent attach "$agent" \
        || herdr --session "$(herdr_session_name)"
    else
      herdr --session "$(herdr_session_name)"
    fi
    return
  fi
  # dry-run is a pure command preview — no tmux session is spawned, so the
  # tmux dependency only matters for the real start path.
  $dry_run || need_tmux
  load_defaults
  load_session "$name"

  local tname
  tname=$(tmux_name "$name")

  if ! $dry_run && is_running "$name"; then
    if $detach; then
      echo "${YELLOW}already running:${RESET} $name"
      return
    fi
    echo "${YELLOW}already running:${RESET} $name — attaching..."
    tmux attach-session -t "=$tname"
    return
  fi

  local dir="${CC_DIR:-$HOME}"
  # Expand ~ in dir path
  dir="${dir/#\~/$HOME}"
  # Hard requirement: dir must be absolute. A relative CC_DIR (from an old
  # session env file) would resolve against whatever pwd happens to be when
  # `amux start` is invoked, and Claude Code would silently write files into
  # the wrong tree. Refuse instead. Re-register with --dir to fix.
  case "$dir" in
    /*) ;;
    *) die "CC_DIR is not absolute ('$dir'). Re-register the worker with: amux register $name --dir /absolute/path" ;;
  esac
  [[ -d "$dir" ]] || die "directory not found: $dir"

  # --- Worktree isolation (opt-in via CC_WORKTREE=1) ---
  # When enabled, each worker gets its own git worktree so it cannot read or
  # clobber a peer's uncommitted edits. The worktree is created at start and
  # removed at stop; it shares the .git object store (no disk duplication).
  # Skip for dry-run: no tmux session follows, so the worktree would be orphaned.
  local worktree_dir=""
  local _provider="${CC_PROVIDER:-claude}"
  # CLAUDE STARTS THROUGH THE SERVER TOO, whenever the server answers.
  #
  # The local builder below cannot give a claude lane its passive status
  # identity (AMUX_STATUS_WORKER/RUN_ID/HOME/URL): only the server's
  # native_status::begin_launch mints the run id the hooks report under. A
  # lane launched here therefore runs with hooks that exit silently, and its
  # status is guessed from the pane for as long as it lives. Measured
  # 2026-09-26: the tmux server died at 17:37 on 09-25, the tmux watchdog
  # recovered the fleet with `amux start-all`, and 22 of 31 running lanes came
  # back through this door with no status identity (and without --name or
  # --mcp-config). amux then read "turn over, 4 shells still running" as
  # active on seven of them for a day.
  #
  # So a claude start goes through the server when /api/health answers within
  # 3s and no inline args were given (the server path does not forward them).
  # At cold boot the server is often not up yet; that still launches locally,
  # and says so, with a verdict in the server log so the gap is countable.
  local _claude_via_server=false
  if [[ "$_provider" == "claude" && $# -eq 0 ]] && ! $dry_run; then
    if [[ "$(_curl -sk -m 3 -o /dev/null -w '%{http_code}' "$AMUX_API/api/health" 2>/dev/null)" == "200" ]]; then
      _claude_via_server=true
    else
      echo "${YELLOW}warn:${RESET} amux server not answering at $AMUX_API; launching $name locally WITHOUT status identity (its status will be estimated from the screen until it is restarted through the server)" >&2
      mkdir -p "$CC_HOME/logs"
      printf '%s WARN amux::cli verdict=cli_local_launch_no_status_identity session=%s reason=server_unreachable\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$name" >> "$CC_HOME/logs/server-rs.log"
    fi
  fi
  if ! $dry_run && [[ "${CC_WORKTREE:-}" == "1" ]] && ! $_claude_via_server \
     && ! server_owns_start "$_provider" "${CC_PROJECT:-}" "${CC_EPHEMERAL:-}" \
     && git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
    worktree_dir="$CC_HOME/worktrees/$name"
    if [[ -d "$worktree_dir" ]]; then
      # Stale worktree from a previous run that wasn't cleaned up
      warn_if_worktree_dirty "$worktree_dir"
      git -C "$dir" worktree remove --force "$worktree_dir" 2>/dev/null || rm -rf "$worktree_dir"
    fi
    mkdir -p "$(dirname "$worktree_dir")"
    if git -C "$dir" worktree add --detach "$worktree_dir" HEAD 2>/dev/null; then
      echo "  ${DIM}worktree: $worktree_dir${RESET}"
      dir="$worktree_dir"
    else
      # REFUSE, DO NOT FALL BACK (contract rule 4, AH-381; the server's own
      # start has refused since AMUX-4770). A worker that asked to be isolated
      # and silently is not inherits every shared-checkout hazard.
      mkdir -p "$CC_HOME/logs"
      printf '%s WARN amux::cli verdict=worktree_launch_refused session=%s reason=worktree_add_failed dir=%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$name" "$dir" >> "$CC_HOME/logs/server-rs.log"
      die "refusing to start $name: CC_WORKTREE=1 asked for an isolated worktree at $worktree_dir and it could not be created. Starting in the shared checkout would put it in a tree other lanes write to. Fix it (git -C $dir worktree prune) or unset CC_WORKTREE."
    fi
  fi

  # codex/ollama: DELEGATE the launch to the server (POST /api/sessions/<n>/start)
  # instead of building the command + tmux session here (AMUX-3164). The server's
  # start_session seeds codex dir-trust (~/.codex/config.toml, AC-356) AND forces
  # model_reasoning_effort=low — neither of which this bash path does, so a
  # CLI-launched codex/ollama worker otherwise hits the trust prompt and runs at
  # xhigh (which hangs local models). Mirrors the herdr delegation above and
  # collapses the two launch constructions into one (D6), so the server-side fixes
  # cannot be skipped by whichever door a worker is started through. The server
  # creates the session as amux-<name> (same name tmux_name produces) — we attach.
  # gemini belongs in this list for the same reason codex and ollama do, and it
  # was missing until 2026-08-29 (AMUX-3888). The server maps provider->binary in
  # ONE place (`launch_base_binary`, session_verbs.rs: "gemini" => "gemini") and
  # builds a real gemini command. This bash path did not: it fell through to the
  # `claude` branch below and launched a gemini worker as
  # `claude --model gemini-2.5-flash --yolo`. claude rejects that model, the
  # process exits, and the tmux session dies with it — so the worker read as
  # "started" and was gone seconds later. Both of the fleet's gemini lanes
  # (photo-analysis, gtm-researcher-gemini) failed exactly this way while being
  # brought back up after a machine restart.
  #
  # This is D6 (two launch constructions) leaking through the door the server
  # does not own. Delegating means the provider->binary map has one home.
  local resume_fallback=""
  # muse belongs in this list for the reason the comment above gives: the server owns the
  # provider->binary map. Left out, `amux start` on a muse worker fell through to the claude
  # builder below and launched `claude --model sonnet --continue` -- the WRONG AGENT, silently,
  # because the fallback is a default rather than a failure. The server-side arm was correct the
  # whole time; only this door was. Observed live before the fix (muse-hooks-probe).
  if $_claude_via_server || server_owns_start "$_provider" "${CC_PROJECT:-}" "${CC_EPHEMERAL:-}"; then
    if $dry_run; then
      echo "${BOLD}$name${RESET} ($_provider — started via server API: POST /api/sessions/$name/start; the server owns the provider→binary map and the provider-specific setup)"
      return
    fi
    if [[ $# -gt 0 ]]; then
      echo "${YELLOW}note:${RESET} inline args after -- are not forwarded through server-side launch — set them in CC_FLAGS (the server reads it). Ignoring: $*" >&2
    fi
    _start_via_api "$name" || return 1
    if $detach; then
      echo "  ${DIM}detached — attach with: amux attach $name${RESET}"
      return
    fi
    tmux attach-session -t "=$tname"
    return
  fi

  # Build command. Check CC_PROVIDER to pick codex vs claude.
  local provider="${CC_PROVIDER:-claude}"
  local cmd
  if [[ "$provider" == "codex" ]]; then
    # Resume from stored codex session ID in meta file
    local meta_file="$CC_SESSIONS/${name}.meta.json"
    local codex_sid=""
    if [[ -f "$meta_file" ]]; then
      codex_sid=$(python3 -c "import json; print(json.load(open('$meta_file')).get('codex_session_id',''))" 2>/dev/null)
    fi
    if [[ -n "$codex_sid" ]]; then
      cmd="codex resume $codex_sid"
    else
      cmd="codex"
    fi
  elif [[ "$provider" == "ollama" ]]; then
    # Ollama workers run codex --oss --local-provider ollama so they get a full
    # coding agent (file editing, hooks, structured events) backed by the local
    # Ollama daemon. The model comes from CC_MODEL (default qwen3.8:27b) — CC_FLAGS
    # can add extra codex flags (approval policy, add-dir, etc.) just like codex.
    cmd="codex --oss --local-provider ollama --model ${CC_MODEL:-qwen3.8:27b}"
  else
    cmd="${AMUX_CLAUDE_CMD:-claude}"
  fi
  # Apply global defaults from defaults.env (skip for codex/ollama — Claude flags don't apply)
  if [[ "$provider" != "codex" && "$provider" != "ollama" && -n "${CC_DEFAULT_FLAGS:-}" ]]; then
    local q
    q=$(quote_flags "$CC_DEFAULT_FLAGS") || die "failed to quote CC_DEFAULT_FLAGS"
    [[ -n "$q" ]] && cmd="$cmd $q"
  fi
  # Apply session flags from <name>.env. Ollama now uses codex under the hood
  # so it accepts codex-style CC_FLAGS (e.g. --approve-for-me, --add-dir, etc.)
  if [[ -n "${CC_FLAGS:-}" ]]; then
    local q
    q=$(quote_flags "$CC_FLAGS") || die "failed to quote CC_FLAGS"
    [[ -n "$q" ]] && cmd="$cmd $q"
  fi
  # Apply any extra inline args from `amux start NAME -- ...`. These are
  # already tokenized argv (the user's outer shell parsed them), so we
  # quote each token via quote_argv. Without this, the v1 plan's $*
  # would lose quoting boundaries when re-evaluated by the nested shell.
  if [[ $# -gt 0 ]]; then
    local q
    q=$(quote_argv "$@") || die "failed to quote inline arguments"
    [[ -n "$q" ]] && cmd="$cmd $q"
  fi

  # Codex-specific defaults (apply to ollama too — it now runs codex under the hood)
  if [[ "$provider" == "codex" || "$provider" == "ollama" ]]; then
    # For codex (cloud): default to gpt-5.5 when no model is set.
    # For ollama: model is already set from CC_MODEL above — no default needed.
    if [[ "$provider" == "codex" ]]; then
      [[ "$cmd" == *"--model"* || "$cmd" == *"-m "* ]] || cmd="$cmd --model gpt-5.5"
    fi
    [[ "$cmd" == *"--full-auto"* || "$cmd" == *"--dangerously-bypass"* || "$cmd" == *"-a "* ]] || cmd="$cmd -a never"
    # codex defaults to read-only sandbox; workers need workspace-write to edit files.
    # Mirrors session_verbs.rs:4946 and OllamaAdapter::build_command (AH-82 / bb14642).
    [[ "$cmd" == *"--dangerously-bypass"* || "$cmd" == *"--sandbox"* || "$cmd" == *"-s "* ]] || cmd="$cmd --sandbox workspace-write"
    if [[ "$cmd" != *"--add-dir"* ]]; then
      local git_root
      git_root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || true
      if [[ -n "$git_root" && "$git_root" != "$dir" ]]; then
        cmd="$cmd --add-dir $(printf '%q' "$git_root")"
        [[ -d "$git_root/.git" ]] && cmd="$cmd --add-dir $(printf '%q' "$git_root/.git")"
      fi
    fi
  else
    [[ "$cmd" == *"--model"* ]] || cmd="$cmd --model sonnet"
    # Resume the most recent conversation in this directory by default, so a
    # restart (crash recovery, a deploy that killed the tmux server, `amux
    # start-all`) picks up where the worker left off instead of silently
    # registering a brand-new, untitled Claude Code session every time this
    # runs — the gap that turned one `stop-all`+`start-all` recovery pass
    # into 8 fresh sessions with random names and zero prior context
    # (2026-08-30, see frustrations.md / INIT-3). Verified safe on a
    # directory with NO prior conversation: `claude --continue` there just
    # starts fresh, exit 0, no error — so this is safe on a worker's very
    # first-ever start too. Skipped if the caller already asked to
    # resume/start a specific conversation another way.
    #
    # CORRECTION 2026-09-23: the sentence above ("verified safe ... exit 0, no
    # error") is FALSE for an interactive launch, which is the only kind this
    # function makes. Measured on a fresh directory:
    #
    #     claude --model haiku --continue -p "say ok"   -> ok, exit 0
    #     claude --model haiku --continue               -> "No conversation
    #                                                       found to continue"
    #                                                      exit 1
    #
    # The original verification was almost certainly the print-mode one; I
    # reproduced it first and believed it too. The interactive exit killed the
    # tmux session within a second of every FIRST start of a new worker, while
    # `amux start` printed "started" (AMUX-5005).
    #
    # The --continue default itself is right and stays: INIT-3 recorded one
    # stop-all+start-all turning into 8 fresh untitled sessions without it. So
    # resume is ATTEMPTED and a failure falls back to a plain launch, rather
    # than the pane dying. `||` fires only on a non-zero exit, and a normal
    # quit from claude exits 0, so this cannot relaunch a session the human
    # closed on purpose.
    #
    # Deliberately NOT done by inspecting ~/.claude/projects/<encoded-dir>:
    # that encoding is Claude Code's private business and it is already
    # inconsistent about which characters it replaces (`irl-refresh.house`
    # keeps its dot, `ethan.dev-minimal` does not). A fallback needs to know
    # nothing.
    #
    # RESUME BY IDENTITY WHEN THE DIRECTORY IS SHARED (AMUX-5033).
    #
    # `--continue` resumes the NEWEST conversation in the working directory and
    # has no way to know which lane owns it. Measured 2026-09-23:
    # `amux-gs-4-gke-minimization`'s pane was driving `gs-10-zero-base-cicd`'s
    # conversation, because the two started 9 seconds apart in the same
    # CC_DIR and gs-4's `--continue` adopted gs-10's. Ethan's message to gs-4
    # was executed by gs-10, both lanes appended to one transcript, and gs-4's
    # peek read a third file 22.7 hours stale. 37 lanes share that directory.
    #
    # So prefer the lane's OWN conversation id, which cannot pick up anybody
    # else's. Fall back to `--continue` only where recency is unambiguous.
    if [[ ! "$cmd" =~ (^|[[:space:]])(-c|--continue|--resume|--session-id|--from-pr|--teleport)([[:space:]]|$) ]]; then
      resume_fallback="$cmd"
      local _own_conv=""
      _own_conv=$(_lane_conversation_id "$name")
      if [[ -n "$_own_conv" ]]; then
        cmd="$cmd --resume $_own_conv"
      elif _workdir_shared_with_another_lane "$name" "$dir"; then
        # No id of our own AND a peer could be the newest conversation here.
        # Starting fresh loses nothing this lane owns; `--continue` would take
        # something it does not. Say which, because a silent choice here is
        # what made the hijack invisible for a day.
        echo "${DIM}[amux] $name has no conversation of its own and shares $dir with another lane; starting a new conversation rather than resuming a peer's (AMUX-5033)${RESET}" >&2
        resume_fallback=""
      else
        cmd="$cmd --continue"
      fi
    fi
  fi

  # Create tmux session and attach
  # Explicit cd to work dir in case shell profile overrides CWD.
  # If Claude OAuth is present (Max/claude.ai login), unset ANTHROPIC_API_KEY
  # to prevent auth conflict — BYO-key users don't have oauthAccount so they're
  # unaffected.
  local shell_setup=""
  if [[ "$provider" != "codex" && "$provider" != "ollama" ]]; then
    shell_setup="unset CLAUDECODE CLAUDE_CODE_ENTRYPOINT; "
    if [[ -f "$HOME/.claude.json" ]] && grep -q '"oauthAccount"' "$HOME/.claude.json" 2>/dev/null; then
      shell_setup="${shell_setup}unset ANTHROPIC_API_KEY; "
    fi
  fi
  if $dry_run; then
    echo "${BOLD}$name${RESET} in $dir"
    if [[ "${CC_WORKTREE:-}" == "1" ]]; then
      echo "  ${DIM}worktree: $CC_HOME/worktrees/$name (created on real start)${RESET}"
    fi
    echo "  ${DIM}$cmd${RESET}"
    return
  fi
  # -e AMUX_SESSION/AMUX_WORKER: without these the worker cannot attribute
  # ANYTHING it writes (board-exp-1, 2026-08-06). The server's own start path
  # passes them; this one never did, so a CLI-started worker running
  # `amux board add` produced a card with session=None, creator='' and the
  # fallback AMUX prefix — landing on another lane's board, owned by nobody, and
  # therefore never driven by advance or pickup. Measured: a fresh worker
  # completed its task and its card came back as AMUX-2471 with no owner.
  # Every attribution header in this CLI reads ${AMUX_WORKER:-${AMUX_SESSION:-}},
  # so both are set here rather than relying on one.
  #
  # AMUX_URL too (board accountability experiment, run 3). The lane had
  # AMUX_SESSION and AMUX_WORKER but NOT the API base, so a fresh Sonnet worker
  # reported "$AMUX_URL wasn't set in this shell" and hand-rolled curl against
  # the default address instead of using `amux board`. Its create happened to
  # carry X-Amux-Session; its later doing->done PATCH did not, and landed as
  # `unattributed`.
  #
  # That is AMUX-2325's shape arriving through a new door: the sanctioned path
  # was not unwalkable, it was merely un-configured, and an un-configured
  # sanctioned path produces exactly the same unattributed writes as a broken
  # one. Exporting the base is what makes `amux board` work without the worker
  # having to discover the address.
  # AMUX-4203: ECONNREFUSED can mean a live, overloaded server. tmux's
  # implicit start unlinks that server's socket and strands its entire fleet.
  local tmux_start_flag=""
  if tmux -N display-message -p '#{pid}' >/dev/null 2>&1; then
    tmux_start_flag=-N
  else
    local socket_path socket_owners="" socket_err socket_rc=0 reason="" lsof_bin=""
    socket_path="${TMUX:-}"
    socket_path="${socket_path%%,*}"
    [[ -n "$socket_path" ]] || socket_path="${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)/default"
    socket_path=$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$socket_path")
    socket_err=$(mktemp) || die "cannot measure tmux socket ownership"
    if command -v lsof >/dev/null 2>&1; then
      lsof_bin=lsof
    elif [[ -x /usr/sbin/lsof ]]; then
      lsof_bin=/usr/sbin/lsof
    elif [[ -x /usr/bin/lsof ]]; then
      lsof_bin=/usr/bin/lsof
    fi
    if [[ -z "$lsof_bin" ]]; then
      reason="socket ownership could not be measured"
    else
      socket_owners=$("$lsof_bin" -nP -a -U -u "$(id -u)" -c tmux -Fn 2>"$socket_err") || socket_rc=$?
    fi
    if [[ -s "$socket_err" || "$socket_rc" -gt 1 ]]; then
      reason="socket ownership could not be measured"
    elif printf '%s\n' "$socket_owners" | python3 -c 'import os,sys
target=sys.argv[1]
sys.exit(0 if any(line.startswith("n/") and os.path.realpath(line[1:].strip().split(" type=")[0]) == target for line in sys.stdin) else 1)' "$socket_path"; then
      reason="a live tmux process still owns the unreachable socket"
    fi
    rm -f "$socket_err"
    if [[ -n "$reason" ]]; then
      mkdir -p "$CC_HOME/logs"
      printf '%s WARN amux::tmux verdict=spawn_refused_live_or_unmeasured_server socket=%s reason=%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$socket_path" "$reason" >> "$CC_HOME/logs/server-rs.log"
      die "refusing to replace tmux socket: $reason. Inspect /api/debug/tmux before starting workers."
    fi
  fi
  local launch="$cmd"
  if [[ -n "$resume_fallback" ]]; then
    # ONLY A RESUME THAT FAILS AT ONCE FALLS BACK. `||` also fires when a
    # resumed lane that ran for hours is stopped, because a killed claude exits
    # non-zero. Measured 2026-09-26: stopping eight idle CLI-launched lanes
    # through the server relaunched every one of them into a FRESH conversation
    # via this line, the server then adopted the new conversation id, and each
    # lane lost its context until it was pointed back by hand. "Nothing to
    # resume" exits within a second or two; 30s separates the two cleanly.
    launch="_amux_t0=\$SECONDS; $cmd || { if (( SECONDS - _amux_t0 < 30 )); then echo '[amux] nothing to resume here; starting a new conversation' >&2; $resume_fallback; fi; }"
  fi
  # Intel tmux can pass an x86 preference through a native provider into all
  # its Bash tools. Reset the preference for new launches, without restarting
  # the shared tmux server; retain the existing explicit opt-out and fallback.
  if [[ "${AMUX_NATIVE_ARCH:-1}" != 0 && "$(uname -s)" == Darwin ]] \
     && [[ -x /usr/bin/arch && "$(/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null || echo 0)" == 1 ]]; then
    launch="/usr/bin/arch -arm64 -x86_64 /bin/sh -c $(printf '%q' "$launch")"
    printf '[amux] verdict=native_provider_launch measured=true n_considered=1 worker=%s\n' "$name" >&2
  fi
  tmux ${tmux_start_flag:+-N} new-session -d -s "$tname" -n "$name" -c "$dir" \
    -e "AMUX_SESSION=$name" -e "AMUX_WORKER=$name" -e "AMUX_URL=$AMUX_API" \
    "${shell_setup}cd $(printf '%q' "$dir"); $launch"
  # Lock the window name so Claude can't overwrite it with escape sequences.
  # Trailing `:` is load-bearing: allow-rename/automatic-rename are WINDOW
  # options, and a bare `=$tname` session-exact-match target makes tmux look
  # for a WINDOW literally named "=amux-<name>" instead of the current window
  # of that session — "no such window", exit 1, and under `set -euo pipefail`
  # (line 19) that silently kills the rest of cmd_start: no "started" echo,
  # no attach, no error shown (stderr was already routed to /dev/null on the
  # very line that fails). Reproduced 2026-08-30: any non-interactive fresh
  # `amux start <name>` (no --detach, e.g. from `amux start-all`) died right
  # here with empty output and exit 1, while the tmux session it had just
  # created was left running and unlocked. See frustrations.md / INIT-2.
  tmux set-option -t "=$tname:" allow-rename off 2>/dev/null
  tmux set-window-option -t "=$tname:" automatic-rename off 2>/dev/null

  # "started" USED TO MEAN "tmux new-session returned", which it always does:
  # the session is created before the command inside it runs, so a command that
  # exits immediately leaves a dead session and a success message (AMUX-5005).
  # Measured on the original defect: session present at t=2s, gone at t=3s,
  # `amux start` exit 0 the whole time.
  #
  # This is the general guard. Fix 1 above removes the cause I found; this
  # catches the next one, whatever it is — a bad model name, a missing binary,
  # a provider flag claude rejects. Costs one second on a path that already
  # takes longer than that.
  # POLL, DO NOT SAMPLE ONCE. A single check at t=1s could not catch the very
  # failure this guard was written for: the original defect's pane was still
  # ALIVE at t=2s and gone at t=3s, so a 1s sample returned "fine" every time.
  # Found by disabling fix 1 above and watching this guard pass anyway.
  local _alive=1 _t
  for _t in 1 2 3 4; do
    sleep 1
    if ! tmux has-session -t "=$tname" 2>/dev/null; then _alive=0; break; fi
  done
  if [[ "$_alive" == 0 ]]; then
    mkdir -p "$CC_HOME/logs"
    printf '%s WARN amux::start verdict=pane_died_immediately session=%s cmd=%s\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$name" "$cmd" >> "$CC_HOME/logs/server-rs.log"
    echo "${RED}failed${RESET} ${BOLD}$name${RESET}: the pane exited within 4s of starting" >&2
    echo "  ${DIM}$cmd${RESET}" >&2
    echo "  ${DIM}run it by hand in $dir to see why; amux did not keep the output${RESET}" >&2
    return 1
  fi
  echo "${GREEN}started${RESET} ${BOLD}$name${RESET} in $dir"
  echo "  ${DIM}$cmd${RESET}"
  # The session is already created detached (new-session -d). Only attach when
  # not asked to detach — --detach makes `amux start` script/CI/boot friendly.
  if $detach; then
    echo "  ${DIM}detached — attach with: amux attach $name${RESET}"
    return
  fi
  tmux attach-session -t "=$tname"
}

cmd_exec() {
  # Register + start in one step
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: amux exec <name> [--model opus] [--yolo] [--dir /path] [claude flags...]"
  shift

  parse_claude_flags "$@"

  local resolved_dir="${CC_DIR:-$(pwd)}"
  case "$resolved_dir" in
    /*) ;;
    *) die "CC_DIR must be absolute, got: $resolved_dir" ;;
  esac

  # Register if not exists, or update
  local file="$CC_SESSIONS/$name.env"
  cat > "$file" <<EOF
# amux session: $name
# registered: $(date -Iseconds)
CC_NAME="$name"
CC_DIR="$resolved_dir"
CC_FLAGS="${CC_FLAGS_STR}"
EOF

  # Start
  cmd_start "$name" "${CC_EXTRA_ARGS[@]+"${CC_EXTRA_ARGS[@]}"}"
}

cmd_attach() {
  local name
  name=$(resolve_session "${1:-}")
  if [[ "$(session_backend "$name")" == "herdr" ]]; then
    need_herdr
    is_running "$name" || die "worker '$name' is not running. Start with: amux start $name"
    local agent
    agent=$(herdr_agent_of "$name")
    if [[ -n "$agent" ]]; then
      exec herdr --session "$(herdr_session_name)" agent attach "$agent"
    fi
    exec herdr --session "$(herdr_session_name)"
  fi
  need_tmux
  local tname
  tname=$(tmux_name "$name")
  is_running "$name" || die "worker '$name' is not running. Start with: amux start $name"
  tmux attach-session -t "=$tname"
}

cmd_peek() {
  local name
  name=$(resolve_session "${1:-}")
  local lines="${2:-30}"

  if [[ "$(session_backend "$name")" == "herdr" ]]; then
    need_herdr
    is_running "$name" || die "worker '$name' is not running"
    local agent
    agent=$(herdr_agent_of "$name")
    echo "${BOLD}── $name ──${RESET}"
    herdr --session "$(herdr_session_name)" agent read "$agent" \
      --source recent-unwrapped --lines "$lines" --format text 2>/dev/null \
      || echo "${DIM}(no output)${RESET}"
    echo "${BOLD}── end ──${RESET}"
    return
  fi

  need_tmux
  local tname
  tname=$(tmux_name "$name")
  is_running "$name" || die "worker '$name' is not running"

  echo "${BOLD}── $name ──${RESET}"
  tmux capture-pane -t "=$tname:" -p -S "-$lines" 2>/dev/null || echo "${DIM}(no output)${RESET}"
  echo "${BOLD}── end ──${RESET}"
}

_send_usage() {
  cat <<USAGE
${BOLD}amux send${RESET} — send a message to a session

  amux send <worker> --stdin        read the message from stdin ${GREEN}(preferred)${RESET}
  amux send <worker> --file <path>  read the message from a file
  amux send <worker> <text>         inline text (see the warning below)
  amux send <worker> --keys 'C-c'   send a raw key sequence

  ${BOLD}--no-board${RESET}  skip board-card creation for one-off questions and status
              checks. Combines with any form above:
                amux send <worker> --no-board --stdin <<'EOF'
              Equivalent to the API's {"no_board": true}, or prefixing the
              message with [no-board] (which the server strips before delivery).

${BOLD}Why --stdin is preferred${RESET}
  With inline text your SHELL evaluates the string before amux ever sees it, so
  \`backticks\` and \$(...) inside the message are EXECUTED, not sent. That has
  garbled messages, leaked a credential, and fired a stray git command on a
  shared checkout. --stdin/--file pass the bytes through untouched.

  amux send api --stdin <<'EOF'
  fix the auth bug — see \`git log -1\` and \$(date) stay literal
  EOF
USAGE
}

cmd_send() {
  # --help must not be parsed as a session name (it used to error with
  # "session '--help' not found", so the safe form was undiscoverable).
  case "${1:-}" in
    --help|-h|help) _send_usage; return 0 ;;
  esac
  local name
  name=$(resolve_session "${1:-}")
  shift
  # --no-board (AC-183): skip board-card creation for one-off questions and status
  # checks. The flag existed only in the thin /usr/local/bin stub the server writes,
  # which is shadowed on PATH by THIS file (~/.local/bin comes first), so the
  # documented invocation `amux send X --no-board ...` reached a CLI that had never
  # heard of it. Consumed in a loop so it works before or after --stdin/--file.
  local _nb=""
  while [[ "${1:-}" == "--no-board" ]]; do _nb=1; shift; done
  # herdr sessions deliver through the server API; tmux is only needed for the raw
  # fallback path on tmux-backed sessions. BOTH sides of this conflict are wanted:
  # main added the --no-board loop, #80 made need_tmux conditional on the backend.
  if [[ "$(session_backend "$name")" != "herdr" ]]; then
    need_tmux
  fi

  local tname
  tname=$(tmux_name "$name")
  # NO LOCAL is_running GATE for a message (AMUX-5237). This used to die with
  # "worker 'X' is not running" before the server was asked, so mixpeek-general's
  # follow-ups to paused mixpeek-observability and backend were dropped on the
  # floor. The server decides now: a paused or stopped lane gets the message
  # QUEUED for resume and the reply says the sender owns the outcome meanwhile.
  # Raw --keys still needs a live pane, so the check stays on that branch.

  # ── Payload via --stdin / --file: the text NEVER transits a shell-evaluated
  # string (AMUX-1888). Passing a message as a double-quoted argument lets the
  # SENDER'S shell expand backticks/$() before amux ever sees it — demonstrated
  # blast radii: garbled messages, a leaked credential, and a stray
  # `git rebase --quit` on a SHARED checkout. Heredoc-per-call fixes it only if
  # every caller remembers; this encodes the safe path instead.
  #   amux send X --stdin <<'EOF' ... EOF
  #   amux send X --file /tmp/msg.txt
  if [[ "${1:-}" == "--stdin" || "${1:-}" == "-" ]]; then
    local msg; msg=$(cat)
    [[ -n "$msg" ]] || die "no message on stdin"
    _send_via_api "$name" "$msg" "$_nb"; return $?
  fi
  if [[ "${1:-}" == "--file" ]]; then
    local f="${2:-}"
    [[ -n "$f" && -r "$f" ]] || die "usage: amux send <worker> --file <path>"
    local msg; msg=$(cat "$f")
    [[ -n "$msg" ]] || die "file is empty: $f"
    # A RECEIPT, BECAUSE THIS PATH CANNOT TELL FRESH BYTES FROM STALE ONES.
    #
    # Reported by mixpeek-frustrations, 2026-09-06, reproduced on themselves: a
    # heredoc write to a scratchpad path failed ("Permission denied" — a 0400
    # file left on that exact name by a session two days earlier), and the send
    # that followed read the STALE file and reported "sent". tubescience received
    # a two-day-old commit message instead of the review finding meant for them.
    #
    # Two independent steps: the first fails loudly to stderr, the second
    # succeeds on stale bytes and prints success in the same breath. Nothing in
    # the send path can distinguish "what the caller just wrote" from "two days
    # old", and the success line is what the eye lands on.
    #
    # Scratchpad filenames are predictable and reused across sessions
    # (msg-ts.txt, msg-scan.txt), so the collision is structural rather than
    # unlucky: a per-session scratchpad that is not per-session in practice.
    #
    # The receipt is the cheap half and it is unconditional — printing WHAT was
    # read, before claiming it was sent, is what makes stale bytes visible with
    # no extra call. Same reason graft-push prints its receipt before pushing.
    # An mtime heuristic was the reporter's option 2 and is deliberately NOT
    # here: a deliberate resend of an older draft is legitimate and would make it
    # noise, and a warning people learn to ignore is worse than none.
    local _bytes _first
    _bytes=$(printf '%s' "$msg" | wc -c | tr -d ' ')
    _first=$(printf '%s' "$msg" | head -1 | cut -c1-72)
    echo "${DIM}read ${_bytes}B from ${f}: ${_first}${RESET}" >&2
    _send_via_api "$name" "$msg" "$_nb"; return $?
  fi

  # Check for --keys flag
  if [[ "${1:-}" == "--keys" ]]; then
    shift
    is_running "$name" || die "worker '$name' is not running"
    tmux send-keys -t "=$tname:" "$@"
    echo "${GREEN}sent keys${RESET} to $name"
  else
    local text="$*"
    [[ -n "$text" ]] || { _send_usage; return 1; }
    # NUDGE ON USE, not content: by the time we see $text the shell has already
    # expanded it, so a warning about backticks is too late to be evidence. What
    # we CAN observe is the risky USAGE SHAPE — long or multi-line payloads are
    # where code/quotes/substitutions live. Warns to stderr, never blocks: this
    # is the only encoding available for callers who never read --help.
    if [[ ${#text} -gt 280 || "$text" == *$'\n'* ]]; then
      echo "${YELLOW}note:${RESET} long/multi-line payload sent as a shell argument — your shell already" >&2
      echo "      expanded any \`backticks\`/\$(...) in it. Prefer: amux send $name --stdin <<'EOF'" >&2
    fi
    _send_via_api "$name" "$text" "$_nb"
  fi
}

# Deliver a message through the server: SERVER-VERIFIED origin stamp
# (X-Amux-Session, AMUX-1768), busy-deferral, audit event. The old raw
# `tmux send-keys` path delivered ANONYMOUS text straight into the pane — no
# provenance, no record, could interrupt an in-flight turn — which is how the
# 2026-07-22 ts-gke→mvs-infra→gtm-engine misroute happened (AMUX-1818). Raw
# Unacknowledged requests remain unknown; direct terminal pasting was removed
# after the TubeScience stacked-draft incident (AMUX-4359).
# ── Unstamped-send ledger (AMUX-2670) ───────────────────────────────────────
#
# A raw-tmux fallback happens precisely when the server cannot be told about it,
# so the record has to be made locally and reconciled later. Otherwise an
# unaudited send and a send that never happened look identical from the server,
# which is the gap this ledger closes.
#
# Failure here must never break a send: every write is best-effort.
_unstamped_ledger() { echo "${CC_HOME}/pending-unstamped.jsonl"; }

_record_unstamped_send() {
  local target="$1" body="$2"
  local f; f=$(_unstamped_ledger)
  TGT="$target" BODY="$body" FROM="${AMUX_SESSION:-}" python3 -c "
import json, os, time, sys
try:
    print(json.dumps({
        'target': os.environ['TGT'],
        'text': os.environ['BODY'],
        'from': os.environ.get('FROM', ''),
        # MILLISECONDS. cmd_history.ts is millis (declared in
        # invariants/checks.rs TIMESTAMP_COLUMNS), and this wrote SECONDS, so
        # every reconciled fallback landed in the audit trail dated 1970-01-21
        # and sorted below every real row — GET /api/history?limit=50 never
        # returned one. The send WAS recorded and was unfindable where anyone
        # looks, which is the exact failure this ledger exists to prevent.
        # Found by writing scripts/test-unstamped-ledger.sh (AMUX-2626).
        'ts': int(time.time() * 1000),
    }))
except Exception:
    sys.exit(1)
" >> "$f" 2>/dev/null || true
}

# Flush on reconnect. Called after a send that REACHED the server, which is the
# only moment we know the server is answering. Each row goes to POST
# /api/history (records, does not deliver — re-delivering would double-send a
# message the pane already received) typed `raw-tmux-fallback`, so the audit
# trail can tell an unstamped injection from an audited send instead of showing
# neither.
_flush_unstamped_ledger() {
  local f; f=$(_unstamped_ledger)
  [[ -s "$f" ]] || return 0
  local api="${AMUX_API:-https://localhost:8824}"
  local tmp; tmp=$(_amux_tmpfile) || return 0
  local sent=0 kept=0 line
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    local body
    body=$(LINE="$line" python3 -c "
import json, os, sys
try:
    d = json.loads(os.environ['LINE'])
except Exception:
    sys.exit(1)   # unparseable row: drop it rather than retry forever
print(json.dumps({
    'text': d.get('text', ''),
    'type': 'raw-tmux-fallback',
    'session': d.get('target', ''),
    # NORMALISE: rows written before the millis fix carry SECONDS. Converting
    # here rather than only at the write site means a ledger that survived the
    # upgrade still reconciles to the right instant instead of to 1970.
    # 1e11 is the discriminator: any plausible seconds timestamp is ~1.8e9 and
    # any plausible millis one is ~1.8e12, so the gap is three orders of
    # magnitude and cannot be straddled by clock skew.
    'ts': (lambda t: int(t) * 1000 if t and int(t) < 100000000000 else t)(d.get('ts')),
    'origin': 'unstamped-fallback from ' + (d.get('from') or 'unknown'),
}))" 2>/dev/null) || continue
    if _curl -sk -m 10 -X POST -H 'Content-Type: application/json' \
         -d "$body" "$api/api/history" >/dev/null 2>&1; then
      sent=$((sent+1))
    else
      # Server went away mid-flush: KEEP the row. Dropping it would lose the
      # only record that the send happened at all.
      printf '%s\n' "$line" >> "$tmp"; kept=$((kept+1))
    fi
  done < "$f"
  if [[ "$kept" -eq 0 ]]; then rm -f "$f"; else mv "$tmp" "$f" 2>/dev/null || true; fi
  rm -f "$tmp" 2>/dev/null || true
  [[ "$sent" -gt 0 ]] && echo "${GREEN}reconciled${RESET} $sent previously-unstamped send(s) into the audit trail" >&2
  return 0
}

# SECOND PERSON + THE SAME BODY TO A SECOND LANE (AF-468).
#
# Reported by ts-gke: five instances in one night across at least three lanes,
# all one mechanism — ONE second-person file sent to more than one recipient.
# "your 01:00-03:00 peak is confirmed" reaches a lane that never ran the scan and
# reads as theirs. The failure is not confusion, it is MISATTRIBUTION OF WORK, and
# it lands on durable artifacts: one instance put tubescience's analysis onto
# mvs-infra's record and into a board card, another nearly credited five of
# ts-gke's findings to mixpeek-cicd and ran FOUR messages before anyone objected.
#
# THE RULE ALREADY EXISTS AND DOES NOT FIRE. Both lanes that broadcast that night
# had written it into their own persistent memory, one with the mechanical step
# spelled out ("grep the body before a multi-send"), and both broke it anyway. Two
# earlier lanes wrote a rule against it the same day they broke it. Four authors,
# four rules, five instances. A rule every lane must remember and every lane
# forgets is a missing feature, not a discipline problem.
#
# ts-gke proposed checking "body has second person AND >1 recipient" at send time.
# CORRECTED WHILE IMPLEMENTING: `amux send` takes exactly ONE worker
# (resolve_session "$1") and there is no broadcast verb, so no invocation ever has
# a recipient list to count. The real shape is N invocations sharing one file. So
# the check keys on the BODY REPEATING to a DIFFERENT target, which is the thing
# that actually happens and is strictly more precise than the proposal.
#
# A PRINT, NEVER A BLOCK, per ts-gke and correctly: second person to several lanes
# is legitimate when it is genuinely addressed to all of them, and only the author
# knows. The author can tell instantly; nobody else can.
_warn_second_person_resend() {
  local target="$1" text="$2"
  local f="${CC_HOME}/recent-sends.jsonl"
  # SKIP when a multi-recipient sender has ALREADY made this decision
  # (ts-gke's seam). mixpeek's scripts/fleet-send.sh takes N recipients, refuses a
  # second-person body at N>1, and offers --allow-second-person as the escape. It
  # then loops `amux send` per recipient, so recipients 2..N would trip this
  # warning AFTER the author already typed the override. That is exactly the
  # already-acted-on class the retry suppression exists for, so it gets the same
  # treatment. Any multi-recipient wrapper can export this.
  [[ -n "${AMUX_SEND_MULTI_ACK:-}" ]] && return 0
  TGT="$target" BODY="$text" LEDGER="$f" FROM="${AMUX_SESSION:-}" python3 - <<'PY' >&2 2>/dev/null || true
import json, os, re, time, hashlib
tgt, body, f = os.environ['TGT'], os.environ['BODY'], os.environ['LEDGER']
me = os.environ.get('FROM', '')
WINDOW = 6 * 3600
h = hashlib.sha256(body.encode('utf-8', 'replace')).hexdigest()[:16]
now = time.time()
rows = []
try:
    with open(f) as fh:
        for line in fh:
            try:
                d = json.loads(line)
            except Exception:
                continue
            if now - float(d.get('ts', 0)) < WINDOW:
                rows.append(d)
except FileNotFoundError:
    pass
# Fire only when THIS send ADDS A NEW LANE to a body that already has one.
# A retry to a lane that already received it must stay silent: the ambiguity
# already happened, the author already saw this warning, and repeating it is the
# noise that gets a check tuned out (ethos rule 5).
seen = {d['target'] for d in rows if d.get('hash') == h}
prior = sorted(seen - {tgt})
if prior and tgt not in seen:
    pron = re.findall(r"\b(you|your|yours|you're|you've|you'd|yourself)\b", body, re.I)
    if pron:
        who = ', '.join(prior)
        # SAY WHO SENT IT, because in a RELAY it was not me (ts-gke). A lane sends
        # me a body and I forward it verbatim: the hash matches their row and the
        # fire is CORRECT — a forwarded "you" meant the forwarder — but "this body
        # was already sent to X" is false in my mouth. Rows carry the sender now,
        # so the sentence is true in both cases and the relay one is more useful
        # than the plain one.
        senders = sorted({d.get('session') or '?' for d in rows
                          if d.get('hash') == h and d.get('target') != tgt})
        by = '' if senders == [me] else ' by ' + ', '.join(senders)
        lead = 'you already sent this body to' if senders == [me] else 'this body was already sent to'
        print(f"warning: {lead} {who}{by}, and it contains "
              f"{len(pron)} second-person reference(s).")
        print(f"  \"you\" resolves to whoever opens it, so {tgt} will read those as theirs.")
        print("  Name the session inline with each claim, or send each lane its own text.")
        print("  (A print, not a block — if it is genuinely addressed to all of them, send it.)")
rows.append({'hash': h, 'target': tgt, 'ts': now, 'session': me})
try:
    with open(f, 'w') as fh:
        for d in rows[-500:]:
            fh.write(json.dumps(d) + "\n")
except Exception:
    pass
PY
}

_send_via_api() {
  local name="$1" text="$2" nb="${3:-}"
  _warn_second_person_resend "$name" "$text"
  local tname; tname=$(tmux_name "$name")
  local AMUX_API="${AMUX_API:-https://localhost:8824}"
  local body resp rc
  body=$(MSG="$text" NB="$nb" python3 -c "
import json, os, uuid
d = {'text': os.environ['MSG'], 'msg_id': str(uuid.uuid4())}
if os.environ.get('NB'):
    d['no_board'] = True          # AC-183: server skips autotask card creation
print(json.dumps(d))")
  resp=$(_curl -sk -m 15 -X POST -H 'Content-Type: application/json' \
    -H "X-Amux-Worker: ${AMUX_WORKER:-${AMUX_SESSION:-}}" \
    -d "$body" "$AMUX_API/api/workers/$name/send" 2>/dev/null) || resp=""
  if [[ -n "$resp" ]]; then
    rc=0
    RESP="$resp" TGT="$name" python3 - <<'PYEOF' || rc=$?
import json, os, sys
try:
    d = json.loads(os.environ["RESP"])
except Exception:
    sys.exit(1)
tgt = os.environ["TGT"]
# The server holds this message ID and is still delivering it (it answers
# "pending" for 120 s, then "uncertain"). Neither is a refusal: printing them
# as FAILED made gs12-cicd resend under NEW ids and the orchestrator got the
# same message three times (2026-10-02). 3 = poll the same id, 4 = unconfirmed.
if d.get("submission") == "pending" and d.get("retryable"):
    sys.exit(3)
if d.get("submission") == "uncertain":
    print(f"UNCONFIRMED send to {tgt}: the server holds this message but never confirmed delivery; "
          f"check `amux history` or the worker before sending again", file=sys.stderr)
    sys.exit(4)
if d.get("error") or d.get("ok") is False:
    # stderr, like every other failure the CLI reports. On stdout it was one
    # `| tail -1` away from invisible, and callers that capture a send's output
    # read the refusal as a value.
    print(f"send to {tgt} FAILED: {d.get('error') or d.get('message') or 'no reason given'}",
          file=sys.stderr)
    sys.exit(2)
if d.get("held_for_resume"):
    # AMUX-5237: NOT delivered. Say so first, so a caller skimming for "sent"
    # cannot read a parked message as a landed one.
    print(f"QUEUED for {tgt}, not delivered: {d.get('message', '')}")
    sys.exit(0)
print(f"sent to {tgt} (origin-stamped): {d.get('message', 'ok')}")
PYEOF
    # A send that REACHED the server is the only moment we know it is
    # answering — so it is the moment to reconcile anything sent unstamped
    # while it was down (AMUX-2670). Best-effort: never let reconciliation
    # affect the result of the send the user actually asked for.
    [[ $rc -eq 0 ]] && { _flush_unstamped_ledger || true; return 0; }
    [[ $rc -eq 2 ]] && return 1   # server understood and refused — do NOT fall back
    [[ $rc -eq 4 ]] && return 1   # held but unconfirmed: said so; never resend
  fi
  # Retry: the server restarts when the builder installs a new binary (it
  # self-adopts and relaunches); a 1-2s wait often recovers. Three tries over
  # ~4s. Every attempt carries the same msg_id so a lost reply cannot duplicate delivery.
  # A "pending" answer polls the SAME message ID every 3s for up to ~2 min
  # (AMUX_SEND_PENDING_WAIT_S) instead of counting as a failed try.
  local _retry=0 _waited=0 _pend_max="${AMUX_SEND_PENDING_WAIT_S:-120}" _transport=0 _pend_prev=""
  while :; do
    _retry=$((_retry + 1))
    _pend_prev=""
    if [[ "${rc:-1}" -eq 3 ]]; then _pend_prev=1; sleep 3; _waited=$((_waited + 3)); else sleep 2; _waited=$((_waited + 2)); _transport=$((_transport + 1)); fi
    resp=$(_curl -sk -m 5 -X POST -H 'Content-Type: application/json' \
      -H "X-Amux-Worker: ${AMUX_WORKER:-${AMUX_SESSION:-}}" \
      -d "$body" "$AMUX_API/api/workers/$name/send" 2>/dev/null) || resp=""
    if [[ -n "$resp" ]]; then
      rc=0
      # AF-556: `_R` is PASSED here. It used to be read from the environment and
      # nothing in this file ever set it, so the attempt number interpolated to
      # '' on every execution forever and the line read "retry ) ". The
      # `.get(_,'')` default is what hid it: an unset variable would have
      # raised, and the empty-string fallback made a dead field look like a
      # formatting nit. A value no input can change is the hardcoded-summary
      # class, and it looked measured.
      #
      # It is not cosmetic here. This annotation is the ONLY thing in the output
      # separating a send that reached the server first try from one that
      # recovered across a restart — and the comment above says exactly when
      # that happens: the builder installs a new binary and the server
      # relaunches. So a send can be evaluated by a DIFFERENT BINARY than the
      # caller pinned, and the marker meant to say so could not.
      #
      # Measured 2026-09-07 during AMUX-4018's policy probes: an allow probe
      # returned exit 0 with "retry " while /health moved 6b72d65e -> 67ab58c7
      # underneath it. The probe was void and only a hand-run /health bracket
      # on both sides caught it. The ELAPSED wait ships too, because "retry 2"
      # alone does not say how long the gap was, and the gap is the window a
      # deploy fits into.
      _R_PENDING="$_pend_prev" _R="$_retry" _R_WAITED="$_waited" RESP="$resp" TGT="$name" python3 - <<'PYEOF' || rc=$?
import json, os, sys
try:
    d = json.loads(os.environ["RESP"])
except Exception:
    sys.exit(1)
tgt = os.environ["TGT"]
attempt = os.environ["_R"]
waited = os.environ["_R_WAITED"]
if d.get("submission") == "pending" and d.get("retryable"):
    sys.exit(3)
if d.get("submission") == "uncertain":
    print(f"UNCONFIRMED send to {tgt} after {waited}s: the server holds this message but never "
          f"confirmed delivery; check `amux history` or the worker before sending again", file=sys.stderr)
    sys.exit(4)
if d.get("error") or d.get("ok") is False:
    # A REFUSAL HAS TO SPEAK. This arm used to `sys.exit(2)` in silence, and
    # the shell turns that into a bare `return 1`. So a send whose transport
    # failed twice and was then REFUSED by the server printed nothing at all:
    # no "sent", no "FAILED", no "UNCONFIRMED", and no cmd_history row to find
    # afterwards. Measured on lat-probe 2026-09-23 — the operator's whole
    # evidence was a missing line (AMUX-5028).
    #
    # It names the retry, because by the time this arm runs TWO things have
    # gone wrong and only one of them is the refusal.
    print(
        f"send to {tgt} FAILED on retry {attempt} after {waited}s "
        f"(earlier attempts never reached the server): "
        f"{d.get('error') or d.get('message') or 'no reason given'}",
        file=sys.stderr,
    )
    sys.exit(2)
if d.get("held_for_resume"):
    print(f"QUEUED for {tgt} (retry {attempt} after {waited}s), not delivered: {d.get('message', '')}")
    sys.exit(0)
if os.environ.get("_R_PENDING") == "1":
    print(f"sent to {tgt} (origin-stamped; confirmed after {waited}s pending under one message ID): "
          f"{d.get('message', 'ok')}")
    sys.exit(0)
# Both operands are REQUIRED, not defaulted: a missing one must crash here
# rather than print an empty field that reads as a measured zero. That default
# is the whole bug this line is fixing, and the refusal arm above reads the
# same two names for the same reason.
print(
    f"sent to {tgt} (origin-stamped, retry {attempt} after {waited}s — "
    f"the server was unreachable on the first try, so this was evaluated by "
    f"whatever binary is live NOW; check /health if you pinned a build): "
    f"{d.get('message', 'ok')}"
)
PYEOF
      # Same reconciliation point as the first attempt: the server answered.
      [[ $rc -eq 0 ]] && { _flush_unstamped_ledger || true; return 0; }
      [[ $rc -eq 2 ]] && return 1
      [[ $rc -eq 4 ]] && return 1
      if [[ $rc -eq 3 ]]; then
        [[ $_waited -lt $_pend_max ]] && continue
        echo "${RED}UNCONFIRMED${RESET} send to $name: still pending after ${_waited}s under one message ID; the server is delivering it. Check message history before sending again." >&2
        return 1
      fi
    else
      rc=1
    fi
    [[ $_transport -ge 2 ]] && break
  done
  # A missing response is not proof that the request failed. The server may
  # already have queued it. Retrying with the same msg_id is safe; typing an
  # extra copy directly into the terminal bypasses dedupe and can splice it
  # into an existing draft (TubeScience's stacked collapsed-paste incident).
  # Keep the terminal untouched and leave a local diagnostic when the server
  # cannot acknowledge any attempt. Historical fallback ledgers still flush.
  TARGET="$name" BODY="$body" SEND_HOME="$CC_HOME" python3 - <<'PYEOF'
import json, os, time
from pathlib import Path
row = {"ts": time.time(), "verdict": "send_delivery_unknown", "target": os.environ["TARGET"],
       "msg_id": json.loads(os.environ["BODY"])["msg_id"], "attempts": 3, "raw_fallback": False}
try:
    path = Path(os.environ["SEND_HOME"]) / "logs" / "send-failures.jsonl"
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a") as f:
        f.write(json.dumps(row) + "\n")
except OSError as error:
    print(f"warning: could not record send_delivery_unknown: {error}", file=__import__('sys').stderr)
print(f"send_delivery_unknown: {row['target']} msg_id={row['msg_id']}", file=__import__('sys').stderr)
PYEOF
  echo "${RED}UNCONFIRMED${RESET} send to $name: amux did not acknowledge the request after retries. It may already be queued; check message history when the server returns before sending again. No raw terminal paste was attempted." >&2
  return 1
}

cmd_stop() {
  local name
  name=$(resolve_session "${1:-}")
  if [[ "$(session_backend "$name")" == "herdr" ]]; then
    if ! is_running "$name"; then
      echo "${DIM}$name is not running${RESET}"
      return
    fi
    # Prefer the server's graceful stop (transcript snapshot + /exit); if the
    # server is down, close the pane directly — loud, like the tmux kill below.
    if _stop_via_api "$name"; then
      return
    fi
    need_herdr
    local pane
    pane=$(sed -n 's/^CC_HERDR_PANE_ID=//p' "$CC_SESSIONS/$name.env" | tail -1 | tr -d '"')
    if [[ -n "$pane" ]] && herdr --session "$(herdr_session_name)" pane close "$pane" >/dev/null 2>&1; then
      echo "${RED}stopped${RESET} $name (pane closed — server was unreachable, no transcript snapshot)"
    else
      die "failed to stop $name: server unreachable and pane close failed"
    fi
    return
  fi
  need_tmux

  local tname
  tname=$(tmux_name "$name")
  if is_running "$name"; then
    tmux kill-session -t "=$tname"
    echo "${RED}stopped${RESET} $name"
  else
    echo "${DIM}$name is not running${RESET}"
  fi

  # Clean up worktree if one exists for this session
  local wt_dir="$CC_HOME/worktrees/$name"
  if [[ -d "$wt_dir" ]]; then
    # Resolve the repo that owns this worktree from the .git file
    local repo_dir=""
    if [[ -f "$wt_dir/.git" ]]; then
      repo_dir=$(sed -n 's/^gitdir: \(.*\)\/\.git\/worktrees\/.*/\1/p' "$wt_dir/.git")
    fi
    warn_if_worktree_dirty "$wt_dir"
    if [[ -n "$repo_dir" ]] && git -C "$repo_dir" worktree remove --force "$wt_dir" 2>/dev/null; then
      echo "  ${DIM}worktree removed: $wt_dir${RESET}"
    else
      rm -rf "$wt_dir"
      echo "  ${DIM}worktree cleaned: $wt_dir${RESET}"
    fi
  fi
}

cmd_pause() {
  local name
  name=$(resolve_session "${1:-}")
  local AMUX_API="${AMUX_API:-https://localhost:8824}"
  local resp
  resp=$(_curl -sk -m 90 -X POST -H "X-Amux-Session: ${AMUX_SESSION:-}" \
    "$AMUX_API/api/workers/$name/pause" 2>/dev/null) || resp=""
  if [[ -z "$resp" ]]; then
    die "could not reach server to pause $name"
  fi
  local ok
  ok=$(echo "$resp" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('lifecycle',''))" 2>/dev/null) || ok=""
  if [[ "$ok" == "paused" ]]; then
    echo "${YELLOW}paused${RESET} $name"
  else
    local err
    err=$(echo "$resp" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('error','unknown'))" 2>/dev/null) || err="unknown"
    echo "${RED}failed to pause $name:${RESET} $err"
    return 1
  fi
}

cmd_resume() {
  local name
  name=$(resolve_session "${1:-}")
  local AMUX_API="${AMUX_API:-https://localhost:8824}"
  local resp
  resp=$(_curl -sk -m 90 -X POST -H "X-Amux-Session: ${AMUX_SESSION:-}" \
    "$AMUX_API/api/workers/$name/resume" 2>/dev/null) || resp=""
  if [[ -z "$resp" ]]; then
    die "could not reach server to resume $name"
  fi
  local ok
  ok=$(echo "$resp" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('lifecycle',''))" 2>/dev/null) || ok=""
  if [[ "$ok" == "active" ]]; then
    echo "${GREEN}resumed${RESET} $name"
  else
    local err
    err=$(echo "$resp" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('error','unknown'))" 2>/dev/null) || err="unknown"
    echo "${RED}failed to resume $name:${RESET} $err"
    return 1
  fi
}

cmd_server() {
  case "${1:-}" in
    start)
      echo "Starting amux server..."
      launchctl kickstart "gui/$(id -u)/com.amux.server-rs"
      echo "${GREEN}server started${RESET}"
      ;;
    stop)
      echo "Stopping amux server..."
      launchctl kill SIGTERM "gui/$(id -u)/com.amux.server-rs"
      echo "${RED}server stopped${RESET}"
      ;;
    restart)
      echo "Restarting amux server..."
      launchctl kickstart -k "gui/$(id -u)/com.amux.server-rs"
      echo "${GREEN}server restarted${RESET}"
      ;;
    status)
      if _curl -sk -m 5 "$(cmd_url)/api/health" >/dev/null 2>&1; then
        echo "${GREEN}server is running${RESET} at $(cmd_url)"
      else
        echo "${RED}server is not reachable${RESET}"
      fi
      ;;
    *)
      echo "Usage: amux server <start|stop|restart|status>"
      ;;
  esac
}

cmd_rm() {
  local name
  name=$(resolve_session "${1:-}")

  # Stop if running (also cleans up any worktree)
  if is_running "$name" 2>/dev/null; then
    cmd_stop "$name"
  else
    # Not running, but a stale worktree might still exist
    local wt_dir="$CC_HOME/worktrees/$name"
    if [[ -d "$wt_dir" ]]; then
      local repo_dir=""
      if [[ -f "$wt_dir/.git" ]]; then
        repo_dir=$(sed -n 's/^gitdir: \(.*\)\/\.git\/worktrees\/.*/\1/p' "$wt_dir/.git")
      fi
      warn_if_worktree_dirty "$wt_dir"
      if [[ -n "$repo_dir" ]]; then
        git -C "$repo_dir" worktree remove --force "$wt_dir" 2>/dev/null || rm -rf "$wt_dir"
      else
        rm -rf "$wt_dir"
      fi
    fi
  fi

  rm -f "$CC_SESSIONS/$name.env"
  echo "${RED}removed${RESET} $name"
}

cmd_info() {
  local name
  name=$(resolve_session "${1:-}")
  load_session "$name"

  echo "${BOLD}$name${RESET}"
  echo "  dir:   ${CC_DIR:-"(not set)"}"
  echo "  flags: ${CC_FLAGS:-"(none)"}"
  local wt_dir="$CC_HOME/worktrees/$name"
  if [[ -d "$wt_dir" ]]; then
    echo "  worktree: $wt_dir"
  elif [[ "${CC_WORKTREE:-}" == "1" ]]; then
    echo "  worktree: ${DIM}enabled (created on start)${RESET}"
  fi
  if is_running "$name" 2>/dev/null; then
    echo "  status: ${GREEN}running${RESET}"
  else
    echo "  status: ${DIM}stopped${RESET}"
  fi
}

cmd_ls() {
  local i=1
  local has_any=false

  for f in "$CC_SESSIONS"/*.env; do
    [[ -f "$f" ]] || continue
    has_any=true
    local name
    name=$(basename "$f" .env)
    load_session "$name"

    local status_icon status_color
    if is_running "$name" 2>/dev/null; then
      status_icon="*"
      status_color="$GREEN"
    else
      status_icon=" "
      status_color="$DIM"
    fi

    # Build flag summary
    local flag_summary=""
    if [[ "${CC_FLAGS:-}" == *"--dangerously-skip-permissions"* ]]; then
      flag_summary+=" ${YELLOW}YOLO${RESET}"
    fi
    local model_match
    if model_match=$(echo "${CC_FLAGS:-}" | sed -n 's/.*--model \([^ ]*\).*/\1/p' 2>/dev/null) && [[ -n "$model_match" ]]; then
      flag_summary+=" ${CYAN}$model_match${RESET}"
    fi

    # Preview last output line if running
    local preview=""
    if is_running "$name" 2>/dev/null; then
      if [[ "$(session_backend "$name")" == "herdr" ]]; then
        local agent
        agent=$(herdr_agent_of "$name")
        preview=$(herdr --session "$(herdr_session_name)" agent read "$agent" --source recent-unwrapped --lines 3 --format text 2>/dev/null | grep -v '^$' | tail -1 | cut -c1-60)
      else
        preview=$(tmux capture-pane -t "=$(tmux_name "$name"):" -p -S -3 2>/dev/null | grep -v '^$' | tail -1 | cut -c1-60)
      fi
      [[ -n "$preview" ]] && preview=" ${DIM}│ $preview${RESET}"
    fi

    printf " %s${status_color}%s${RESET} ${BOLD}%-16s${RESET} %s%s%s\n" \
      "$i" "$status_icon" "$name" "${DIM}${CC_DIR:-}${RESET}" "$flag_summary" "$preview"
    ((i++))
  done

  if ! $has_any; then
    echo "${DIM}No workers registered. Run: amux register <name>${RESET}"
  fi
}

cmd_dashboard() {
  # A BARE `amux` IS AN INTERACTIVE DASHBOARD. Refuse it when nobody can see
  # it, because the failure mode is not a useless screen, it is a process that
  # never exits.
  #
  # Measured 2026-09-18: 9,141 processes of `bash ~/.local/bin/amux` with no
  # subcommand, accumulated over 14 hours, every one sleeping, load average 97
  # on a box ~/Dev/CLAUDE.md says must stay up and that has already lost
  # sessions to a jetsam-driven power cycle. They gridlocked the fleet: every
  # graft-push scans `ps -A` in its in-flight check, and at 10k processes that
  # scan takes ~60s, so a loop printing "waiting 5s" ticked once a minute and a
  # 13-minute wait became ~111 minutes.
  #
  # The hang is NOT the `read` loop below — with stdin at EOF that returns and
  # breaks. It is `cmd_ls`, three lines down, which fans out tmux calls across
  # every session. A single `tmux list-sessions` measured 884ms at load 84
  # against ~50ms idle, so the dashboard's fan-out stalls, the caller never
  # returns, and the next invocation arrives before the last one left. That is
  # a feedback loop: the pile-up is what makes tmux slow enough to cause the
  # pile-up.
  #
  # Refusing on a non-TTY also makes the CALLER visible. A hung process is
  # anonymous; a non-zero exit with this message lands in whatever log invoked
  # it, which is what nobody had while 9,141 of them accumulated.
  if [[ ! -t 0 || ! -t 1 ]]; then
    echo "amux: no subcommand, and this is not an interactive terminal." >&2
    echo "The bare command opens a dashboard that reads keystrokes and enumerates" >&2
    echo "every session over tmux; with no terminal it would block forever." >&2
    echo "Run 'amux help' for usage, or name a subcommand." >&2
    exit 2
  fi
  need_tmux
  clear

  echo "${BOLD}${BLUE}  amux${RESET} ${DIM}v${CC_VERSION}${RESET}"
  echo ""
  cmd_ls
  echo ""
  echo "${DIM}Commands: [n]umber to attach, p[n] to peek, s[n] to send, q to quit${RESET}"
  echo ""

  while true; do
    read -rp "${CYAN}amux>${RESET} " input || break
    case "$input" in
      q|quit|exit)
        break
        ;;
      ls|list)
        cmd_ls
        ;;
      p[0-9]*)
        local num="${input#p}"
        local name
        name=$(resolve_session "$num" 2>/dev/null) && cmd_peek "$name" || echo "${RED}invalid${RESET}"
        ;;
      s[0-9]*)
        # s1 fix the bug → send "fix the bug" to session 1
        local rest="${input#s}"
        local num="${rest%% *}"
        local text="${rest#* }"
        [[ "$text" == "$num" ]] && text=""
        local name
        if name=$(resolve_session "$num" 2>/dev/null); then
          if [[ -n "$text" ]]; then
            cmd_send "$name" "$text"
          else
            read -rp "  msg> " text
            [[ -n "$text" ]] && cmd_send "$name" "$text"
          fi
        else
          echo "${RED}invalid${RESET}"
        fi
        ;;
      [0-9]*)
        local name
        name=$(resolve_session "$input" 2>/dev/null) && cmd_attach "$name" || echo "${RED}invalid${RESET}"
        ;;
      "")
        ;;
      *)
        # Try as session name
        local name
        if name=$(resolve_session "$input" 2>/dev/null); then
          cmd_attach "$name"
        else
          echo "${RED}unknown:${RESET} $input"
        fi
        ;;
    esac
  done
}

cmd_defaults() {
  local subcmd="${1:-show}"
  case "$subcmd" in
    show)
      if [[ -s "$CC_DEFAULTS" ]]; then
        echo "${BOLD}Global defaults:${RESET}"
        cat "$CC_DEFAULTS"
      else
        echo "${DIM}No defaults set. Run: amux defaults edit${RESET}"
      fi
      ;;
    edit)
      "${EDITOR:-vi}" "$CC_DEFAULTS"
      ;;
    reset)
      : > "$CC_DEFAULTS"
      echo "${GREEN}defaults reset${RESET}"
      ;;
    *)
      die "usage: amux defaults [show|edit|reset]"
      ;;
  esac
}

cmd_stop_all() {
  for f in "$CC_SESSIONS"/*.env; do
    [[ -f "$f" ]] || continue
    local name
    name=$(basename "$f" .env)
    if is_running "$name" 2>/dev/null; then
      cmd_stop "$name"
    fi
  done
}

cmd_pause_all() {
  local AMUX_API="${AMUX_API:-https://localhost:8824}"
  local sessions_json
  sessions_json=$(_curl -sk -m 30 "$AMUX_API/api/sessions" 2>/dev/null) || die "could not reach server"
  local names
  names=$(echo "$sessions_json" | python3 -c "
import json, sys
data = json.load(sys.stdin)
for s in data:
    if not s.get('archived') and s.get('lifecycle', 'active') == 'active':
        print(s['name'])
" 2>/dev/null) || die "failed to parse sessions"
  local paused=0 skipped=0 failed=0
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    local resp
    resp=$(_curl -sk -m 90 -X POST -H "X-Amux-Session: ${AMUX_SESSION:-}" \
      "$AMUX_API/api/workers/$name/pause" 2>/dev/null) || resp=""
    local lc
    lc=$(echo "$resp" | python3 -c "import json,sys; print(json.load(sys.stdin).get('lifecycle',''))" 2>/dev/null) || lc=""
    if [[ "$lc" == "paused" ]]; then
      echo "${YELLOW}paused${RESET} $name"
      paused=$((paused + 1))
    elif [[ "$lc" == "paused" ]] || echo "$resp" | grep -q '"noop"'; then
      echo "${DIM}$name already paused${RESET}"
      skipped=$((skipped + 1))
    else
      echo "${RED}failed to pause $name${RESET}"
      failed=$((failed + 1))
    fi
  done <<< "$names"
  echo "${BOLD}pause-all:${RESET} ${YELLOW}${paused} paused${RESET} · ${skipped} skipped · ${failed} failed"
}

cmd_resume_all() {
  local AMUX_API="${AMUX_API:-https://localhost:8824}"
  local sessions_json
  sessions_json=$(_curl -sk -m 30 "$AMUX_API/api/sessions" 2>/dev/null) || die "could not reach server"
  local names
  names=$(echo "$sessions_json" | python3 -c "
import json, sys
data = json.load(sys.stdin)
for s in data:
    if s.get('lifecycle') == 'paused':
        print(s['name'])
" 2>/dev/null) || die "failed to parse sessions"
  local resumed=0 failed=0
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    local resp
    resp=$(_curl -sk -m 90 -X POST -H "X-Amux-Session: ${AMUX_SESSION:-}" \
      "$AMUX_API/api/workers/$name/resume" 2>/dev/null) || resp=""
    local lc
    lc=$(echo "$resp" | python3 -c "import json,sys; print(json.load(sys.stdin).get('lifecycle',''))" 2>/dev/null) || lc=""
    if [[ "$lc" == "active" ]]; then
      echo "${GREEN}resumed${RESET} $name"
      resumed=$((resumed + 1))
    else
      echo "${RED}failed to resume $name${RESET}"
      failed=$((failed + 1))
    fi
  done <<< "$names"
  echo "${BOLD}resume-all:${RESET} ${GREEN}${resumed} resumed${RESET} · ${failed} failed"
}

# Start every registered, NON-ARCHIVED worker that is not already running.
#
# This is the fleet's cold-start path (a machine reboot, `amux stop-all`, a
# launchd boot agent), and on 2026-08-29 it could not do the job in three
# independent ways at once — none of which announced itself, because the only
# caller was a human who read the first worker's output and assumed the rest
# followed (AMUX-3887):
#
#   1. NO ARCHIVE FILTER. It iterated every *.env, and 66 of the 124 registered
#      workers are archived. Archiving a worker is how you retire it; bulk-start
#      resurrecting all 66 would have been the loudest possible bug, and it never
#      fired only because of (2).
#   2. IT ABORTED AFTER THE FIRST WORKER. `cmd_start` exited 1 on every real
#      start (the tmux allow-rename bug, see cmd_start), and under
#      `set -euo pipefail` a non-zero return from a function called bare in a
#      loop body kills the whole script. So this started exactly ONE worker and
#      exited — silently, with the shell's status, having printed nothing.
#   3. IT TRIED TO ATTACH. `cmd_start` without --detach ends in
#      `tmux attach-session`, which cannot work from launchd or any other
#      non-TTY caller.
#
# Each fix below is paired with the reporting that would have caught it: the
# per-worker verdict, and the started/skipped/failed/archived summary. A bulk
# operation that cannot say how many of N it actually did is indistinguishable
# from one that did nothing, which is ethos rule 4 — the count beside the zero.
cmd_start_all() {
  local started=0 already=0 failed=0 archived=0
  local failures=()
  shopt -s nullglob
  local files=("$CC_SESSIONS"/*.env)
  shopt -u nullglob
  local f name
  # `${files[@]+"${files[@]}"}`, never a bare `"${files[@]}"`. macOS ships bash
  # 3.2, where expanding an EMPTY array under `set -u` is ITSELF the "unbound
  # variable" fatal (bash fixed this in 4.4; a `#!/usr/bin/env bash` script on
  # macOS cannot assume it). With nullglob on and no *.env registered, `files`
  # is empty, so the bare form killed cmd_start_all before its first iteration:
  # `line 1794: files[@]: unbound variable`, rc=1, nothing else printed.
  #
  # The only caller is the launchd boot agent, so the failure surfaced as a
  # fleet that had simply never started, with the reason buried in
  # fleet-boot.log. A machine with zero registered workers is exactly a FRESH
  # INSTALL — so this fired hardest where there was least context to debug it.
  #
  # Falling through to the summary with an empty list is correct, not a special
  # case: "0 started · 0 archived" is the count beside the zero the block
  # comment above exists to demand.
  for f in ${files[@]+"${files[@]}"}; do
    [[ -f "$f" ]] || continue
    name=$(basename "$f" .env)
    # Archived workers are retired on purpose. Read the flag from the env file
    # rather than the server so cold start does not depend on the server being
    # up yet — at boot it frequently is not.
    if grep -q '^CC_ARCHIVED="\?1' "$f" 2>/dev/null; then
      archived=$((archived + 1))
      continue
    fi
    if grep -q '^CC_PAUSED="\?1' "$f" 2>/dev/null; then
      archived=$((archived + 1))
      continue
    fi
    local running_rc=0 shell_flags
    shell_flags="$-"
    set +e
    is_running "$name" 2>/dev/null
    running_rc=$?
    case "$shell_flags" in *e*) set -e ;; *) set +e ;; esac
    if [[ "$running_rc" -eq 0 ]]; then
      already=$((already + 1))
      continue
    elif [[ "$running_rc" -eq 124 ]]; then
      failed=$((failed + 1))
      failures+=("$name: tmux has-session timed out")
      continue
    fi
    # --detach is mandatory here (see (3) above). `|| true`-style capture keeps
    # one bad worker from taking down the other 55 (see (2) above).
    if cmd_start "$name" --detach; then
      started=$((started + 1))
      # Stagger. `tmux new-session -d` returns immediately, so with no delay all
      # 56 agent processes begin their startup work in the same instant — and the
      # moment this matters most is a cold boot, when the machine is already
      # contending with everything else launchd is bringing up. Tunable via
      # AMUX_START_ALL_STAGGER (0 disables).
      local _stagger="${AMUX_START_ALL_STAGGER:-1}"
      [[ "$_stagger" != "0" ]] && sleep "$_stagger"
    else
      failed=$((failed + 1))
      failures+=("$name")
    fi
  done
  echo
  echo "${BOLD}start-all:${RESET} ${GREEN}${started} started${RESET} · ${already} already running · ${failed} failed · ${archived} archived (skipped)"
  if (( failed > 0 )); then
    echo "${YELLOW}failed:${RESET} ${failures[*]}" >&2
    return 1
  fi
  return 0
}

# Build and send a status transition, INCLUDING the gate-satisfying fields.
# AMUX-2325: the status verbs used to send only {"status":...}. There was no
# CLI way to pass gate_ack / gate_checked / type / override_doing, so the
# moment a gate fired — which is most cards — the only way forward was a
# hand-rolled `curl -X PATCH`, and a hand-rolled curl usually omits
# X-Amux-Session. The gate system was therefore MANUFACTURING the unattributed
# writes it depends on being attributed (found by the Claude/Gemini test pair
# on ATC-1, reproduced fleet-wide on RH-* and GE-*). The honest path has to be
# the easy path; a rule saying "remember the header" is not a fix.
# Reject a FLAG sitting in the ISSUE-ID slot, for every board verb that takes one.
#
# Without this, `amux board <verb> --help` sent the flag as the id: PATCH
# /api/board/--help, answered {"error":"item not found","id":"--help"}. The help
# request was spent as a failed WRITE and the caller got a not-found for a card
# they never named.
#
# I fixed this on 2026-08-14 (d7d5509) — for ONE verb. The log sweep the next day
# still found --help rows, timestamped AFTER that commit, because the other TEN
# id-taking verbs (needsyou, status, type, archive, reviewer, retitle, ask,
# status-update, claim, progress) each parse the id themselves and none of them
# checked. That commit claimed to guard "the CLASS, not the literal --help" and it
# did — within a single case arm. The class was the VERBS.
#
# So the check lives in one function now, called from every site, which is the
# only shape that cannot drift back apart.
_board_id_guard() {
  local verb="$1" id="$2"
  case "$id" in
    --help|-h|help)
      echo "Usage: amux board $verb <ISSUE-ID> [...]  — run 'amux board' for the full list" >&2
      exit 0 ;;
    -*)
      die "amux board $verb: '$id' looks like a flag, not an ISSUE-ID." ;;
  esac
}

# AF-542. `reviewer`/`shepherd` hand a card to a named session with no check
# that the name can ever act on it — 21 of 24 named reviewers measured
# unreachable-by-construction (isolated or gone) on 2026-09-07, each one a
# card silently stuck in `review` forever with nobody able to honor the gate
# (ethos rule 3: the constraint had no truthful path through for that name).
#
# Mirrors push-consent.sh's lane_state(): a lookup that cannot complete must
# move the verdict toward "unknown", never manufacture a false "ok" (ethos
# rule 4). Unlike lane_state, "no such session" is its own state here rather
# than folded into unknown — a typo'd name is refusable outright, where a
# push-consent probe only ever asks about names that already made a commit.
_board_assignee_state() {  # -> "ok" | "isolated" | "archived" | "missing" | "unknown:<why>"
  local who="$1"
  [[ -z "$AMUX_API" ]] && { echo "unknown:AMUX_URL unset"; return; }
  local body rc=0
  body=$(_curl -sk -m 12 "$AMUX_API/api/sessions/$who" 2>/dev/null) || rc=$?
  [[ "$rc" -ne 0 ]] && { echo "unknown:session lookup failed"; return; }
  [[ -z "$body" ]] && { echo "unknown:empty response"; return; }
  printf '%s' "$body" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("unknown:unparseable response"); sys.exit()
if not isinstance(d, dict):
    print("unknown:unparseable response"); sys.exit()
if d.get("error") or "name" not in d:
    print("missing"); sys.exit()
if d.get("isolated"):
    print("isolated"); sys.exit()
if d.get("archived"):
    print("archived"); sys.exit()
print("ok")
'
}

# Shared by `reviewer` and `shepherd`: both hand a card to a named peer and
# both were missing this check (same defect, same fix, ethos rule 1 — a gap
# fixed in one arm and left in its sibling is still the gap).
_board_assignee_guard() {  # verb who force -> 0 (proceed) | die()s | prints warnings to stderr
  local verb="$1" who="$2" force="$3"
  [[ -z "$who" ]] && return 0
  local state; state=$(_board_assignee_state "$who")
  case "$state" in
    missing)
      die "amux board $verb: session '$who' does not exist — refusing to set it.
Check the name (amux fleet lists live sessions). A $verb that can never exist
can never act, so the gate it is meant to satisfy would be stuck shut forever." ;;
    isolated)
      if [[ "$force" -ne 1 ]]; then
        die "amux board $verb: '$who' is an ISOLATED session — it refuses interaction from
other workers and cannot be reached the normal way to deliver on this. Pass --force
if you have another route (e.g. the owner relays it) for their sign-off, or name a
reachable session instead. Same refusal push-consent.sh applies before a push."
      fi
      echo "${YELLOW}warning:${RESET} amux board $verb: '$who' is isolated — set anyway (--force). Their sign-off needs a route other than a direct send." >&2 ;;
    archived)
      echo "${YELLOW}warning:${RESET} amux board $verb: '$who' is archived (not isolated) — may still be reachable but is not an active lane." >&2 ;;
    unknown:*)
      echo "${YELLOW}warning:${RESET} amux board $verb: could not confirm '$who' is reachable (${state#unknown:}) — proceeding anyway." >&2 ;;
  esac
  return 0
}


# Typed approval categories, narrowed by the effective server-side scope policy.
#
# Refused HERE and not only server-side, because the point of the refusal is
# that the reader sees the vocabulary. A 409 teaches it too, but only after a
# round trip, and the round trip is what makes people reach for a raw PATCH.
_needsyou_types_or_die() {
  local t="$1" id="$2"
  case "$(printf '%s' "$t" | tr '[:upper:]' '[:lower:]')" in
    budget|customer_outbound|decision|access|credential|external|judgment) return 0 ;;
  esac
  local head="amux board needsyou: --ask is required."
  [[ -n "$t" ]] && head="amux board needsyou: '$t' is not an accepted approval category."
  die "$head

  budget      increased spend or an increase beyond the authorized budget
  customer_outbound  customer communication without existing authorization
  decision    a choice only the owner can make: direction, priority, a trade-off
              with no right answer
  access      you cannot reach something: a repo, a console, an environment, a person
  credential  a secret, token, key or sign-in only the owner can supply
  external    waiting on a third party: a vendor, a support ticket, another
              company's deploy
  judgment    a call only the owner's taste settles: is this good enough, does
              this read right

The effective global/group/worker policy may allow only budget and customer_outbound.
Ordinary choices should proceed. If no human act is required, work the blocker:

  amux board backlog $id --trigger \"<the condition that re-arms it>\"   external wait
  amux board doing $id                                                work the blocker

  amux board needsyou $id --actor Ethan --ask decision --question \"...?\" --unblocks \"...\""
}

# A response can be unreadable AFTER a write landed. Stop before any dependent
# status transition, and retain the uncertainty in the existing diagnostic spool.
_board_require_ack() {
  AMUX_ACK_LOG="$CC_HOME/cli-transport.jsonl" python3 -c '
import json, os, sys, time
try:
    value = json.load(sys.stdin)
    if not isinstance(value, dict): raise ValueError("non-object acknowledgement")
except Exception:
    item, field, pending_status = sys.argv[1:4]
    event = {"ts": int(time.time()), "cli": "bash", "curl_exit": 0,
             "verdict": "board_ack_unknown", "measured": True, "n_considered": 1,
             "item": item, "field": field, "applied": None,
             "session": os.environ.get("AMUX_SESSION", "")}
    try:
        with open(os.environ["AMUX_ACK_LOG"], "a") as out:
            out.write(json.dumps(event) + "\n")
    except OSError:
        sys.stderr.write("warning: acknowledgement diagnostic could not be persisted\n")
    sys.stderr.write("error: %s %s acknowledgement is unreadable; write outcome is unknown.\n" % (item, field))
    if pending_status:
        sys.stderr.write("The %s status transition was not attempted.\n" % pending_status)
    sys.stderr.write("Read amux board show %s before retrying; earlier writes may have landed. [board_ack_unknown]\n" % item)
    sys.exit(1)
' "$1" "$2" "${3:-}"
}

_board_transition() {
  local id="$1" status="$2"; shift 2
  local ack="" newtype="" override="" rev="" outcome="" trigger="" force_reason="" verify_cmd=""
  local folded_into=""
  local reviewer="" want_stdin="" evidence="" want_ev_stdin=""
  local checked=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --outcome) outcome="${2:-}"; [[ -n "$outcome" ]] || die "--outcome needs text"; shift 2 ;;
      # --outcome-stdin / --outcome-file: the same escape `send` has had since
      # AMUX-1888, for the same reason. An inline double-quoted --outcome is
      # evaluated by YOUR SHELL before amux sees it, so backticks and $(...)
      # inside it are EXECUTED, not recorded. Outcomes are the field most likely
      # to contain a command: on 2026-08-06 an outcome quoting a git invocation
      # in backticks reached the card as "resolved the last commit with , which
      # is a SUBSTRING search" — the command silently eaten, the sentence left
      # dangling, and the shell erroring separately so the board write still
      # looked like it succeeded. send and `board add` both had --stdin; the
      # one field that routinely quotes shell did not.
      # DEFERRED, not read here (AF-16). Reading stdin mid-parse meant a LATER
      # unknown flag died with the heredoc already consumed, so the refusal
      # destroyed the very outcome text needed to satisfy the retry — ethos
      # rule 6, and it cost ~40 lines of re-authored review on AF-15. The read
      # now happens after argv validates, so a bad invocation leaves stdin
      # untouched and the same heredoc can simply be piped again.
      --outcome-stdin) want_stdin=1; shift ;;
      --outcome-file) [[ -r "${2:-}" ]] || die "--outcome-file needs a readable path"
                      outcome="$(cat "$2")"; shift 2 ;;
      # --trigger records the EXTERNAL condition a card is parked on, into
      # source_ref/last_verified_at — the fields the board already has and
      # already renders (is:sourcestale). Without a verb the only way to set
      # them was a hand-rolled PATCH, which is the same unaudited back door
      # AMUX-2325 was about, and it is the reason a parked card could sleep
      # forever: nothing machine-readable said what it was waiting for.
      # --evidence records WHAT WAS RUN, into the `evidence` column the server
      # requires on `done` (AF-321). Deliberately not the same field as
      # --outcome: an outcome is prose about the card, evidence is the thing a
      # reader can re-run. --outcome falls back into it below so lanes already
      # closing cards with a substantive outcome keep working untouched.
      # Same shell-evaluation trap as --outcome, and worse here, because
      # evidence is USUALLY a command: prefer --evidence-stdin.
      --evidence) evidence="${2:-}"; [[ -n "$evidence" ]] || die "--evidence needs text"; shift 2 ;;
      --evidence-stdin) want_ev_stdin=1; shift ;;
      --evidence-file) [[ -r "${2:-}" ]] || die "--evidence-file needs a readable path"
                       evidence="$(cat "$2")"; shift 2 ;;
      --trigger) trigger="${2:-}"; [[ -n "$trigger" ]] || die "--trigger needs text"; shift 2 ;;
      # --verify-cmd freezes a contract card's verify command as it enters
      # doing, in the SAME PATCH as the status (GE1-4): sent on its own before
      # doing it has nothing to attach to, and `board doing` alone refused
      # contract_required with no flag to supply it.
      --verify-cmd) verify_cmd="${2:-}"; [[ -n "$verify_cmd" ]] || die "--verify-cmd needs a command"; shift 2 ;;
      # --folded-into names the card this one's work moved to, so a HAND-ROLLED
      # fold reads like the peer-driven one. The server writes the canonical
      # `capture folded into <ID>` line from it; this does not author log text.
      #
      # Measured by mixpeek-frustrations on their own cards after b3db93fd:
      # MS-1369 and SP-713 had the server line (peer-folded, covered), while
      # MF-888/MF-890/MF-893 did NOT, because they folded by hand with
      # `board progress` then `board discard`. Same shape, wrong summary.
      --folded-into) folded_into="${2:-}"; [[ -n "$folded_into" ]] || die "--folded-into needs an ISSUE-ID"; shift 2 ;;
      --ack) ack=1; shift ;;
      --checked)
        shift
        # Consume criteria until the next flag. Quote each one; they are the
        # gate strings the server handed back verbatim.
        while [[ $# -gt 0 && "$1" != --* ]]; do checked+=("$1"); shift; done ;;
      --type) newtype="${2:-}"; [[ -n "$newtype" ]] || die "--type needs a value"; shift 2 ;;
      --override-doing) override=1; shift ;;
      # --reviewer NAMES the peer a card is handed to (AF-16). `amux board
      # review <ID>` could set the STATUS but not the reviewer, and the review
      # gate rests entirely on the reviewer's own X-Amux-Session being the
      # required sign-off ("the author cannot close it") — so a card could
      # reach `review` with reviewer=None, which is a card nobody has been
      # asked to look at. Completing the handoff meant a hand-rolled PATCH,
      # i.e. the unattributed back door AMUX-2325 is about, reached from the
      # audited path for want of one flag.
      --reviewer) reviewer="${2:-}"; [[ -n "$reviewer" ]] || die "--reviewer needs a session name"; shift 2 ;;
      --rev) rev="${2:-}"; shift 2 ;;
      --force) force_reason="${2:-}"; [[ -n "$force_reason" ]] || die "--force requires a reason (why you are bypassing the gate)"; shift 2 ;;
      *) die "amux board: unknown flag '$1'
Usage: amux board <status> <ID> [--checked \"crit\" ...] [--ack] [--type T] [--reviewer W] [--override-doing] [--trigger \"cond\"] [--verify-cmd \"cmd\"] [--evidence-stdin] [--force \"reason\"]
  discard only: [--folded-into <ID>]  the card whose work absorbed this one, so the
                                      callback names it instead of reading as a drop" ;;
    esac
  done
  # Now that argv is known-good, drain stdin. See --outcome-stdin above: doing
  # this inside the loop meant an unknown flag AFTER it swallowed the heredoc
  # and then died, and the retry had nothing left to pipe.
  if [[ -n "$want_stdin" && -n "$want_ev_stdin" ]]; then
    die "--outcome-stdin and --evidence-stdin both read stdin; there is only one.
Pipe one and pass the other with --outcome-file / --evidence-file."
  fi
  if [[ -n "$want_stdin" ]]; then
    outcome="$(cat)"; [[ -n "$outcome" ]] || die "--outcome-stdin got empty input"
  fi
  if [[ -n "$want_ev_stdin" ]]; then
    evidence="$(cat)"; [[ -n "$evidence" ]] || die "--evidence-stdin got empty input"
  fi
  # An --outcome that already names an artifact IS evidence. Falling back keeps
  # every lane that closes cards with a substantive outcome working unchanged;
  # the ones this refuses are the ones closing on "implemented", which is the
  # card this gate came from.
  [[ -z "$evidence" && -n "$outcome" ]] && evidence="$outcome"
  # Record the outcome as its OWN write, BEFORE attempting the transition.
  # A PATCH is atomic, so `{"desc":...,"status":"done"}` that trips the gate
  # discards the outcome text TOO — and the retry then has nothing to satisfy
  # "Outcome recorded in the item" with, so it fails again for a new reason.
  # THE REVIEWER IS WRITTEN FIRST TOO, for the same reason (AMUX-3534).
  #
  # `amux board review <ID> --reviewer <peer>` on a GATED card refused the
  # transition, correctly, and silently discarded the reviewer: the PATCH is
  # atomic, so a gate 409 rolls back the whole body. Observed 2026-08-23 on
  # AMUX-3527 — card stayed `doing`, reviewer never set, and the 409 body lists
  # the criteria and the type escape while saying NOTHING about the flag that
  # was passed. So half the command evaporated and nothing distinguished that
  # from success.
  #
  # Naming the peer is a fact about the handoff and is independent of whether
  # the move is permitted. A refusal should cost the transition, not the
  # handoff — which is exactly the argument the outcome block below already
  # makes, one field over. The failure is easy to miss in ordinary work: you
  # fix the gate, re-run, it succeeds, and you never learn the first attempt
  # left a card in review with nobody asked to look at it. That is the
  # condition --reviewer was added to prevent.
  #
  # Sent in the STATUS body as well, deliberately. It is idempotent, and if
  # this pre-write fails for a reason the transition survives, the second copy
  # still lands.
  if [[ -n "$reviewer" ]]; then
    local _rvresp _rvcurl=0
    _rvresp=$(_curl -sk -X PATCH -H 'Content-Type: application/json' \
      -H "X-Amux-Worker: ${AMUX_WORKER:-${AMUX_SESSION:-}}" \
      -d "$(V="$reviewer" python3 -c 'import json,os;print(json.dumps({"reviewer":os.environ["V"]}))')" \
      "${AMUX_API:-https://localhost:8824}/api/board/$id" 2>/dev/null) || _rvcurl=$?
    if [[ "$_rvcurl" -ne 0 ]]; then
      die "cannot reach the board at ${AMUX_API:-https://localhost:8824} (curl exit $_rvcurl).
NOTHING was applied — not the reviewer, and not the '$status' transition.
The card is unchanged."
    fi
    # Do NOT discard this response: a dropped reviewer that looks saved is the
    # whole defect (AC-323's shape, now on a fourth field).
    printf '%s' "$_rvresp" | _board_require_ack "$id" "reviewer" "$status" || return $?
    printf '%s' "$_rvresp" | python3 -c '
import sys, json
try: d = json.load(sys.stdin)
except Exception:
    sys.stderr.write("warning: reviewer NOT set — server sent no JSON. "
                     "The transition below was still attempted; check its result.\n"); sys.exit(0)
if d.get("error") or d.get("blocked"):
    sys.stderr.write("warning: reviewer NOT set: %s\n" % (d.get("error") or "blocked")); sys.exit(0)
ign = [f for f in (d.get("ignored_fields") or []) if f]
if ign:
    sys.stderr.write("warning: reviewer NOT set — server ignored %s\n" % ", ".join(ign))
'
  fi

  # EVIDENCE IS WRITTEN FIRST, for the reason the reviewer block above gives:
  # a PATCH is atomic, so sending it together with `status:done` means a gate
  # 409 rolls back the evidence too — and the retry then has nothing to satisfy
  # the very gate that refused it. That is the AC-323 shape this file has now
  # been bitten by on four fields; do not fold this into the status body.
  if [[ -n "$evidence" ]]; then
    local _evresp _evcurl=0
    _evresp=$(_curl -sk -X PATCH -H 'Content-Type: application/json' \
      -H "X-Amux-Worker: ${AMUX_WORKER:-${AMUX_SESSION:-}}" \
      -d "$(V="$evidence" python3 -c 'import json,os;print(json.dumps({"evidence":os.environ["V"]}))')" \
      "${AMUX_API:-https://localhost:8824}/api/board/$id" 2>/dev/null) || _evcurl=$?
    if [[ "$_evcurl" -ne 0 ]]; then
      die "cannot reach the board at ${AMUX_API:-https://localhost:8824} (curl exit $_evcurl).
NOTHING was applied — not the evidence, and not the '$status' transition.
The card is unchanged."
    fi
    printf '%s' "$_evresp" | _board_require_ack "$id" "evidence" "$status" || return $?
    printf '%s' "$_evresp" | python3 -c '
import sys, json
try: d = json.load(sys.stdin)
except Exception:
    sys.stderr.write("warning: evidence NOT recorded — server sent no JSON. "
                     "The transition below was still attempted; check its result.\n"); sys.exit(0)
if d.get("error") or d.get("blocked"):
    sys.stderr.write("warning: evidence NOT recorded: %s\n" % (d.get("error") or "blocked")); sys.exit(0)
ign = [f for f in (d.get("ignored_fields") or []) if f]
if "evidence" in ign:
    # SAY WHAT SURVIVED, NOT ONLY WHAT DID NOT. This first read "Upgrade it",
    # which points at a build that may not exist yet: the CLI half of AF-321
    # ships on SAVE (this file is a symlink into the worktree) and the server
    # half ships on commit + build, so for a while every lane in the fleet saw
    # this on every close. Two lanes read it as "my outcome was dropped, the
    # server is stale"; one re-posted its outcome as a status-update and another
    # was about to restart the server. Neither was true — the outcome had
    # persisted in full both times. A warning that names only the casualty
    # invites the reader to guess at the blast radius, and they guessed wide.
    sys.stderr.write("note: the separate `evidence` field was not stored — this server "
                     "predates AF-321. Your --outcome/--evidence TEXT still persisted to "
                     "the card in full; only the dedicated column was dropped. Nothing is "
                     "stale and nothing needs restarting.\n")
'
  fi

  # mixpeek-orchestrator hit this three times on 2026-08-04 (MO-3076 x2,
  # MO-3077). Two writes, not one: the outcome survives a refused transition.
  if [[ -n "$outcome" ]]; then
    local _obody
    _obody=$(O="$outcome" python3 -c 'import json,os;print(json.dumps({"desc_append":os.environ["O"]}))')
      # Do NOT discard this response. This write exists so the outcome survives
      # a refused transition — piping it to /dev/null made a DROPPED outcome
      # look identical to a saved one. AC-323 shape a third time (board
      # progress, --trigger stamp, now here), found by the sweep
      # mixpeek-frustrations suggested rather than by it being reported.
    # CAPTURE curl's OWN exit status, do not pipe it straight into python.
    #
    # AEAB-36. This was `curl ... | python3 -c ...`, and the python deliberately
    # exits 0 on failure so a lost outcome does not block the transition below.
    # `set -euo pipefail` (line 19) defeated that completely: on a TRANSPORT
    # failure curl exits non-zero, `pipefail` makes the pipeline return curl's
    # status rather than python's, and `set -e` aborts the whole script right
    # here — AFTER python has printed "outcome NOT recorded".
    #
    # So the user saw one warning, scoped to the OUTCOME, and the status
    # transition never ran and never said so. Observed live on 2026-08-19
    # closing AEAB-34, while the server happened to be restarting to adopt a new
    # build: status stayed `review`, desc unchanged, and the natural reading of
    # that warning — "status moved, prose lost" — was the exact opposite of the
    # truth. Reproduced deterministically with AMUX_API pointed at a dead port:
    # one warning line, exit 7, no transition.
    #
    # A code path written to be non-fatal was made fatal by a shell option one
    # line from the top of the file, in precisely the case it was designed to
    # survive.
    local _oresp _ocurl=0
    _oresp=$(_curl -sk -X PATCH -H 'Content-Type: application/json' \
      -H "X-Amux-Worker: ${AMUX_WORKER:-${AMUX_SESSION:-}}" -d "$_obody" \
      "${AMUX_API:-https://localhost:8824}/api/board/$id" 2>/dev/null) || _ocurl=$?
    if [[ "$_ocurl" -ne 0 ]]; then
      # Unreachable for the outcome means unreachable for the transition. Say
      # BOTH facts, because reporting only the first is what made this
      # dangerous, and stop rather than pretending to try.
      die "cannot reach the board at ${AMUX_API:-https://localhost:8824} (curl exit $_ocurl).
NOTHING was applied — not the outcome, and not the '$status' transition.
The card is unchanged. Re-run when the server is back; if it just restarted to
adopt a build, that is expected and a retry normally succeeds."
    fi
    printf '%s' "$_oresp" | _board_require_ack "$id" "outcome" "$status" || return $?
    printf '%s' "$_oresp" | python3 -c '
import sys, json
try: d = json.load(sys.stdin)
except Exception:
    sys.stderr.write("warning: outcome NOT recorded — server sent no JSON. "
                     "The transition below was still attempted; check its result.\n"); sys.exit(0)
if d.get("error") or d.get("blocked"):
    sys.stderr.write("warning: outcome NOT recorded: %s\n" % (d.get("error") or "blocked")); sys.exit(0)
ign = [f for f in (d.get("ignored_fields") or []) if f]
if ign:
    sys.stderr.write("warning: outcome NOT recorded — server ignored %s\n" % ", ".join(ign))
'
  fi
  local body
  # WARNING: the block below is inside single quotes (python3 -c '...'). An
  # apostrophe anywhere in it — including in a comment — closes the quote early
  # and bash then fails to parse this whole FILE. That is not a local bug: this
  # script is the symlink target of ~/.local/bin/amux, so a save is a deploy and
  # every session in the fleet loses every subcommand at once, with the CLI too
  # broken to print the help that would name the HTTP fallback. It happened
  # (AMUX-3464, 2026-08-26). Keep explanations out here in bash-comment land,
  # where quoting does not apply. `.claude/check-and-commit.sh` runs `bash -n`
  # on save now, and tests/cli_syntax_guard.rs is the backstop.
  #
  # `reason` and `desc_append` are BOTH sent for a force, on purpose. The server
  # interpolates `reason` into the permanent audit line ("force by <who>: a->b
  # reason=..."); desc_append is prose a later edit can bury. Sending only the
  # latter is why all 41 force lines this board had ever written read `reason=`
  # empty, while 9 of those cards carried a good "[FORCED] <why>" in the desc:
  # --force had already refused to run without a reason, and it simply never
  # reached the ledger.
  body=$(S="$status" A="$ack" T="$newtype" O="$override" R="$rev" G="$trigger" F="$force_reason" V="$reviewer" FI="$folded_into" VC="$verify_cmd" python3 -c '
import json, os, sys, time
b = {"status": os.environ["S"]}
if os.environ.get("A"): b["gate_ack"] = True
if os.environ.get("T"): b["type"] = os.environ["T"]
if os.environ.get("V"): b["reviewer"] = os.environ["V"]
if os.environ.get("FI"): b["folded_into"] = os.environ["FI"]
if os.environ.get("VC"): b["verify_cmd"] = os.environ["VC"]
if os.environ.get("O"): b["override_doing"] = True
if os.environ.get("R"): b["rev"] = int(os.environ["R"])
if os.environ.get("F"):
    b["force"] = True
    b["reason"] = os.environ["F"]
    b["desc_append"] = "[FORCED] " + os.environ["F"]
# Stamp last_verified_at alongside source_ref: a trigger with no verification
# time is indistinguishable from one checked a month ago, and the staleness
# view keys on exactly that field. Setting one without the other would make
# every parked card read as stale the instant it was parked.
if os.environ.get("G"):
    b["source_ref"] = os.environ["G"]
    b["last_verified_at"] = int(time.time())
crit = sys.argv[1:]
if crit: b["gate_checked"] = crit
print(json.dumps(b))' ${checked[@]+"${checked[@]}"})
  # Same AEAB-36 trap as the outcome write above, and WORSE here because this
  # one is not piped: `result=$(_board_transition ...)` under `set -e` aborted
  # the caller the instant curl failed at the transport level, so
  # `amux board done <ID>` against an unreachable server printed ABSOLUTELY
  # NOTHING and exited 7. Not a warning, not an error, not the id — the purest
  # form of the silent-failure class this file already guards against in three
  # other places, sitting on the sanctioned path.
  #
  # A dropped connection and a refused transition must never look alike: one
  # means "nothing happened, retry", the other means "the board said no".
  local _tresp _tcurl=0
  _tresp=$(_curl -sk -X PATCH \
    -H 'Content-Type: application/json' \
    -H "X-Amux-Worker: ${AMUX_WORKER:-${AMUX_SESSION:-}}" \
    -d "$body" \
    "${AMUX_API:-https://localhost:8824}/api/board/$id" 2>/dev/null) || _tcurl=$?
  if [[ "$_tcurl" -ne 0 ]]; then
    printf '%s\n' "cannot reach the board at ${AMUX_API:-https://localhost:8824} (curl exit $_tcurl).
The '$status' transition was NOT applied and the card is unchanged — this is a
transport failure, not a refused gate. Re-run when the server is back." >&2
    return 1
  fi
  # SAY WHERE THE TRIGGER WENT (AF-379).
  #
  # `--trigger` works: it stores the condition in `source_ref` and stamps
  # `last_verified_at`. But the success line is about the STATUS ("MR-112 ->
  # backlog") and never names the field, so a reader who checks reasonably looks
  # for a key called `trigger`, does not find one, and concludes the payload was
  # dropped. mvs-research filed exactly that, having verified against a card whose
  # text WAS stored. My own first probe on this made the same mistake, and so did
  # my probe on AF-359 an hour earlier.
  #
  # A flag whose effect is real and invisible is indistinguishable from one that
  # was discarded, and the reader pays either way. One line on stderr, so the
  # captured JSON on stdout is untouched.
  if [[ -n "${trigger:-}" ]]; then
    printf '%s\n' "  trigger stored in source_ref (+ last_verified_at). Read it back with:
      curl -sk --connect-timeout 2 \"\$AMUX_URL/api/board/$id\" | python3 -c 'import json,sys;print(json.load(sys.stdin)[\"source_ref\"])'" >&2
  fi
  printf '%s' "$_tresp"
}

# The board's valid item types, ASKED FOR rather than carried.
#
# Extracted from the `type` verb, which learned this the hard way: it used to
# hold a hardcoded list that drifted — advertising `task` and `decision`, both
# rejected, and omitting `tripwire` — so following the tool's own usage line
# produced "unknown type 'decision'" and sent you looking at your card instead
# of at the CLI (AMUX-2479). `add --type` needs the same list, and a SECOND copy
# is how that drift happens again, so there is one implementation and no literal
# list anywhere in this file. On an unreachable server it returns a POINTER, not
# a guess: confidently wrong help is worse than none.
_board_valid_types() {
  local _resp _code _body _t
  # -w captures the STATUS so a transport failure and a 200-with-an-unexpected
  # -shape cannot print the same sentence. They did, for every session: this
  # helper read ["fields"]["valid_types"] while the server publishes `types` at
  # top level (board.rs, KNOWN_TYPES), so `amux board add --help` on a perfectly
  # healthy server said "server unreachable" and pointed the reader at the
  # AMUX-3046 stranded-port hunt instead of at a key-path bug one line away.
  # The note above already said confidently wrong help is worse than none; this
  # separates the two failures so the message can keep that promise.
  _resp=$(_curl -sk --max-time 3 -w '\n%{http_code}' "$AMUX_API/api/board/contract" 2>/dev/null)
  _code="${_resp##*$'\n'}"
  _body="${_resp%$'\n'*}"
  if [[ "$_code" != "200" ]]; then
    echo "(server unreachable at ${AMUX_API} (http=${_code:-000}) — see GET /api/board/contract)"
    return
  fi
  # Read BOTH spellings: `types` is what the server publishes, the nested one is
  # the historical shape this helper was written against. Accepting either means
  # the next rename degrades to the other key rather than blanking the list.
  _t=$(printf '%s' "$_body" | python3 -c 'import json,sys
d = json.load(sys.stdin)
t = d.get("types") or (d.get("fields") or {}).get("valid_types") or []
print(" ".join(t))' 2>/dev/null)
  [[ -n "$_t" ]] && echo "$_t" \
    || echo "(server answered 200 but published no type list — contract shape changed; see GET /api/board/contract)"
}

# Refuse an argument that LOOKS like a flag but is not one this verb knows.
#
# AEAB-17: every board verb taking positional text used `*) text="$1"` as its
# catch-all, so an unsupported or mistyped flag became part of the TEXT with
# exit 0 and no warning. The failure is invisible at the call site — the command
# prints the card id it created and looks like it worked.
#
# Only `--`-prefixed arguments are refused. A positional title is legitimate and
# must keep working; something starting with `--` is a mistake often enough that
# refusing it is right, and the escape (--stdin/--file) is named in the message
# so a title that genuinely begins with dashes is still expressible.
_board_bad_flag() {
  local verb="$1" arg="$2"; shift 2
  die "amux board $verb: unknown option '$arg'
accepted here: $*
If '$arg' was meant as literal text, pass it via --stdin or --file so it is
never parsed as a flag. Unknown flags used to be folded silently into the
title/text (AEAB-17), which produced cards with a scratch path in the title
and an empty body."
}

_board_add_usage() {
  cat <<EOF
Usage: amux board add <title>
       amux board add --stdin | --file <path>          (title, unevaluated by your shell)

Optional:
  --desc <text> | --desc-stdin | --desc-file <path>    card body
  --type <type>                                        the GATE is derived from this
  --depends-on <ISSUE-ID>                              link the new card to one it
                                                       depends on (repeatable).
                                                       BLOCKS the claim until the
                                                       dependency resolves; does NOT
                                                       push when it does. board-drive
                                                       picks the card up on a later
                                                       tick (AF-621). For a wakeup on
                                                       completion use "board request",
                                                       which arms a terminal callback.
  --help                                               this text

types: $(_board_valid_types)

Prefer --stdin/--file for a title and --desc-stdin/--desc-file for a body: inline
text is evaluated by YOUR shell first, so backticks and \$(...) in it are EXECUTED
before amux ever sees them (AMUX-1888).
