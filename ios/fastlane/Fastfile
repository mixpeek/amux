default_platform(:ios)

platform :ios do

  # Bump build number to git commit count (deterministic, no conflicts)
  lane :set_build_number do
    count = sh("git rev-list --count HEAD").strip
    increment_build_number(build_number: count, xcodeproj: "AmuxApp.xcodeproj")
  end

  # One-time: create certs + provisioning profiles (run via CI dispatch)
  lane :create_certs do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id:        ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:     ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content:   ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      api_key: api_key,
      readonly: false,
      force: true
    )
  end

  # CI: fetch certs + build + upload to TestFlight
  lane :beta do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id:        ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:     ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content:   ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(type: "appstore", api_key: api_key, readonly: true)

    set_build_number

    build_app(
      scheme: "AmuxApp",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-skipPackagePluginValidation -allowProvisioningUpdates"
    )

    changelog = ENV["CHANGELOG"] || "Bug fixes and improvements."

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: changelog
    )
  end

  # Push metadata + screenshots only (no build required)
  lane :metadata do
    api_key = app_store_connect_api_key(
      key_id:        ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:     ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content:   ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # Same version the release lane submits (project.yml MARKETING_VERSION);
    # the old "1.0.1" default edited a stale entry with no build.
    spec = ["../project.yml", "project.yml"].find { |p| File.exist?(p) }
    UI.user_error!("project.yml not found from #{Dir.pwd}") unless spec
    version = ENV["APP_VERSION"] ||
      File.read(spec, encoding: "UTF-8")[/MARKETING_VERSION:\s*"([^"]+)"/, 1]

    deliver(
      api_key: api_key,
      app_version: version,
      skip_binary_upload: true,
      skip_screenshots: false,
      # Replace the store set with the repo's; adding on top hit the 10-per-
      # device cap and skipped images ("Too many screenshots found").
      overwrite_screenshots: true,
      skip_metadata: false,
      force: true,
      submit_for_review: false,
      run_precheck_before_submit: false
    )
  end

  # Read-only: where the app stands on App Store Connect (versions, review
  # state, attached build). Changes nothing. Added 2026-09-25 so "is the iOS
  # update live?" has a measured answer instead of a guess.
  lane :status do
    api_key = app_store_connect_api_key(
      key_id:        ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:     ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content:   ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    bundle_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    app = Spaceship::ConnectAPI::App.find(bundle_id)
    UI.user_error!("app #{bundle_id} not found") unless app
    app.get_app_store_versions(limit: 5, includes: "build").each do |v|
      build = v.build ? "#{v.build.version} (#{v.build.processing_state})" : "none"
      UI.message("STATUS version=#{v.version_string} state=#{v.app_store_state} release=#{v.release_type} created=#{v.created_date} build=#{build}")
    end
    app.get_review_submissions(filter: { platform: "IOS" }).first(5).each do |sub|
      UI.message("STATUS submission=#{sub.id} state=#{sub.state} submitted=#{sub.submitted_date}")
    end
  end

  # Promote latest TestFlight build to App Store (run manually)
  lane :release do
    api_key = app_store_connect_api_key(
      key_id:        ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:     ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content:   ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # NAME THE VERSION AND THE BUILD (first real run, 2026-09-24, run
    # 36008794593). Without app_version deliver edited the stale "1.0.1"
    # App Store entry, which has no build, while TestFlight held 1.1.0 (6261).
    # The version is the one the app is built with (project.yml
    # MARKETING_VERSION); the build is the newest TestFlight build of it.
    # Fastfile Ruby runs in ios/fastlane, actions in ios; accept either.
    spec = ["../project.yml", "project.yml"].find { |p| File.exist?(p) }
    UI.user_error!("project.yml not found from #{Dir.pwd}") unless spec
    version = ENV["APP_VERSION"] ||
      File.read(spec, encoding: "UTF-8")[/MARKETING_VERSION:\s*"([^"]+)"/, 1]
    UI.user_error!("no MARKETING_VERSION in project.yml") if version.to_s.empty?
    build = ENV["BUILD_NUMBER"].to_s.empty? ?
      latest_testflight_build_number(api_key: api_key, version: version) : ENV["BUILD_NUMBER"]
    UI.message("Submitting #{version} (#{build}) for review")

    # CANCEL_PENDING=1: take a submission that is waiting for review back out
    # first. App Store Connect locks screenshots and metadata while a version
    # waits for review ("Failed verification of all screenshots deleted"), so
    # replacing them means cancel, edit, resubmit. Opt-in only.
    if ENV["CANCEL_PENDING"] == "1"
      Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
      bundle_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
      app = Spaceship::ConnectAPI::App.find(bundle_id)
      UI.user_error!("app #{bundle_id} not found on App Store Connect") unless app
      pending = app.get_review_submissions(filter: { state: "WAITING_FOR_REVIEW,READY_FOR_REVIEW,UNRESOLVED_ISSUES" })
      UI.message("#{pending.size} pending review submission(s)")
      pending.each do |sub|
        UI.important("Cancelling review submission #{sub.id} (#{sub.state}) so the listing can be edited")
        sub.cancel_submission
      end
      editable = %w[PREPARE_FOR_SUBMISSION DEVELOPER_REJECTED REJECTED METADATA_REJECTED]
      state = nil
      18.times do
        v = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
        state = v && v.app_store_state
        UI.message("version #{v && v.version_string} state: #{state}")
        break if editable.include?(state)
        sleep 10
      end
      UI.user_error!("version never became editable (state #{state})") unless editable.include?(state)
    end

    deliver(
      api_key: api_key,
      app_version: version,
      build_number: build.to_s,
      skip_binary_upload: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      skip_metadata: false,
      # Precheck cannot inspect in-app purchases with an API key and fails the
      # whole submit on that alone. The rest of precheck still runs.
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false }
    )
  end

end
