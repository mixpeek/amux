#!/usr/bin/env python3
# amux-push-guard — blocks a push that would ship commits authored by a
# DIFFERENT amux session sharing this checkout.
#
# The staged-guard stops one session COMMITTING another's staged files. Nothing
# stopped one session PUSHING another's commits, and in a shared checkout that
# is the same class of problem one layer up: `git push` ships whatever is on the
# branch, so a session pushing its own work silently deploys everyone else's
# too. On 2026-07-30 that happened five times in one day — work shipped without
# the owner asking, and once a board feature went out inside a commit message
# about browser fixes.
#
# Attribution comes from the Amux-Session trailer that prepare-commit-msg
# already stamps on every commit, so this needs no new bookkeeping.
#
# Fail-open by design: any error lets the push proceed. Outside amux
# ($AMUX_SESSION unset) it is a no-op — the human is always allowed to push.
# Intentional cross-session push: AMUX_ALLOW_FOREIGN=1 git push ...
import datetime, json, os, ssl, subprocess, sys, urllib.parse, urllib.request

ZERO = "0" * 40


# The blocking-run probe's budget. It was 3s, which is UNDER what this host
# delivers: `GET /api/sessions` measured 1.60s with the machine unloaded, and
# this box runs at load ~37 on 28 cores because the fleet compiles and tests
# this very server continuously (AMUX-3646). So the probe timed out during a
# real push today and the guard silently fell back to its trailer-only
# message. A probe whose budget sits below the normal latency of the thing it
# probes reports "unreachable" about a healthy server, and the degradation is
# invisible because the fallback text looks like an answer.
_API_TIMEOUT_S = float(os.environ.get("AMUX_PUSH_GUARD_API_TIMEOUT_S", "8"))


def _session_is_isolated(name):
    """Is `name` an ISOLATED raw-agent worker — one the harness will not let a
    peer send to, so its consent CANNOT be obtained?

    READS THE SAME FILE THE SERVER DOES: `~/.amux/sessions/<name>.env`, key
    `CC_ISOLATED`. That is what `session_is_isolated` in session_verbs.rs reads,
    so this consults the same input rather than re-deciding from a derived view.

    IT USED TO ASK THE SERVER, AND THAT TURNED MAIN RED. CI has no amux server,
    so the probe failed closed, `:owner` was refused, and test J failed on every
    run while passing on my laptop — a test whose verdict depends on the host's
    state, which is precisely what PR #145's author warned about in their own
    harness three hours earlier. Reading the file also makes the guard work with
    the server down, which a push-path decision should not depend on.

    FAILS CLOSED on every uncertainty — missing file, unreadable, absent key.
    "I could not tell" must mean "go ask them", never "assume they could not be
    asked".
    """
    if not name or "/" in name or name.startswith("."):
        return False
    path = os.path.join(
        os.environ.get("HOME", ""), ".amux", "sessions", "%s.env" % name)
    try:
        with open(path) as fh:
            for line in fh:
                line = line.strip()
                if not line.startswith("CC_ISOLATED"):
                    continue
                _, _, val = line.partition("=")
                return val.strip().strip('"').strip("'").lower() in (
                    "1", "true", "yes", "on")
    except Exception:
        return False
    return False


def _patch_ids(argv, timeout=25):
    """`git <argv> | git patch-id --stable` -> {patch_id: sha}.

    Returns None (not {}) when the pipeline could not run, because an empty map
    and a failed map lead to opposite decisions here: empty means "no upstream
    twin, keep blocking", failed means "I do not know". Collapsing them is the
    unwrap_or_default shape the invariants module exists to catch.
    """
    try:
        diff = subprocess.run(["git"] + argv, capture_output=True, text=True,
                              timeout=timeout)
        if diff.returncode != 0:
            return None
        pid = subprocess.run(["git", "patch-id", "--stable"], input=diff.stdout,
                             capture_output=True, text=True, timeout=timeout)
        if pid.returncode != 0:
            return None
    except Exception:
        return None
    out = {}
    for row in pid.stdout.splitlines():
        bits = row.split()
        if len(bits) >= 2:
            out.setdefault(bits[0], bits[1])
    return out


def _upstream_duplicates(shas, limit):
    """Which of `shas` are ALREADY UPSTREAM under a different sha? (AC-227)

    THE BUG THIS FIXES. CLAUDE.md's pre-push recipe lists `origin/main..main`
    and says to ask the author about any foreign commit. A commit already
    upstream under a DIFFERENT sha — cherry-pick, rebase, replay — sits in that
    range permanently, so the guard blocked amux-cloud's own push and made them
    ask a peer for permission the peer did not need to give. `acdbfdf` and
    `9ebc42c` share patch-id `dff284cf093aecaa`; both still do today.

    The `--not --remotes=origin` bound above already handles a rebase of YOUR
    branch onto origin, because those commits stay reachable from an origin ref.
    It cannot handle a REPLAY, which produces a new object with the same diff.
    Only the diff can answer that, which is what patch-id is.

    amux-cloud's REFUSAL of 2026-08-11 is why this is code and not another
    paragraph: the documentation half shipped and they grepped *.sh, *.rs and
    the CLI and found no executable path computing a patch-id anywhere. A recipe
    a human runs by hand is not a check.

    REVERT SAFETY, and it is the reason this does not just test membership. If
    the patch was applied upstream and later REVERTED, re-applying it does ship
    something new, and clearing it would be the entry's own stated inverse
    hazard: "a session assuming a familiar-looking commit is last week's
    duplicate and shipping something genuinely unreviewed". A revert's diff is
    the reverse of the original, so its patch-id equals the REVERSE patch-id of
    the candidate. If both directions are present upstream the net state is
    ambiguous and the commit stays foreign.

    Returns (dup, note). `dup` is {short_sha: (upstream_sha, patch_id)}; it is
    None when the check could not run at all, which keeps every commit foreign —
    the safe direction, since this only ever REMOVES a block.
    """
    up = _patch_ids(["log", "--no-merges", "-p", "-n", str(limit), "--remotes=origin"])
    if up is None:
        return None, "could not compute upstream patch-ids"
    dup = {}
    for sha in shas:
        mine = _patch_ids(["show", "--no-merges", sha], timeout=15)
        if not mine:
            continue                       # empty diff, or unreadable: not a duplicate
        pid = next(iter(mine))
        if pid not in up:
            continue
        # `git show -R` does NOT produce the inverse patch — it swaps the a/b
        # labels and leaves the +/- direction alone, so its patch-id matches
        # nothing and the revert guard silently never fired. `git diff <sha>
        # <sha>^` is the reverse patch, and its id equals the REVERT commit's
        # exactly. Measured both ways on a throwaway repo before trusting it:
        # show -R gave a33c5ad7, the revert commit gave d1ef02e4, and
        # `diff sha sha^` gave d1ef02e4. Case N is the pin.
        rev = _patch_ids(["diff", sha, "%s^" % sha], timeout=15)
        if rev and next(iter(rev)) in up:
            continue                       # applied AND reverted upstream: ambiguous
        dup[sha] = (up[pid], pid)
    # NO SILENT CAPS. The walk is bounded, so a twin older than the bound reads
    # as "not upstream" and the commit stays blocked. That is the safe error, but
    # it is still an error and the caller must be able to see it was possible.
    return dup, "compared against the last %d origin commit(s)" % limit


def _audit(kind, detail):
    """Append to the push-guard audit log. Best-effort: logging must never
    brick a push, and a guard that dies on a full disk is worse than one that
    logs nothing. Shares a directory with append-only-guard.log so the two
    halves of the push story sit side by side."""
    try:
        path = os.path.expanduser("~/.amux/logs/push-guard.log")
        os.makedirs(os.path.dirname(path), exist_ok=True)
        repo = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                              capture_output=True, text=True, timeout=5).stdout.strip() or "?"
        with open(path, "a") as fh:
            fh.write("%s %s repo=%s session=%s %s\n" % (
                datetime.datetime.now().strftime("%Y-%m-%dT%H:%M:%S"), kind, repo,
                os.environ.get("AMUX_SESSION", "(human)"), detail))
    except Exception:
        pass


def main():
    # DATA-LOSS GUARD FIRST, and BEFORE the session early-returns: a stale
    # shared-file republish (MG-1483 — 10 pushed entry-lines silently reverted,
    # no conflict) destroys published work no matter who pushes, so the
    # append-only guard runs for humans and AMUX_ALLOW_FOREIGN pushes too.
    # Stdin is consumed once here and shared with the attribution walk below.
    stdin_text = sys.stdin.read()
    try:
        guard = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                             "append-only-push-guard")
        if os.path.exists(guard):
            r = subprocess.run([guard] + sys.argv[1:], input=stdin_text,
                               text=True, timeout=60)
            if r.returncode != 0:
                return r.returncode
    except Exception:
        pass  # fail open — the guard must never brick a push on its own bug
    sess = os.environ.get("AMUX_SESSION", "")
    if not sess or os.environ.get("AMUX_ALLOW_FOREIGN"):
        return 0
    if os.environ.get("AMUX_PUSH_GUARD", "1").strip().lower() in ("0", "false", "off", "no"):
        return 0
    foreign = {}
    ordered = []
    try:
        for line in stdin_text.splitlines():
            parts = line.split()
            if len(parts) < 4:
                continue
            local_sha, remote_sha = parts[1], parts[3]
            if local_sha.strip("0") == "":
                continue                      # branch deletion
            # A NEW branch has no remote counterpart, so remote_sha is all
            # zeros. Walking `local_sha` alone then means "everything reachable"
            # — the ENTIRE history — and the guard reported 1081 foreign commits
            # for a branch that added exactly one, every other commit already
            # sitting on origin and shipping nothing.
            #
            # That is worse than a missing check. The guard's whole value is
            # that AMUX_ALLOW_FOREIGN=1 stays a deliberate act; one that cries
            # wolf on every `git checkout -b` teaches the reflex of setting it
            # blind, and then the one push that really does carry someone
            # else's work sails through. Bound the walk by what origin ALREADY
            # has, which is the question the guard actually means to ask.
            #
            # The SAME bound is needed when remote_sha is real, and for the same
            # reason. `remote_sha..local_sha` reads as "what this push adds",
            # and it is that only while the push fast-forwards. Rebase the
            # branch onto current origin/main — which is the hygiene everyone is
            # told to do before pushing — and the old tip stops being an
            # ancestor, so that range widens to every commit rebased ONTO,
            # all of them already on origin and shipping nothing. Measured
            # 2026-08-22: a branch adding 2 commits was blocked as "22 commits
            # authored by another session", and all 22 were provably ancestors
            # of origin/main.
            #
            # So the guard punished exactly the practice it wants, and the
            # paragraph above already says why that is the worse failure: an
            # alarm that fires on a routine, correct action teaches the reflex
            # of setting AMUX_ALLOW_FOREIGN=1 blind, and then the push that
            # really does carry someone else's work sails through. The escape
            # is worded "if the human explicitly asked you to ship everything",
            # which is FALSE in this case — so the honest options were to lie or
            # to stop. That is rule 3, and the fix is to make the question
            # right rather than to widen the escape.
            #
            # One expression for both cases: everything reachable from what is
            # being pushed, minus everything origin already has. remote_sha is
            # listed explicitly as well, so a remote ref this checkout has not
            # fetched still bounds the walk.
            rng_args = [local_sha, "--not", "--remotes=origin"]
            if remote_sha != ZERO:
                rng_args.append(remote_sha)
            out = subprocess.run(
                ["git", "log", "--format=%h%x1f%s%x1f%(trailers:key=Amux-Session,valueonly)"]
                + rng_args,
                capture_output=True, text=True, timeout=15).stdout
            for row in out.splitlines():
                if not row.strip():
                    continue
                bits = row.split("\x1f")
                if len(bits) < 3:
                    continue
                who = bits[2].strip()
                ordered.append((bits[0], who))   # newest-first, for the escape below
                if who and who != sess:
                    foreign.setdefault(who, []).append((bits[0], bits[1][:62]))
                elif not who:
                    foreign.setdefault("(no Amux-Session trailer)", []).append(
                        (bits[0], bits[1][:62]))
    except Exception:
        return 0  # fail open — the guard must never brick a push
    # ALREADY-UPSTREAM REPLAYS ARE NOT FOREIGN WORK (AC-227). Runs BEFORE
    # consent, because a commit that ships nothing new should never need anyone's
    # permission — that is the exact cost amux-cloud recorded: a blocked push and
    # a peer asked for consent they did not need to give.
    dup_note = ""
    if foreign:
        try:
            limit = int(os.environ.get("AMUX_PATCHID_LIMIT", "400"))
        except ValueError:
            limit = 400
        if limit > 0:
            all_shas = [sha for rows in foreign.values() for sha, _s in rows]
            dup, note = _upstream_duplicates(all_shas, limit)
            if dup:
                remaining = {}
                for who, rows in foreign.items():
                    keep = [r for r in rows if r[0] not in dup]
                    if keep:
                        remaining[who] = keep
                _audit("DUPLICATE", "already-upstream=%s" % ",".join(
                    "%s~%s" % (s, u) for s, (u, _p) in sorted(dup.items())))
                lines = "".join(
                    "    %s  is already upstream as %s  (patch-id %s)\n"
                    % (s, u[:12], p[:16]) for s, (u, p) in sorted(dup.items()))
                dup_note = (
                    "\namux push-guard: %d commit(s) look foreign but are ALREADY UPSTREAM "
                    "under a different sha\n"
                    "  (cherry-pick / rebase / replay). They ship nothing new, so they are "
                    "not treated as foreign:\n%s"
                    "  Matched by DIFF, not by sha, and %s. A commit whose twin is older "
                    "than that bound\n"
                    "  still reads as foreign — the safe error, but say so rather than let "
                    "it look impossible.\n"
                    "  A patch applied AND reverted upstream is deliberately NOT cleared: "
                    "re-applying it ships\n"
                    "  something real (AC-227's own stated inverse hazard).\n\n"
                    % (len(dup), lines, note))
                foreign = remaining
            elif dup is None:
                dup_note = (
                    "\namux push-guard: could not check for already-upstream replays "
                    "(%s).\n"
                    "  Every commit below stays foreign — the safe direction, but a "
                    "cherry-pick may be\n"
                    "  among them (AC-227). `git patch-id` is the discriminator if you "
                    "want to check by hand.\n\n" % note)
    if dup_note:
        sys.stderr.write(dup_note)
    if not foreign:
        return 0

    # AUTHOR CONSENT, RECORDED (AMUX-3533).
    #
    # Until this existed the guard modelled exactly ONE consenting party. Its
    # three exits were: ship your contiguous prefix, ask the author to push
    # their own, or `AMUX_ALLOW_FOREIGN=1` "if the human explicitly asked you to
    # ship everything". On a shared checkout with ~50 lanes the consenting party
    # is routinely the AUTHOR, not the human, and none of the three fit that:
    #
    #   - the prefix exit is WRONG when a foreign commit sits BETWEEN two of
    #     yours. Measured 2026-08-23: it offered a "contiguous run" that was one
    #     of my two commits, so taking it would have shipped half my work and
    #     read as success.
    #   - "ask that session to push its own" is circular — their push then
    #     carries yours and they hit this same refusal from the other side.
    #   - ALLOW_FOREIGN is the only exit that ships the real set, and its stated
    #     precondition is false. The honest options were to lie about who asked,
    #     or to stop with the work unshipped and the author's explicit consent
    #     ignored.
    #
    # TWO INDEPENDENT INSTANCES THE SAME DAY, and the second is why this is a
    # guard change rather than a doc change: amux-frustrations took
    # ALLOW_FOREIGN on the written consent of two peers four hours earlier and
    # did not notice the wording did not cover them. Attentiveness was never the
    # variable. That is ethos rule 6 — a constraint whose sanctioned escape is
    # unwalkable gets walked from somewhere else — and rule 3, since complying
    # honestly was impossible.
    #
    # This is STRICTER than ALLOW_FOREIGN, not a second way around the guard:
    #   - each entry names a SHA and the session that must have authored it,
    #     and the guard checks that against the commit's real trailer. A
    #     mismatch REFUSES, where a blanket override would have shipped it.
    #   - every foreign commit must be covered. One uncovered commit and the
    #     push is still blocked, naming what is missing.
    #   - it is written to the audit log with the sha/session pairs, so the
    #     trail answers "who authorized shipping this?" instead of recording an
    #     undifferentiated override. Both of today's pushes are in that log as
    #     blanket overrides, which is the fact this recovers.
    consent_raw = os.environ.get("AMUX_FOREIGN_CONSENT", "").strip()
    if consent_raw and not os.environ.get("AMUX_ALLOW_FOREIGN"):
        pairs = []
        malformed = []
        for tok in consent_raw.replace(",", " ").split():
            if ":" not in tok:
                malformed.append(tok)
                continue
            # THREE FIELDS = OWNER CONSENT ON BEHALF OF AN UNREACHABLE WORKER
            # (Ethan, 2026-08-23). An ISOLATED raw-agent worker has the amux
            # harness stripped and is reachable only by the owner from the
            # dashboard, so `amux send <them>` is REFUSED by construction. That
            # made two of the guard's three exits unwalkable for their commits:
            # "ask that session to push its own" cannot be asked, and
            # AMUX_FOREIGN_CONSENT needed a yes that cannot be given. The only
            # remaining exit was the blanket override — which is exactly the
            # shape AMUX-3533 fixed one layer up, reappearing because the fix
            # assumed every author is reachable.
            #
            # `:owner` is NOT a second blanket override. It is refused unless
            # the named session is GENUINELY ISOLATED, verified against the
            # server, so it cannot be used to wave through a peer you could
            # simply have asked. And it is logged as CONSENT-OWNER, distinct
            # from author consent, because "the owner authorized this on behalf
            # of a worker that cannot speak" is a different fact from "the
            # author said yes" and the audit should not blur them.
            bits = [b.strip() for b in tok.split(":")]
            if len(bits) == 3 and bits[2].lower() == "owner":
                pairs.append((bits[0], bits[1], True))
            elif len(bits) == 2:
                pairs.append((bits[0], bits[1], False))
            else:
                malformed.append(tok)
        # A malformed entry is REFUSED, never skipped. Silently ignoring one
        # would leave the caller believing they granted a consent they did not,
        # and the push would then fail for a reason that names the wrong commit.
        if malformed:
            sys.stderr.write(
                "\namux push-guard: AMUX_FOREIGN_CONSENT is malformed: %s\n"
                "  Expected space/comma separated <sha>:<session> pairs, e.g.\n"
                "    AMUX_FOREIGN_CONSENT=\"bb3d9a8:amux-frustrations\" git push ...\n\n"
                % ", ".join(malformed))
            return 1
        cleared, mismatched = [], []
        for sha_in, who_in, owner_grant in pairs:
            real = subprocess.run(
                ["git", "log", "-1",
                 "--format=%h%x1f%(trailers:key=Amux-Session,valueonly)", sha_in],
                capture_output=True, text=True, timeout=15)
            if real.returncode != 0 or not real.stdout.strip():
                mismatched.append((sha_in, who_in, "no such commit"))
                continue
            bits = real.stdout.strip().split("\x1f")
            real_who = (bits[1].strip() if len(bits) > 1 else "")
            if real_who != who_in:
                mismatched.append(
                    (sha_in, who_in, "actually authored by %s" % (real_who or "(no trailer)")))
                continue
            if owner_grant and not _session_is_isolated(who_in):
                # FAIL CLOSED. Unreachable-or-not-isolated both land here: if we
                # cannot establish that the author is unaskable, the answer is
                # ask them.
                mismatched.append((
                    sha_in, who_in,
                    "':owner' is only for ISOLATED workers you cannot ask, and '%s' is not "
                    "confirmed isolated (or the server could not be reached). Ask them, or "
                    "use the two-field form if they consented" % who_in))
                continue
            if not owner_grant and _session_is_isolated(who_in):
                # THE OTHER DIRECTION, AND IT IS THE ONE THAT SILENTLY LIED
                # (AF-206). `:owner` was already refused when the author is NOT
                # isolated. The inverse was accepted: a two-field grant for an
                # author who CANNOT BE ASKED cleared on a trailer match alone
                # and was logged as author consent, so the audit trail recorded
                # "the author said yes" about a raw-agent worker with the amux
                # harness stripped, whose `amux send` is refused by
                # construction. Nobody had to be careless to produce that — the
                # refusal message computed the two-field string for every author
                # including the isolated ones and invited you to paste it.
                #
                # This half is what makes the `:owner` distinction mean
                # anything. An owner grant is a different FACT from an author
                # grant, and a form that lets you spell one as the other
                # collapses them at exactly the point the audit needs them
                # separate.
                mismatched.append((
                    sha_in, who_in,
                    "'%s' is an ISOLATED (raw-agent) worker — `amux send` to it is refused "
                    "by construction, so its author consent cannot have been obtained. "
                    "Only the owner can grant this, and it is recorded distinctly: use "
                    "%s:%s:owner" % (who_in, sha_in, who_in)))
                continue
            cleared.append((bits[0], who_in, owner_grant))
        if mismatched:
            sys.stderr.write(
                "\namux push-guard: AMUX_FOREIGN_CONSENT does not match the commits.\n"
                "  Consent must name the sha AND the session that really authored it —\n"
                "  this check is why author-consent is safer than a blanket override.\n\n")
            for sha_in, who_in, why in mismatched:
                sys.stderr.write("    %s:%s -> %s\n" % (sha_in, who_in, why))
            sys.stderr.write("\n")
            return 1
        cleared_short = {c[0] for c in cleared}
        remaining = {}
        for who, rows in foreign.items():
            keep = [r for r in rows if r[0] not in cleared_short]
            if keep:
                remaining[who] = keep
        if not remaining:
            _audit(
                "CONSENT-OWNER" if any(c[2] for c in cleared) else "CONSENT",
                "cleared=%s" % ",".join(
                    "%s:%s%s" % (c[0], c[1], ":owner-granted" if c[2] else "") for c in cleared))
            sys.stderr.write(
                "\namux push-guard: %d foreign commit(s) cleared by recorded author consent:\n"
                "  %s\n"
                "  (logged to ~/.amux/logs/push-guard.log — this is an AUDITED exit, not a bypass)\n\n"
                % (len(cleared), ", ".join(
                    "%s (%s%s)" % (c[0], c[1], ", owner-granted: isolated worker" if c[2] else "")
                    for c in cleared)))
            return 0
        # PARTIAL consent still blocks, and says exactly what is uncovered —
        # otherwise a caller who granted three of four would read the refusal as
        # the consent mechanism not working at all.
        sys.stderr.write(
            "\namux push-guard: AMUX_FOREIGN_CONSENT covers %d commit(s) but not all of them.\n"
            "  Still uncovered:\n" % len(cleared))
        for who in sorted(remaining):
            for sha, subj in remaining[who][:6]:
                sys.stderr.write("    %s  %s  (%s)\n" % (sha, subj, who))
        sys.stderr.write("\n  Add each to AMUX_FOREIGN_CONSENT as <sha>:<session>, or ask "
                         "those sessions to push.\n\n")
        return 1

    w = sys.stderr.write
    n = sum(len(v) for v in foreign.values())
    w("\namux push-guard: PUSH BLOCKED — this would ship %d commit(s) authored by "
      "another session in this shared checkout:\n\n" % n)
    for who in sorted(foreign):
        w("  %s:\n" % who)
        for sha, subj in foreign[who][:6]:
            w("    %s  %s\n" % (sha, subj))
        if len(foreign[who]) > 6:
            w("    ... and %d more\n" % (len(foreign[who]) - 6))
    # NAME THE ESCAPE, and compute it (AMUX-2512). This refusal offered only "ask
    # that session" or the override, and said nothing about ORDER — so two sessions
    # with interleaved commits each blocked correctly and both stalled. That happened
    # twice in one afternoon, roles swapped the second time, and it took a third
    # session reading the stack from outside to spot it.
    #
    # The constraint the guard creates and never announced, stated precisely — my
    # first version of this comment overstated it and the test caught me:
    # you can always ship the contiguous run of YOUR commits sitting directly above
    # the remote, whatever is above THAT. So a tip owner is not fully blocked; they
    # ship their lower prefix and wait for the foreign commit to clear before the
    # rest. Only a stack whose FIRST unpushed commit is foreign has no escape at all.
    # Either way the ordering is: lower owner first. Nothing in the old message
    # hinted ordering mattered, so "correctly declined to override" looked identical
    # to "stalled".
    safe = ""
    for _sha, _who in reversed(ordered):      # oldest first
        if _who == sess:
            safe = _sha
        else:
            break
    # AN ISOLATED AUTHOR CANNOT BE ASKED, AND THE MESSAGE HAS TO SAY SO (AF-206).
    #
    # `:owner` has existed in the parser since 2026-08-23 and appeared in NO exit
    # this message offers. So the capability reached nobody who needed it —
