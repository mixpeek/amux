# ============================================================================
# amux-staged-guard — blocks a commit whose staged set contains files that a
# DIFFERENT amux session edited in this shared checkout (staged-state sweep,
# AMUX-1730: two sessions share one git index, so `git add -A` in one sweeps
# the other's in-flight WIP into an unrelated commit). Outside amux
# ($AMUX_SESSION unset) it is a no-op — the human is always allowed.
# Intentional cross-session commit: AMUX_ALLOW_FOREIGN=1 git commit ...
#
# FAIL-OPEN, BUT NEVER SILENT (2026-08-09). The previous version wrapped the
# whole server call in `except Exception: return 0  # fail open` and printed
# NOTHING. When the rust cutover left POST /api/git/staged-guard unrouted, the
# endpoint answered 405 about 1,147 times an hour and this hook swallowed every
# one: it exited 0, printed nothing, and every commit on every shared checkout
# went unguarded for the entire window — during which two real sweeps landed.
# Blocking commits on a server hiccup would be worse, so fail-open stays; what
# changes is that a failure now SAYS SO, loudly, with the reason. A guard that
# cannot report its own absence is indistinguishable from a guard that passed.
import json, os, ssl, subprocess, sys, time, urllib.error, urllib.request

# Bump on ANY change to this file, not only on a request/response contract
# change. It is what the installed-copy inventory greps
# (`grep -L 'GUARD_VERSION = 8' */.git/hooks/amux-staged-guard`), so a tracked
# file that changed without moving this number makes every stale installed copy
# read as current — the two-components-disagreeing shape this hook exists to
# report. `scripts/install-hooks.sh` still compares bytes; this is the cheap
# read for "which checkouts are behind".
GUARD_VERSION = 10


def amux_base_url():
    """Where to reach the amux server, self-healing a STALE INHERITED PORT.

    A git hook runs as a child of the `claude` process that invoked git, so it
    inherits that process's `AMUX_URL`. About 55 live sessions predate the
    8822 -> 8824 cutover and carry `AMUX_URL=https://localhost:8822` in their
    process env, which cannot be rotated without killing them. That is why
    "just fix the default" does nothing here: `os.environ.get("AMUX_URL",
    <default>)` only consults the default when the variable is UNSET, and it
    never is. The retired port stayed the busiest one on the machine while
    three separate "fixes" to defaults were in place (ethos rule 1 — capability
    that reaches nobody).

    A one-shot hook has exactly one way to know its inherited URL is stale: ask
    something on this machine that knows better. `endpoint.json` is written by
    the server itself at boot, so the numbers are never hardcoded here — which
    matters because they are REVERSED in the cloud image (8822 is canonical
    there), and a hook with a baked-in `8822 -> 8824` rewrite would break it.

    The rule is deliberately narrow: swap ONLY a localhost URL that is on the
    port the server itself calls retired. A session pointed at a dev instance on
    some other port, or at a remote amux, has made a deliberate choice and is
    left alone.
    """
    url = (os.environ.get("AMUX_URL") or "").strip().rstrip("/")
    home = os.environ.get("AMUX_HOME") or os.path.expanduser("~/.amux")
    try:
        with open(os.path.join(home, "endpoint.json")) as fh:
            ep = json.load(fh)
        canonical = (ep.get("canonical_url") or "").rstrip("/")
        # RETIRED ports, not just the currently-bound legacy one (AMUX-2946).
        # This used to read `if legacy and canonical` — so the self-heal died
        # the instant the legacy bind was dropped and `legacy_port` began
        # publishing null, which is the one moment it was needed. Observed
        # immediately: "staged-guard: NOT ENFORCED — connection refused",
        # cross-session sweep protection off for every pre-cutover session.
        # A retired address has to stay KNOWN after it stops being served,
        # because the processes still naming it cannot be told anything else.
        stale = list(ep.get("retired_ports") or [])
        if ep.get("legacy_port"):
            stale.append(ep["legacy_port"])
        if canonical and stale:
            from urllib.parse import urlsplit
            sp = urlsplit(url)
            # Only loopback, and only a port we KNOW we retired: a session
            # aimed at a dev instance or a remote amux made a deliberate
            # choice and is left alone.
            if sp.hostname in ("localhost", "127.0.0.1", "::1") and sp.port in stale:
                return canonical
    except Exception:
        # Missing/garbled file is not an error: fall back to the inherited URL,
        # which is what every version before this one did. NB the old comment
        # here reasoned "the legacy bind still answers, so the worst case is the
        # status quo" — true until 2026-08-11, when the bind went and the worst
        # case became a guard that cannot reach the server at all. It fails
        # LOUDLY and records to staged-guard-unenforced.jsonl, which is how this
        # was caught, but the fallback is no longer harmless.
        pass
    return url or "https://localhost:8824"


# ---------------------------------------------------------------------------
# THE UNENFORCED LEDGER (AMUX-2807).
#
# This guard FAILS OPEN, which is the right default — failing closed would brick
# every lane whenever the server bounces, and the server bounces on every commit
# that touches crates/ (the builder installs a new binary and the running server
# self-adopts). But a bypass that leaves no trace is the ethos-6 defect: the one
# escape from the whole protection is the one action with no record, while the
# message says "OFF for this commit" and then forgets.
#
# So every NOT-ENFORCED outcome is appended here, on the LOCAL disk, deliberately
# not via the server — the server being unreachable is the commonest reason we
# are in this path at all. A dependency you cannot reach cannot be your audit log.
UNENFORCED_LOG = os.path.join(
    os.environ.get("AMUX_HOME") or os.path.expanduser("~/.amux"),
    "staged-guard-unenforced.jsonl")


def record_unenforced(reason, sess, paths):
    """Append one unguarded commit. Never raises: an audit failure must not
    become a commit failure."""
    try:
        head = subprocess.run(["git", "rev-parse", "--short", "HEAD"],
                              capture_output=True, text=True, timeout=5).stdout.strip()
        with open(UNENFORCED_LOG, "a") as fh:
            fh.write(json.dumps({
                "ts": time.time(), "session": sess, "reason": reason,
                "paths": len(paths), "head_before": head,
                "guard_version": GUARD_VERSION,
            }) + "\n")
    except Exception:
        pass


def report_unenforced_backlog(w, sess):
    """Surface the ledger WHERE THE READER ALREADY IS — on the next commit whose
    guard actually ran. A count in a file nobody opens is the same failure as no
    count (ethos rule 4, second layer: the blindness just moves). Entries are
    marked reported so this announces a backlog once, not forever."""
    try:
        if not os.path.exists(UNENFORCED_LOG):
            return
        with open(UNENFORCED_LOG) as fh:
            rows = [json.loads(l) for l in fh if l.strip()]
        new = [r for r in rows if not r.get("reported")]
        if not new:
            return
        oldest = min(r.get("ts", 0) for r in new)
        mine = sum(1 for r in new if r.get("session") == sess)
        w("\namux staged-guard: %d COMMIT(S) LANDED UNGUARDED since %s (%d by you, %s).\n"
          "  Sweep protection was off for those — a peer's work could be in them and nothing compared it.\n"
          "  %s\n"
          "  Reasons: %s\n"
          % (len(new), time.strftime("%Y-%m-%d %H:%M", time.localtime(oldest)), mine, sess,
             UNENFORCED_LOG,
             ", ".join(sorted({(r.get("reason") or "?")[:60] for r in new}))))
        for r in rows:
            r["reported"] = True
        with open(UNENFORCED_LOG, "w") as fh:
            for r in rows:
                fh.write(json.dumps(r) + "\n")
    except Exception:
        pass


# ---------------------------------------------------------------------------
# AF-127: per-verdict OUTCOME reporting. The guard's verdict rows record
# BLOCK/ALLOW; these helpers report what happened NEXT, which is the half no
# instrument carried — a true positive (audited override) and a false positive
# (reflexive ack) were byte-identical. `proceeded` is DECLARED (the override
# env var the operator actually set); trimmed/reallowed are OBSERVED (this
# hook compares the next staged set itself); aborted is never reported at all
# — the server computes it from unresolved-and-old rows.
def _marker_path(sess, top):
    import hashlib
    h = hashlib.sha256(top.encode()).hexdigest()[:12]
    d = os.path.join(os.environ.get("AMUX_HOME") or os.path.expanduser("~/.amux"),
                     "hooks", "state")
    try:
        os.makedirs(d, exist_ok=True)
    except Exception:
        pass
    return os.path.join(d, "guard-block-%s-%s.json" % (sess, h))


def _read_marker(sess, top):
    try:
        with open(_marker_path(sess, top)) as fh:
            return json.load(fh)
    except Exception:
        return None


def _write_marker(sess, top, verdict_id, paths):
    try:
        with open(_marker_path(sess, top), "w") as fh:
            json.dump({"verdict_id": verdict_id, "ts": time.time(),
                       "dir": top, "paths": paths}, fh)
    except Exception:
        pass


def _clear_marker(sess, top):
    try:
        os.remove(_marker_path(sess, top))
    except Exception:
        pass


def _post_outcome(sess, top, resolution, basis, override=None,
                  verdict_id=None, elapsed=None):
    """Fire-and-forget outcome report. Failure must never touch the commit;
    a failed send is appended to the local ledger so the data point is not
    silently lost (same pattern as the unenforced ledger)."""
    body = {"resolution": resolution, "basis": basis, "dir": top}
    if override:
        body["override"] = override
    if verdict_id is not None:
        body["verdict_id"] = verdict_id
    if elapsed is not None:
        body["elapsed_s"] = round(elapsed, 1)
    try:
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        req = urllib.request.Request(
            amux_base_url() + "/api/git/guard-outcome",
            data=json.dumps(body).encode(), method="POST",
            headers={"Content-Type": "application/json", "X-Amux-Session": sess})
        with urllib.request.urlopen(req, timeout=3, context=ctx) as r:
            d = json.loads(r.read().decode())
        if not d.get("attached"):
            # A real answer, kept: pre-emptive override with no open block,
            # or a verdict predating guard_verdicts.
            record_unenforced("outcome-unattached: %s" % (d.get("note") or "")[:80],
                              sess, [])
    except Exception as e:
        record_unenforced("outcome-send-failed: %r" % (e,), sess, [])


# ---------------------------------------------------------------------------
# AF-195: YOU ARE COMMITTING THE INDEX; YOUR TESTS DESCRIBED THE WORKING TREE.
#
# INCIDENT (2026-08-24, AF-182 instance five). amux-frustrations ran the full
# suite: 37/37 green. Minutes later the same suite failed for another lane on
# the commit they had just made, because the blob in `.git/index` for
# `board.rs` was not the file on disk they had tested. A numeric floor that
# their own commit message said was REMOVED was added back by the diff.
#
# Both results were true. The verification did not fail, it EXPIRED — and that
# defeats "verify before you commit" as a habit, because the habit's premise is
# that a green result describes the thing you are about to commit.
#
# THE FRAMING THAT MAKES IT CHEAP TO CATCH: nothing "moved". `git commit`
# writes the INDEX and every test reads the WORKING TREE, and those are two
# objects that nothing requires to agree. So the check is one command, it is
# deterministic, it needs no server, and it answers in milliseconds:
#
#     (worktree != index)  INTERSECT  (index != HEAD)
#
# The intersection is load-bearing in both directions. Without the first term
# you flag every ordinary commit; without the second you flag unrelated dirty
# files that are not being committed at all — which is most of a shared
# checkout, most of the time, and a guard that fires on every commit is one
# everybody learns to bypass.
#
# WHY THE OTHER COMMIT FORMS DO NOT TRIP IT, verified rather than assumed (see
# scripts/test-index-worktree-divergence.sh): `git commit -a` and
# `git commit -- <paths>` both build a TEMPORARY index from the working tree
# and point GIT_INDEX_FILE at it, so `git diff` inside the hook compares the
# worktree against that temp index and finds nothing. The form this fires on is
# plain `git commit` over a hand-staged index, which is exactly the form the
# incident used.
DIVERGENCE_LOG = os.path.join(
    os.environ.get("AMUX_HOME") or os.path.expanduser("~/.amux"),
    "staged-guard-divergence.jsonl")


def _git_lines(args):
    r = subprocess.run(["git"] + args, capture_output=True, text=True, timeout=10)
    return [p for p in r.stdout.split("\0") if p.strip()]


def index_worktree_divergence(sess, w):
    """Refuse a commit whose staged content differs from the files on disk.

    Returns 1 to block, 0 to allow. Fails OPEN on any error, like the rest of
    this guard: a hook that cannot run must not brick every lane's commit.
    """
    try:
        staged = set(_git_lines(["diff", "--cached", "--name-only", "-z"]))
        if not staged:
            return 0
        dirty = set(_git_lines(["diff", "--name-only", "-z"]))
        both = sorted(staged & dirty)
        if not both:
            return 0
    except Exception as e:
        # Distinguishable from "clean" in the log, per the file's own rule
        # about the difference between a check that passed and one that never
        # got as far as asking.
        record_unenforced("divergence-check-unreadable: %r" % (e,), sess, [])
        return 0

    if os.environ.get("AMUX_PARTIAL_STAGE"):
        # The honest escape, in the AF-26 shape the overrides below already
        # use: a DECLARATION, not a suppression. `git add -p` is a real
        # workflow and this claim is the true statement for it.
        _record_divergence(sess, both, "declared-partial")
        w("\namux staged-guard: partial stage DECLARED for %d path(s) — %s\n"
          "  Proceeding. Recorded in %s\n" % (len(both), ", ".join(both), DIVERGENCE_LOG))
        return 0

    _record_divergence(sess, both, "blocked")
    w("\n" + "=" * 72 + "\n"
      "amux staged-guard: REFUSED — YOU ARE COMMITTING THE INDEX, NOT THESE FILES.\n"
      + "=" * 72 + "\n"
      "\nThese paths are staged AND differ from the copy on disk:\n\n")
    for p in both:
        w("    %s\n" % p)
    w("\nSo the bytes about to be committed are not the bytes any test you ran\n"
      "read. A green suite minutes ago described the working tree; `git commit`\n"
      "writes the index. Nothing in git, cargo, or this guard's other checks\n"
      "compares the two, which is how AF-182 instance five shipped a commit whose\n"
      "message asserted the opposite of its own diff.\n"
      "\nTHREE HONEST WAYS FORWARD. Pick by which one is TRUE for you:\n"
      "\n  1. Commit what you tested:\n"
      "         git add %s\n"
      "     READ THE DIFF FIRST if the divergence surprised you. On a shared\n"
      "     checkout the disk copy can contain a PEER's edit that landed after\n"
      "     you staged, and re-adding would sweep it into your commit. The\n"
      "     cross-session half of this guard runs next and will say so, but you\n"
      "     want to know before you get there:  git diff -- %s\n"
      "\n  2. Test what you are committing (stash the unstaged remainder first):\n"
      "         git stash push --keep-index && <your test> && git stash pop\n"
      "\n  3. You MEANT to commit a subset (`git add -p`), and you accept that the\n"
      "     staged subset is not what you exercised:\n"
      "         AMUX_PARTIAL_STAGE=1 git commit ...\n"
      "\nNot `--no-verify`: that turns off the cross-session sweep protection too,\n"
      "and this refusal is the cheap one to satisfy.\n"
      % (" ".join(both), " ".join(both)))
    return 1


def _record_divergence(sess, paths, resolution):
    """Local ledger, deliberately not server-backed — the whole value of this
    check is that it answers with nothing running. Counted so instance six of
    AF-182 is a query instead of a conversation between two lanes who happened
    to be talking."""
    try:
        head = subprocess.run(["git", "rev-parse", "--short", "HEAD"],
                              capture_output=True, text=True, timeout=5).stdout.strip()
        with open(DIVERGENCE_LOG, "a") as fh:
            fh.write(json.dumps({
                "ts": time.time(), "session": sess, "resolution": resolution,
                "paths": paths, "head_before": head,
                "guard_version": GUARD_VERSION,
            }) + "\n")
    except Exception:
        pass


def _derive_session_from_tmux():
    """Fallback identity for MR-43: $AMUX_SESSION can be empty inside a lane
    that IS running in its amux-launched tmux pane (the var got lost somewhere
    in the process env, not at spawn — spawn always injects it, session_verbs.rs).
    Ask tmux directly and strip the `amux-` prefix the launcher always uses.

    Scoped to amux- prefixed panes only, so a genuine human shell (no such
    prefix, or no tmux at all) still resolves to "" and takes the existing
    no-op path below — this only recovers a lane that lost its own identity,
    it never invents one for a human.
    """
    try:
        name = subprocess.run(["tmux", "display-message", "-p", "#S"],
                              capture_output=True, text=True, timeout=3).stdout.strip()
    except Exception:
        return ""
    return name[len("amux-"):] if name.startswith("amux-") else ""


def _render_split_risk(d, w):
    """AF-190: this commit SPLITS a peer's work, so it can fail to build even
    though the tree it came from compiles.

    `cargo check` and the pre-commit gate both pass, correctly — they build the
    TREE, which holds the peer's uncommitted half. Nothing builds the COMMIT, so
    53ae4b8b was the tip of origin/main and did not compile.

    A SEPARATE FUNCTION so this can be tested. The rest of the verdict rendering
    lives inline in main() behind a live HTTP call, which is exactly the shape
    that lets a print statement be wrong for months: a field the server emits and
    no hook renders reaches nobody, and nothing about reading main() would say
    so. test_amux_staged_guard.py drives this directly.

    Advisory, never blocking. It is a warning about a BUILD, not an assertion
    that the staged bytes are somebody else's, and blocking on it would stop
    commits that are perfectly legitimate. Printed BEFORE the block section:
    when both fire, this one names a consequence the committer can act on
    without first reading a claim about ownership.
    """
    for _sr in d.get("split_risk") or []:
        w("\namux staged-guard: SPLIT COMMIT WARNING — %s's work is being cut in half:\n"
          % _sr.get("owner", "?"))
        w("  in this commit:  %s\n" % ", ".join(_sr.get("staged") or []))
        w("  left behind, dirty and NOT committed:\n")
        for _p in _sr.get("left_dirty") or []:
            w("    %s\n" % _p)
        # The server's sentence, verbatim. It STATES the hazard rather than
        # asking the committer to judge a number: the guard already printed a
        # discriminating insertion count for the specimen behind this feature
        # ("34 insertions / 9 deletions — if that is MORE than you wrote...")
        # and its author read past it, because 34 matched what they expected.
        # A number that agrees with you is exactly where a check gets skipped.
        w("  %s\n" % _sr.get("why", ""))


def main():
    sess = os.environ.get("AMUX_SESSION", "")
    derived = False
    if not sess:
        sess = _derive_session_from_tmux()
        derived = bool(sess)
    if derived:
        # Said HERE, once, before any check runs on `sess` — every message and
        # server call below already uses whatever `sess` resolved to, so this
        # is the one place a reader needs the note to make sense of the rest.
        sys.stderr.write(
            "amux staged-guard: $AMUX_SESSION was empty; using '%s' from the "
            "tmux session name instead (MR-43).\n" % sess)
    # AF-195 runs FIRST and outranks the overrides below, because it is a
    # different claim. ALLOW_FOREIGN says "their work is in it and I mean to
    # ship it"; neither it nor VERIFIED_SOLO says anything about whether the
    # staged bytes are the bytes you tested, and letting them imply it would
    # put the commonest override in the fleet on the path of the newest check.
    if sess and index_worktree_divergence(sess, sys.stderr.write):
        return 1
    # AMUX_VERIFIED_SOLO is the HONEST half of the same exit (AF-26). Both skip the
    # check; they differ in what the operator asserts, and that difference is the point —
    # ALLOW_FOREIGN says "their work is in it and I mean to ship it", VERIFIED_SOLO says
    # "I read the staged diff and none of it is theirs". Clearing a FALSE positive
    # previously required claiming the first, which is ethos rule 3: a constraint with no
    # truthful path forward in a legitimate state.
    if not sess:
        return 0
    _ov = ("allow_foreign" if os.environ.get("AMUX_ALLOW_FOREIGN")
           else "verified_solo" if os.environ.get("AMUX_VERIFIED_SOLO") else None)
    if _ov:
        # AF-127: the override IS the outcome — the one honestly-reported cell.
        # Which var was set is a different claim in each case, and recording
        # only "proceeded" would throw that distinction away (the reporter's
        # own worked example: e823ae3, blocked, audited, chose SOLO because
        # SOLO was the true statement).
        try:
            _top = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                                  capture_output=True, text=True,
                                  timeout=5).stdout.strip() or os.getcwd()
            _m = _read_marker(sess, _top) or {}
            _el = (time.time() - _m["ts"]) if _m.get("ts") else None
            _post_outcome(sess, _top, "proceeded", "declared", override=_ov,
                          verdict_id=_m.get("verdict_id"), elapsed=_el)
            _clear_marker(sess, _top)
        except Exception:
            pass
        return 0
    w = sys.stderr.write
    try:
        staged = subprocess.run(["git", "diff", "--cached", "--name-only", "-z"],
                                capture_output=True, text=True, timeout=10)
        paths = [p for p in staged.stdout.split("\0") if p.strip()]
        if not paths:
            return 0
        top = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True,
                             timeout=10).stdout.strip() or os.getcwd()
    except Exception as e:
        # Even the local git calls report themselves now. This branch means the
        # guard never got as far as asking, which is not the same as "clean".
        w("amux staged-guard: SKIPPED — could not read the staged set (%r). "
          "Cross-session sweep protection is OFF for this commit.\n" % (e,))
        record_unenforced("staged-set-unreadable: %r" % (e,), sess, [])
        return 0

    url = amux_base_url() + "/api/git/staged-guard"
    body = json.dumps({"session": sess, "dir": top, "paths": paths,
                       "op": "commit", "guard_version": GUARD_VERSION}).encode()
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    req = urllib.request.Request(url, data=body, method="POST", headers={
        "Content-Type": "application/json", "X-Amux-Session": sess})
    # THREE distinct failure classes, three distinct messages. They used to be
    # one silent `except`, and the difference between them is the difference
    # between "start the server", "your server is too old / the route is gone",
    # and "the server is broken" — a reader who is told only "it failed" cannot
    # act, and a reader who is told nothing does not know to.
    # RETRY A CONNECTION FAILURE, ONCE-PLUS. A single 5s attempt is brittle
    # against a dependency that THIS WORKFLOW restarts: committing to crates/
    # makes the builder install a new binary and the running server self-adopt,
    # so the very next lane's commit can arrive mid-bounce. amux-cloud lost two
    # consecutive commits' protection to timeouts (AMUX-2807).
    #
    # Only connection-level failures are retried. An HTTP error is a DEFINITIVE
    # answer — a 404 means the route is gone and no amount of waiting fixes it,
    # and retrying it would just triple the delay before the same message.
    raw = None
    last_err = None
    t0 = time.time()
    for attempt in range(3):
        try:
            with urllib.request.urlopen(req, timeout=5, context=ctx) as r:
                raw = r.read().decode()
            break
        except urllib.error.HTTPError:
            # Definitive — re-raised below so the existing per-code messages,
            # which tell the reader how to ACT on each, stay the only place
            # those are written.
            raw = None
            last_err = None
            break
        except Exception as e:
            last_err = e
            if attempt < 2:
                time.sleep(1.5)
    if raw is None and last_err is not None:
        # Report the MEASURED elapsed, not a guess at it: a connection refused
        # instantly and a connection that timed out three times are ~3s and ~18s,
        # and telling the reader which one they had is the difference between
        # "the server is down" and "the server is wedged or the network is".
        w("\namux staged-guard: NOT ENFORCED — could not reach the amux server at %s "
          "after 3 attempts over %.1fs (%r).\n"
          "  Cross-session sweep protection is OFF for this commit — RECORDED in %s\n"
          % (url, time.time() - t0, last_err, UNENFORCED_LOG))
        record_unenforced("unreachable after %.1fs: %r" % (time.time() - t0, last_err), sess, paths)
        return 0
    try:
        if raw is None:
            with urllib.request.urlopen(req, timeout=5, context=ctx) as r:
                raw = r.read().decode()
    except urllib.error.HTTPError as e:
        detail = ""
        try:
            detail = (e.read().decode() or "")[:200]
        except Exception:
            pass
        if e.code in (404, 405, 501):
            w("\namux staged-guard: NOT ENFORCED — the amux server does not route "
              "POST /api/git/staged-guard (HTTP %d).\n"
              "  Cross-session sweep protection is OFF for this commit and every other "
              "commit on this machine.\n"
              "  This is the exact failure that went unnoticed for the whole rust cutover. "
              "Update the server, then check:  curl -sk -X POST -d '{}' %s\n"
              % (e.code, url))
        else:
            w("\namux staged-guard: NOT ENFORCED — the server errored (HTTP %d) %s\n"
              "  Cross-session sweep protection is OFF for this commit.\n"
              % (e.code, detail))
        record_unenforced("http-%d" % e.code, sess, paths)
        return 0
    except Exception as e:
        w("\namux staged-guard: NOT ENFORCED — could not reach the amux server at %s (%r).\n"
          "  Cross-session sweep protection is OFF for this commit.\n" % (url, e))
        return 0
    try:
        d = json.loads(raw)
    except Exception:
        w("\namux staged-guard: NOT ENFORCED — the server answered non-JSON (%r).\n"
          "  Cross-session sweep protection is OFF for this commit.\n" % (raw[:200],))
        record_unenforced("non-json", sess, paths)
        return 0
    if not isinstance(d, dict):
        w("\namux staged-guard: NOT ENFORCED — unexpected response shape.\n")
        record_unenforced("bad-shape", sess, paths)
        return 0

    # UNDECIDED is not ALL-CLEAR. The server says so explicitly because the two
    # are byte-identical otherwise: empty foreign/shared/unclaimed lists (ethos
    # rule 4 — a wrong answer must be detectable from what you keep).
    # The guard reached the server, so this is the moment the reader is looking
    # at its output — the only moment a backlog of unguarded commits will be
    # read. Announced before the verdict so it is not lost under a long report.
    report_unenforced_backlog(w, sess)

    if d.get("undecided"):
        w("\namux staged-guard: COULD NOT DECIDE — %s\n"
          "  The empty verdict below is NOT a clean bill of health; nothing was compared.\n"
          % (d.get("reason") or "no reason given",))
    for note in (d.get("degraded") or []):
        # A verdict WAS computed but may UNDER-report — the dangerous direction.
        w("amux staged-guard: PARTIAL — %s\n" % note)
    if d.get("enabled") is False:
        w("amux staged-guard: DISABLED on the server (AMUX_STAGED_GUARD=0) — "
          "cross-session sweep protection is OFF.\n")

    # SHARED paths are not blocked — both sessions edited them, so the committer
    # has a legitimate claim and blocking would deadlock the file. But say it out
    # loud (AMUX-2332): in a single-file project this is the NORMAL case on the
    # only file that matters, so the guard was silent on exactly the sweeps most
    # likely to happen. `git add -A` here takes the other session's in-flight
    # hunks too, and their `git commit` then reports "nothing to commit".
    for f in (d.get("shared") or []):
        mins = int((f.get("age_secs") or 0) / 60)
        _n = ""
        try:
            _ns = subprocess.run(
                ["git", "diff", "--cached", "--numstat", "--", f.get("path") or ""],
                capture_output=True, text=True, timeout=5).stdout.split()
            if len(_ns) >= 2 and _ns[0].isdigit():
                _n = " This commit stages %s insertions / %s deletions there — if that is " \
                     "MORE than you wrote, their work is in it." % (_ns[0], _ns[1])
        except Exception:
            _n = ""
        # AC-297: upgrade from NOTE to WARNING when the file has unstaged changes
        # right now. That is the FACT — someone has uncommitted work in a file
        # you are about to commit whole.
        _level = "WARNING" if f.get("has_unstaged_changes") else "NOTE"
        # RECIPE CORRECTED (AC-303). This printed `git diff -U0` + `git apply
        # --cached`, and that pairing produced FOUR unbuildable commits on
        # 2026-08-08 — all the same shape, a `try:` in main() whose body came
        # from the hunk that was trimmed out. Zero-context hunks carry no anchor
        # lines, so a trimmed patch lands at a stale offset precisely when the
        # hunks you dropped share a region with the ones you kept, which is the
        # normal case for co-edited code and therefore the only case this notice
        # fires in. Default context + --check makes git VERIFY placement and
        # refuse.
        # AF-24: '(unknown)' is the NO-PEER placeholder from the server's shared
        # branch, not a session name. Rendering it as "also edited by session
        # '(unknown)'" asserts a co-editor who does not exist — the real fact is
        # that YOU edited it and it has uncommitted changes.
        _who = ("was also edited by session '%s' %dm ago" % (f.get("owner"), mins)
                if f.get("peer")
                else "is yours and has uncommitted changes right now — no other "
                     "session edited it")
        w("amux staged-guard: %s — %s %s.%s\n"
          "  Reconcile the count above against what you believe you wrote — that is the "
          "check that caught this class twice.\n"
          "  Keep only your hunks:  git diff %s > /tmp/mine.patch  (trim to yours)  &&  "
          "git apply --cached --check /tmp/mine.patch  &&  git apply --cached /tmp/mine.patch\n"
          "  Do NOT use -U0/--unidiff-zero: it disables context checking and lands hunks at "
          "stale offsets (four unbuildable commits, 2026-08-08).\n"
          "  Then verify the STAGED blob, not the worktree:  git show \":%s\" | "
          "python3 -c 'import ast,sys; ast.parse(sys.stdin.read())'\n"
          % (_level, f.get("path"), _who, _n, f.get("path"), f.get("path")))
        # AMUX-3497: when the server marks the co-edit signal as an ambiguous
        # mtime echo (one write possibly seen through two sessions' Bash
        # windows), say so HERE, where the reader decides whether to go
        # apologize to a peer who never touched the file. Absent on real
        # transcript co-edits; old servers never send it.
        if f.get("co_signal"):
            w("  Co-edit signal caveat: %s\n" % f.get("co_signal"))
        # AMUX-3662: say how EACH side knows, not just the peer's side.
        #
        # `co_signal` above only fires when the PEER's claim is observed, so the
        # inverse case — their claim is a recorded write and YOURS is an mtime
        # your Bash window caught — printed no marker at all. Both ages rendered
        # identically and the reader had no way to tell which claim was
        # inferred. Measured 2026-08-24 on `api/board.rs`: equal ages, peer's
        # claim real (commit 8575cc6f), mine a `sed` that only READ the file.
        #
        # Printed only when the two DISAGREE, because that is the case the
        # reader cannot resolve; two transcript claims need no annotation and a
        # line on every row is a line nobody reads. Absent on old servers, which
        # is why it is a .get with a default rather than an index.
        _mp, _tp = f.get("mine_provenance"), f.get("their_provenance")
        if _mp and _tp and _mp != _tp:
            if _mp == "observed":
                w("  Provenance: THEIR claim is a recorded write; YOURS is an mtime your "
                  "own Bash command saw move, which on a shared checkout includes writes "
                  "you did not make. Before concluding they are a phantom co-editor, check "
                  "whether the phantom is yours (AMUX-3662).\n")
            else:
                w("  Provenance: YOUR claim is a recorded write; THEIRS is an mtime their "
                  "Bash command saw move — possibly your own write, seen from their "
                  "window (AMUX-3662).\n")
    # THE BELT (AMUX-2443 / AF-19 residual / AC-297 — three sightings, one gap):
    # staged paths with NO edit record from ANY session in the window were
    # invisible to both classifications above, and a plain commit ships them
    # under the committer's name (762e06e swept exactly this shape, hours past
    # the window). Not blocked — no owner to defer to — but silence is what
    # made it a sweep.
    _unc = d.get("unclaimed") or []
    if _unc:
        _up = ", ".join((f.get("path") or "") for f in _unc[:6]) \
              + ((" (+%d more)" % (len(_unc) - 6)) if len(_unc) > 6 else "")
        # AMUX-3560: WHETHER THIS SHIPS THEM IS KNOWABLE, so stop guessing.
        #
        # `git commit` with no pathspec commits THE INDEX, which on a shared
        # checkout is one index shared by every session — so a peer staging
        # files makes them yours to commit, silently, with the diff stat the
        # only place it shows. c8272bf1 was meant to carry two files and carried
        # six, four of them another session's in-flight work, and it took that
        # session's name in the trailer too.
        #
        # `git commit -- <paths>` builds the commit from HEAD plus those paths
        # and never reads the shared index, so unclaimed entries in it are
        # irrelevant. Git tells a hook which form it is: with a pathspec it
        # builds a TEMPORARY index and points GIT_INDEX_FILE at
        # `.git/next-index-<pid>.lock`; without one, GIT_INDEX_FILE is
        # `.git/index` (or unset). Verified both ways before relying on it.
        #
        # So the warning becomes a BLOCK for the form that actually ships them,
        # and stays a warning for the form that cannot. This enforces what
        # CLAUDE.md already requires ("`git commit -- <paths>` pathspec form
        # always") rather than asking people to remember it — a rule that only
        # asks you to remember is the shape ethos rule 6 warns about, and this
        # repo has the incident to prove it.
        _idx = os.environ.get("GIT_INDEX_FILE") or ""
        _whole_index = (not _idx) or os.path.basename(_idx) == "index"
        if _whole_index and os.environ.get("AMUX_ALLOW_UNCLAIMED") not in ("1", "true", "yes"):
            w("\namux staged-guard: COMMIT BLOCKED — this commit takes the WHOLE "
              "SHARED INDEX, which holds staged paths no session has an edit "
              "record for:\n\n    " + _up + "\n\n"
              "  On a shared checkout the index belongs to everyone, so a peer "
              "staging a file makes it yours to commit. Scope the commit to your "
              "own paths and the shared index is never read:\n\n"
              "      git commit -m \"...\" -- <your paths>\n\n"
              "  Or unstage what is not yours:  git restore --staged -- <path>\n"
              "  If you have checked and they ARE yours from earlier, "
              "AMUX_ALLOW_UNCLAIMED=1 proceeds.\n")
            return 1
        w("amux staged-guard: UNCLAIMED STAGED PATHS — no edit record from ANY "
          "session in the window: " + _up + "\n"
          "  This commit is path-scoped, so the shared index is not what gets "
          "committed and these do not ride along. Noted because if you did not "
          "stage them, a peer did.\n")
    # AMUX-3446: staged ADDED lines the committer's OWN firsthand edit content
    # cannot account for — the one ownership signal that survives peer-record
    # expiry (7797e45 swept a peer's table row silently because their records
    # had aged out; this line-level check would have named the exact hunk).
    # Advisory, never blocking: shell-edited files are skipped server-side,
    # and an Edit+sed workflow can false-positive.
    for _ua in d.get("unaccounted") or []:
        w("amux staged-guard: NOTE — %d staged added line(s) in %s match nothing "
          "you edited firsthand in the window:\n" % (_ua.get("count", 0), _ua.get("path", "?")))
        for _l in _ua.get("lines") or []:
            w("    + %s\n" % _l)
        w("  If these are yours via shell edits, proceed. If you do not recognize "
          "one, it is a peer's in-flight hunk riding your git add — stage "
          "per-hunk instead (git add -p %s).\n" % _ua.get("path", ""))
    _render_split_risk(d, w)
    foreign = d.get("foreign") or []
    _m = _read_marker(sess, top)
    if not foreign:
        if _m:
            # AF-127, the OBSERVED cells: a prior block in this repo resolved
            # without an override. Which way is a fact this hook can read
            # directly off the staged set — no correlation, no guessing.
            _prev = set(_m.get("paths") or [])
            _res = "trimmed" if not (_prev & set(paths)) else "reallowed"
            _el = (time.time() - _m["ts"]) if _m.get("ts") else None
            _post_outcome(sess, top, _res, "observed",
                          verdict_id=_m.get("verdict_id"), elapsed=_el)
            _clear_marker(sess, top)
        return 0
    w("\namux staged-guard: COMMIT BLOCKED — staged files were edited by "
      "OTHER amux sessions sharing this checkout:\n\n")
    for f in foreign:
        mins = int((f.get("age_secs") or 0) / 60)
        _w = f.get("why")
        w("  %s   (edited by session '%s' %dm ago)%s\n"
          % (f.get("path"), f.get("owner"), mins,
             ("\n      %s" % _w) if _w else ""))
    w("\nUnstage them:   git restore --staged "
      + " ".join(f.get("path", "") for f in foreign) + "\n")
    # AF-26. Two separate defects, both about an honest exit.
    #
    # 1. This verdict is derived from edit RECORDS in a time window; it never reads
    #    the staged patch. So it can fire when the staged diff verifiably contains
    #    none of the peer's work. Tell the reader how to CHECK that, instead of
    #    leaving "am I about to sweep someone?" unanswerable at the moment they
    #    must answer it.
    # 2. The only documented escape was AMUX_ALLOW_FOREIGN=1, described as "if this
    #    cross-session commit is intentional". Clearing a FALSE positive therefore
    #    required asserting the commit was cross-session when it was not — ethos
    #    rule 3. The honest case now has an honest name.
    w("\nVERIFY BEFORE OVERRIDING — this verdict comes from edit records in a time\n"
      "window, NOT from the staged diff, so check whether their work is actually in it:\n")
    for f in foreign:
        w("  git diff --cached -- %s        # is any of this theirs?\n" % f.get("path", ""))
    w("\nThen take the exit that is TRUE:\n"
      "  AMUX_ALLOW_FOREIGN=1 git commit ...   # yes, their work is in it, and I mean to ship it\n"
      "  AMUX_VERIFIED_SOLO=1 git commit ...   # I checked the staged diff: none of it is theirs\n\n")
    # AF-127: anchor the episode. The marker carries THIS verdict's row id so
    # the eventual outcome attaches by id; on a retry-block the marker moves to
    # the newest verdict and the server closes the older row as superseded.
    _write_marker(sess, top, d.get("verdict_id"),
                  [f.get("path", "") for f in foreign])
    return 1


